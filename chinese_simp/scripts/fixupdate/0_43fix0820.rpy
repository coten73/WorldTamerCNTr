translate chinese_simp diana_second_visit_e2e5e82c:

    # player "I'll be back in a few days then."
    player "那我过几天再来。"


# game/scripts/Characters/ellie.rpy:2914
translate chinese_simp druid_quest_six_dc1e2143:

    # player "Yes, the druid's wife visited us."
    player "是的，德鲁伊的妻子来拜访了我们。"


# game/scripts/Characters/ellie.rpy:2918
translate chinese_simp druid_quest_six_cc54602d:

    # player "She wanted to tame me, but I ended up offering her a better deal."
    player "她想驯服我，但最终我向她提出了一个更好的交易。"


# game/scripts/Characters/ellie.rpy:2919
translate chinese_simp druid_quest_six_ce4c185a:

    # player "She said she knows you when I brought you up."
    player "当我提到你时，她说她认识你。"


# game/scripts/Characters/ellie.rpy:2922
translate chinese_simp druid_quest_six_84118ff3:

    # astra "Her name is [kaia], yes. I know a little about her."
    astra "她叫[kaia]，是的。我对她略知一二。"


# game/scripts/Characters/ellie.rpy:2925
translate chinese_simp druid_quest_six_3bdacab2:

    # astra "But why was I brought up?"
    astra "但为什么会提到我？"


# game/scripts/Characters/ellie.rpy:2926
translate chinese_simp druid_quest_six_81a6abec:

    # astra "Am I part of the deal you offered her?"
    astra "我是你给她的交易的一部分吗？"


# game/scripts/Characters/ellie.rpy:2927
translate chinese_simp druid_quest_six_aff2ee69:

    # player "Yes. You're the strongest person I know, so I felt like it was my only choice."
    player "是的。你是我认识的最强的人，所以我觉得这是我唯一的选择。"


# game/scripts/Characters/ellie.rpy:2930
translate chinese_simp druid_quest_six_a84cbb85:

    # astra "I guess it depends on what you promised..."
    astra "我想这取决于你答应了什么……"


# game/scripts/Characters/ellie.rpy:2931
translate chinese_simp druid_quest_six_91290d9c:

    # player "I said you'd help them if they need a celestial."
    player "我说过，如果他们需要一位天人，你会帮忙。"


# game/scripts/Characters/ellie.rpy:2934
translate chinese_simp druid_quest_six_a2c99500:

    # astra "That's kinda vague..."
    astra "这有点含糊……"


# game/scripts/Characters/ellie.rpy:2935
translate chinese_simp druid_quest_six_7a47b4cf:

    # player "I know. But it's not all decided yet."
    player "我知道。但这还没有完全决定。"


# game/scripts/Characters/ellie.rpy:2939
translate chinese_simp druid_quest_six_e42cb6c1:

    # player "She went back to ask the druid if he's fine with this kind of deal."
    player "她回去问德鲁伊是否同意这种交易。"


# game/scripts/Characters/ellie.rpy:2940
translate chinese_simp druid_quest_six_f605c145:

    # player "But she'll be back to negotiate further."
    player "但她会回来进一步协商。"


# game/scripts/Characters/ellie.rpy:2943
translate chinese_simp druid_quest_six_5c255ab4:

    # astra "And I'm guessing I'll get to be there that time?"
    astra "我猜到时候我也会在场吧？"


# game/scripts/Characters/ellie.rpy:2944
translate chinese_simp druid_quest_six_cd0ce7b5:

    # player "Yes. I want you to do all the talking, since this is about your cooperation."
    player "是的。我希望由你来说，因为这关系到你的合作。"


# game/scripts/Characters/ellie.rpy:2950
translate chinese_simp druid_quest_six_4e39b15d:

    # astra "Let's come up with what we can offer, and what's too far then."
    astra "那我们来想想我们能提供什么，以及什么算过界。"


# game/scripts/Characters/ellie.rpy:2954
translate chinese_simp druid_quest_six_72b42553:

    # ellie "I'm guessing giving them access to your dimension whenever is off the table?"
    ellie "我猜随时让他们进入你的领域这件事是没得商量的吧？"


# game/scripts/Characters/ellie.rpy:2955
translate chinese_simp druid_quest_six_f3d8c784:

    # astra "Yeah. That's not something I'd be fine with."
    astra "是的。那是我不能接受的。"


# game/scripts/Characters/ellie.rpy:2956
translate chinese_simp druid_quest_six_582c1d63:

    # player "What other services can a celestial offer besides that?"
    player "除了这个，一位天人还能提供什么服务？"


# game/scripts/Characters/ellie.rpy:2959
translate chinese_simp druid_quest_six_1d9326c8:

    # astra "Toned down versions of that."
    astra "弱化版的类似服务。"


# game/scripts/Characters/ellie.rpy:2960
translate chinese_simp druid_quest_six_c20ea3e6:

    # astra "Like using my dimension to teleport somewhere."
    astra "比如利用我的领域进行传送。"


# game/scripts/Characters/ellie.rpy:2961
translate chinese_simp druid_quest_six_4e440a61:

    # astra "Or letting them hide inside if there's an emergency."
    astra "或者在紧急情况下让他们躲进去。"


# game/scripts/Characters/ellie.rpy:2962
translate chinese_simp druid_quest_six_6aa66f1d:

    # player "Oh, I understand."
    player "哦，我明白了。"


# game/scripts/Characters/ellie.rpy:2965
translate chinese_simp druid_quest_six_9feef4b1:

    # astra "There's also checking old spells, working with artifacts, and so on..."
    astra "还有检查古老法术、处理神器等等……"


# game/scripts/Characters/ellie.rpy:2966
translate chinese_simp druid_quest_six_fbe0a95b:

    # astra "Boring celestial work, basically."
    astra "基本上就是些无聊的天人工作。"


# game/scripts/Characters/ellie.rpy:2967
translate chinese_simp druid_quest_six_d3b43c41:

    # ellie "Would that actually be useful to them?"
    ellie "那些对他们来说真的有用吗？"


# game/scripts/Characters/ellie.rpy:2971
translate chinese_simp druid_quest_six_7fa19868:

    # astra "It's easy work, but celestials are really expensive."
    astra "工作不难，但天人的服务很贵。"


# game/scripts/Characters/ellie.rpy:2974
translate chinese_simp druid_quest_six_92fd69bf:

    # astra "But considering who we're dealing with..."
    astra "但考虑到我们面对的是谁……"


# game/scripts/Characters/ellie.rpy:2977
translate chinese_simp druid_quest_six_2df3914d:

    # astra "If [kaia] comes back ready to work on this deal, then there's something big they'll need me for."
    astra "如果[kaia]回来时准备敲定这笔交易，那么他们一定有什么大事需要我。"


# game/scripts/Characters/ellie.rpy:2978
translate chinese_simp druid_quest_six_06e48663:

    # player "Should we get ahead of that?"
    player "我们要提前做好准备吗？"


# game/scripts/Characters/ellie.rpy:2981
translate chinese_simp druid_quest_six_ebcb5280:

    # astra "We can try, but if that's the main thing they need me for, then I doubt she'll let us."
    astra "我们可以试试，但如果那是他们需要我的主要原因，我怀疑她不会让我们知道。"


# game/scripts/Characters/ellie.rpy:2982
translate chinese_simp druid_quest_six_9a9eb607:

    # ellie "It might help us figure out what it is before promising you'll do it."
    ellie "这或许能帮我们在答应你会做之前，先搞清楚那是什么。"


# game/scripts/Characters/ellie.rpy:2986
translate chinese_simp druid_quest_six_3d2596ec:

    # player "So what would you be fine doing then?"
    player "那你能接受做什么呢？"


# game/scripts/Characters/ellie.rpy:2987
translate chinese_simp druid_quest_six_30ae6669:

    # player "Just the simple yet expensive stuff?"
    player "就那些简单但收费高的？"


# game/scripts/Characters/ellie.rpy:2991
translate chinese_simp druid_quest_six_23437f6c:

    # astra "I'll also do occasional teleportation, and a place for them to hide if needed."
    astra "我偶尔也可以提供传送，以及在需要时给他们一个藏身之处。"


# game/scripts/Characters/ellie.rpy:2992
translate chinese_simp druid_quest_six_3f19d6ee:

    # player "I hope that's enough..."
    player "希望这足够了……"


# game/scripts/Characters/ellie.rpy:2995
translate chinese_simp druid_quest_six_03b13117:

    # astra "If they want more, then they'll have to give up some of the things I just mentioned."
    astra "如果他们想要更多，那他们就得放弃我刚才提到的一些东西。"


# game/scripts/Characters/ellie.rpy:2997
translate chinese_simp druid_quest_six_daf01101:

    # player "Then when she comes back, I'll bring her back here directly."
    player "那等她回来，我直接带她来这里。"


# game/scripts/Characters/ellie.rpy:3000
translate chinese_simp druid_quest_six_f0c4f26e:

    # astra "Yeah. All three of us should talk with her this time."
    astra "嗯。这次我们三个应该一起和她谈谈。"


# game/scripts/Characters/ellie.rpy:3004
translate chinese_simp druid_quest_six_c241f406:

    # ellie "So when I feel her pass through my barrier, I'll just come in here instead."
    ellie "所以，当我感觉到她穿过我的屏障时，我就直接到这里来。"


# game/scripts/Characters/ellie.rpy:3005
translate chinese_simp druid_quest_six_5d8600d5:

    # player "Yeah. I don't want to risk her doing anything to you again."
    player "嗯。我不想冒险让她再对你做什么。"


# game/scripts/Characters/ellie.rpy:3008
translate chinese_simp druid_quest_six_8226e977:

    # ellie "But that means you'll be completely alone with her."
    ellie "但那意味着你会和她单独相处。"


# game/scripts/Characters/ellie.rpy:3009
