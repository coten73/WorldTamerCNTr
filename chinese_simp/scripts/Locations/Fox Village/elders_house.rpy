# game/scripts/Locations/Fox Village/elders_house.rpy:1984
translate chinese_simp forest_quest_twenty_eight_b3b8ed6b:

    # helen "If anything, the trial worked exactly as intended."
    helen "如果要说的话，试炼正好达到了它的目的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:1987
translate chinese_simp forest_quest_twenty_eight_19118c76:

    # freya "And what about the ones who never make it back?"
    freya "那那些再也回不来的人呢？"

# game/scripts/Locations/Fox Village/elders_house.rpy:1988
translate chinese_simp forest_quest_twenty_eight_1af0a98a:

    # freya "Did the trial work perfectly for them too?"
    freya "试炼对他们来说也完美达成目的了吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:1989
translate chinese_simp forest_quest_twenty_eight_07616b43:

    # freya "You talk so much about being superior to humans and keeping our distance from them-"
    freya "你总说我们比人类优越，要跟他们保持距离-"

# game/scripts/Locations/Fox Village/elders_house.rpy:1990
translate chinese_simp forest_quest_twenty_eight_549b3bfe:

    # freya "Yet you're so quick to send our own people out into their world with nothing."
    freya "但你又这么容易就让我们的人两手空空地被丢进他们的世界。"

# game/scripts/Locations/Fox Village/elders_house.rpy:1991
translate chinese_simp forest_quest_twenty_eight_66447c73:

    # abigail "I have to say, I'm inclined to agree with [freya] here."
    abigail "我得说，在这件事上我倾向于同意[freya]。"

# game/scripts/Locations/Fox Village/elders_house.rpy:1994
translate chinese_simp forest_quest_twenty_eight_f07455ff:

    # helen "Of course you are."
    helen "你当然会这么说。"

# game/scripts/Locations/Fox Village/elders_house.rpy:1997
translate chinese_simp forest_quest_twenty_eight_e0c777f5:

    # freya "This isn't just about [lisa]. It's about everyone who was forced to leave."
    freya "这不只是[lisa]一个人的事。这关系到每一个被迫离开的人。"

# game/scripts/Locations/Fox Village/elders_house.rpy:1998
translate chinese_simp forest_quest_twenty_eight_bf400a4d:

    # freya "How many capable foxes have we lost over the years to this flawed strength trial?"
    freya "这些年来，因为这个有缺陷的力量试炼，我们失去了多少有才能的狐狸？"

# game/scripts/Locations/Fox Village/elders_house.rpy:1999
translate chinese_simp forest_quest_twenty_eight_906af8dc:

    # freya "How many of them could have been great strategists, leaders, or teachers?"
    freya "他们之中有多少本可以成为优秀的战略家、领袖或导师？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2002
translate chinese_simp forest_quest_twenty_eight_5f9152ee:

    # abigail "So, what's your proposal?"
    abigail "所以，你的建议是什么？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2003
translate chinese_simp forest_quest_twenty_eight_50de3aff:

    # freya "A new system."
    freya "一套新的制度。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2006
translate chinese_simp forest_quest_twenty_eight_2dfd1e75:

    # freya "One that still values strength, but also intelligence and resourcefulness."
    freya "既重视力量，也重视智力和应变能力。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2007
translate chinese_simp forest_quest_twenty_eight_1fe25565:

    # freya "A trial that weighs all three equally to determine who's truly fit to stay."
    freya "三项并重，来决定谁真正适合留下来。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2008
translate chinese_simp forest_quest_twenty_eight_fa51f41a:

    # freya "A system that evaluates potential instead of discarding people just because they lack brute force."
    freya "一个评估潜力的制度，而不是仅仅因为缺乏蛮力就把人抛弃。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2011
translate chinese_simp forest_quest_twenty_eight_3b3f7b97:

    # helen "You're asking us to change something that's been in place for generations."
    helen "你这是在要求我们改变世代沿袭的东西。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2012
translate chinese_simp forest_quest_twenty_eight_d0c17cef:

    # helen "How do you think people will react?"
    helen "你觉得大家会怎么想？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2015
translate chinese_simp forest_quest_twenty_eight_5c2501c1:

    # freya "Not everyone is as close-minded as you."
    freya "不是每个人都像你一样思想封闭。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2016
translate chinese_simp forest_quest_twenty_eight_5fb18f1c:

    # freya "Most would agree if they considered their own children."
    freya "如果他们想想自己的孩子，大多数都会同意的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2017
translate chinese_simp forest_quest_twenty_eight_e72da61a:

    # abigail "We've made changes before. We even accepted a human into the village..."
    abigail "我们以前也做过改变。我们甚至允许一个人类进入村子……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2020
translate chinese_simp forest_quest_twenty_eight_2ae5e3f3:

    # helen "That was different-he was tamed by one of our own."
    helen "那不一样——他是被我们的人驯服的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2021
translate chinese_simp forest_quest_twenty_eight_232f078f:

    # freya "Does that mean anyone can just leave and bring back a human they tame?"
    freya "那是不是意味着谁都可以出去，然后带个驯服的人类回来？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2024
translate chinese_simp forest_quest_twenty_eight_3021a7da:

    # helen "No."
    helen "不行。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2025
translate chinese_simp forest_quest_twenty_eight_5abff8ab:

    # freya "Right. That would 'taint' our perfect little fox village, wouldn't it?"
    freya "对。那会‘玷污’我们完美的小狐村，对吧？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2028
translate chinese_simp forest_quest_twenty_eight_7bda975d:

    # freya "Face it, [helen]. Change is already happening. You'll have to adapt."
    freya "面对现实吧，[helen]。改变已经在发生。你迟早得适应。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2029
translate chinese_simp forest_quest_twenty_eight_a94da1e0:

    # abigail "I think [freya]'s idea is worth considering."
    abigail "我觉得[freya]的想法值得考虑。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2030
translate chinese_simp forest_quest_twenty_eight_e26a2ac1:

    # freya "We should teach our children to strive for more than just brute strength."
    freya "我们应该教导我们的孩子，追求的不应只是蛮力。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2033
translate chinese_simp forest_quest_twenty_eight_4fb123eb:

    # abigail "We don't have to decide today, but let's not act like this isn't worth discussing."
    abigail "我们不用今天就做决定，但别表现得好像这事不值得讨论一样。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2034
translate chinese_simp forest_quest_twenty_eight_b9358342:

    # freya "That's all I ask."
    freya "我要的就是这个。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2035
translate chinese_simp forest_quest_twenty_eight_33ae565a:

    # helen "...Fine. That's fair."
    helen "……行吧。这样公平。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2038
translate chinese_simp forest_quest_twenty_eight_b36f9812:

    # abigail "That's settled then."
    abigail "那就这么定了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2041
translate chinese_simp forest_quest_twenty_eight_1b507245:

    # abigail "By the way, why did you invite [player] to listen in?"
    abigail "对了，你为什么邀请[player]来旁听？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2044
translate chinese_simp forest_quest_twenty_eight_f2d20dc4:

    # freya "Thought I might need him as a witness for [lisa]'s case."
    freya "我想或许需要他作为[lisa]案件的证人。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2045
translate chinese_simp forest_quest_twenty_eight_abf86d46:

    # helen "Sending him on errands and now this?"
    helen "让他跑腿还不够，现在还让他旁听？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2048
translate chinese_simp forest_quest_twenty_eight_4db2e665:

    # freya "I'm not one to turn down free help~"
    freya "我可不会拒绝免费劳力~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2049
translate chinese_simp forest_quest_twenty_eight_759f50f8:

    # freya "Besides, if his presence really was an issue, one of you would have objected the second he got here."
    freya "再说了，如果他真不该待在这儿，你们俩早在他进门的时候就该反对了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2050
translate chinese_simp forest_quest_twenty_eight_f27e18c3:

    # abigail "That's true... and, well, he is quite involved in all of this..."
    abigail "这倒是……而且，他确实参与了进来……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2051
translate chinese_simp forest_quest_twenty_eight_98700da5:

    # abigail "I suppose there's no harm in him sitting in..."
    abigail "他坐在这儿应该也没什么问题……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2054
translate chinese_simp forest_quest_twenty_eight_6b17adb0:

    # helen "But he does {i}not{/i} get a voice in these meetings. He can observe-nothing more."
    helen "但这些会议里他{i}没有{/i}发言权。只能旁听——仅此而已。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2055
translate chinese_simp forest_quest_twenty_eight_61566f50:

    # freya "That's fair."
    freya "这很合理。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2058
translate chinese_simp forest_quest_twenty_eight_c3f86881:

    # helen "And make sure no one sees you coming back here."
    helen "还有，确保没人看到你再来这里。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2059
translate chinese_simp forest_quest_twenty_eight_096917ff:

    # player "Right..."
    player "知道了……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2062
translate chinese_simp forest_quest_twenty_eight_b9ed8edc:

    # think "[helen] seems to be struggling with something..."
    think "[helen]好像有什么心事……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2063
translate chinese_simp forest_quest_twenty_eight_53511139:

    # think "I should check in on her after this..."
    think "等会儿我得去看看她……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2073
translate chinese_simp forest_quest_twenty_nine_ced1a1f5:

    # player "[helen]? Everything okay?"
    player "[helen]？你还好吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2076
translate chinese_simp forest_quest_twenty_nine_cf21649d:

    # helen "..."
    helen "……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2077
translate chinese_simp forest_quest_twenty_nine_de1567c8:

    # player "You were acting kinda strange at the elder meeting..."
    player "你在长老会上表现得有点奇怪……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2080
translate chinese_simp forest_quest_twenty_nine_698e9c09:

    # helen "Yes."
    helen "嗯。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2083
translate chinese_simp forest_quest_twenty_nine_d5d0d5b8:

    # helen "I'm a hypocrite!"
    helen "我是个伪君子！"

# game/scripts/Locations/Fox Village/elders_house.rpy:2084
translate chinese_simp forest_quest_twenty_nine_03775ec8:

    # player "..."
    player "……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2087
translate chinese_simp forest_quest_twenty_nine_f7280fb9:

    # helen "All the things I say about humans... and here I am, tamed to one.!"
    helen "我说了那么多关于人类的话……结果我自己却被一个人类驯服了！"

# game/scripts/Locations/Fox Village/elders_house.rpy:2088
translate chinese_simp forest_quest_twenty_nine_edf46049:

    # helen "But what am I supposed to do? Just change my whole attitude about humans overnight?"
    helen "但我该怎么办？一夜之间改变我对人类的所有看法吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2089
translate chinese_simp forest_quest_twenty_nine_fd88b027:

    # player "Go slow. Be more agreeable. No one's expecting you to suddenly open the village to humans. That's not what anyone wants."
    player "慢慢来。试着更包容一点。没人指望你突然就对人类敞开大门。那也不是大家想要的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2090
translate chinese_simp forest_quest_twenty_nine_77075f28:

    # player "And you don't have to be perfect either. You can like some humans and dislike others... the same way you like [abigail] but dislike [freya]~"
    player "你也不用做到完美。你可以喜欢某些人类，讨厌另一些……就像你喜欢[abigail]但讨厌[freya]一样~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2093
translate chinese_simp forest_quest_twenty_nine_4646abdd:

    # helen "I don't dislike [freya]... she's just... very pushy."
    helen "我不是讨厌[freya]……她只是……太强势了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2094
translate chinese_simp forest_quest_twenty_nine_78579b04:

    # player "And that's exactly what makes it good. You clearly both care for the village people..."
    player "这不正是好事吗。你们俩都关心村子……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2097
translate chinese_simp forest_quest_twenty_nine_f7d09e85:

    # helen "Everything just feels so much more complicated now..."
    helen "现在一切都变得好复杂……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2100
translate chinese_simp forest_quest_twenty_nine_2a8d2c93:

    # helen "There are just so many secrets I have to keep now-being tamed to you, same with [layla]..."
    helen "我要守的秘密太多了——被你驯服，还有[layla]的事……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2101
translate chinese_simp forest_quest_twenty_nine_9166bbfb:

    # helen "The fact that you're supposed to be tamed to [lisa], not the other way around. And on top of all that, I have to pretend I still despise all humans."
    helen "明明应该是你被[lisa]驯服，而不是反过来。而且除了这些，我还得假装我仍然鄙视所有人类。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2102
translate chinese_simp forest_quest_twenty_nine_7462a578:

    # player "Well... that last part still feels mostly true."
    player "嗯……最后那条感觉还是挺真的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2105
translate chinese_simp forest_quest_twenty_nine_e37cd69a:

    # helen "Not all humans... You're different. You don't act like a human."
    helen "不是所有人类……你不一样。你的行事方式不像人类。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2106
translate chinese_simp forest_quest_twenty_nine_5fb5390f:

    # player "And how do humans act, exactly?"
    player "那人类该怎么行事？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2109
translate chinese_simp forest_quest_twenty_nine_6338790e:

    # helen "Entitled. Like they're the most important race."
    helen "自以为高人一等。好像他们是最重要的种族。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2110
translate chinese_simp forest_quest_twenty_nine_17b1c3a0:

    # player "We do have the biggest numbers by far."
    player "我们确实是目前数量最多的种族。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2113
translate chinese_simp forest_quest_twenty_nine_4939af7f:

    # helen "That's just because... You're compatible with every other race."
    helen "那只是因为……你们跟所有其他种族都能繁衍后代。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2116
translate chinese_simp forest_quest_twenty_nine_ebaa167f:

    # helen "But there's no point in talking about that now."
    helen "但现在讨论这个没意义。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2117
translate chinese_simp forest_quest_twenty_nine_9f3c545f:

    # helen "You're right... I need to start digging my way out of this hole."
    helen "你说得对……我得想办法从这个困境里走出来。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2120
translate chinese_simp forest_quest_twenty_nine_d27068f2:

    # helen "And before you go..."
    helen "你走之前……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2123
translate chinese_simp forest_quest_twenty_nine_7961f38e:

    # helen "Thank you for checking up on me..."
    helen "谢谢你来看我……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2126
translate chinese_simp forest_quest_twenty_nine_4911ff03:

    # helen "[player]..!"
    helen "[player]..！"

# game/scripts/Locations/Fox Village/elders_house.rpy:2127
translate chinese_simp forest_quest_twenty_nine_7797a937:

    # player "I won't stop you if you decide to hug me one of these days you know..."
    player "如果你哪天想抱抱我，我不会介意的……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2130
translate chinese_simp forest_quest_twenty_nine_da8a0a7d:

    # helen "Right... Sorry."
    helen "对……抱歉。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2144
translate chinese_simp forest_quest_thirty_d115571b:

    # think "Hmm..?"
    think "嗯..？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2147
translate chinese_simp forest_quest_thirty_bd901bad:

    # helen "Hello, it's me [helen]."
    helen "喂，是我，[helen]。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2148
translate chinese_simp forest_quest_thirty_f2a16d56:

    # player "I know. You're saved in my phone."
    player "我知道。我存了你的号码。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2149
translate chinese_simp forest_quest_thirty_2522be97:

    # player "You don't usually call me out of nowhere though. What's going on?"
    player "不过你通常不会无缘无故打电话给我。出什么事了？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2150
translate chinese_simp forest_quest_thirty_26b0c42b:

    # helen "It's about [freya]."
    helen "是关于[freya]的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2151
translate chinese_simp forest_quest_thirty_170b15f1:

    # helen "You helped her become an elder, so I figured you'd be the best person to talk to her."
    helen "你帮她当上了长老，所以我想你应该是跟她谈这件事的最佳人选。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2152
translate chinese_simp forest_quest_thirty_66523fab:

    # player "What did she do?"
    player "她做什么了？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2153
translate chinese_simp forest_quest_thirty_2ed2e9ec:

    # helen "Just come over.{w=1}{nw}"
    helen "你过来一趟。{w=1}{nw}"

# game/scripts/Locations/Fox Village/elders_house.rpy:2158
translate chinese_simp forest_quest_thirty_8a75b116:

    # player "I guess that's the end of the phone call..."
    player "看来电话就到这里了……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2159
translate chinese_simp forest_quest_thirty_c66b4dd1:

    # player "I should visit her house in the afternoon."
    player "我下午去她家一趟。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2173
translate chinese_simp elders_quest_one_b2195cfe:

    # player "[helen]?"
    player "[helen]？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2174
translate chinese_simp elders_quest_one_93c7fba4:

    # helen "Yes, come in."
    helen "嗯，进来吧。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2178
translate chinese_simp elders_quest_one_0d6514d1:

    # helen "Give me a minute."
    helen "等我一下。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2179
translate chinese_simp elders_quest_one_18e3d202:

    # player "Even at home, you're still buried in work."
    player "在家也还是埋头工作。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2182
translate chinese_simp elders_quest_one_8d6cfa38:

    # helen "I honestly didn't know who else to ask about this."
    helen "老实说，我不知道还能找谁商量这件事。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2183
translate chinese_simp elders_quest_one_e5636cb8:

    # helen "I know you did a few things for her when she wanted to become an elder..."
    helen "我知道她在争取长老位置的时候，你帮她做了一些事……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2184
translate chinese_simp elders_quest_one_d0d79b05:

    # player "Yeah. What happened?"
    player "嗯。发生什么事了？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2187
translate chinese_simp elders_quest_one_0c135841:

    # helen "Yesterday she told us that she's thinking about quitting, and will probably do so in the next few weeks."
    helen "昨天她告诉我们她在考虑辞去长老职位，很可能接下来几周就会这么做。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2188
translate chinese_simp elders_quest_one_eaba0a47:

    # player "Oh."
    player "哦。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2191
translate chinese_simp elders_quest_one_c246a0cc:

    # helen "It took a lot of restraint not to hit her right there."
    helen "我忍了半天才没当场揍她。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2194
translate chinese_simp elders_quest_one_98a78c61:

    # helen "We went through a lot of trouble getting [silas] removed as quickly as we did."
    helen "为了让[silas]这么快退下来，我们费了很大劲。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2195
translate chinese_simp elders_quest_one_63280921:

    # helen "If she quits now, we'd be forced into another selection almost immediately."
    helen "要是她现在辞了，我们几乎马上就得再选一次。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2196
translate chinese_simp elders_quest_one_9d0c39c1:

    # player "I'll talk to her. Even get [lisa] involved if needed."
    player "我去跟她谈谈。实在不行，我让[lisa]也出面。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2199
translate chinese_simp elders_quest_one_1530f8ad:

    # helen "I appreciate that..."
    helen "谢谢……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2202
translate chinese_simp elders_quest_one_0c7bcc20:

    # helen "That woman makes me so mad sometimes..."
    helen "那个女人有时候真把我气得够呛……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2203
translate chinese_simp elders_quest_one_493866a3:

    # player "Want me to stay over, and help you work off that frustration~?"
    player "要我留下来帮你消消气吗~？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2206
translate chinese_simp elders_quest_one_abf79346:

    # helen "I do. But I got a lot of work to do before sleep."
    helen "我是想。但睡前我还有好多工作要做。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2207
translate chinese_simp elders_quest_one_5c2c9715:

    # player "Maybe next time then."
    player "那下次吧。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2210
translate chinese_simp elders_quest_one_981f8206:

    # helen "Considering how she is, there's definitely going to be a next time."
    helen "以她的性子，肯定还有下次。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2211
translate chinese_simp elders_quest_one_6c66edb1:

    # player "Exactly~"
    player "没错~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2214
translate chinese_simp elders_quest_one_b0952972:

    # helen "I really don't know what you can do to change her mind, but I hope you succeed."
    helen "我真不知道你能做什么让她改变主意，但我希望你能成功。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2215
translate chinese_simp elders_quest_one_a594091e:

    # player "I'll do my best, and as I mentioned, I'll involve [lisa] if needed. Thanks for letting me know."
    player "我会尽力的。之前说了，有需要我会找[lisa]。谢谢告诉我这些。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2225
translate chinese_simp elders_quest_two_12767219:

    # freya "Hey [player]~"
    freya "嘿[player]~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2226
translate chinese_simp elders_quest_two_8900e919:

    # freya "You seem like you're in a bad mood~"
    freya "你看起来心情不太好~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2227
translate chinese_simp elders_quest_two_5ce90c73:

    # freya "Want me to strip and wait for you in the bed like last time~?"
    freya "要不要我跟上次一样脱光在床上等你~？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2228
translate chinese_simp elders_quest_two_b94c8704:

    # player "No. You know exactly why I'm mad..."
    player "不用。你很清楚我为什么生气……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2231
translate chinese_simp elders_quest_two_bcfb934b:

    # freya "Ah."
    freya "啊。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2232
translate chinese_simp elders_quest_two_2aa984a7:

    # freya "So [helen] and [abigail] already told you."
    freya "所以[helen]和[abigail]已经跟你说了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2233
translate chinese_simp elders_quest_two_0c081e71:

    # player "Yes."
    player "对。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2237
translate chinese_simp elders_quest_two_8e97351e:

    # player "You have some explaining to do."
    player "你得解释清楚。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2238
translate chinese_simp elders_quest_two_c3a26357:

    # player "Why are you doing this?"
    player "你为什么要这样？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2241
translate chinese_simp elders_quest_two_646694e9:

    # freya "I don't know..."
    freya "我不知道……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2242
translate chinese_simp elders_quest_two_bd8a52b8:

    # freya "I'm just bored... It's all so slow, nothing gets done in there."
    freya "我就是无聊……太慢了，什么事都办不成。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2245
translate chinese_simp elders_quest_two_60b40b27:

    # freya "Just meetings and meetings, and going in circles about everything."
    freya "没完没了的会，什么事都绕来绕去。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2246
translate chinese_simp elders_quest_two_f26aa82b:

    # player "So?"
    player "那又怎样？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2249
translate chinese_simp elders_quest_two_450fc32a:

    # freya "It's boring and I don't like it."
    freya "很无聊，我不喜欢。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2250
translate chinese_simp elders_quest_two_d11c4604:

    # player "Then change it."
    player "那就改变它。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2251
translate chinese_simp elders_quest_two_57313ed6:

    # player "You're in the best position to do exactly that."
    player "你现在的处境最适合做这件事。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2254
translate chinese_simp elders_quest_two_61f33273:

    # freya "That's true..."
    freya "那倒是……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2255
translate chinese_simp elders_quest_two_51215a6b:

    # freya "But [helen]'s really not making it easy..."
    freya "但[helen]真的不肯让步……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2256
translate chinese_simp elders_quest_two_3c3f53e9:

    # freya "She's so uptight. And way too traditional."
    freya "她太刻板了。而且太守旧。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2257
translate chinese_simp elders_quest_two_45d56346:

    # player "Yeah. I picked up on that."
    player "嗯。我看出来了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2260
translate chinese_simp elders_quest_two_5ddfffdb:

    # freya "Does she even listen to her daughter?"
    freya "她连自己女儿的话都不听吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2261
translate chinese_simp elders_quest_two_e0f1cb17:

    # freya "[layla] might be able to push her-"
    freya "[layla]也许能推动她-"

# game/scripts/Locations/Fox Village/elders_house.rpy:2262
translate chinese_simp elders_quest_two_29113672:

    # player "No."
    player "不行。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2263
translate chinese_simp elders_quest_two_d69d14f9:

    # player "I'm not getting involved like that."
    player "我不会那样做。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2267
translate chinese_simp elders_quest_two_83a3b352:

    # freya "Okay that's fair..."
    freya "好吧，有道理……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2268
translate chinese_simp elders_quest_two_662804a9:

    # player "You surprise me with how lazy you are sometimes..."
    player "你有时候的懒散真让我惊讶……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2269
translate chinese_simp elders_quest_two_fb62ef7c:

    # player "Were you not an adventurer?"
    player "你不是冒险家吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2270
translate chinese_simp elders_quest_two_d269add0:

    # player "Doesn't that involve constant moving and working."
    player "那不是需要不停奔波、不停做事吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2273
translate chinese_simp elders_quest_two_d2e15f98:

    # freya "And you think I want to live like that again?"
    freya "你觉得我想再过那种生活？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2274
translate chinese_simp elders_quest_two_e598ab48:

    # freya "I burned myself out."
    freya "我已经把自己榨干了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2275
translate chinese_simp elders_quest_two_bb593c21:

    # player "Get over it, and do it for [lisa] then."
    player "振作起来，就当是为了[lisa]。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2276
translate chinese_simp elders_quest_two_daa0010c:

    # player "Or any other fox that might get banished for the same reason."
    player "或者为了任何其他可能因为同样原因被流放的狐狸。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2279
translate chinese_simp elders_quest_two_99faef79:

    # freya "Bringing [lisa] into it, hmm?"
    freya "把[lisa]搬出来，嗯？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2280
translate chinese_simp elders_quest_two_70e68a05:

    # player "We talked about all the reasons before..."
    player "我们之前谈过所有理由……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2281
translate chinese_simp elders_quest_two_1efef1a8:

    # player "[lisa] was one of the main ones."
    player "[lisa]是主要动机之一。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2284
translate chinese_simp elders_quest_two_d42511ae:

    # freya "Okay, fine."
    freya "好吧，行。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2285
translate chinese_simp elders_quest_two_54703767:

    # freya "I'll withdraw my resignation tomorrow."
    freya "我明天撤回辞呈。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2286
translate chinese_simp elders_quest_two_e342d590:

    # player "You'll need to give them a reason for the sudden attitude change."
    player "你得给她们一个态度突然转变的理由。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2287
translate chinese_simp elders_quest_two_aad1fe14:

    # player "And you can't say it was all me."
    player "而且不能说全是因为我。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2290
translate chinese_simp elders_quest_two_ef04dda2:

    # freya "Hmm... I'll just say you had [lisa] convince me."
    freya "嗯……我就说你让[lisa]来说服我的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2291
translate chinese_simp elders_quest_two_47d3db26:

    # freya "I'll say she reminded me what I wanted to do, and why."
    freya "我会说，她让我想起了我想做的事，以及为什么要做。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2292
translate chinese_simp elders_quest_two_47eb3af5:

    # player "I guess that works."
    player "那也行。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2293
translate chinese_simp elders_quest_two_ad3c1548:

    # player "Give her a call and explain the situation, just in case."
    player "给她打个电话说明一下，免得出纰漏。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2296
translate chinese_simp elders_quest_two_dce14ae7:

    # freya "I'll do that."
    freya "我会的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2299
translate chinese_simp elders_quest_two_8e5278c8:

    # freya "Since you're here..."
    freya "既然你来了……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2300
translate chinese_simp elders_quest_two_67351865:

    # freya "Wanna stay over and spend the night~?"
    freya "要不要留下来过夜~？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2301
translate chinese_simp elders_quest_two_7e7f0684:

    # player "I would've done it if you weren't trying to cause trouble again."
    player "要不是你又惹麻烦，我本来会的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2304
translate chinese_simp elders_quest_two_5a8df257:

    # freya "Aww..."
    freya "哎……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2316
translate chinese_simp elders_quest_three_b2195cfe:

    # player "[helen]?"
    player "[helen]？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2317
translate chinese_simp elders_quest_three_93c7fba4:

    # helen "Yes, come in."
    helen "嗯，进来。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2321
translate chinese_simp elders_quest_three_ee2e6d09:

    # helen "She changed her mind, and isn't quitting anymore."
    helen "她改变主意了，不辞了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2322
translate chinese_simp elders_quest_three_1304caac:

    # player "That's good, right?"
    player "那不是好事吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2325
translate chinese_simp elders_quest_three_698e9c09:

    # helen "Yes."
    helen "是。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2326
translate chinese_simp elders_quest_three_72172d78:

    # helen "How did you convince her so fast?"
    helen "你怎么这么快就说动她了？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2327
translate chinese_simp elders_quest_three_72b3ff2d:

    # player "I got [lisa] involved."
    player "我让[lisa]出面了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2330
translate chinese_simp elders_quest_three_0a36c50b:

    # helen "That makes sense."
    helen "难怪。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2331
translate chinese_simp elders_quest_three_68e9e4ff:

    # player "You don't seem very happy about it though~"
    player "不过你看起来不太高兴啊~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2334
translate chinese_simp elders_quest_three_00282563:

    # helen "I'm a little happy about her not messing things up, but that's nothing compared to how mad I am with her attitude."
    helen "她没把事情搞砸，我确实有点高兴，但那点高兴完全比不上我对她态度的不满。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2335
translate chinese_simp elders_quest_three_23c79d1b:

    # player "What'd she say this time?"
    player "她这次又说什么了？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2339
translate chinese_simp elders_quest_three_8ef52c60:

    # helen "She proposed a few serious changes."
    helen "她提了几项重大改革。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2340
translate chinese_simp elders_quest_three_50db95fc:

    # helen "We haven't even sorted the trial thing out."
    helen "试炼的事都还没理清楚。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2341
translate chinese_simp elders_quest_three_009d3a6a:

    # player "She did mention that it bothers her how slow everything is."
    player "她确实说过，事情太慢让她很烦躁。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2344
translate chinese_simp elders_quest_three_fab97912:

    # helen "That's just how things work."
    helen "流程就是这样。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2345
translate chinese_simp elders_quest_three_4c0324c3:

    # helen "It's not like me or [abigail] want it that way..."
    helen "又不是我或者[abigail]想让它这么慢……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2346
translate chinese_simp elders_quest_three_aa9b7117:

    # player "Then can't you just change that?"
    player "那你们不能改吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2347
translate chinese_simp elders_quest_three_ade4a7e6:

    # player "Since all three of you agree on it."
    player "既然你们三个都对这个慢节奏不满。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2350
translate chinese_simp elders_quest_three_5c68761a:

    # helen "I don't want to bark orders at the others like that..."
    helen "我不想那样对下面的人发号施令……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2351
translate chinese_simp elders_quest_three_78fc9ded:

    # player "But that's their job, right? To do what you three say."
    player "但他们的工作不就是执行你们三位的决定吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2354
translate chinese_simp elders_quest_three_06cf56cb:

    # helen "Yeah..."
    helen "嗯……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2355
translate chinese_simp elders_quest_three_be527a0f:

    # player "It's kinda funny listening to you sometimes."
    player "有时候听你说话还挺有意思的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2358
translate chinese_simp elders_quest_three_3ae2fa95:

    # helen "What do you mean?"
    helen "什么意思？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2359
translate chinese_simp elders_quest_three_c9745b20:

    # player "You hate humans and other races indiscriminately."
    player "你不分青红皂白地憎恨人类和其他种族。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2360
translate chinese_simp elders_quest_three_36333365:

    # player "You're fine with banishing weak foxes."
    player "你能接受流放弱小的狐狸。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2361
translate chinese_simp elders_quest_three_c2bab062:

    # player "But when it comes to the villagers, you care about what they think too much."
    player "但一涉及到村民，你又太在意他们的看法。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2364
translate chinese_simp elders_quest_three_cf21649d:

    # helen "..."
    helen "……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2365
translate chinese_simp elders_quest_three_4d153222:

    # player "Maybe that wasn't fair to say, you've changed a lot since I first met you."
    player "也许这么说不太公平，你跟我刚认识你的时候已经变了很多。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2366
translate chinese_simp elders_quest_three_6eb7568d:

    # player "And you're clearly trying."
    player "而且你显然在努力。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2369
translate chinese_simp elders_quest_three_a3466195:

    # helen "So you're saying I should care less about the villagers?"
    helen "所以你是说，我应该少关心村民？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2370
translate chinese_simp elders_quest_three_a2316854:

    # player "Not like that. You just shouldn't worry about hurting their feelings as much."
    player "不是那个意思。只是你不用那么担心会伤到他们的感受。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2373
translate chinese_simp elders_quest_three_cf21649d_1:

    # helen "..."
    helen "……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2374
translate chinese_simp elders_quest_three_44684a61:

    # player "Try it out with something simple."
    player "先从小事开始试试。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2375
translate chinese_simp elders_quest_three_d4c55b1e:

    # player "I bet they trust you enough to just do what you say."
    player "我敢说他们足够信任你，你说什么他们就会照做。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2378
translate chinese_simp elders_quest_three_460c1d95:

    # helen "Alright..."
    helen "好吧……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2379
translate chinese_simp elders_quest_three_260e6849:

    # player "By the way, I'm not saying to change everything that [freya] wants to change."
    player "顺便说一句，我不是说[freya]想改什么你就改什么。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2380
translate chinese_simp elders_quest_three_e9f1804c:

    # player "I can imagine her having some crazy ideas."
    player "我能想象她会有一些疯狂的想法。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2383
translate chinese_simp elders_quest_three_31de4fcd:

    # helen "Don't worry. I'll always fight her on those. I'll just make the whole process faster from now on."
    helen "放心。那些我还是会反对的。只是以后整体流程我会加快一些。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2384
translate chinese_simp elders_quest_three_c12bea5c:

    # player "Perfect~"
    player "完美~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2390
translate chinese_simp elders_quest_three_cf21649d_2:

    # helen "..."
    helen "……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2391
translate chinese_simp elders_quest_three_e68d421e:

    # player "This is new~"
    player "这倒是新鲜~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2394
translate chinese_simp elders_quest_three_6685fd8c:

    # helen "I don't want to talk about work anymore."
    helen "我不想再谈工作了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2395
translate chinese_simp elders_quest_three_f9d406e1:

    # helen "It's just making me more and more stressed."
    helen "只会让我越来越焦虑。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2396
translate chinese_simp elders_quest_three_397bc84f:

    # helen "You're here to help with that, right?"
    helen "你是来帮我的，对吧？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2397
translate chinese_simp elders_quest_three_91b5a262:

    # player "I am. How would you like to do it today~?"
    player "当然。今天你想怎么做~？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2400
translate chinese_simp elders_quest_three_e81123f7:

    # helen "Missionary."
    helen "传教士式。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2401
translate chinese_simp elders_quest_three_bf2eae31:

    # player "Oh~"
    player "哦~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2402
translate chinese_simp elders_quest_three_854dae2b:

    # player "I love that you're so direct~"
    player "我就喜欢你这么直接~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2405
translate chinese_simp elders_quest_three_73ce6443:

    # helen "I just..."
    helen "我只是……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2406
translate chinese_simp elders_quest_three_6eac1913:

    # helen "I need more than being held tonight."
    helen "今晚我不只是想要拥抱。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2407
translate chinese_simp elders_quest_three_36698d19:

    # player "I get that."
    player "我懂。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2414
translate chinese_simp elders_quest_three_71713cac:

    # helen "Thank you for today..."
    helen "今天谢谢你……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2415
translate chinese_simp elders_quest_three_a0f7be06:

    # player "Of course... I like seeing you this happy~"
    player "不用谢……我喜欢看你这么开心~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2418
translate chinese_simp elders_quest_three_4b81f830:

    # helen "...mhm~"
    helen "……嗯~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2419
translate chinese_simp elders_quest_three_cad6aaa1:

    # player "What now~? Back to work?"
    player "接下来呢~？回去工作？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2422
translate chinese_simp elders_quest_three_3a78289c:

    # helen "No..."
    helen "不……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2425
translate chinese_simp elders_quest_three_ad346bef:

    # helen "I'd like you to stay over."
    helen "我想让你留下来。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2426
translate chinese_simp elders_quest_three_eedcf6e5:

    # player "I'd like that too~"
    player "我也愿意~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2429
translate chinese_simp elders_quest_three_57f209b3:

    # helen "I'll get the covers, and turn off the lights."
    helen "我去拿被子，关灯。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2430
translate chinese_simp elders_quest_three_635294c9:

    # helen "And you take your shirt off in the meantime."
    helen "你趁这会儿把上衣脱了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2431
translate chinese_simp elders_quest_three_a1e90803:

    # player "If you say so~"
    player "听你的~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2434
translate chinese_simp elders_quest_three_29a8662f:

    # helen "It's still not dark outside, are you tired enough to sleep?"
    helen "外面天还没黑，你累得能睡着吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2435
translate chinese_simp elders_quest_three_d0d8fd93:

    # player "I {i}am{/i} after the workout we just had~"
    player "刚运动完{i}确实{/i}累~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2436
translate chinese_simp elders_quest_three_8307aa31:

    # helen "...Okay. Night, [player]."
    helen "……好吧。晚安，[player]。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2437
translate chinese_simp elders_quest_three_43c70318:

    # player "Night, [helen]~"
    player "晚安，[helen]~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2451
translate chinese_simp elders_quest_four_78c0e259:

    # abigail "About what?"
    abigail "关于什么？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2452
translate chinese_simp elders_quest_four_0d08ec01:

    # player "The whole thing between [freya] and [helen]."
    player "[freya]和[helen]之间的那些事。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2455
translate chinese_simp elders_quest_four_2bc0f2c3:

    # abigail "Ohhh. [freya] almost quitting?"
    abigail "哦哦。你说[freya]差点辞职的事？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2456
translate chinese_simp elders_quest_four_4bc80cc5:

    # abigail "That was actually kind of funny~"
    abigail "其实还蛮好笑的~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2457
translate chinese_simp elders_quest_four_5c96901a:

    # player "Funny?"
    player "好笑？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2458
translate chinese_simp elders_quest_four_cc5fac11:

    # player "You weren't even a little worried?"
    player "你就一点都不担心？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2461
translate chinese_simp elders_quest_four_5811c92e:

    # abigail "Not really."
    abigail "不怎么担心。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2462
translate chinese_simp elders_quest_four_83314695:

    # abigail "They argue all the time. It's like foreplay at this point."
    abigail "她俩总在吵。现在就跟前戏似的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2463
translate chinese_simp elders_quest_four_80805ce3:

    # player "Really?"
    player "真的？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2464
translate chinese_simp elders_quest_four_5f26bd0b:

    # abigail "Watching them snap at each other keeps work interesting."
    abigail "看着她们互相呛声，工作才有意思。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2467
translate chinese_simp elders_quest_four_045c899c:

    # abigail "It was painfully boring when [silas] worked here."
    abigail "[silas]还在的时候，简直无聊得要命。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2470
translate chinese_simp elders_quest_four_6c740772:

    # abigail "[freya] shook that up with her ideas and personality."
    abigail "[freya]用她的想法和个性把死水搅活了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2471
translate chinese_simp elders_quest_four_c6198b7e:

    # player "So [silas] was more like [helen]?"
    player "所以[silas]更像[helen]？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2474
translate chinese_simp elders_quest_four_45f608ba:

    # abigail "In terms of clinging to old traditions? Very much."
    abigail "在固守旧传统这方面？简直一模一样。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2475
translate chinese_simp elders_quest_four_74a666a8:

    # abigail "Everything had to be done exactly as it always had been."
    abigail "什么事都必须按老规矩办。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2476
translate chinese_simp elders_quest_four_8402d79c:

    # player "At least one of you is having fun~"
    player "至少你们中有一个玩得挺开心~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2479
translate chinese_simp elders_quest_four_b8ac79bf:

    # abigail "Oh, I absolutely am~"
    abigail "哦，我绝对是玩得最开心的那个~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2480
translate chinese_simp elders_quest_four_f00b402a:

    # abigail "It's nice seeing someone challenge everything~"
    abigail "看有人挑战一切的感觉真好~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2483
translate chinese_simp elders_quest_four_96c659ea:

    # abigail "Honestly though..."
    abigail "不过说实话……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2484
translate chinese_simp elders_quest_four_3f43e78b:

    # abigail "I think they actually like each other."
    abigail "我觉得她们其实挺喜欢对方的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2485
translate chinese_simp elders_quest_four_80805ce3_1:

    # player "Really?"
    player "真的？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2488
translate chinese_simp elders_quest_four_f728bbed:

    # abigail "In that enemies-to-friends kind of way."
    abigail "就是那种不打不相识的感觉。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2489
translate chinese_simp elders_quest_four_b216debb:

    # abigail "They'd never admit it-"
    abigail "她们永远不会承认-"

# game/scripts/Locations/Fox Village/elders_house.rpy:2490
translate chinese_simp elders_quest_four_4f00f124:

    # abigail "But I bet they'd miss each other if one of them left."
    abigail "但我敢打赌，要是其中一个人走了，另一个肯定会想念她的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2491
translate chinese_simp elders_quest_four_c07c2aa9:

    # abigail "That's probably why [helen] reacted so badly when [freya] talked about quitting."
    abigail "这大概就是为什么[freya]提辞职的时候，[helen]反应那么强烈。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2492
translate chinese_simp elders_quest_four_073671c1:

    # player "I thought she was just worried about how it would look to the villagers."
    player "我还以为她只是担心村民怎么看。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2495
translate chinese_simp elders_quest_four_849dfdae:

    # abigail "That's a part of it, sure."
    abigail "那也是一部分原因，没错。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2496
translate chinese_simp elders_quest_four_d97eb4c0:

    # abigail "But there's more to it than that~"
    abigail "但不止如此~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2497
translate chinese_simp elders_quest_four_41ad7b11:

    # player "Good to know I guess."
    player "那倒也好。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2500
translate chinese_simp elders_quest_four_24d7a82e:

    # abigail "You should join one of our meetings sometime."
    abigail "你该找个时间来旁听我们的会议。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2501
translate chinese_simp elders_quest_four_020f85b2:

    # player "Would they actually be okay with that?"
    player "她们真的会同意？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2504
translate chinese_simp elders_quest_four_fb48e4a5:

    # abigail "Yeah. You've done it before, I don't think either of them mind you listening in."
    abigail "嗯。你不是旁听过吗，我觉得她们都不介意。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2505
translate chinese_simp elders_quest_four_0863f201:

    # player "Alright. I can do that."
    player "好。那行。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2508
translate chinese_simp elders_quest_four_80283cb8:

    # abigail "Just don't try to interfere, I don't think we're ready for that yet."
    abigail "别试着插手就行，我觉得我们还没到那一步。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2509
translate chinese_simp elders_quest_four_43a0c580:

    # player "I have no interest in that."
    player "我没兴趣。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2510
translate chinese_simp elders_quest_four_f47fa158:

    # player "I'm not a fox, I don't want any say in how your village runs things."
    player "我不是狐狸，你们村子怎么运作我没发言权。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2513
translate chinese_simp elders_quest_four_abb72ce2:

    # abigail "Then I have no problem with you joining~"
    abigail "那你来旁听我没意见~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2514
translate chinese_simp elders_quest_four_30646e5a:

    # player "I'll stop by sometime, hope the other two feel the same as you~"
    player "我会找时间过来的，希望另外两位也像你这么想~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2524
translate chinese_simp elders_quest_five_23510e9b:

    # helen "Not a word from you, okay?"
    helen "你别说话，行吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2525
translate chinese_simp elders_quest_five_be0881b8:

    # player "You got it, I'm just here to listen."
    player "没问题，我只是来听的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2528
translate chinese_simp elders_quest_five_268e2d0a:

    # freya "You're so damn uptight."
    freya "你真是有够死板的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2529
translate chinese_simp elders_quest_five_645af1b3:

    # helen "And you're not nearly uptight enough."
    helen "而你一点都不严肃。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2532
translate chinese_simp elders_quest_five_a5dfe655:

    # helen "He may be tolerated by a lot of people, but he's still an outsider."
    helen "他也许被很多人容忍，但他终究是个外人。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2533
translate chinese_simp elders_quest_five_4293530a:

    # helen "I don't see why either of you is so comfortable letting him sit in on this again."
    helen "我不明白你们俩为什么这么放心让他再来旁听。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2536
translate chinese_simp elders_quest_five_cc1c116b:

    # abigail "You said it yourself, he's been here before."
    abigail "你自己也说了，他来过了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2537
translate chinese_simp elders_quest_five_38d449a9:

    # freya "And the world didn't end."
    freya "而且天也没塌下来。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2540
translate chinese_simp elders_quest_five_9da834d8:

    # helen "Fine. Whatever."
    helen "行吧。随便。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2543
translate chinese_simp elders_quest_five_32ed6783:

    # abigail "Should we start now?"
    abigail "开始吧？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2544
translate chinese_simp elders_quest_five_80b7925f:

    # freya "Please. Finally."
    freya "赶紧吧，总算开始了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2547
translate chinese_simp elders_quest_five_a3915704:

    # abigail "Let's talk about the trial again."
    abigail "再谈谈试炼的事。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2548
translate chinese_simp elders_quest_five_3c4acb84:

    # freya "Great..! Let's get rid of it."
    freya "太好了！取消它吧。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2549
translate chinese_simp elders_quest_five_0d4e2596:

    # helen "Over my dead body."
    helen "除非我死。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2552
translate chinese_simp elders_quest_five_55828c40:

    # freya "Might be soon then, you're getting up there in age~"
    freya "那也快了，毕竟你年纪也不小了~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2553
translate chinese_simp elders_quest_five_2a49b605:

    # helen "Huh? That doesn't even-!"
    helen "哈？这根本-！"

# game/scripts/Locations/Fox Village/elders_house.rpy:2556
translate chinese_simp elders_quest_five_ad31f497:

    # helen "I'm two years older than you! Two!"
    helen "我就比你大两岁！两岁！"

# game/scripts/Locations/Fox Village/elders_house.rpy:2557
translate chinese_simp elders_quest_five_d47c3694:

    # abigail "Okay, okay, I can already tell where this is going."
    abigail "好了好了，我都能猜到接下来会发生什么了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2560
translate chinese_simp elders_quest_five_0b48af7e:

    # abigail "How long have we been having this exact argument?"
    abigail "这场一模一样的争论我们持续了多久了？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2561
translate chinese_simp elders_quest_five_3670d5a3:

    # freya "Since the day I became an elder."
    freya "从我当上长老那天起。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2564
translate chinese_simp elders_quest_five_2ca6772b:

    # freya "And that's exactly why I wanted to quit."
    freya "这正好就是我想辞职的原因。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2565
translate chinese_simp elders_quest_five_b5f20319:

    # freya "It's meeting after meeting, the same topics, the same circles, and of course nothing ever changes."
    freya "不停地开会，同样的话题，同样的绕圈子，结果什么都没变。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2566
translate chinese_simp elders_quest_five_a0580273:

    # helen "I do understand that."
    helen "这点我明白。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2569
translate chinese_simp elders_quest_five_660689a2:

    # helen "The process is slow. I don't like it either."
    helen "流程太慢。我也不喜欢。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2570
translate chinese_simp elders_quest_five_b8c44b8a:

    # freya "That's great to hear! Let's change it then."
    freya "那太好了！我们改改吧。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2573
translate chinese_simp elders_quest_five_6015437a:

    # abigail "First we decide what we actually want to change."
    abigail "首先我们得确定到底想改什么。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2574
translate chinese_simp elders_quest_five_51eff3d4:

    # abigail "Then we figure out how to make the process faster."
    abigail "然后再想办法怎么加快流程。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2577
translate chinese_simp elders_quest_five_323ef821:

    # freya "Would be a lot easier if [helen] wasn't so stubborn."
    freya "要是[helen]不那么固执，事情就好办多了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2578
translate chinese_simp elders_quest_five_de66f092:

    # helen "I'm protecting the village and its future."
    helen "我是在保护村子和它的未来。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2581
translate chinese_simp elders_quest_five_32f31db5:

    # freya "From what, exactly? Foxes that aren't physically strong?"
    freya "到底保护什么？保护那些体力不够强的狐狸？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2582
translate chinese_simp elders_quest_five_fb534160:

    # freya "[lisa] is a great example of what a failure this trial system has been."
    freya "[lisa]就是个很好的例子，证明了这套试炼制度有多失败。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2583
translate chinese_simp elders_quest_five_dc0b8e0d:

    # freya "Think about everyone we kicked out, the ones still wandering outside lost, without a home."
    freya "想想那些被我们赶出去的人，那些还在外面漂泊、无家可归的人。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2586
translate chinese_simp elders_quest_five_cf21649d:

    # helen "..."
    helen "……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2589
translate chinese_simp elders_quest_five_519d3afa:

    # helen "This is the way we've done things long before either of us was born."
    helen "在我们出生之前很久，就是这样做的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2590
translate chinese_simp elders_quest_five_af2a3763:

    # helen "And whatever you think of them, the village is still standing strong."
    helen "不管你怎么想，村子至今依然稳固。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2593
translate chinese_simp elders_quest_five_1c36f61c:

    # abigail "It's impossible to argue those two things are directly connected."
    abigail "不能说这两件事有直接因果关系。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2596
translate chinese_simp elders_quest_five_caffb615:

    # freya "Exactly. You act like the village is under siege every day, but we barely face any real danger."
    freya "没错。你表现得好像村子天天被围困似的，但其实我们几乎没遇到什么真正的危险。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2599
translate chinese_simp elders_quest_five_bec3ae91:

    # abigail "Not on a grand scale, no, but the guards do deal with attackers every day."
    abigail "大规模确实没有，但守卫确实每天都得应付袭击者。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2600
translate chinese_simp elders_quest_five_829a318b:

    # abigail "So be specific, [freya]. What exactly do you want to change first?"
    abigail "所以具体点，[freya]。你最先想改什么？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2603
translate chinese_simp elders_quest_five_85a1e699:

    # freya "I'd love to know how many of those 'attackers' are just foxes trying to come home."
    freya "我很想知道，那些‘袭击者’里有多少只是想要回家的狐狸。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2604
translate chinese_simp elders_quest_five_4d0155b1:

    # freya "Especially after [helen] pushed to remove the option to retake the trial."
    freya "尤其是在[helen]力主取消重考资格之后。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2607
translate chinese_simp elders_quest_five_cf21649d_1:

    # helen "..."
    helen "……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2608
translate chinese_simp elders_quest_five_37de4835:

    # freya "So that's my first change. We stop turning our own people away at the gate."
    freya "这就是我的第一项改变。我们不再在村口拒绝自己人。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2609
translate chinese_simp elders_quest_five_15661b1b:

    # abigail "I think that's fair."
    abigail "我觉得这很合理。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2612
translate chinese_simp elders_quest_five_210ce9ec:

    # freya "We welcome back any fox that was born here. Without a trial to prove themselves."
    freya "我们欢迎任何在这里出生的狐狸回来。不需要通过试炼来证明自己。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2613
translate chinese_simp elders_quest_five_b2999a12:

    # helen "...Fine."
    helen "……行。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2616
translate chinese_simp elders_quest_five_c120242a:

    # freya "[player] can help spread that on the outside."
    freya "[player]可以在外面帮忙传播这个消息。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2617
translate chinese_simp elders_quest_five_41e5ff31:

    # freya "Not the location, obviously. Just the message. If they were born here, they're welcome back."
    freya "当然，不用说地点在哪。只需要传话。如果他们在这里出生，这里欢迎他们回来。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2618
translate chinese_simp elders_quest_five_fc4d5c67:

    # player "Sure, I can do that. But I don't really know any other foxes."
    player "行，我可以帮忙。但我确实不认识其他狐狸。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2621
translate chinese_simp elders_quest_five_4eeed9eb:

    # abigail "There probably aren't many around town."
    abigail "镇上估计也没多少。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2622
translate chinese_simp elders_quest_five_24b6abc1:

    # abigail "Maybe he can help [lisa] or [layla] look for them."
    abigail "或许他可以帮[lisa]或者[layla]去找找。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2626
translate chinese_simp elders_quest_five_d7adc3cd:

    # player "I'll ask them about it."
    player "我去问问她们。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2629
translate chinese_simp elders_quest_five_fa59eb92:

    # freya "Perfect~"
    freya "完美~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2632
translate chinese_simp elders_quest_five_c56fc7e9:

    # freya "The next thing that needs changing is the trial itself."
    freya "下一个需要改的是试炼本身。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2633
translate chinese_simp elders_quest_five_34035f9e:

    # freya "And I know you're never going to let me remove it completely, so I'm not wasting my breath on that anymore."
    freya "而且我知道你绝不会让我完全废除它，所以我也不在这上面白费口舌了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2636
translate chinese_simp elders_quest_five_9b0041d0:

    # abigail "You want to implement your three tests idea."
    abigail "你想实施三项测试的方案。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2637
translate chinese_simp elders_quest_five_fe64787e:

    # freya "Yes..! Instead of just strength, we also test for intelligence and resourcefulness."
    freya "对！除了力量，我们还要测试智力和应变能力。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2640
translate chinese_simp elders_quest_five_b92a5bb5:

    # helen "I still can't agree to that as it stands."
    helen "就目前而言，我还是不能同意。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2641
translate chinese_simp elders_quest_five_ace3d16f:

    # helen "Intelligence and resourcefulness are too vague and hard to judge with a test."
    helen "智力和应变能力太模糊了，很难用测试来评判。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2642
translate chinese_simp elders_quest_five_f0ec343a:

    # abigail "That's true."
    abigail "这倒是。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2645
translate chinese_simp elders_quest_five_1a860f93:

    # helen "Do some actual work and come up with a plan."
    helen "做点实事，拿出个方案来。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2646
translate chinese_simp elders_quest_five_7b58d620:

    # helen "Write down exactly how you want the tests to function."
    helen "把你想怎么实施这些测试写清楚。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2647
translate chinese_simp elders_quest_five_4b41797d:

    # helen "Be as detailed as possible."
    helen "越详细越好。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2650
translate chinese_simp elders_quest_five_bd82b840:

    # freya "...Ugh."
    freya "……啧。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2651
translate chinese_simp elders_quest_five_2705bdf6:

    # abigail "I think that's a fair request."
    abigail "我觉得这要求很合理。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2654
translate chinese_simp elders_quest_five_f1c0f2e7:

    # freya "Yeah... It is."
    freya "嗯……确实。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2655
translate chinese_simp elders_quest_five_ff77fc84:

    # freya "I'll get it done as soon as possible."
    freya "我会尽快弄出来。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2658
translate chinese_simp elders_quest_five_2974a0cf:

    # freya "But in the meantime we can put the first part of the plan in motion."
    freya "不过在此期间，我们可以先把计划的第一部分落实。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2661
translate chinese_simp elders_quest_five_914f623a:

    # helen "I'm fine with that. I'll brief the guards today."
    helen "我没意见。我今天就去跟守卫们说明。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2662
translate chinese_simp elders_quest_five_98a9e576:

    # helen "Any fox born here is to be welcomed back to their family."
    helen "任何在这里出生的狐狸，都应欢迎他们回家。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2665
translate chinese_simp elders_quest_five_fa59eb92_1:

    # freya "Perfect~"
    freya "完美~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2666
translate chinese_simp elders_quest_five_002c2800:

    # abigail "Amazing~"
    abigail "太棒了~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2669
translate chinese_simp elders_quest_five_99d2cc11:

    # abigail "We actually accomplished something today."
    abigail "我们今天总算做成了一件事。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2670
translate chinese_simp elders_quest_five_0517afbd:

    # think "Okay, I totally get why [abigail] finds this entertaining."
    think "好吧，我完全理解为什么[abigail]觉得这有意思了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2673
translate chinese_simp elders_quest_five_cf366c59:

    # abigail "Let's stop there for today."
    abigail "今天就到这里吧。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2674
translate chinese_simp elders_quest_five_d1426ac1:

    # abigail "One issue per meeting, then we focus on acting on it quickly."
    abigail "每次会议解决一个问题，然后集中精力快速行动。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2675
translate chinese_simp elders_quest_five_16ec2fd6:

    # freya "I'm happy with that."
    freya "我没意见。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2676
translate chinese_simp elders_quest_five_454832df:

    # helen "...mhm."
    helen "……嗯。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2679
translate chinese_simp elders_quest_five_ee54efe7:

    # freya "I'm heading home to write those tests."
    freya "我回家写测试方案。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2682
translate chinese_simp elders_quest_five_0e417542:

    # helen "I still can't picture her keeping her head down and working."
    helen "我还是没法想象她埋头苦干的样子。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2683
translate chinese_simp elders_quest_five_716bb661:

    # abigail "It probably is a very rare sight~"
    abigail "那想必是百年一遇的奇景~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2686
translate chinese_simp elders_quest_five_f3bc8597:

    # helen "I'm leaving early too."
    helen "我也先走了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2687
translate chinese_simp elders_quest_five_e339c6a5:

    # helen "I need to prepare the orders and explanations for the guards."
    helen "我得去给守卫们准备命令和说明。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2688
translate chinese_simp elders_quest_five_a4211f6a:

    # abigail "Alright. Have fun~"
    abigail "行。忙去吧~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2691
translate chinese_simp elders_quest_five_0312845d:

    # abigail "So, what did you think~?"
    abigail "怎么样，觉得有意思吗~？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2692
translate chinese_simp elders_quest_five_d0bcec58:

    # player "It was quite entertaining to watch."
    player "看起来确实挺有意思的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2695
translate chinese_simp elders_quest_five_1529da2e:

    # abigail "You see it too, right? They secretly like each other."
    abigail "你也看出来了对吧？她们私下里喜欢对方。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2696
translate chinese_simp elders_quest_five_85ef05cc:

    # player "I'm starting to."
    player "我开始觉得是这么回事了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2699
translate chinese_simp elders_quest_five_88aa5fa7:

    # abigail "Let's give them time. I bet they'll be good friends one day."
    abigail "给她们点时间吧。我赌她们总有一天会成为好朋友。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2700
translate chinese_simp elders_quest_five_3de10258:

    # player "Would be nice to see."
    player "那倒是挺想看到的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2710
translate chinese_simp elders_quest_six_7ddc93bc:

    # helen "Hey."
    helen "嘿。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2711
translate chinese_simp elders_quest_six_2b020f58:

    # player "Hi."
    player "嗨。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2714
translate chinese_simp elders_quest_six_49855e54:

    # helen "What do you need?"
    helen "什么事？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2715
translate chinese_simp elders_quest_six_82b356b8:

    # player "Bad time~?"
    player "来得不是时候~？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2718
translate chinese_simp elders_quest_six_dc17b4b2:

    # helen "Just tired."
    helen "只是有点累。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2719
translate chinese_simp elders_quest_six_79d6fb81:

    # helen "I've been dealing with the list of banished foxes."
    helen "一直在处理被流放狐狸的名单。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2720
translate chinese_simp elders_quest_six_4f1242bb:

    # player "A list? Are you sending people to look for them?"
    player "名单？你要派人去找他们？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2723
translate chinese_simp elders_quest_six_926e5fce:

    # helen "No, but if someone shows up at the village entrance, we need to know whether they were actually born here."
    helen "不是。但如果有人出现在村口，我们得知道他们是不是确实在这里出生的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2724
translate chinese_simp elders_quest_six_051c22fc:

    # player "Oh, that makes sense, I guess not everyone still has family here."
    player "哦，有道理，毕竟不是所有人在这里还有家人。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2727
translate chinese_simp elders_quest_six_2ffcf3a2:

    # helen "Most do, but there's exceptions, yes."
    helen "大多数有，但也有例外。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2728
translate chinese_simp elders_quest_six_88688a3c:

    # helen "Most of those are my age or older."
    helen "那些例外大多跟我同龄或者更年长。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2729
translate chinese_simp elders_quest_six_2d8ed2ea:

    # player "I get it, hard to have a family here if you're thrown out at twenty."
    player "能理解，二十岁就被赶出去的话，很难在这里成家。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2732
translate chinese_simp elders_quest_six_272d9834:

    # helen "Yeah."
    helen "嗯。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2735
translate chinese_simp elders_quest_six_12170dd6:

    # helen "But there are plenty of younger ones out there too."
    helen "不过外面也有不少年轻的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2736
translate chinese_simp elders_quest_six_ddfe354d:

    # helen "We're going to have to visit their families and ask whether they've kept in contact."
    helen "我们得去拜访他们的家人，问问他们还有没有联系。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2737
translate chinese_simp elders_quest_six_4b3a81ea:

    # player "Can I help with that?"
    player "我能帮上忙吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2740
translate chinese_simp elders_quest_six_2467769a:

    # helen "...Hmm."
    helen "……嗯。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2743
translate chinese_simp elders_quest_six_50e81a33:

    # helen "I'd need a really good reason to bring you along."
    helen "我得有个非常好的理由才能带上你。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2744
translate chinese_simp elders_quest_six_03775ec8:

    # player "..."
    player "……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2745
translate chinese_simp elders_quest_six_7b1db6c8:

    # player "I could help on the outside."
    player "我可以在外面帮忙。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2746
translate chinese_simp elders_quest_six_2f8d0f8e:

    # player "If a family knows where someone is, but can't reach them, I could go look."
    player "如果有家人知道人在哪儿，但联系不上，我可以去找。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2749
translate chinese_simp elders_quest_six_ca56b12a:

    # helen "I guess that would work."
    helen "那倒也行。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2750
translate chinese_simp elders_quest_six_6230a80b:

    # helen "If they have a location and no way to contact them, you'd be useful."
    helen "如果他们有地址但没法联系，你就能派上用场。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2751
translate chinese_simp elders_quest_six_fab8dd6d:

    # player "Exactly."
    player "没错。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2754
translate chinese_simp elders_quest_six_725cd87c:

    # helen "Come to the elders' house in the morning, and I'll take you with me."
    helen "早上来长老家，我带你一起去。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2755
translate chinese_simp elders_quest_six_158dd786:

    # player "Just you and me?"
    player "就你和我？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2758
translate chinese_simp elders_quest_six_60e7deaf:

    # helen "No, [freya]'s coming too."
    helen "不，[freya]也来。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2759
translate chinese_simp elders_quest_six_2f0ea234:

    # player "What about [abigail]?"
    player "[abigail]呢？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2762
translate chinese_simp elders_quest_six_2b3a2b8c:

    # helen "She's got other things to work on."
    helen "她有别的事要忙。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2763
translate chinese_simp elders_quest_six_00b5157e:

    # player "So just us three?"
    player "就我们三个？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2764
translate chinese_simp elders_quest_six_3c817e22:

    # player "Is that a good idea?"
    player "这合适吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2767
translate chinese_simp elders_quest_six_d5df7068:

    # helen "If this is about our arguing..."
    helen "如果你是指我们吵架的事……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2770
translate chinese_simp elders_quest_six_c05a1ed9:

    # helen "We know how to behave in public."
    helen "我们知道在公共场合该怎么表现。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2771
translate chinese_simp elders_quest_six_cf3b66b6:

    # player "Are we going to be wearing those hoods?"
    player "我们要戴那种兜帽吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2774
translate chinese_simp elders_quest_six_7b9c971b:

    # helen "No. We're going on behalf of the elders, not as the elders."
    helen "不用。我们是以长老代表的名义去，不是以长老本人的身份。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2775
translate chinese_simp elders_quest_six_4f3ec921:

    # player "But you are the elders..."
    player "但你们就是长老啊……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2778
translate chinese_simp elders_quest_six_88fcc8f1:

    # helen "Yes. But the villagers don't know that."
    helen "对。但村民们不知道。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2781
translate chinese_simp elders_quest_six_7d33082a:

    # helen "We'll be going as people that work for the village."
    helen "我们会以村子工作人员的身份去。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2782
translate chinese_simp elders_quest_six_74b714a1:

    # player "Okay, I get it. I'll be careful with what I say."
    player "好，我明白了。我会注意说话分寸。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2783
translate chinese_simp elders_quest_six_b4f6204e:

    # player "...What about [freya]?"
    player "……[freya]呢？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2786
translate chinese_simp elders_quest_six_d986d3b8:

    # helen "Unlike in our meetings, she knows how to behave in public."
    helen "跟我们开会时不一样，她在公共场合知道分寸。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2787
translate chinese_simp elders_quest_six_28907701:

    # helen "So you don't need to worry about her."
    helen "所以你不用替她操心。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2790
translate chinese_simp elders_quest_six_cf9a836f:

    # helen "You know, this isn't going to be quick. We'll be out for six to eight hours."
    helen "跟你说，这不会很快。我们要在外面待六到八个小时。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2791
translate chinese_simp elders_quest_six_5be8b452:

    # helen "Going house to house, staying as long as people expect us to..."
    helen "挨家挨户地走，只要人家想留，我们就得待着……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2792
translate chinese_simp elders_quest_six_958f299e:

    # helen "And drinking whatever they put in our hands."
    helen "还得喝下他们递来的任何东西。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2795
translate chinese_simp elders_quest_six_3d8b57de:

    # helen "Can you handle that?"
    helen "你能应付得了吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2796
translate chinese_simp elders_quest_six_aa6aae2d:

    # player "I think so..."
    player "我想可以……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2799
translate chinese_simp elders_quest_six_c1d5c512:

    # helen "At least it counts as training. You'll get better at it every time."
    helen "至少算是一种锻炼。多来几次你就熟练了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2800
translate chinese_simp elders_quest_six_e78fc7d4:

    # player "Hopefully..."
    player "希望吧……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2803
translate chinese_simp elders_quest_six_1c3ea766:

    # helen "I still have a lot of work to do..."
    helen "我还有好多事要做……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2804
translate chinese_simp elders_quest_six_38e8f60d:

    # player "I get it, I'll leave you be."
    player "我懂，不打扰你了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2807
translate chinese_simp elders_quest_six_f02a7a59:

    # helen "Thanks."
    helen "谢谢。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2819
translate chinese_simp visit_the_families_ea709419:

    # narrator "You spend the morning visiting the villagers with [helen] and [freya]."
    narrator "你花了一上午的时间跟[helen]和[freya]一起拜访村民。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2843
translate chinese_simp elders_quest_seven_26ed48ef:

    # freya "Ready?"
    freya "准备好了？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2844
translate chinese_simp elders_quest_seven_5e950bcb:

    # player "I am. Is [helen] coming too?"
    player "嗯。[helen]也来吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2847
translate chinese_simp elders_quest_seven_cd087abe:

    # freya "No, she found the lead and gave me the location."
    freya "不来，她找到了线索，把位置给了我。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2848
translate chinese_simp elders_quest_seven_5959b850:

    # freya "That is as far as she wants to be involved with something that's outside the village."
    freya "她只愿意参与到这个程度，不想再牵扯村外的事了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2849
translate chinese_simp elders_quest_seven_0458270e:

    # player "Sounds about right. What kind of lead is it?"
    player "像是她会做的事。什么线索？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2852
translate chinese_simp elders_quest_seven_7bb78f77:

    # freya "Old trial records."
    freya "以前的试炼记录。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2853
translate chinese_simp elders_quest_seven_559e0f95:

    # freya "Her name is [diana]."
    freya "她叫[diana]。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2854
translate chinese_simp elders_quest_seven_d8b72acb:

    # freya "She failed her trial years before [helen] or I ever took ours."
    freya "她在[helen]和我参加试炼之前很多年就失败了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2857
translate chinese_simp elders_quest_seven_e258fc72:

    # freya "There's a more recent 'update' about where she's probably staying."
    freya "有一条比较新的记录，提到她可能住在哪里。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2858
translate chinese_simp elders_quest_seven_443ab96f:

    # freya "It was noted when she tried to come back two decades or so ago and failed the trial again."
    freya "那是大约二十年前她试图回来时留下的，当时她又没通过试炼。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2859
translate chinese_simp elders_quest_seven_4f98ca50:

    # freya "Nothing certain, but it is the only clue we have."
    freya "不确定，但这是我们唯一的线索。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2860
translate chinese_simp elders_quest_seven_69633190:

    # player "Alright, lead the way."
    player "行，带路吧。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2863
translate chinese_simp elders_quest_seven_745d5c01:

    # narrator "You and [freya] spend the next several hours making your way through rough forest trails."
    narrator "接下来的几个小时，你和[freya]在崎岖的林间小道上行进。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2866
translate chinese_simp elders_quest_seven_02c6ebfa:

    # freya "We should be close now."
    freya "我们应该快到了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2867
translate chinese_simp elders_quest_seven_e6fe62f4:

    # player "You really think she lives this high up?"
    player "你真觉得她住这么高的地方？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2870
translate chinese_simp elders_quest_seven_7e7fe3d3:

    # freya "I do not know."
    freya "我也不知道。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2871
translate chinese_simp elders_quest_seven_7f673ae5:

    # freya "But if she does, then she is exactly the kind of fox I wanted to find."
    freya "但如果她真的住这儿，那她就是我想要找的那种狐狸。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2872
translate chinese_simp elders_quest_seven_1f7bded6:

    # player "Why's that?"
    player "为什么？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2875
translate chinese_simp elders_quest_seven_56f0da39:

    # freya "Just means she survived on her own after failing the trial."
    freya "说明她在试炼失败后靠自己活了下来。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2876
translate chinese_simp elders_quest_seven_6226c757:

    # player "So she's more proof that the trial doesn't work."
    player "所以她进一步证明了试炼没用。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2877
translate chinese_simp elders_quest_seven_3ddfe3d9:

    # freya "Exactly."
    freya "没错。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2880
translate chinese_simp elders_quest_seven_65d652ab:

    # narrator "After another hour you and [freya] notice a house near the edge of a nearby town."
    narrator "又走了一个小时，你和[freya]注意到附近镇子边缘有座房子。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2883
translate chinese_simp elders_quest_seven_cdc999f8:

    # freya "This has to be it."
    freya "应该就是这儿了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2884
translate chinese_simp elders_quest_seven_df9a66a7:

    # player "It's the only house here. If it's not we wasted the trip."
    player "这儿就这一座房子。要不是，那我们就白跑一趟了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2885
translate chinese_simp elders_quest_seven_0094da9e:

    # freya "Yeah."
    freya "嗯。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2888
translate chinese_simp elders_quest_seven_bd7d1ab8:

    # diana "Can I help you?"
    diana "有事吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2889
translate chinese_simp elders_quest_seven_fd38c197:

    # freya "We were hoping we were at the right place..!"
    freya "我们希望没找错地方..！"

# game/scripts/Locations/Fox Village/elders_house.rpy:2892
translate chinese_simp elders_quest_seven_5d702898:

    # diana "..?"
    diana "..？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2893
translate chinese_simp elders_quest_seven_7303ebc3:

    # freya "We're from the fox village."
    freya "我们来自狐村。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2896
translate chinese_simp elders_quest_seven_8d837955:

    # diana "Both of you? He doesn't look like a fox."
    diana "你们两个都是？他看起来不像狐狸。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2897
translate chinese_simp elders_quest_seven_f7e22ad8:

    # freya "He doesn't live there, but he's allowed in."
    freya "他不住那儿，但他能进去。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2898
translate chinese_simp elders_quest_seven_7ad5c4d5:

    # freya "As you can see there's been quite a few changes, could we talk for a bit?"
    freya "如你所见，村子变化不小，我们能聊聊吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2899
translate chinese_simp elders_quest_seven_829d2692:

    # diana "Sure. Let's go inside."
    diana "行，进来说吧。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2903
translate chinese_simp elders_quest_seven_4df2815a:

    # diana "So why come all this way?"
    diana "所以你们跑这么远来是为什么？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2904
translate chinese_simp elders_quest_seven_e72593d7:

    # freya "Things are changing, if a fox was born in the village, she is allowed to come back now."
    freya "村子在改革。只要是出生在村子里的狐狸，现在都可以回来。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2905
translate chinese_simp elders_quest_seven_4eff23ed:

    # freya "No trial or anything like that. We came because that includes you."
    freya "不需要试炼什么的。我们来这里是因为你也在其中。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2908
translate chinese_simp elders_quest_seven_4c539270:

    # diana "I see."
    diana "原来如此。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2909
translate chinese_simp elders_quest_seven_50b186c3:

    # diana "So after all these years, the village has decided I may return if I want to."
    diana "所以过了这么多年，村子终于决定我可以回去了，只要我想。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2910
translate chinese_simp elders_quest_seven_63904a91:

    # freya "Yes, we don't have another way to contact you, so finding you was the only way."
    freya "对，我们没有别的办法联系你，所以只能找到你。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2913
translate chinese_simp elders_quest_seven_b0c1117c:

    # diana "I appreciate you coming all this way."
    diana "谢谢你们大老远跑来。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2914
translate chinese_simp elders_quest_seven_f9c8c1af:

    # diana "But I don't think I'm going to come back."
    diana "但我不打算回去。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2915
translate chinese_simp elders_quest_seven_06625e39:

    # freya "Why not?"
    freya "为什么？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2918
translate chinese_simp elders_quest_seven_7cbc33d7:

    # diana "Because my life is here, I left the village behind a long time ago."
    diana "因为我的人生在这里，我早就把村子放下了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2919
translate chinese_simp elders_quest_seven_46f02432:

    # diana "I don't have family or anything waiting for me there anymore."
    diana "那儿已经没有家人或者任何东西在等着我了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2920
translate chinese_simp elders_quest_seven_d0fc49b7:

    # freya "It was still your home..."
    freya "但那还是你的家啊……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2923
translate chinese_simp elders_quest_seven_4debf500:

    # diana "It was."
    diana "曾经是。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2924
translate chinese_simp elders_quest_seven_25176e8f:

    # diana "Then I failed my trial, got thrown out, and had to make something else work."
    diana "然后我试炼失败，被赶了出来，不得不在外面重新开始。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2927
translate chinese_simp elders_quest_seven_8d5cce0e:

    # diana "I came back a few years later, but all I got was another impossible trial."
    diana "几年后我回去过一次，但得到的只是又一次无法通过的试炼。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2928
translate chinese_simp elders_quest_seven_18f1437e:

    # diana "After that I saw no reason to ever try going back again."
    diana "从那以后，我就觉得没有再回去的必要了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2929
translate chinese_simp elders_quest_seven_3a8a2f58:

    # player "I get it. Being invited back doesn't do much for you."
    player "我明白。就算被邀请回去，对你来说也没什么意义。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2932
translate chinese_simp elders_quest_seven_2a765a7d:

    # diana "Not by itself."
    diana "光是这样确实不够。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2933
translate chinese_simp elders_quest_seven_d0d13d55:

    # diana "For someone younger, or for someone whose family is still there, this could mean everything."
    diana "对更年轻的人，或者家人还在村里的人来说，这或许意味着一切。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2934
translate chinese_simp elders_quest_seven_ea84b4d7:

    # diana "For me, it mostly means the village finally changed its mind."
    diana "对我来说，这主要意味着村子终于改变想法了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2937
translate chinese_simp elders_quest_seven_d300d341:

    # diana "It just isn't enough to make me pack up my whole life and move."
    diana "但这不足以让我放弃现在的生活搬回去。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2938
translate chinese_simp elders_quest_seven_888b102f:

    # freya "There's more to it than that."
    freya "不止是这样。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2941
translate chinese_simp elders_quest_seven_d81bdc43:

    # diana "Like what?"
    diana "还有什么？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2942
translate chinese_simp elders_quest_seven_f27f24d2:

    # freya "You failed the trial but still survived and grew older out here."
    freya "你没通过试炼，但你在外面活了下来，还活到了现在。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2943
translate chinese_simp elders_quest_seven_c9024f24:

    # freya "That's good proof that the trial isn't effective at all."
    freya "这很好地证明了试炼根本没有意义。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2946
translate chinese_simp elders_quest_seven_490d8a46:

    # freya "You coming back would help me with getting the trial changed."
    freya "你愿意回去的话，能帮我说服大家改革试炼。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2947
translate chinese_simp elders_quest_seven_246c0938:

    # freya "Would that be enough?"
    freya "这样能让你改变主意吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2948
translate chinese_simp elders_quest_seven_b60720ee:

    # think "She's saying she wants to just use her so openly..."
    think "她居然这么直接地说想利用她……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2951
translate chinese_simp elders_quest_seven_d585ceef:

    # diana "I appreciate your honesty..."
    diana "我欣赏你的坦诚……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2952
translate chinese_simp elders_quest_seven_e3066d3a:

    # diana "But I need a few reassurances before I do anything."
    diana "但在我做任何决定之前，我需要一些保障。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2953
translate chinese_simp elders_quest_seven_481b250d:

    # freya "Okay..."
    freya "好……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2956
translate chinese_simp elders_quest_seven_30ee70d7:

    # diana "If I came back, where would I live?"
    diana "如果我回去了，我住哪儿？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2957
translate chinese_simp elders_quest_seven_68f194a9:

    # diana "What would I do?"
    diana "我做什么？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2958
translate chinese_simp elders_quest_seven_88f7b05c:

    # diana "Would I actually be part of the village again?"
    diana "我真的能重新成为村子的一员吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2959
translate chinese_simp elders_quest_seven_9c39490a:

    # diana "I'm not going to walk away from the life I built just to hope things work out after."
    diana "我不会放弃我现在的生活，去赌一个未知的未来。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2962
translate chinese_simp elders_quest_seven_19250407:

    # diana "People with families can go back to their families."
    diana "有家人的人可以回去跟家人团聚。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2963
translate chinese_simp elders_quest_seven_b14019aa:

    # diana "Someone like me would be starting from nothing."
    diana "像我这样的人，回去就得从零开始。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2964
translate chinese_simp elders_quest_seven_4268b830:

    # freya "We'll arrange all of that."
    freya "我们会把一切都安排好。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2967
translate chinese_simp elders_quest_seven_be9e88d0:

    # diana "Maybe. Come back to me when you do."
    diana "或许吧。等你们安排好了再来找我。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2968
translate chinese_simp elders_quest_seven_effccb79:

    # freya "Could I just get your number and call you?"
    freya "我能留个你的电话，到时候打给你吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2969
translate chinese_simp elders_quest_seven_c00936aa:

    # freya "You're not really in an easy-to-visit location~"
    freya "你这地方可不好找~"

# game/scripts/Locations/Fox Village/elders_house.rpy:2972
translate chinese_simp elders_quest_seven_e62e9869:

    # diana "That's fair, I'll give you my number."
    diana "那倒是，我给你号码吧。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2973
translate chinese_simp elders_quest_seven_2ad1b386:

    # player "So if we return with all those answers, would you consider coming back?"
    player "所以如果我们带着这些答案回来，你会考虑回去吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2976
translate chinese_simp elders_quest_seven_d893c126:

    # diana "Yes."
    diana "会。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2977
translate chinese_simp elders_quest_seven_9d48d221:

    # diana "If you come back with something solid, I'll hear you out."
    diana "如果你们回来的时候给出了切实的方案，我会好好考虑的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2978
translate chinese_simp elders_quest_seven_694838ca:

    # diana "But I'm not leaving my home before that."
    diana "但在此之前，我不会离开我的家。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2979
translate chinese_simp elders_quest_seven_01dd41c5:

    # freya "Fair enough..."
    freya "说得在理……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2982
translate chinese_simp elders_quest_seven_cddcddfb:

    # narrator "After a few more minutes you and [freya] decide to head back to the village."
    narrator "几分钟后，你和[freya]决定返回村子。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2985
translate chinese_simp elders_quest_seven_f27dcf44:

    # freya "I thought I was bringing her good news."
    freya "我还以为我是来带好消息给她的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2986
translate chinese_simp elders_quest_seven_db6343d1:

    # player "You were, but looking at it from her perspective, it makes sense."
    player "确实是好消息，但从她的角度来看，这反应也合理。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2989
translate chinese_simp elders_quest_seven_f0e93b26:

    # freya "Yeah..."
    freya "嗯……"

# game/scripts/Locations/Fox Village/elders_house.rpy:2990
translate chinese_simp elders_quest_seven_ce49c8d6:

    # freya "She was right."
    freya "她是对的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2991
translate chinese_simp elders_quest_seven_f167815f:

    # freya "For a fox with family still in the village, this is easy."
    freya "对家人还在村子里的狐狸来说，这事很简单。"

# game/scripts/Locations/Fox Village/elders_house.rpy:2994
translate chinese_simp elders_quest_seven_e263d742:

    # freya "But for someone like [diana], what am I really asking her to come back to?"
    freya "但对[diana]这样的人来说，我到底是让她回去做什么呢？"

# game/scripts/Locations/Fox Village/elders_house.rpy:2995
