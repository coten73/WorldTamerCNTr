    # freya "Sweetie, is that you..?"
    freya "亲爱的，是你吗..？"

# game/scripts/Locations/Fox Village/elders_house.rpy:278
translate chinese_simp forest_quest_two_ae96af05:

    # player "It's me..."
    player "是我……"

# game/scripts/Locations/Fox Village/elders_house.rpy:281
translate chinese_simp forest_quest_two_352ceb5d:

    # freya "Oh- The tamer."
    freya "哦——驯兽师先生。"

# game/scripts/Locations/Fox Village/elders_house.rpy:282
translate chinese_simp forest_quest_two_2b4f4b69:

    # freya "What brings you here..? Alone..."
    freya "什么风把你吹来了..？还一个人……"

# game/scripts/Locations/Fox Village/elders_house.rpy:283
translate chinese_simp forest_quest_two_34fea3ae:

    # player "I wanted to talk..."
    player "我想找你聊聊……"

# game/scripts/Locations/Fox Village/elders_house.rpy:286
translate chinese_simp forest_quest_two_d34f8604:

    # freya "About [lisa]?"
    freya "关于[lisa]？"

# game/scripts/Locations/Fox Village/elders_house.rpy:287
translate chinese_simp forest_quest_two_0c081e71:

    # player "Yes."
    player "对。"

# game/scripts/Locations/Fox Village/elders_house.rpy:290
translate chinese_simp forest_quest_two_ab1a4b7c:

    # freya "Interesting... So tell me, how many girls have you tamed..."
    freya "有意思……那你说说，你驯服了多少个女孩了……"

# game/scripts/Locations/Fox Village/elders_house.rpy:291
translate chinese_simp forest_quest_two_dae8ac75:

    # player "A few..."
    player "有几个了……"

# game/scripts/Locations/Fox Village/elders_house.rpy:292
translate chinese_simp forest_quest_two_d1b316e6:

    # freya "Is the number's too high to count or do you not feel like sharing?"
    freya "是数量多得数不过来，还是你不想分享？"

# game/scripts/Locations/Fox Village/elders_house.rpy:295
translate chinese_simp forest_quest_two_31d356e1:

    # freya "Well regardless, do you care this much for all of them?"
    freya "算了，不管怎样，你对她们每个人都这么上心吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:296
translate chinese_simp forest_quest_two_94cfb5bc:

    # player "Yes, but [lisa]'s special."
    player "是的，但[lisa]很特别。"

# game/scripts/Locations/Fox Village/elders_house.rpy:299
translate chinese_simp forest_quest_two_0d300ab1:

    # freya "We can agree on that."
    freya "这一点我同意。"

# game/scripts/Locations/Fox Village/elders_house.rpy:302
translate chinese_simp forest_quest_two_dfdcbc9f:

    # freya "She told me how you met and how she ended up tamed..."
    freya "她告诉我你们是怎么认识的，以及她是怎么被驯服的……"

# game/scripts/Locations/Fox Village/elders_house.rpy:303
translate chinese_simp forest_quest_two_9645ef38:

    # freya "Was she the first girl you tamed..?"
    freya "她是你驯服的第一个女孩吗..？"

# game/scripts/Locations/Fox Village/elders_house.rpy:304
translate chinese_simp forest_quest_two_d6e0ab68:

    # player "No-"
    player "不是-"

# game/scripts/Locations/Fox Village/elders_house.rpy:305
translate chinese_simp forest_quest_two_5fe23994:

    # player "I came here to talk to you, remember?"
    player "我是来找你谈话的，记得吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:308
translate chinese_simp forest_quest_two_4eb2d659:

    # freya "Fine, fine, what do you want to know?"
    freya "好好好，你想知道什么？"

# game/scripts/Locations/Fox Village/elders_house.rpy:309
translate chinese_simp forest_quest_two_023788d2:

    # player "Last time I was here you mentioned a curse..?"
    player "上次我来这里，你提到了一个‘诅咒’..？"

# game/scripts/Locations/Fox Village/elders_house.rpy:312
translate chinese_simp forest_quest_two_22e5d572:

    # freya "Oh that... Well, it's not literally a curse-"
    freya "哦，那个啊……其实不是真正意义上的诅咒-"

# game/scripts/Locations/Fox Village/elders_house.rpy:313
translate chinese_simp forest_quest_two_132485a1:

    # freya "We just called it that between ourselves."
    freya "是我们自己私下这么叫的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:316
translate chinese_simp forest_quest_two_9c17b66b:

    # freya "She was essentially very weak, and no matter what I did I couldn't help her."
    freya "她天生就很弱，我试过各种办法都没能帮上忙。"

# game/scripts/Locations/Fox Village/elders_house.rpy:317
translate chinese_simp forest_quest_two_4f54742a:

    # player "So you left?"
    player "所以你就离开了？"

# game/scripts/Locations/Fox Village/elders_house.rpy:320
translate chinese_simp forest_quest_two_f7c5e555:

    # freya "I went on a few quests to look for a 'cure' or ways to help, yes."
    freya "对，我接了几个任务，去寻找‘解药’或者能帮到她的办法。"

# game/scripts/Locations/Fox Village/elders_house.rpy:321
translate chinese_simp forest_quest_two_1d0bb7d2:

    # player "And after she got exiled?"
    player "那她被流放之后呢？"

# game/scripts/Locations/Fox Village/elders_house.rpy:322
translate chinese_simp forest_quest_two_79ffdc94:

    # freya "Same thing..."
    freya "也一样……"

# game/scripts/Locations/Fox Village/elders_house.rpy:323
translate chinese_simp forest_quest_two_0865a6d8:

    # player "And now that she's back? Do you intend to leave her again?"
    player "那她现在回来了，你打算再离开她吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:326
translate chinese_simp forest_quest_two_a97d732b:

    # freya "Figured this is where your questions would lead..."
    freya "我就猜到你会问这个……"

# game/scripts/Locations/Fox Village/elders_house.rpy:329
translate chinese_simp forest_quest_two_69d922c2:

    # freya "No."
    freya "不。"

# game/scripts/Locations/Fox Village/elders_house.rpy:330
translate chinese_simp forest_quest_two_8f947020:

    # freya "Would it make you happy if I said I don't intend to leave her again?"
    freya "如果我说我不打算再离开她了，你会高兴点吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:331
translate chinese_simp forest_quest_two_1941f2ba:

    # player "If it's the truth..."
    player "只要你说的是实话……"

# game/scripts/Locations/Fox Village/elders_house.rpy:334
translate chinese_simp forest_quest_two_6650cf16:

    # freya "It is... We had a long talk and decided I'm done adventuring."
    freya "是实话……我们长谈了一次，决定我不再冒险了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:335
translate chinese_simp forest_quest_two_fe1c1287:

    # player "So what will you do?"
    player "那你打算做什么？"

# game/scripts/Locations/Fox Village/elders_house.rpy:338
translate chinese_simp forest_quest_two_4e67b020:

    # freya "Don't know... Maybe I'll actually apply to become an elder. Should keep me busy..."
    freya "不知道……也许我真的可以去申请当个长老。应该能让我忙起来……"

# game/scripts/Locations/Fox Village/elders_house.rpy:339
translate chinese_simp forest_quest_two_68e11a21:

    # player "Do you want to be an elder..?"
    player "你想当长老吗..？"

# game/scripts/Locations/Fox Village/elders_house.rpy:342
translate chinese_simp forest_quest_two_a6ec9c48:

    # freya "Beats sitting around doing nothing all day..."
    freya "总比整天无所事事强……"

# game/scripts/Locations/Fox Village/elders_house.rpy:343
translate chinese_simp forest_quest_two_9f7ef59a:

    # player "You should go for it... [abigail] basically begged you to apply..."
    player "你应该去试试……[abigail]都明摆着求你申请了……"

# game/scripts/Locations/Fox Village/elders_house.rpy:344
translate chinese_simp forest_quest_two_ad2fe3e7:

    # freya "I guess..."
    freya "也许吧……"

# game/scripts/Locations/Fox Village/elders_house.rpy:347
translate chinese_simp forest_quest_two_8cb54a9f:

    # freya "Wait- What's it to you?"
    freya "等等——这跟你有什么关系？"

# game/scripts/Locations/Fox Village/elders_house.rpy:348
translate chinese_simp forest_quest_two_d9210764:

    # freya "Why do you care if I become an elder?"
    freya "你为什么在意我能不能当上长老？"

# game/scripts/Locations/Fox Village/elders_house.rpy:349
translate chinese_simp forest_quest_two_663100b6:

    # player "Just gives you another reason to stay here."
    player "只是给你多一个留在这里的理由。"

# game/scripts/Locations/Fox Village/elders_house.rpy:352
translate chinese_simp forest_quest_two_78de463a:

    # freya "I see..."
    freya "我明白了……"

# game/scripts/Locations/Fox Village/elders_house.rpy:353
translate chinese_simp forest_quest_two_b650d9cb:

    # freya "She really found herself a good tamer-"
    freya "她真是给自己找了个好驯兽师——"

# game/scripts/Locations/Fox Village/elders_house.rpy:354
translate chinese_simp forest_quest_two_5706aadc:

    # freya "I'm kinda jealous..."
    freya "我都有点嫉妒了……"

# game/scripts/Locations/Fox Village/elders_house.rpy:355
translate chinese_simp forest_quest_two_c9bd8035:

    # player "I mean-"
    player "我是说-"

# game/scripts/Locations/Fox Village/elders_house.rpy:358
translate chinese_simp forest_quest_two_632afa5b:

    # freya "I bet that got you real interested~"
    freya "我敢打赌，这话让你来劲了~"

# game/scripts/Locations/Fox Village/elders_house.rpy:361
translate chinese_simp forest_quest_two_8daba46c:

    # freya "Well... Being at home is pretty boring..."
    freya "嗯……待在家里确实很无聊……"

# game/scripts/Locations/Fox Village/elders_house.rpy:362
translate chinese_simp forest_quest_two_9147b3ad:

    # freya "Maybe getting tamed isn't such a bad idea~ Would spice things up for sure..."
    freya "也许被驯服也不是个坏主意~肯定能让生活多点乐子……"

# game/scripts/Locations/Fox Village/elders_house.rpy:365
translate chinese_simp forest_quest_two_d9668883:

    # freya "Okay~ Since you want me to become an elder so badly..."
    freya "好吧~既然你这么想让我当长老……"

# game/scripts/Locations/Fox Village/elders_house.rpy:366
translate chinese_simp forest_quest_two_a0aba362:

    # freya "Make that happen, and I'll let you tame me~"
    freya "你帮我实现它，我就让你驯服我~"

# game/scripts/Locations/Fox Village/elders_house.rpy:367
translate chinese_simp forest_quest_two_ad8b7d2b:

    # freya "Do we have a deal~?"
    freya "成交吗~？"

# game/scripts/Locations/Fox Village/elders_house.rpy:368
translate chinese_simp forest_quest_two_b7eb08e3:

    # player "We do~"
    player "成交~"

# game/scripts/Locations/Fox Village/elders_house.rpy:371
translate chinese_simp forest_quest_two_f19d3cfe:

    # freya "Figured that would motivate you~"
    freya "我就知道这个能激励你~"

# game/scripts/Locations/Fox Village/elders_house.rpy:372
translate chinese_simp forest_quest_two_18092244:

    # freya "But don't take too long, I'm already looking forward to it~"
    freya "不过别让我等太久，我已经等不及了~"

# game/scripts/Locations/Fox Village/elders_house.rpy:373
translate chinese_simp forest_quest_two_8a6c5596:

    # player "I'll try my best~"
    player "我会尽力的~"

# game/scripts/Locations/Fox Village/elders_house.rpy:384
translate chinese_simp forest_quest_three_553d9cb8:

    # narrator "You knock on the door and after a few minutes hear a voice telling you to walk in."
    narrator "你敲了敲门，几分钟后，一个声音让你进去。"

# game/scripts/Locations/Fox Village/elders_house.rpy:387
translate chinese_simp forest_quest_three_587c45eb:

    # abigail "How can we help you [player]..."
    abigail "我们能帮你什么忙吗，[player]……"

# game/scripts/Locations/Fox Village/elders_house.rpy:388
translate chinese_simp forest_quest_three_a23da068:

    # silas "Why are you here again?"
    silas "你怎么又来了？"

# game/scripts/Locations/Fox Village/elders_house.rpy:389
translate chinese_simp forest_quest_three_dea48766:

    # player "It's about an elder candidate-"
    player "是关于一个长老候选人的-"

# game/scripts/Locations/Fox Village/elders_house.rpy:392
translate chinese_simp forest_quest_three_a8bc60d4:

    # silas "You are a human, you are not one of us you won't be even considered."
    silas "你是人类，不是我们的一员，我们甚至不会考虑你。"

# game/scripts/Locations/Fox Village/elders_house.rpy:393
translate chinese_simp forest_quest_three_52df0b35:

    # player "I know, it's about [freya]."
    player "我知道，我说的是[freya]。"

# game/scripts/Locations/Fox Village/elders_house.rpy:396
translate chinese_simp forest_quest_three_3f7ecc0a:

    # silas "That woman? She's an adventurer, she leaves the village on a whim, she won't be considered."
    silas "那个女人？她是个冒险家，一时兴起就离开村子，不能考虑她。"

# game/scripts/Locations/Fox Village/elders_house.rpy:397
translate chinese_simp forest_quest_three_b6897a6a:

    # abigail "Now, now... Did she send you here herself?"
    abigail "好了，好了……是她自己派你来的吗？"

# game/scripts/Locations/Fox Village/elders_house.rpy:398
translate chinese_simp forest_quest_three_887e6164:

    # player "Yes. She says she's done adventuring and is interested in becoming an elder."
    player "是的。她说她已经不当冒险家了，现在对当长老有兴趣。"

# game/scripts/Locations/Fox Village/elders_house.rpy:401
translate chinese_simp forest_quest_three_dad7e1d8:

    # silas "She can't just change her mind like that."
    silas "她不能就这么改变主意。"

# game/scripts/Locations/Fox Village/elders_house.rpy:402
translate chinese_simp forest_quest_three_d95ee041:

    # helen "She can."
    helen "她可以。"

# game/scripts/Locations/Fox Village/elders_house.rpy:403
translate chinese_simp forest_quest_three_0680e775:

    # helen "If she wishes to become a candidate she has every right to."
    helen "如果她想成为候选人，她完全有这个权利。"

# game/scripts/Locations/Fox Village/elders_house.rpy:406
translate chinese_simp forest_quest_three_01a13694:

    # silas "Ah, fine... Whatever..."
    silas "啊，好吧……随你们便吧……"

# game/scripts/Locations/Fox Village/elders_house.rpy:407
translate chinese_simp forest_quest_three_3bbb488f:

    # silas "You figure this stuff out, I'm taking a break..."
    silas "你们自己商量吧，我先休息一下……"

# game/scripts/Locations/Fox Village/elders_house.rpy:410
translate chinese_simp forest_quest_three_dfe5ec10:

    # abigail "Excuse him... He acts like this with every candidate."
    abigail "别介意他……他对每个候选人都这样。"

# game/scripts/Locations/Fox Village/elders_house.rpy:411
translate chinese_simp forest_quest_three_cd65bf21:

    # helen "Who wouldn't hate seeing all their potential replacements like that."
    helen "谁会乐意看到这么多可能取代自己的人。"

# game/scripts/Locations/Fox Village/elders_house.rpy:412
translate chinese_simp forest_quest_three_720cc23c:

    # abigail "You got a point there~"
    abigail "这话倒是没错~"

# game/scripts/Locations/Fox Village/elders_house.rpy:415
translate chinese_simp forest_quest_three_150f88d8:

    # abigail "So... [freya] finally decided to retire as an adventurer..?"
    abigail "所以……[freya]终于决定不当冒险家退休了..？"

# game/scripts/Locations/Fox Village/elders_house.rpy:416
translate chinese_simp forest_quest_three_b0cab938:

    # player "Yes. I think she wants to stay close and in contact with [lisa] from now on."
    player "是的。我想她是想从此以后待在[lisa]身边，保持联系。"

# game/scripts/Locations/Fox Village/elders_house.rpy:417
translate chinese_simp forest_quest_three_6468412b:

    # helen "That's understandable."
    helen "可以理解。"

# game/scripts/Locations/Fox Village/elders_house.rpy:420
translate chinese_simp forest_quest_three_47978fa4:

    # helen "But why isn't she here? Why send you?"
    helen "但她为什么没来？为什么要派你来？"

# game/scripts/Locations/Fox Village/elders_house.rpy:421
translate chinese_simp forest_quest_three_47bdfbb8:

    # player "She asked it as a favor..."
    player "她请我帮忙跑一趟……"

# game/scripts/Locations/Fox Village/elders_house.rpy:422
translate chinese_simp forest_quest_three_8d978995:

    # helen "I see..."
    helen "我明白了……"

# game/scripts/Locations/Fox Village/elders_house.rpy:425
translate chinese_simp forest_quest_three_d34488eb:

    # abigail "Considering your relationship, we'll count this as okay and write her down as a candidate."
    abigail "考虑到你们的关系，我们就算通过了，把她记作候选人。"

# game/scripts/Locations/Fox Village/elders_house.rpy:426
translate chinese_simp forest_quest_three_5a6e5dbf:

    # player "Thank you."
    player "谢谢。"

# game/scripts/Locations/Fox Village/elders_house.rpy:427
translate chinese_simp forest_quest_three_7b575a97:

    # player "What happens now?"
    player "现在呢？"

# game/scripts/Locations/Fox Village/elders_house.rpy:430
translate chinese_simp forest_quest_three_4f1ca5bc:

    # helen "Now we wait a few more days for the second stage begins."
    helen "现在我们再等几天，第二阶段就开始。"

# game/scripts/Locations/Fox Village/elders_house.rpy:431
translate chinese_simp forest_quest_three_f922f702:

    # abigail "We'll essentially go through the candidates and pick the one we find most capable for the job."
    abigail "我们会对候选人进行评估，然后选出我们认为最适合这个位置的人。"

# game/scripts/Locations/Fox Village/elders_house.rpy:432
translate chinese_simp forest_quest_three_5642a5e3:

    # player "Is there anything the candidates can do to increase their odds..?"
    player "候选人有什么办法能提高胜算吗..？"

# game/scripts/Locations/Fox Village/elders_house.rpy:435
translate chinese_simp forest_quest_three_ad24a8eb:

    # helen "No. This is done strictly behind closed doors."
    helen "没有。选拔过程是完全不公开的。"

# game/scripts/Locations/Fox Village/elders_house.rpy:436
translate chinese_simp forest_quest_three_92ca78b4:

    # helen "The results will be known when we figure everything out."
    helen "等我们决定了，结果自然会公布。"

# game/scripts/Locations/Fox Village/elders_house.rpy:437
translate chinese_simp forest_quest_three_6e4f5f94:

    # player "I see. I'll be on my way then, I'll let [freya] know that she's now a candidate."
    player "我明白了。那我先走了，我会告诉[freya]她现在是候选人了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:446
translate chinese_simp forest_quest_four_f05779c6:

    # freya "How did it go?"
    freya "怎么样了？"

# game/scripts/Locations/Fox Village/elders_house.rpy:447
translate chinese_simp forest_quest_four_2524de08:

    # player "You're now a candidate."
    player "你现在是候选人了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:448
translate chinese_simp forest_quest_four_746b0f64:

    # freya "Great!"
    freya "太好了！"

# game/scripts/Locations/Fox Village/elders_house.rpy:451
translate chinese_simp forest_quest_four_294c1da2:

    # freya "So what's your plan now?"
    freya "那你现在打算怎么办？"

# game/scripts/Locations/Fox Village/elders_house.rpy:452
translate chinese_simp forest_quest_four_c2d74f20:

    # player "What do you mean?"
    player "什么怎么办？"

# game/scripts/Locations/Fox Village/elders_house.rpy:455
translate chinese_simp forest_quest_four_70837b87:

    # freya "Well... To get me picked..?"
    freya "嗯……让他们选我啊..？"

# game/scripts/Locations/Fox Village/elders_house.rpy:456
translate chinese_simp forest_quest_four_e9f9db0d:

    # player "They said there's nothing else to be done..."
    player "他们说没什么能做的了……"

# game/scripts/Locations/Fox Village/elders_house.rpy:459
translate chinese_simp forest_quest_four_395f3f33:

    # freya "Well duh, it's between the elders now."
    freya "那当然，现在是长老们内部决定了。"

# game/scripts/Locations/Fox Village/elders_house.rpy:462
translate chinese_simp forest_quest_four_b0039f26:

    # freya "Try talking to [helen] and [abigail]."
    freya "去跟[helen]和[abigail]谈谈。"

# game/scripts/Locations/Fox Village/elders_house.rpy:463
translate chinese_simp forest_quest_four_ced4948f:

    # freya "I'm sure there are ways for you to win their favor~"
    freya "我相信你肯定有办法讨她们欢心的~"

# game/scripts/Locations/Fox Village/elders_house.rpy:464
translate chinese_simp forest_quest_four_d331daba:

    # player "I guess that couldn't hurt to try..."
    player "试试应该也没什么坏处……"

# game/scripts/Locations/Fox Village/elders_house.rpy:467
translate chinese_simp forest_quest_four_45f929a1:

    # freya "Just don't go overboard, you don't want it hurting my odds."
    freya "别太过分就行，你可别弄巧成拙。"

# game/scripts/Locations/Fox Village/elders_house.rpy:477
translate chinese_simp forest_quest_five_2220a51b:

    # abigail "I figured you'd eventually ask about that."
    abigail "我就知道你迟早会来问这个。"

# game/scripts/Locations/Fox Village/elders_house.rpy:478
translate chinese_simp forest_quest_five_0cf04105:

