translate chinese_simp katherine_confrontation_b1da7ca5:

    # katherine "What I should have done from the start. Talk to them."
    katherine "做我从一开始就该做的事。和她们谈谈。"

# game/scripts/Locations/katherine_house.rpy:288
translate chinese_simp katherine_confrontation_26ceb341:

    # katherine "I'm going to explain the whole story, they deserve to know. I can't make another bad decision for them."
    katherine "我要把整个故事告诉她们，她们有权知道。我不能再为她们做出错误的决定了。"

# game/scripts/Locations/katherine_house.rpy:289
translate chinese_simp katherine_confrontation_55510db9:

    # player "I can get behind on that... I'll make sure I'll be there when you tell them."
    player "这个我支持……你跟她们谈的时候，我会在场的。"

