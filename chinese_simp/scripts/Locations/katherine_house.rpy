translate chinese_simp katherine_confrontation_2c92cc60:

    # luna "Did not expect that."
    luna "真没想到会这样。"

# game/scripts/Locations/katherine_house.rpy:316
translate chinese_simp katherine_confrontation_a2289b28:

    # think "I know right... I am happy for [ava] and [emma] though, they might actually get their mother back."
    think "可不是嘛……不过我真心为 [ava] 和 [emma] 感到高兴，她们或许真的能找回妈妈了。"

# game/scripts/Locations/katherine_house.rpy:317
translate chinese_simp katherine_confrontation_cc51f890:

    # think "If they believe her story of course..."
    think "当然，前提是她们愿意相信她的话……"

