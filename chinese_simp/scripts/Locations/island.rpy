    layla "[astra] 派我来的！她让我来找你！"

# game/scripts/Locations/island.rpy:1413
translate chinese_simp island_layla_search_1d468f81:

    # player "Does she have a plan to get us home?"
    player "她有办法带我们回家吗？"

# game/scripts/Locations/island.rpy:1416
translate chinese_simp island_layla_search_d4b09d56:

    # layla "She gave me something, she said you'll know how to use it."
    layla "她给了我一样东西，说你会知道怎么用。"

# game/scripts/Locations/island.rpy:1417
translate chinese_simp island_layla_search_0fade97d:

    # player "I see... She probably meant the door portal thing..."
    player "原来如此……她大概说的是那个传送门之类的东西……"

# game/scripts/Locations/island.rpy:1420
translate chinese_simp island_layla_search_4b7937a8:

    # layla "Yeah! She said it will only work when our times are synced up."
    layla "对！她说只有在我们时间同步的时候才能用。"

# game/scripts/Locations/island.rpy:1421
translate chinese_simp island_layla_search_51ffa04a:

    # player "Well that's great! It means we have an actual way home!"
    player "那太好了！这意味着我们有了一条真正的回家之路！"

# game/scripts/Locations/island.rpy:1424
translate chinese_simp island_layla_search_264cd815:

    # layla "But there's a problem..."
    layla "但有个问题……"

# game/scripts/Locations/island.rpy:1425
translate chinese_simp island_layla_search_c2d74f20:

    # player "What do you mean?"
    player "什么问题？"

# game/scripts/Locations/island.rpy:1428
translate chinese_simp island_layla_search_9d5e207d:

    # layla "I lost it..."
    layla "我把它弄丢了……"

# game/scripts/Locations/island.rpy:1429
translate chinese_simp island_layla_search_58c172a6:

    # player "What? How?"
    player "什么？怎么弄丢的？"

# game/scripts/Locations/island.rpy:1432
translate chinese_simp island_layla_search_c90be9d1:

    # layla "I don't know... I had it in my pocket the first night here, but when I woke up it was gone..."
    layla "我不知道……第一天晚上我还放在口袋里，但醒来就不见了……"

# game/scripts/Locations/island.rpy:1433
translate chinese_simp island_layla_search_5cb9984b:

    # layla "I've been searching around here ever since..."
    layla "从那以后我一直在附近找……"

# game/scripts/Locations/island.rpy:1434
translate chinese_simp island_layla_search_a5f19388:

    # player "That's really strange..."
    player "那真的很奇怪……"

# game/scripts/Locations/island.rpy:1437
translate chinese_simp island_layla_search_4cdece3f:

    # lisa "What if someone took it?"
    lisa "会不会是被谁拿走了？"

# game/scripts/Locations/island.rpy:1440
translate chinese_simp island_layla_search_e51001be:

    # lisa "[quila] wouldn't do something like that."
    lisa "[quila] 不会做那种事的。"

# game/scripts/Locations/island.rpy:1441
translate chinese_simp island_layla_search_9edad833:

    # player "True..."
    player "那倒是……"

# game/scripts/Locations/island.rpy:1444
translate chinese_simp island_layla_search_5ca76527:

    # player "But [kora] definitely would... I'll go talk to her..."
    player "但 [kora] 肯定会……我去找她谈谈……"

# game/scripts/Locations/island.rpy:1457
translate chinese_simp island_leaving_2949f215:

    # lisa "I think everyone's here..."
    lisa "我想人都到齐了……"

# game/scripts/Locations/island.rpy:1458
translate chinese_simp island_leaving_2939197d:

    # player "Okay, then let's start."
    player "好，那我们开始吧。"

# game/scripts/Locations/island.rpy:1462
translate chinese_simp island_leaving_609c5533:

    # player "Since we're all here, can you at least let me set it up?"
    player "既然人都到齐了，你至少让我布置一下吧？"

# game/scripts/Locations/island.rpy:1463
translate chinese_simp island_leaving_6f3a21c7:

    # kora "Sure."
    kora "行。"

# game/scripts/Locations/island.rpy:1467
translate chinese_simp island_leaving_e474c11d:

    # think "[astra]'s connection is stable, right?"
    think "[astra] 的连接是稳定的，对吧？"

# game/scripts/Locations/island.rpy:1468
translate chinese_simp island_leaving_f818a1f9:

    # luna "Yes."
    luna "对。"

# game/scripts/Locations/island.rpy:1472
translate chinese_simp island_leaving_806aa04a:

    # player "Okay... That should've worked..."
    player "好了……应该没问题了……"

# game/scripts/Locations/island.rpy:1476
translate chinese_simp island_leaving_fb0b78af:

    # lisa "Only one way to find out!"
    lisa "试试就知道了！"

# game/scripts/Locations/island.rpy:1477
translate chinese_simp island_leaving_2fd7a58c:

    # player "Go ahead."
    player "你来吧。"

# game/scripts/Locations/island.rpy:1481
translate chinese_simp island_leaving_1bebe896:

    # girls "..."
    girls "……"

# game/scripts/Locations/island.rpy:1485
translate chinese_simp island_leaving_7ac8583e:

    # astra "[persistent.astraplayerTitle]!"
    astra "[persistent.astraplayerTitle]！"

# game/scripts/Locations/island.rpy:1486
translate chinese_simp island_leaving_37d6b004:

    # player "Hey [astra]!"
    player "嘿 [astra]！"

# game/scripts/Locations/island.rpy:1487
translate chinese_simp island_leaving_938b1899:

    # astra "Get in here everyone!"
    astra "大家快进来！"

# game/scripts/Locations/island.rpy:1493
translate chinese_simp island_leaving_45b51c4b:

    # astra "It's amazing to see both of you home again!"
    astra "真是太好了，看到你们都安全回来了！"

# game/scripts/Locations/island.rpy:1494
translate chinese_simp island_leaving_272c830a:

    # player "It's good to be back... As you can see, we brought some people with us..."
    player "回来的感觉真好……如你所见，我们还带了一些人回来……"

# game/scripts/Locations/island.rpy:1495
translate chinese_simp island_leaving_9f7b6fb2:

    # lisa "They've been stuck in there for a really long time..."
    lisa "她们被困在那里很久了……"

# game/scripts/Locations/island.rpy:1499
translate chinese_simp island_leaving_0e6d310e:

    # astra "Woah... A demon and a goblin? Both really rare to see these days..."
    astra "哇哦……一个恶魔和一个哥布林？现在这两种族都很少见了……"

# game/scripts/Locations/island.rpy:1500
translate chinese_simp island_leaving_d6fdc734:

    # kora "You must be the celestial [player] somehow tamed."
    kora "你一定是那个被 [player] 不知怎么驯服的天体吧。"

# game/scripts/Locations/island.rpy:1501
translate chinese_simp island_leaving_81dec6d4:

    # astra "That's me!"
    astra "就是我！"

# game/scripts/Locations/island.rpy:1502
translate chinese_simp island_leaving_623ed94d:

    # quila "Thank you for getting us home..."
    quila "谢谢你带我们回家……"

# game/scripts/Locations/island.rpy:1505
translate chinese_simp island_leaving_453d0f3d:

    # astra "You're welcome!"
    astra "不客气！"

# game/scripts/Locations/island.rpy:1506
translate chinese_simp island_leaving_449a718d:

    # player "So how long were we gone for?"
    player "所以我们消失了多久？"

# game/scripts/Locations/island.rpy:1510
translate chinese_simp island_leaving_9824035a:

    # astra "Well... It's been a little less than a month out here."
    astra "嗯……这边过了还不到一个月。"

# game/scripts/Locations/island.rpy:1514
translate chinese_simp island_leaving_4be09e5a:

    # kora "So, how did you figure out a way to reach [player]?"
    kora "那么，你是怎么找到联系 [player] 的方法的？"

# game/scripts/Locations/island.rpy:1515
translate chinese_simp island_leaving_804ba51c:

    # astra "Well I had to learn time magic from scratch for starters..."
    astra "首先，我不得不从头开始学习时间魔法……"

# game/scripts/Locations/island.rpy:1516
translate chinese_simp island_leaving_fc6f75e3:

    # player "(I think [astra] can take it from here, let's go back home.)"
    player "（我想 [astra] 能搞定这边，我们回家吧。）"

# game/scripts/Locations/island.rpy:1520
translate chinese_simp island_leaving_dd99e66b:

    # lisa "(Right! Looks like they're hitting it off~)"
    lisa "（嗯！看起来她们聊得挺投机的~）"

# game/scripts/Locations/island.rpy:1527
translate chinese_simp island_leaving_100463e7:

    # player "Hey..."
    player "嘿……"

# game/scripts/Locations/island.rpy:1531
translate chinese_simp island_leaving_11462e3c:

    # emily "It's really you?"
    emily "真的是你？"

# game/scripts/Locations/island.rpy:1532
translate chinese_simp island_leaving_5679bbdc:

    # player "Yeah... We're back!"
    player "嗯……我们回来了！"

# game/scripts/Locations/island.rpy:1536
translate chinese_simp island_leaving_913a8eb7:

    # emily "I never imagined I'd miss you this much after just a month..."
    emily "我没想到才一个月，我就这么想你……"

# game/scripts/Locations/island.rpy:1537
translate chinese_simp island_leaving_81787396:

    # player "I missed you too... And it's been three months for us..."
    player "我也想你……而且对我们来说已经过了三个月了……"

# game/scripts/Locations/island.rpy:1541
translate chinese_simp island_leaving_5b115859:

    # emily "Three months? How?"
    emily "三个月？怎么会？"

# game/scripts/Locations/island.rpy:1542
translate chinese_simp island_leaving_c616938a:

    # player "It's a long story... I'll tell you about it later."
    player "说来话长……我晚点再告诉你。"

# game/scripts/Locations/island.rpy:1546
translate chinese_simp island_leaving_e8e0add9:

    # player "I promised [lisa] I'll take her somewhere when we get home."
    player "我答应过 [lisa]，回家后要带她去个地方。"

# game/scripts/Locations/island.rpy:1550
translate chinese_simp island_leaving_095ca567:

    # emily "We understand. Go do what you planned."
    emily "我们懂。去做你们计划好的事吧。"

# game/scripts/Locations/island.rpy:1554
translate chinese_simp island_leaving_11245bd2:

    # player "I bet you wanna get out of those clothes just as much as me."
    player "我猜你跟我一样，恨不得立刻把这身衣服换掉。"

# game/scripts/Locations/island.rpy:1555
translate chinese_simp island_leaving_fd00c3cb:

    # lisa "I really do need something new after so long."
    lisa "过了这么久，我真的需要换身新衣服了。"

# game/scripts/Locations/island.rpy:1556
translate chinese_simp island_leaving_db66805f:

    # player "Let's go try some out."
    player "我们去试试几件吧。"

# game/scripts/Locations/island.rpy:1560
translate chinese_simp island_leaving_6e42b7cf:

    # lisa "What do you think~"
    lisa "你觉得怎么样~"

# game/scripts/Locations/island.rpy:1564
translate chinese_simp island_leaving_0556fe24:

    # player "I think you know the answer to that~"
    player "我觉得你自己清楚答案~"

# game/scripts/Locations/island.rpy:1568
translate chinese_simp island_leaving_fdb0c518:

    # lisa "I do~"
    lisa "我知道~"

# game/scripts/Locations/island.rpy:1573
translate chinese_simp island_leaving_155f3817:

    # lisa "I love what you chose as well~"
    lisa "我也很喜欢你选的~"

# game/scripts/Locations/island.rpy:1574
translate chinese_simp island_leaving_ab343f73:

    # player "Thank you~"
    player "谢谢~"

# game/scripts/Locations/island.rpy:1579
translate chinese_simp island_leaving_6043b664:

    # lisa "Mmmmnnn~"
    lisa "唔嗯~"

# game/scripts/Locations/island.rpy:1580
translate chinese_simp island_leaving_86c18d1d:

    # player "Let's buy these and head home."
    player "就买这些，我们回家吧。"

# game/scripts/Locations/island.rpy:1583
translate chinese_simp island_leaving_f992c615:

    # lisa "Already..?"
    lisa "这么快..？"

# game/scripts/Locations/island.rpy:1584
translate chinese_simp island_leaving_f0911d55:

    # player "Figured we'd continue this in my room~"
    player "我想我们可以回我房间再继续~"

