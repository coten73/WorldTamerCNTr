    # think "It's going to be difficult to hear anything from here, need to get closer somehow."
    think "从这儿听不清她说什么，得再靠近点。"

# game/scripts/Locations/bar.rpy:765
translate chinese_simp bar_katherine_meeting_f624fe75:

    # think "This should be close enough."
    think "这个距离应该可以了。"

# game/scripts/Locations/bar.rpy:766
translate chinese_simp bar_katherine_meeting_b3694da9:

    # katherine "Yes... They're all alone, they got no one to look after them..."
    katherine "对……她们就两个人，没人照顾她们……"

# game/scripts/Locations/bar.rpy:767
translate chinese_simp bar_katherine_meeting_dfbda595:

    # luna "Hmm... Maybe we got her all wrong..."
    luna "嗯……难道是我们误会她了……"

# game/scripts/Locations/bar.rpy:768
translate chinese_simp bar_katherine_meeting_bf751c0e:

    # katherine "But they're both such sweet girls..."
    katherine "但她们俩都是那么可爱的姑娘……"

# game/scripts/Locations/bar.rpy:769
translate chinese_simp bar_katherine_meeting_edbfe85e:

    # think "Yeah... Maybe she actually cares about them."
    think "是啊……也许她确实是关心她们的。"

# game/scripts/Locations/bar.rpy:770
translate chinese_simp bar_katherine_meeting_bc723370:

    # katherine "It should be easy to take the bar, I just need a bit of time."
    katherine "拿下酒吧应该不难，我只需要一点时间。"

# game/scripts/Locations/bar.rpy:771
translate chinese_simp bar_katherine_meeting_82dace0c:

    # katherine "I have to convince them that they can trust me and that I can make it easier for them."
    katherine "我得让她们相信我是可信的，能让她们的生活轻松一点。"

# game/scripts/Locations/bar.rpy:772
translate chinese_simp bar_katherine_meeting_0e159355:

