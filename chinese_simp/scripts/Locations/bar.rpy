    # ava "Let's go change into something more casual."
    ava "我们去换身更休闲的衣服吧。"

# game/scripts/Locations/bar.rpy:1196
translate chinese_simp emma_taming_2_c9aafc1d_1:

    # luna "[emma] looked really beautiful in that..."
    luna "[emma]穿那件真的很漂亮……"

# game/scripts/Locations/bar.rpy:1197
translate chinese_simp emma_taming_2_ecb4b325_1:

    # think "Yeah she did..."
    think "是啊……真的美……"

# game/scripts/Locations/bar.rpy:1198
translate chinese_simp emma_taming_2_2b81b4fc_1:

    # luna "She seemed really uncomfortable, you should say something next time."
    luna "她看起来不太自在，下次你该主动说点什么。"

# game/scripts/Locations/bar.rpy:1199
translate chinese_simp emma_taming_2_202e9823_1:

    # think "Yeah, yeah..."
    think "好好好……"

# game/scripts/Locations/bar.rpy:1202
translate chinese_simp emma_taming_2_f5fe702d_1:

    # ava "These are more our styles~"
    ava "这些更适合我们~"

# game/scripts/Locations/bar.rpy:1203
translate chinese_simp emma_taming_2_b8fcbd05_1:

    # ava "Even though [emma] doesn't really agree, had to drag her out here..."
    ava "虽然[emma]不太情愿，我还是硬把她拉出来了……"

# game/scripts/Locations/bar.rpy:1204
translate chinese_simp emma_taming_2_5d348c55_1:

    # ava "Doesn't seem like the biggest fan of that shirt."
    ava "看起来她不太喜欢那件上衣。"

# game/scripts/Locations/bar.rpy:1205
translate chinese_simp emma_taming_2_c36c9857_1:

    # player "I think she looks amazing in it..."
    player "我觉得她穿那件很好看……"

# game/scripts/Locations/bar.rpy:1208
translate chinese_simp emma_taming_2_e9603c8f_1:

    # ava "Right?"
    ava "是吧？"

# game/scripts/Locations/bar.rpy:1209
translate chinese_simp emma_taming_2_2d698981_1:

    # emma "Th-thank you..."
    emma "谢、谢谢……"

# game/scripts/Locations/bar.rpy:1212
translate chinese_simp emma_taming_2_ab9054cc_1:

    # ava "She fills it out perfectly~"
    ava "她穿起来身材曲线完美~"

# game/scripts/Locations/bar.rpy:1213
translate chinese_simp emma_taming_2_444af8de_1:

    # ava "Let's go change back, we're buying these, right?"
    ava "我们去换回来吧，我们就买这些了，对吧？"

# game/scripts/Locations/bar.rpy:1216
translate chinese_simp emma_taming_2_fa6bbd80_1:

    # emma "Yes."
    emma "嗯。"

# game/scripts/Locations/bar.rpy:1219
translate chinese_simp emma_taming_2_8445fe56_1:

    # luna "That was a quick 'Yes', told you complimenting her would do you good~"
    luna "这个‘嗯’答应得可真快。我说了吧，夸她肯定没坏处~"

# game/scripts/Locations/bar.rpy:1224
translate chinese_simp emma_taming_2_12dd93dc:

    # ava "What are you guys having?"
    ava "你们要吃什么？"

# game/scripts/Locations/bar.rpy:1225
translate chinese_simp emma_taming_2_b5a736d8:

    # ava "I can't decide..."
    ava "我选不出来……"

# game/scripts/Locations/bar.rpy:1226
translate chinese_simp emma_taming_2_b8273e58:

    # player "I'll probably just have some pasta, nothing fancy..."
    player "我大概就点个意面吧，简单点……"

# game/scripts/Locations/bar.rpy:1227
translate chinese_simp emma_taming_2_5496fd5f:

    # ava "Might have to go with that as well..."
    ava "我可能也得点一样的了……"

# game/scripts/Locations/bar.rpy:1230
translate chinese_simp emma_taming_2_301ff188:

    # ava "What about you?"
    ava "你呢？"

# game/scripts/Locations/bar.rpy:1231
translate chinese_simp emma_taming_2_9fda31ea:

    # emma "I'll have that too."
    emma "我也来一样的。"

# game/scripts/Locations/bar.rpy:1232
translate chinese_simp emma_taming_2_89cc4755:

    # player "I guess you also couldn't pick from the menu..?"
    player "你也选不出来是吧……？"

# game/scripts/Locations/bar.rpy:1235
translate chinese_simp emma_taming_2_87bd26d4:

    # emma "Yeah..."
    emma "嗯……"

# game/scripts/Locations/bar.rpy:1238
translate chinese_simp emma_taming_2_225621e4:

    # ava "It does look good..."
    ava "看起来确实不错……"

# game/scripts/Locations/bar.rpy:1239
translate chinese_simp emma_taming_2_2f303233:

    # player "Hard to go wrong with pasta..."
    player "意面一般不会踩雷……"

# game/scripts/Locations/bar.rpy:1242
translate chinese_simp emma_taming_2_74ade54a:

    # ava "That's true."
    ava "那倒是。"

# game/scripts/Locations/bar.rpy:1245
translate chinese_simp emma_taming_2_9790f725:

    # ava "That was good..."
    ava "真好吃……"

# game/scripts/Locations/bar.rpy:1246
translate chinese_simp emma_taming_2_1706ed55:

    # ava "Food tastes so much better if you're the customer~"
    ava "自己当顾客的时候，感觉食物都更好吃了~"

# game/scripts/Locations/bar.rpy:1249
translate chinese_simp emma_taming_2_4d0e9660:

    # ava "We still got half the day left..."
    ava "我们还有半天时间……"

# game/scripts/Locations/bar.rpy:1250
translate chinese_simp emma_taming_2_5cd026fb:

    # ava "You guys wanna head back to the bar and chill there a bit?"
    ava "要不要回酒吧去待会儿？"

# game/scripts/Locations/bar.rpy:1251
translate chinese_simp emma_taming_2_c86af14a:

    # player "I'd be down for that."
    player "我没问题。"

# game/scripts/Locations/bar.rpy:1254
translate chinese_simp emma_taming_2_d34772ef:

    # emma "Me too..."
    emma "我也是……"

# game/scripts/Locations/bar.rpy:1257
translate chinese_simp emma_taming_2_1af8015e:

    # ava "Oh, man... We haven't had this much fun since we were kids!"
    ava "天哪……我们从小到现在都没这么开心过！"

# game/scripts/Locations/bar.rpy:1258
translate chinese_simp emma_taming_2_06d86a57:

    # emma "I remember Dad taking us to the pool when he first opened the bar..."
    emma "我记得爸爸刚开酒吧的时候，带我们去游泳池玩过……"

# game/scripts/Locations/bar.rpy:1261
translate chinese_simp emma_taming_2_68ee4579:

    # ava "Oh, yeah... I kinda miss those family days if I'm honest..."
    ava "哦，是啊……说实话，我有点怀念那些家庭时光……"

# game/scripts/Locations/bar.rpy:1262
translate chinese_simp emma_taming_2_e3c9628d:

    # emma "We can still have them with Mom..."
    emma "我们还可以和妈妈一起享受啊……"

# game/scripts/Locations/bar.rpy:1265
translate chinese_simp emma_taming_2_8b083a62:

    # ava "Don't get me started on her... It's gonna be a while before I go anywhere with her."
    ava "别跟我提她……我要过很久才会跟她一起出门。"

# game/scripts/Locations/bar.rpy:1266
translate chinese_simp emma_taming_2_337ed8f4:

    # emma "She's really trying to show how much she cares."
    emma "她真的在努力证明她有多在乎我们。"

# game/scripts/Locations/bar.rpy:1267
translate chinese_simp emma_taming_2_b834fcd4:

    # ava "I know, but after abandoning us for 20 years, I think she has to spend quite a bit more time trying."
    ava "我知道。但她抛弃了我们二十年，我觉得她需要花更长的时间来弥补。"

# game/scripts/Locations/bar.rpy:1268
translate chinese_simp emma_taming_2_6881ca6a:

    # ava "She probably wouldn't even be here if the bar didn't get as successful as it did."
    ava "如果酒吧不是这么成功的话，她可能根本就不会出现。"

# game/scripts/Locations/bar.rpy:1271
translate chinese_simp emma_taming_2_8827eafd:

    # emma "You don't know that..."
    emma "你又不知道……"

# game/scripts/Locations/bar.rpy:1274
translate chinese_simp emma_taming_2_4128a86e:

    # ava "Whatever, let's not argue about that again."
    ava "算了，我们别再为这个吵了。"

# game/scripts/Locations/bar.rpy:1275
translate chinese_simp emma_taming_2_7eba9923:

    # emma "You're right..."
    emma "你说得对……"

# game/scripts/Locations/bar.rpy:1278
translate chinese_simp emma_taming_2_1e008891:

    # ava "Hey, [player]."
    ava "嘿，[player]。"

# game/scripts/Locations/bar.rpy:1279
translate chinese_simp emma_taming_2_2a07d104:

    # ava "Did you notice the looks we got today?"
    ava "你注意到今天那些人的眼神了吗？"

# game/scripts/Locations/bar.rpy:1280
translate chinese_simp emma_taming_2_93d76aac:

    # emma "Because of him being a human?"
    emma "因为他是人类吗？"

# game/scripts/Locations/bar.rpy:1281
translate chinese_simp emma_taming_2_dd427c76:

    # ava "Probably us being bunny girls."
    ava "大概是因为我们是兔娘吧。"

# game/scripts/Locations/bar.rpy:1284
translate chinese_simp emma_taming_2_dc6ef25c:

    # ava "I wonder what they must've been thinking..."
    ava "不知道他们当时在想什么……"

# game/scripts/Locations/bar.rpy:1287
translate chinese_simp emma_taming_2_f7781909:

    # ava "Seeing 2 bunny girls with a human~"
    ava "看到两个兔娘和一个人类在一起~"

# game/scripts/Locations/bar.rpy:1288
translate chinese_simp emma_taming_2_20656362:

    # player "You don't care about that?"
    player "你不在乎吗？"

# game/scripts/Locations/bar.rpy:1291
translate chinese_simp emma_taming_2_8772ec19:

    # ava "Nah, it doesn't bother me, they can think whatever they want."
    ava "不在乎，他们爱怎么想怎么想。"

# game/scripts/Locations/bar.rpy:1292
translate chinese_simp emma_taming_2_15c2eef5:

    # ava "I bet you don't mind either."
    ava "你肯定也不介意吧。"

# game/scripts/Locations/bar.rpy:1295
translate chinese_simp emma_taming_2_4f729294:

    # ava "What about you, [emma]?"
    ava "你呢，[emma]？"

# game/scripts/Locations/bar.rpy:1296
translate chinese_simp emma_taming_2_0fb17b5f:

    # emma "I don't know..."
    emma "我不知道……"

# game/scripts/Locations/bar.rpy:1297
translate chinese_simp emma_taming_2_15df2ef4:

    # ava "Well. It's either that, or you hide who you are when going out."
    ava "那要么接受，要么你出门的时候就得隐藏身份。"

# game/scripts/Locations/bar.rpy:1300
translate chinese_simp emma_taming_2_c6a7b942:

    # emma "I'm fine with it then..."
    emma "那我选择接受吧……"

# game/scripts/Locations/bar.rpy:1301
translate chinese_simp emma_taming_2_52b1d42b:

    # ava "Thought you'd be."
    ava "我就知道。"

# game/scripts/Locations/bar.rpy:1308
translate chinese_simp emma_taming_2_09142292:

    # ava "Today really was great though..."
    ava "不过今天真的很开心……"

# game/scripts/Locations/bar.rpy:1309
translate chinese_simp emma_taming_2_1b174289:

    # ava "Never thought we'd see the bar grow this much..."
    ava "真没想到酒吧能发展成这样……"

# game/scripts/Locations/bar.rpy:1310
translate chinese_simp emma_taming_2_7c68c832:

    # emma "Dad would be proud of it..."
    emma "爸爸一定会为此感到骄傲……"

# game/scripts/Locations/bar.rpy:1311
translate chinese_simp emma_taming_2_2d9be260:

    # ava "Yeah... I'm glad we're able to carry on something he put so much work into..."
    ava "是啊……很高兴我们能继承他倾注了这么多心血的事业……"

# game/scripts/Locations/bar.rpy:1314
translate chinese_simp emma_taming_2_e98c5ac2:

    # ava "We couldn't do it without you of course."
    ava "当然，没有你的话我们做不到。"

# game/scripts/Locations/bar.rpy:1315
translate chinese_simp emma_taming_2_ee3259a2:

    # ava "We're very grateful for everything you do."
    ava "我们非常感谢你所做的一切。"

# game/scripts/Locations/bar.rpy:1316
translate chinese_simp emma_taming_2_4b4dbf82:

    # player "I'm just glad I'm able to help when possible."
    player "我只是很高兴能在力所能及的时候帮上忙。"

# game/scripts/Locations/bar.rpy:1319
translate chinese_simp emma_taming_2_c7bca759:

    # ava "Stay as humble as you want, but this bar is now just as much yours as is ours."
    ava "你想怎么谦虚都行，但这间酒吧现在跟你和跟我们的关系一样大。"

# game/scripts/Locations/bar.rpy:1320
translate chinese_simp emma_taming_2_b8d972d3:

    # ava "Legally speaking as well~"
    ava "法律上也是哦~"

# game/scripts/Locations/bar.rpy:1323
translate chinese_simp emma_taming_2_49b516d2:

    # emma "I'm glad it's us three..."
    emma "我很高兴是我们三个人……"

# game/scripts/Locations/bar.rpy:1324
translate chinese_simp emma_taming_2_a2c936d5:

    # ava "Don't worry, we won't be adding anyone else to that list."
    ava "放心，我们不会再加别人进来了。"

# game/scripts/Locations/bar.rpy:1327
translate chinese_simp emma_taming_2_02827c78:

    # ava "We should do something like this again~"
    ava "我们应该再来一次~"

# game/scripts/Locations/bar.rpy:1330
translate chinese_simp emma_taming_2_abe86fc8:

    # emma "But we have to close the bar for the whole day for it..."
    emma "但那样的话酒吧就得全天歇业了……"

# game/scripts/Locations/bar.rpy:1331
translate chinese_simp emma_taming_2_869f9130:

    # ava "Is that so bad? We can afford to take some days off."
    ava "那样不好吗？我们现在休几天假还是可以的。"

# game/scripts/Locations/bar.rpy:1332
translate chinese_simp emma_taming_2_a06b7c6c:

    # emma "I guess that's true... We just can't get too lazy..."
    emma "也是……但也不能太懒散了……"

# game/scripts/Locations/bar.rpy:1335
translate chinese_simp emma_taming_2_cb328fc8:

    # ava "Yeah, yeah... I know what you mean..."
    ava "好好好……我知道你的意思……"

# game/scripts/Locations/bar.rpy:1347
translate chinese_simp hire_waitress_b8006e3b:

    # think "Only saw one standing outside... [ava] even prepared the questions for me..."
    think "只看到一个站在外面……[ava]连面试问题都帮我准备好了……"

# game/scripts/Locations/bar.rpy:1348
translate chinese_simp hire_waitress_8cb92d11:

    # think "I guess this is really short notice, so only one showed up... I hope she's normal and I can hire her right away."
    think "大概是通知得太急了，所以只来了一个……希望她没问题，能直接录用。"

# game/scripts/Locations/bar.rpy:1351
translate chinese_simp hire_waitress_afae5222:

    # player "Nice to meet you..."
    player "很高兴认识你……"

# game/scripts/Locations/bar.rpy:1352
translate chinese_simp hire_waitress_20fbe717:

    # nora "[nora]."
    nora "[nora]。"

# game/scripts/Locations/bar.rpy:1353
translate chinese_simp hire_waitress_24bb59b2:

    # player "Can you tell me a little about yourself?"
    player "能简单介绍一下你自己吗？"

# game/scripts/Locations/bar.rpy:1354
translate chinese_simp hire_waitress_d9adb3af:

    # nora "Oh, sure. I've been waitressing on and off for a couple of years. It's busy, but I like keeping on my toes. Makes the day go faster, you know?"
    nora "哦，当然。我断断续续做服务员有几年了。工作挺忙的，但我喜欢忙起来的感觉。这样时间过得快，你懂吧？"

# game/scripts/Locations/bar.rpy:1355
translate chinese_simp hire_waitress_5bdaad63:

    # player "Why are you interested in working as a waitress here?"
    player "你为什么想来这里做服务员？"

# game/scripts/Locations/bar.rpy:1356
translate chinese_simp hire_waitress_31ad4091:

    # nora "I've heard good things about this place. Seems like a friendly spot. I'm just looking for a change of scenery, honestly."
    nora "我听说过这里不错。感觉是个很友好的地方。老实说，我只是想换个环境。"

# game/scripts/Locations/bar.rpy:1357
translate chinese_simp hire_waitress_d5ae526c:

    # player "How do you handle difficult customers?"
    player "你怎么应对难缠的客人？"

# game/scripts/Locations/bar.rpy:1358
translate chinese_simp hire_waitress_775d8fad:

    # nora "Oh, you know, with a smile and a bit of patience. Most times, people are just having a bad day. I try to keep cool and sort things out as best I can."
    nora "哦，你知道的，就是保持微笑，多点耐心。大多数时候，客人只是心情不好而已。我尽量保持冷静，尽量把事情解决好。"

# game/scripts/Locations/bar.rpy:1359
translate chinese_simp hire_waitress_11598ce6:

    # player "We open in the afternoon, and stay open far into the night, would that work for you?"
    player "我们下午开门，营业到深夜，你能适应吗？"

# game/scripts/Locations/bar.rpy:1360
translate chinese_simp hire_waitress_46b20548:

    # nora "Yeah, no problem with that. I'm pretty flexible with my schedule. Weekends, evenings, whatever's needed, I can make it work."
    nora "没问题，我对工作时间很灵活的。周末、晚上，需要怎么排班我都可以。"

# game/scripts/Locations/bar.rpy:1363
translate chinese_simp hire_waitress_06de9011:

    # think "I guess it really was just her that showed up..."
    think "看来真的只有她一个人来面试……"

# game/scripts/Locations/bar.rpy:1364
translate chinese_simp hire_waitress_dc9935da:

    # think "She seems nice... I guess she's got the job."
    think "她看起来还不错……那就她了吧。"

# game/scripts/Locations/bar.rpy:1365
translate chinese_simp hire_waitress_e35bc502:

    # think "If things go bad we can always just fire her and get someone else."
    think "要是之后不合适，再辞退她换人就行了。"

# game/scripts/Locations/bar.rpy:1366
translate chinese_simp hire_waitress_20a874a9:

    # think "There should be more applicants in the future with the bar growing this fast."
    think "酒吧发展得这么快，以后肯定会有更多人来应聘的。"

# game/scripts/Locations/bar.rpy:1370
translate chinese_simp hire_waitress_eb9d6312:

    # player "[nora], we'd like to offer you the position."
    player "[nora]，我们想录用你。"

# game/scripts/Locations/bar.rpy:1374
translate chinese_simp hire_waitress_d583b5e5:

    # nora "Really? That's great! I'm excited to start."
    nora "真的吗？太棒了！我很期待开始工作。"

# game/scripts/Locations/bar.rpy:1375
translate chinese_simp hire_waitress_88f14352:

    # nora "I promise, you won't regret this. When do I begin?"
    nora "我保证你不会后悔的。我什么时候开始上班？"

# game/scripts/Locations/bar.rpy:1376
translate chinese_simp hire_waitress_30c7cf09:

    # player "You can show up today a bit before we open in the afternoon, [ava] will show you around when you arrive."
    player "你今天下午开门前一点过来就行，到时候[ava]会带你熟悉环境。"

# game/scripts/Locations/bar.rpy:1377
translate chinese_simp hire_waitress_5b156227:

    # nora "That sounds great. I'll be here."
    nora "好的。我会准时到的。"

# game/scripts/Locations/bar.rpy:1388
translate chinese_simp ava_taming_3_ac964250:

    # ava "I'm really starting to like [nora]."
    ava "我越来越喜欢[nora]了。"

# game/scripts/Locations/bar.rpy:1389
translate chinese_simp ava_taming_3_52db879e:

    # ava "It's really nice to have another person helping with the tables..."
    ava "能有另一个人帮忙招呼客人真是太好了……"

# game/scripts/Locations/bar.rpy:1390
translate chinese_simp ava_taming_3_0800d7d9:

    # player "How's she doing so far?"
    player "她干得怎么样？"

# game/scripts/Locations/bar.rpy:1391
translate chinese_simp ava_taming_3_fd5ca52c:

    # ava "Pretty good, she's getting the hang of this place, and she's starting to warm up to [emma] too."
    ava "挺好的，她已经慢慢上手了，而且也开始和[emma]熟络起来了。"

# game/scripts/Locations/bar.rpy:1392
translate chinese_simp ava_taming_3_8c2fc438:

    # ava "But she's still getting used to working through most of the night and having to sleep in the morning."
    ava "但她还在适应熬夜工作和早上睡觉的作息。"

# game/scripts/Locations/bar.rpy:1393
translate chinese_simp ava_taming_3_361805f5:

    # ava "She's even slept over in the guest room once. I'm glad I talked [emma] out of giving that room to [katherine]..."
    ava "她还在客房住过一次。幸好我说服了[emma]没把那间房给[katherine]……"

# game/scripts/Locations/bar.rpy:1394
translate chinese_simp ava_taming_3_876bf2fd:

    # ava "But yeah, I think she's gonna fit in here just fine."
    ava "总之，我觉得她会很适应这里的。"

# game/scripts/Locations/bar.rpy:1395
translate chinese_simp ava_taming_3_a48936c5:

    # player "That's great to hear, nice knowing I chose the right person."
    player "那就好，看来我没选错人。"

# game/scripts/Locations/bar.rpy:1399
translate chinese_simp ava_taming_3_be856b74:

    # ava "On the subject of choosing... The kitchen just got done, so we need a cook."
    ava "说到选人……厨房刚建好，我们需要一个厨师。"

# game/scripts/Locations/bar.rpy:1400
translate chinese_simp ava_taming_3_3939d3d2:

    # player "I'm guessing you put up the ad already?"
    player "你已经贴出招聘广告了？"

# game/scripts/Locations/bar.rpy:1401
translate chinese_simp ava_taming_3_f5bce890:

    # ava "No, this time we already got someone in mind, I told her to come over in the morning, so you can interview her."
    ava "这次我们心里已经有人选了，我让她早上过来，到时候你来面试。"

# game/scripts/Locations/bar.rpy:1402
translate chinese_simp ava_taming_3_4cba9a4c:

    # player "That's no problem. Who is she though?"
    player "没问题。不过她是谁？"

# game/scripts/Locations/bar.rpy:1406
translate chinese_simp ava_taming_3_b887c053:

    # ava "She's an old friend from culinary school. While me and [emma] were there to become waitresses, she was studying to be a cook."
    ava "她是我们在烹饪学校的老朋友。我和[emma]当时是去学当服务员的，她是去学厨师的。"

# game/scripts/Locations/bar.rpy:1407
translate chinese_simp ava_taming_3_1ec69139:

    # ava "We got along really well, so she was the first that came to mind."
    ava "我们那时候关系很好，所以我一有需要第一个就想到了她。"

# game/scripts/Locations/bar.rpy:1408
translate chinese_simp ava_taming_3_df331415:

    # player "That makes sense, so she pretty much has the job? I don't need to worry about an extensive interview?"
    player "这倒也是，所以她基本上就已经被录用了？我不需要做什么深入的面试了吧？"

# game/scripts/Locations/bar.rpy:1409
translate chinese_simp ava_taming_3_50bab3bd:

    # ava "She'd have to say some really weird stuff to fail it... It's more of just having her meet you and seeing if she'd fit in with us."
    ava "她得说些很离谱的话才会不被录用……其实就是让她见见你，看你俩合不合得来。"

# game/scripts/Locations/bar.rpy:1410
translate chinese_simp ava_taming_3_81aa9d54:

    # player "Gotcha."
    player "明白了。"

# game/scripts/Locations/bar.rpy:1423
translate chinese_simp hire_cook_081fc0b9:

    # leah "Nice to meet you, I'm [leah]. You must be the new co-owner [ava] told me about."
    leah "你好，我是[leah]。你肯定就是[ava]跟我提到的那位新合伙人吧。"

# game/scripts/Locations/bar.rpy:1424
translate chinese_simp hire_cook_2dacc0d0:

    # player "Yeah, that's me, nice to meet you."
    player "对，是我，很高兴认识你。"

# game/scripts/Locations/bar.rpy:1428
translate chinese_simp hire_cook_910c7de1:

    # player "I just have a few questions before I can offer you the job."
    player "在正式录用你之前，我有几个问题想问。"

# game/scripts/Locations/bar.rpy:1429
translate chinese_simp hire_cook_6b474587:

    # leah "I understand, most of the time knowing someone can only get you half of the way there."
    leah "我理解。很多时候，认识人也只能让你走一半的路。"

# game/scripts/Locations/bar.rpy:1430
translate chinese_simp hire_cook_0f97f4f5:

    # player "Have you worked in the kitchen before?"
    player "你有厨房工作经验吗？"

# game/scripts/Locations/bar.rpy:1431
translate chinese_simp hire_cook_5dfe03ba:

    # leah "Yes, that's been my job for the past four years."
    leah "有，过去四年我一直都在厨房工作。"

# game/scripts/Locations/bar.rpy:1432
translate chinese_simp hire_cook_c9f34f32:

    # player "Was it a small kitchen? And what was your role?"
    player "那是间小厨房吗？你当时负责什么？"

# game/scripts/Locations/bar.rpy:1436
translate chinese_simp hire_cook_094cbc9e:

    # leah "It wasn't. There were 8 of us working at the same time."
    leah "不算小。我们同时有8个人在工作。"

# game/scripts/Locations/bar.rpy:1437
translate chinese_simp hire_cook_c59b393c:

    # leah "My first role was washing the dishes, it's what everyone fresh from school does."
    leah "我刚进去的时候是负责洗碗的，每个刚毕业的新手都是这么开始的。"

# game/scripts/Locations/bar.rpy:1438
translate chinese_simp hire_cook_eebb40ac:

    # leah "Over the years I worked my way up to being a chef."
    leah "经过几年的努力，我一步步升到了主厨的位置。"

# game/scripts/Locations/bar.rpy:1439
translate chinese_simp hire_cook_6750fbb4:

    # player "Sounds like it's going well for you there, how come you're looking for another job?"
    player "听起来你在那里发展得不错，怎么想到换工作呢？"

# game/scripts/Locations/bar.rpy:1443
translate chinese_simp hire_cook_2629c147:

    # leah "There are two reasons, the first being the schedule, we work 16 hours every second day, and we're free on others."
    leah "有两个原因。第一是排班问题，我们隔一天就要连续工作16个小时，不上班的时候倒是空的。"

# game/scripts/Locations/bar.rpy:1444
translate chinese_simp hire_cook_bbee64b3:

    # leah "It might sound good at first, but over time you really start dreading working for that long."
    leah "一开始听起来可能还不错，但时间久了，你真的很害怕要连续工作那么长时间。"

# game/scripts/Locations/bar.rpy:1445
translate chinese_simp hire_cook_fdf288ff:

    # player "I can see that being the case yeah..."
    player "这我完全可以理解……"

# game/scripts/Locations/bar.rpy:1449
translate chinese_simp hire_cook_03dddab0:

    # leah "The second reason is [emma] and [ava], I'd have to have a really important job to decline an offer from them."
    leah "第二个原因是[emma]和[ava]。除非我有了一份特别重要的工作，不然我是不会拒绝她们的邀请的。"

# game/scripts/Locations/bar.rpy:1450
translate chinese_simp hire_cook_24d097d5:

    # player "[ava] did say you're really good friends..."
    player "[ava]确实说过你们是很好的朋友……"

# game/scripts/Locations/bar.rpy:1451
translate chinese_simp hire_cook_e2058a5b:

    # player "You'd be the only chef in this kitchen, for quite a while, are you fine with that?"
    player "在接下来很长一段时间里，你都会是这间厨房里唯一的厨师，你没问题吧？"

# game/scripts/Locations/bar.rpy:1455
translate chinese_simp hire_cook_7feb1655:

    # leah "I got no problem with it, I work fine on my own, and I'm capable of doing everything in the kitchen myself."
    leah "没问题，我一个人也能做得很好，而且厨房里所有事情我自己都能搞定。"

# game/scripts/Locations/bar.rpy:1456
translate chinese_simp hire_cook_5c533bad:

    # player "That's great to hear."
    player "那就好。"

# game/scripts/Locations/bar.rpy:1457
translate chinese_simp hire_cook_7f6878a1:

    # player "As a last thing, I should mention, you'd be making mostly pizza, at least for now, we'll probably increase the size of the menu later."
    player "最后一点，我要说明一下，你主要负责做披萨，至少现阶段是这样。我们之后可能会扩大菜单。"

# game/scripts/Locations/bar.rpy:1458
translate chinese_simp hire_cook_41332634:

    # leah "That's not a problem, I've made it before, so I'm sure I'll get used to it pretty fast."
    leah "没问题，我以前也做过，所以应该很快就能上手。"

# game/scripts/Locations/bar.rpy:1459
translate chinese_simp hire_cook_27bfe9af:

    # player "Okay, that should be everything. I think I can offer you the job right away, welcome."
    player "好，那应该没别的问题了。我想可以直接录用你，欢迎加入。"

# game/scripts/Locations/bar.rpy:1463
translate chinese_simp hire_cook_5227a307:

    # leah "Awesome! I can't wait to start. When can I stop by?"
    leah "太好了！我都等不及要开始了。我什么时候过来上班？"

# game/scripts/Locations/bar.rpy:1464
translate chinese_simp hire_cook_15bd32b0:

    # player "Since you know [ava] and [emma], you can go talk to them right away, they're in the back."
    player "你反正也认识[ava]和[emma]，直接去后面找她们就行。"

# game/scripts/Locations/bar.rpy:1465
translate chinese_simp hire_cook_4e2708b9:

    # leah "Will do."
    leah "好的。"

# game/scripts/Locations/bar.rpy:1475
translate chinese_simp emma_taming_3_503d3fe1:

    # ava "Hey, [player]!"
    ava "嘿，[player]！"

# game/scripts/Locations/bar.rpy:1476
translate chinese_simp emma_taming_3_19cee3af:

    # ava "Could you do me a favor?"
    ava "能帮我个忙吗？"

# game/scripts/Locations/bar.rpy:1477
translate chinese_simp emma_taming_3_7e5e05b6:

    # player "Sure, what's up?"
    player "可以啊，什么事？"

# game/scripts/Locations/bar.rpy:1480
translate chinese_simp emma_taming_3_d1c3c6f1:

    # ava "As you can see we're getting pretty busy..."
    ava "你也看到了，我们现在越来越忙了……"

# game/scripts/Locations/bar.rpy:1483
translate chinese_simp emma_taming_3_0d1ef5d8:

    # ava "We need some emergency supplies for the kitchen."
    ava "厨房需要紧急补一些货。"

# game/scripts/Locations/bar.rpy:1484
translate chinese_simp emma_taming_3_58cdaabd:

    # ava "I was planning on going with [emma]..."
    ava "我本来打算和[emma]一起去的……"

# game/scripts/Locations/bar.rpy:1487
translate chinese_simp emma_taming_3_981593da:

    # ava "But now that you're here, you two can go instead!"
    ava "不过既然你来了，那就你俩去吧！"

# game/scripts/Locations/bar.rpy:1488
translate chinese_simp emma_taming_3_74490e30:

    # player "Sure, I don't mind going..."
    player "行啊，我不介意跑一趟……"

# game/scripts/Locations/bar.rpy:1491
translate chinese_simp emma_taming_3_d320c28f:

    # ava "Great!"
    ava "太好了！"

# game/scripts/Locations/bar.rpy:1492
translate chinese_simp emma_taming_3_b0dcf16a:

    # emma "You ready?"
    emma "你准备好了吗？"

# game/scripts/Locations/bar.rpy:1495
translate chinese_simp emma_taming_3_40324bdc:

    # ava "Was about to go change, but [player] showed up."
    ava "我本来都准备去换衣服了，但[player]来了。"

# game/scripts/Locations/bar.rpy:1496
translate chinese_simp emma_taming_3_09d16f12:

    # ava "You two can go instead!"
    ava "你们两个替我跑一趟吧！"

# game/scripts/Locations/bar.rpy:1497
translate chinese_simp emma_taming_3_6e5e6492:

    # ava "Oh, I see you put on the new outfit... You look really cute~"
    ava "哦，我看到你穿新衣服了……真可爱~"

# game/scripts/Locations/bar.rpy:1500
translate chinese_simp emma_taming_3_af27a579:

    # emma "Just the two of us..?"
    emma "就我们两个……？"

# game/scripts/Locations/bar.rpy:1501
translate chinese_simp emma_taming_3_dd084dd8:

    # ava "Yes... It's not a big deal..."
    ava "是啊……没什么大不了的……"

# game/scripts/Locations/bar.rpy:1502
translate chinese_simp emma_taming_3_1e135389:

    # ava "We've been out together before."
    ava "我们之前也一起出去过啊。"

# game/scripts/Locations/bar.rpy:1505
translate chinese_simp emma_taming_3_d6807404:

    # ava "Plus. This time it's not a shopping trip, you're just quickly going to the store for a few supplies."
    ava "而且这次不是去逛街，就是快去快回买点东西而已。"

# game/scripts/Locations/bar.rpy:1506
translate chinese_simp emma_taming_3_8478fe95:

    # emma "Okay... I'm ready to go..."
    emma "好吧……我准备好了……"

# game/scripts/Locations/bar.rpy:1510
translate chinese_simp emma_taming_3_93b67328:

    # player "What are we here to pick up?"
    player "我们要来买什么？"

# game/scripts/Locations/bar.rpy:1511
translate chinese_simp emma_taming_3_2929792a:

    # emma "A few things for the kitchen..."
    emma "厨房里要用的东西……"

# game/scripts/Locations/bar.rpy:1512
translate chinese_simp emma_taming_3_55072fdc:

    # emma "Things we'll run out of before they can be delivered in a few days."
    emma "一些等不到几天后送货就会用完的东西。"

# game/scripts/Locations/bar.rpy:1513
translate chinese_simp emma_taming_3_b31833de:

    # player "Ah, okay... That shouldn't take long then."
    player "啊，好的……那应该很快就能搞定。"

# game/scripts/Locations/bar.rpy:1516
translate chinese_simp emma_taming_3_cbfe2e36:

    # player "We basically ran to the store, how come you're in such a hurry?"
    player "我们简直是跑去店的，你怎么这么着急？"

# game/scripts/Locations/bar.rpy:1519
translate chinese_simp emma_taming_3_ed6540f6:

    # emma "I don't want [ava] to have to work instead of me..."
    emma "我不想让[ava]一个人忙不过来……"

# game/scripts/Locations/bar.rpy:1520
translate chinese_simp emma_taming_3_8ebde985:

    # player "That's kinda sweet of you~"
    player "你还挺贴心的~"

# game/scripts/Locations/bar.rpy:1523
translate chinese_simp emma_taming_3_fe3bba7c:

    # emma "It is..?"
    emma "有吗……？"

# game/scripts/Locations/bar.rpy:1524
translate chinese_simp emma_taming_3_73c94569:

    # player "Yeah, but you worry too much, [ava]'s got [nora] and [leah] there now."
    player "是啊。不过你也太担心了，[ava]现在有[nora]和[leah]帮忙了。"

# game/scripts/Locations/bar.rpy:1525
translate chinese_simp emma_taming_3_15c17072:

    # player "You two aren't alone anymore..."
    player "你们俩现在已经不是孤军奋战了……"

# game/scripts/Locations/bar.rpy:1526
translate chinese_simp emma_taming_3_019c0702:

    # player "I'm also here for whatever either of you needs~"
    player "而且不管你们谁有需要，我都在~"

# game/scripts/Locations/bar.rpy:1529
translate chinese_simp emma_taming_3_93ae4ac4:

    # emma "Thank you."
    emma "谢谢你。"

# game/scripts/Locations/bar.rpy:1530
translate chinese_simp emma_taming_3_2e06b861:

    # luna "Looks like you're slowly getting to her..."
    luna "看来你在慢慢走进她心里了……"

# game/scripts/Locations/bar.rpy:1540
translate chinese_simp ava_taming_4_e4ca2ffc:

    # ava "Not much left to do. We just need a good way to let people know we got food now."
    ava "剩下要做的事不多了。我们只需要一个好的方法，让大家知道我们现在有吃的了。"

# game/scripts/Locations/bar.rpy:1541
translate chinese_simp ava_taming_4_97e9a168:

    # player "Not that many different ways to do that."
    player "能用的方法其实也就那些。"

# game/scripts/Locations/bar.rpy:1542
translate chinese_simp ava_taming_4_55c546bf:

    # player "Most will get around by word of mouth, but we can help with a few posters around town."
    player "大多数人会通过口口相传得知消息，但我们可以在镇上贴一些海报帮忙宣传。"

# game/scripts/Locations/bar.rpy:1543
translate chinese_simp ava_taming_4_41b8b46c:

    # ava "That could work, but we need a good design, and I have no idea how to draw something like that..."
    ava "可以是可以，但我们需要好的设计，我完全不知道怎么画那种东西……"

# game/scripts/Locations/bar.rpy:1544
translate chinese_simp ava_taming_4_67406aef:

    # player "I can take care of that."
    player "我可以搞定。"

# game/scripts/Locations/bar.rpy:1548
translate chinese_simp ava_taming_4_df408f82:

    # ava "You can?"
    ava "你行吗？"

# game/scripts/Locations/bar.rpy:1549
translate chinese_simp ava_taming_4_525a59d3:

    # player "Of course! If you got some pens in the apartment, I can draw a rough sketch right now."
    player "当然！你公寓里要是有笔的话，我现在就能画个草稿出来。"

# game/scripts/Locations/bar.rpy:1550
translate chinese_simp ava_taming_4_df2f3841:

    # ava "That would be amazing! Follow me."
    ava "那太好了！跟我来。"

# game/scripts/Locations/bar.rpy:1553
translate chinese_simp ava_taming_4_1098d1ab:

    # narrator "You draw a sketch of a poster advertising the bar and the fact you now welcome families and serve food."
    narrator "你画了一张宣传酒吧的海报草稿，上面写明了本店现在欢迎家庭聚餐并提供餐饮服务。"

# game/scripts/Locations/bar.rpy:1558
translate chinese_simp ava_taming_4_7b84e79c:

    # ava "This looks amazing! This would even get {i}me{/i} to come eat here!"
    ava "太棒了！就连我都想来这里吃饭了！"

# game/scripts/Locations/bar.rpy:1559
translate chinese_simp ava_taming_4_a5ef8b13:

    # ava "And it's just a sketch! Can't imagine how good it's gonna look after it's finished!"
    ava "而且这还只是草图！等成品出来肯定更好看！"

# game/scripts/Locations/bar.rpy:1563
translate chinese_simp ava_taming_4_69f265d8:

    # ava "I'm so happy right now I could literally kiss you!"
    ava "我现在开心得恨不得亲你一口！"

# game/scripts/Locations/bar.rpy:1564
translate chinese_simp ava_taming_4_1cb9586e:

    # player "Do you mean that?"
    player "你说真的吗？"

# game/scripts/Locations/bar.rpy:1568
translate chinese_simp ava_taming_4_65b28230:

    # ava "Why'd you get all serious like that? Of course I mean it..."
    ava "你干嘛突然这么严肃？我当然是真的……"

# game/scripts/Locations/bar.rpy:1572
translate chinese_simp ava_taming_4_7eb9a762:

    # player "All jokes aside, do you really mean it?"
    player "不开玩笑地说，你真的这么想吗？"

# game/scripts/Locations/bar.rpy:1573
translate chinese_simp ava_taming_4_8445014d:

    # ava "Where's all this coming from, [player]?"
    ava "[player]，你怎么突然问这个？"

# game/scripts/Locations/bar.rpy:1574
translate chinese_simp ava_taming_4_1a0245c3:

    # player "[ava], do you trust me?"
    player "[ava]，你相信我吗？"

# game/scripts/Locations/bar.rpy:1575
translate chinese_simp ava_taming_4_68694cb4:

    # ava "..."
    ava "……"

# game/scripts/Locations/bar.rpy:1576
translate chinese_simp ava_taming_4_d314ce0d:

    # ava "{size=-10}...yes...{/size}"
    ava "{size=-10}……相信……{/size}"

# game/scripts/Locations/bar.rpy:1577
translate chinese_simp ava_taming_4_9940fa4b:

    # think "I don't think I've ever seen her this lost for words..."
    think "我好像从来没见过她这么语塞……"

# game/scripts/Locations/bar.rpy:1578
translate chinese_simp ava_taming_4_870a9c1a:

    # player "If you really trust me, then I want you to actually kiss me."
    player "如果你真的相信我，那就真的亲我一下。"

# game/scripts/Locations/bar.rpy:1579
translate chinese_simp ava_taming_4_8784aab3:

    # ava "But... I'll..."
    ava "但是……那样我就……"

# game/scripts/Locations/bar.rpy:1580
translate chinese_simp ava_taming_4_567e01c5:

    # think "Do you have a problem with me telling her about this, [luna]?"
    think "我告诉她这件事你有意见吗，[luna]？"

# game/scripts/Locations/bar.rpy:1581
translate chinese_simp ava_taming_4_a751b34e:

    # luna "No... I think we can trust her, I like her..."
    luna "没有……我觉得可以信任她，我喜欢她……"

# game/scripts/Locations/bar.rpy:1582
translate chinese_simp ava_taming_4_3e4a71c8:

    # ava "No. I...I'm okay with this."
    ava "不，我……我没事。"

# game/scripts/Locations/bar.rpy:1587
translate chinese_simp ava_taming_4_e78dc59f:

    # ava "Mmmmmnnnn..."
    ava "嗯嗯嗯嗯……"

# game/scripts/Locations/bar.rpy:1591
translate chinese_simp ava_taming_4_b919f148:

    # ava "I did it..."
    ava "我做到了……"

# game/scripts/Locations/bar.rpy:1595
translate chinese_simp ava_taming_4_c1f69a2d:

    # ava "I kissed you..."
    ava "我亲了你……"

# game/scripts/Locations/bar.rpy:1596
translate chinese_simp ava_taming_4_9b15158e:

    # ava "You're my tamer now..."
    ava "你现在是我的驯服者了……"

# game/scripts/Locations/bar.rpy:1597
translate chinese_simp ava_taming_4_238305e9:

    # player "Do you not want me to be?"
    player "你不想我成为吗？"

# game/scripts/Locations/bar.rpy:1601
translate chinese_simp ava_taming_4_64f36a68:

    # ava "I...I made my choice, and there's no reversing it now..."
    ava "我……我已经做出了选择，现在也无法反悔了……"

# game/scripts/Locations/bar.rpy:1602
translate chinese_simp ava_taming_4_2b21843e:

    # player "Thank you for trusting me... In exchange, I'll trust you back."
    player "谢谢你信任我……作为交换，我也会信任你。"

# game/scripts/Locations/bar.rpy:1605
translate chinese_simp ava_taming_4_0b7d0386:

    # ava "Hmm? Trust me with what?"
    ava "嗯？信任我什么？"

# game/scripts/Locations/bar.rpy:1606
translate chinese_simp ava_taming_4_851d42a9:

    # player "But you can't tell anyone about what I'm going to do..."
    player "但是你不能告诉任何人我要做什么……"

# game/scripts/Locations/bar.rpy:1610
translate chinese_simp ava_taming_4_76142d7e:

    # ava "Wh-What are you planning to do..."
    ava "你、你打算做什么……"

# game/scripts/Locations/bar.rpy:1617
translate chinese_simp ava_taming_4_567e8b1b:

    # ava "Wh-what just happened..?"
    ava "刚、刚才发生了什么……？"

# game/scripts/Locations/bar.rpy:1618
translate chinese_simp ava_taming_4_0cc2a5e8:

    # ava "I feel like my old self again... I..."
    ava "我感觉自己又变回原来的我了……我……"

# game/scripts/Locations/bar.rpy:1619
translate chinese_simp ava_taming_4_2c2e0fe3:

    # player "I untamed you."
    player "我解除对你的驯化了。"

# game/scripts/Locations/bar.rpy:1620
translate chinese_simp ava_taming_4_fd42ccdc:

    # ava "That's not possible..."
    ava "这不可能……"

# game/scripts/Locations/bar.rpy:1621
translate chinese_simp ava_taming_4_8ca8cae8:

    # ava "I was definitely tamed to you... Now I'm back to my normal self again..."
    ava "我明明已经被你驯服了……现在又变回正常了……"

# game/scripts/Locations/bar.rpy:1622
translate chinese_simp ava_taming_4_7051e6c0:

    # player "I don't want you to worry about getting tamed anymore... We can do whatever we want now."
    player "我不想你再为被驯服而担惊受怕……我们现在可以自由地做任何事了。"

# game/scripts/Locations/bar.rpy:1623
translate chinese_simp ava_taming_4_ef4107d6:

    # player "If you ever decide you want to stay tamed... It should be your choice, knowing there's this alternative."
    player "如果将来你决定要保持被驯服状态……那也应该是你自己的选择，而且你知道还有这个选项。"

# game/scripts/Locations/bar.rpy:1627
translate chinese_simp ava_taming_4_0849e69e:

    # ava "Does this mean I don't have to worry about getting tamed? Ever?"
    ava "这是不是说我再也不用担心被驯服了？永远都不用？"

# game/scripts/Locations/bar.rpy:1628
translate chinese_simp ava_taming_4_017a9a81:

    # ava "Or do you have to \"Cancel\" it in a certain period after you do it?"
    ava "还是说你在驯服之后，要在一定时间内才能‘解除’？"

# game/scripts/Locations/bar.rpy:1629
translate chinese_simp ava_taming_4_afb1f81e:

    # player "As far as I know, I can do it whenever."
    player "据我所知，我随时都可以。"

# game/scripts/Locations/bar.rpy:1630
translate chinese_simp ava_taming_4_45850dd7:

    # ava "That's good..."
    ava "那就好……"

# game/scripts/Locations/bar.rpy:1634
translate chinese_simp ava_taming_4_dcc39049:

    # ava "Can I tell [emma] about this?"
    ava "我能告诉[emma]这件事吗？"

# game/scripts/Locations/bar.rpy:1635
translate chinese_simp ava_taming_4_6a5d5a2a:

    # player "Of course, but only [emma], and make sure she doesn't tell anyone else."
    player "当然，但只能告诉[emma]，确保她不会告诉别人。"

# game/scripts/Locations/bar.rpy:1636
translate chinese_simp ava_taming_4_898bced7:

    # player "Already got enough people trying to kill me."
    player "想杀我的人已经够多了。"

# game/scripts/Locations/bar.rpy:1637
translate chinese_simp ava_taming_4_25b13f87:

    # ava "Yeah, that's fair."
    ava "嗯，那倒是。"

# game/scripts/Locations/bar.rpy:1652
translate chinese_simp emma_taming_4_105b1cd2:

    # ava "You're here!"
    ava "你来了！"

# game/scripts/Locations/bar.rpy:1653
translate chinese_simp emma_taming_4_b241da54:

    # player "Why? Did something happen?"
    player "怎么了？出什么事了吗？"

# game/scripts/Locations/bar.rpy:1657
translate chinese_simp emma_taming_4_71f2debf:

    # ava "Not yet, but it's about to, we're hosting quite a big group today."
    ava "还没，但很快就有了，我们今天要接待一个大团。"

# game/scripts/Locations/bar.rpy:1658
translate chinese_simp emma_taming_4_59724a5c:

    # ava "This is the first event of this type we're doing, so we're all a bit nervous..."
    ava "这是我们第一次办这种活动，所以大家都有点紧张……"

# game/scripts/Locations/bar.rpy:1659
translate chinese_simp emma_taming_4_cc46309c:

    # emma "We finally have the space and the food to host something like this..."
    emma "我们终于有空间和食物来办这种活动了……"

# game/scripts/Locations/bar.rpy:1660
translate chinese_simp emma_taming_4_bfda7f29:

    # player "I see... Who are we hosting?"
    player "明白了……来的是什么人？"

# game/scripts/Locations/bar.rpy:1664
translate chinese_simp emma_taming_4_555a2d28:

    # ava "A group of cow girls from the local farm and the farm owner, [sally]."
    ava "一群来自当地农场的牛娘，还有农场主，[sally]。"

# game/scripts/Locations/bar.rpy:1665
translate chinese_simp emma_taming_4_ff0ee583:

    # ava "Do you know her?"
    ava "你认识她吗？"

# game/scripts/Locations/bar.rpy:1667
translate chinese_simp emma_taming_4_d8b176a6:

    # player "Yeah... I met [sally] before..."
    player "嗯……我之前见过[sally]……"

# game/scripts/Locations/bar.rpy:1668
translate chinese_simp emma_taming_4_a879e84b:

    # ava "Oh, cool..."
    ava "哦，不错啊……"

# game/scripts/Locations/bar.rpy:1670
translate chinese_simp emma_taming_4_ba104be0:

    # player "No..."
    player "并不……"

# game/scripts/Locations/bar.rpy:1674
translate chinese_simp emma_taming_4_541f9cd5:

    # ava "Well it doesn't matter anyway, you'll be working the bar today."
    ava "反正也不重要，你今天负责吧台。"

# game/scripts/Locations/bar.rpy:1675
translate chinese_simp emma_taming_4_2eba9ec4:

    # player "What about [emma]?"
    player "那[emma]呢？"

# game/scripts/Locations/bar.rpy:1679
translate chinese_simp emma_taming_4_c9b0affb:

    # ava "She'll be working the tables with me and [nora]."
    ava "她和我、[nora]一起负责餐桌。"

# game/scripts/Locations/bar.rpy:1680
translate chinese_simp emma_taming_4_9723d159:

    # player "Alright..."
    player "好的……"

# game/scripts/Locations/bar.rpy:1684
translate chinese_simp emma_taming_4_838f005f:

    # think "There are quite a few of them..."
    think "人还挺多的……"

# game/scripts/Locations/bar.rpy:1685
translate chinese_simp emma_taming_4_988b4778:

    # think "But I think five of us should be able to handle it."
    think "不过我觉得我们五个人应该能应付得来。"

# game/scripts/Locations/bar.rpy:1689
translate chinese_simp emma_taming_4_b0e37db6:

    # ava "Four beers, yes."
    ava "四杯啤酒，好的。"

# game/scripts/Locations/bar.rpy:1690
translate chinese_simp emma_taming_4_9723d159_1:

    # player "Alright..."
    player "好……"

# game/scripts/Locations/bar.rpy:1694
translate chinese_simp emma_taming_4_f700f109:

    # player "She seems to be doing fine..."
    player "她看起来适应得不错……"

# game/scripts/Locations/bar.rpy:1695
translate chinese_simp emma_taming_4_848de0c7:

    # ava "Yeah, it's not a difficult job... Well, I guess it depends on the person."
    ava "是啊，这活不算难……不过也得看人。"

# game/scripts/Locations/bar.rpy:1699
translate chinese_simp emma_taming_4_6448be9c:

    # ava "We got a long night ahead of us, so we'll see how it goes."
    ava "今晚还长着呢，我们看看情况。"

# game/scripts/Locations/bar.rpy:1707
translate chinese_simp emma_taming_4_9ed6cd68:

    # player "How's it going so far?"
    player "情况怎么样？"

# game/scripts/Locations/bar.rpy:1708
translate chinese_simp emma_taming_4_4b76a1fb:

    # emma "Fine..."
    emma "还好……"

# game/scripts/Locations/bar.rpy:1712
translate chinese_simp emma_taming_4_6567f036:

    # player "If you wanna switch any time through the night, let me know."
    player "如果今晚什么时候你想换班的话，跟我说就行。"

# game/scripts/Locations/bar.rpy:1713
translate chinese_simp emma_taming_4_a25166c0:

    # emma "I'm managing, it's good practice, and it's not as bad as it seemed yesterday..."
    emma "我还撑得住，正好可以练练手，而且也没有昨天看起来那么可怕……"

# game/scripts/Locations/bar.rpy:1714
translate chinese_simp emma_taming_4_789e4c1d:

    # player "Alright, have fun..."
    player "那好，加油……"

# game/scripts/Locations/bar.rpy:1715
translate chinese_simp emma_taming_4_cec9e46d:

    # think "I guess she won't meet any difficult customers today at least..."
    think "至少今天她应该不会遇到难缠的客人吧……"

# game/scripts/Locations/bar.rpy:1719
translate chinese_simp emma_taming_4_567db4b3:

    # ava "It's time to start bringing out the food. We're gonna need your help with this part, [player]."
    ava "该上菜了。这部分需要你帮忙，[player]。"

# game/scripts/Locations/bar.rpy:1720
translate chinese_simp emma_taming_4_aa75ffb7:

    # player "Sure..."
    player "没问题……"

# game/scripts/Locations/bar.rpy:1724
translate chinese_simp emma_taming_4_f319bbbf:

    # ava "[nora], can you handle the two tables outside?"
    ava "[nora]，外面的两张桌子交给你行吗？"

# game/scripts/Locations/bar.rpy:1725
translate chinese_simp emma_taming_4_8da70dd2:

    # nora "Of course."
    nora "没问题。"

# game/scripts/Locations/bar.rpy:1726
translate chinese_simp emma_taming_4_3b5b6bbe:

    # ava "Great, you take care of that and we'll do the rest."
    ava "好，那你负责那边，剩下的我们来。"

# game/scripts/Locations/bar.rpy:1727
translate chinese_simp emma_taming_4_3790d2a1:

    # nora "Okay."
    nora "好的。"

# game/scripts/Locations/bar.rpy:1728
translate chinese_simp emma_taming_4_d976f3d7:

    # ava "Alright, let's start."
    ava "好了，开始吧。"

# game/scripts/Locations/bar.rpy:1732
translate chinese_simp emma_taming_4_79c9afb2:

    # player "You thinking about serving tables more often?"
    player "你会考虑多去负责餐桌吗？"

# game/scripts/Locations/bar.rpy:1733
translate chinese_simp emma_taming_4_0fb17b5f:

    # emma "I don't know..."
    emma "我不知道……"

# game/scripts/Locations/bar.rpy:1734
translate chinese_simp emma_taming_4_fec102ad:

    # player "You're very efficient working at the bar, so I wouldn't worry about it."
    player "你在吧台干活效率很高，所以不用太担心。"

# game/scripts/Locations/bar.rpy:1738
translate chinese_simp emma_taming_4_96fbbc01:

    # emma "Thank you..."
    emma "谢谢你……"

# game/scripts/Locations/bar.rpy:1739
translate chinese_simp emma_taming_4_8bceb2e2:

    # emma "You're great at it too..."
    emma "你也很厉害……"

# game/scripts/Locations/bar.rpy:1740
translate chinese_simp emma_taming_4_dadc67fc:

    # player "I appreciate that, but I can't even compare to you yet."
    player "谢谢夸奖，但我现在还远远比不上你。"

# game/scripts/Locations/bar.rpy:1743
translate chinese_simp emma_taming_4_3b2c218c:

    # emma "I- I'm not that great..."
    emma "我、我没那么厉害……"

# game/scripts/Locations/bar.rpy:1749
translate chinese_simp emma_taming_4_36d2dc66:

    # ava "How come you've been gravitating towards the bar the whole day?"
    ava "你怎么一整天都往吧台那边跑啊？"

# game/scripts/Locations/bar.rpy:1753
translate chinese_simp emma_taming_4_164a9e1d:

    # ava "Is it subconscious or is there another reason~"
    ava "是潜意识作祟还是另有原因呢~"

# game/scripts/Locations/bar.rpy:1757
translate chinese_simp emma_taming_4_c5a45340:

    # emma "It's out of habit!"
    emma "是习惯！"

# game/scripts/Locations/bar.rpy:1758
translate chinese_simp emma_taming_4_e3806e6c:

    # ava "I'm sure it is..."
    ava "我相信你……"

# game/scripts/Locations/bar.rpy:1762
translate chinese_simp emma_taming_4_d16c352f:

    # leah "You need any help cleaning up here?"
    leah "需要帮忙打扫这里吗？"

# game/scripts/Locations/bar.rpy:1763
translate chinese_simp emma_taming_4_9c710368:

    # player "What about the kitchen?"
    player "厨房那边呢？"

# game/scripts/Locations/bar.rpy:1766
translate chinese_simp emma_taming_4_42c5c88e:

    # leah "That's all done, I started cleaning right after dinner."
    leah "那边都弄好了，晚饭一结束我就开始打扫了。"

# game/scripts/Locations/bar.rpy:1767
translate chinese_simp emma_taming_4_7b7d0cba:

    # player "Oh. In that case, you can head home, we'll handle it out here."
    player "哦，那你先回去吧，外面我们来收拾。"

# game/scripts/Locations/bar.rpy:1768
translate chinese_simp emma_taming_4_89fc2906:

    # leah "Alright. I'll be on my way then."
    leah "好的，那我就先走了。"

# game/scripts/Locations/bar.rpy:1772
translate chinese_simp emma_taming_4_1b46b7e1:

    # ava "The three of us can handle a few tables on our own."
    ava "我们三个人能应付得来这几张桌子的。"

# game/scripts/Locations/bar.rpy:1775
translate chinese_simp emma_taming_4_377f9e3d:

    # ava "I'll go clean up outside, you two can do the inside."
    ava "我去打扫外面，你们两个负责里面。"

# game/scripts/Locations/bar.rpy:1776
translate chinese_simp emma_taming_4_1b82baa9:

    # player "Sounds good."
    player "好。"

# game/scripts/Locations/bar.rpy:1780
translate chinese_simp emma_taming_4_5f2828de:

    # emma "I'll take care of the tables, you do the bar."
    emma "我来擦桌子，你负责吧台。"

# game/scripts/Locations/bar.rpy:1781
translate chinese_simp emma_taming_4_9c861a0a:

    # player "Okay."
    player "好。"

# game/scripts/Locations/bar.rpy:1785
translate chinese_simp emma_taming_4_ad5b8ecc:

    # player "I'm done here, you need any help?"
    player "我这边搞定了，需要帮忙吗？"

# game/scripts/Locations/bar.rpy:1788
translate chinese_simp emma_taming_4_85ead482:

    # emma "Just got two tables left, you can head home if you want."
    emma "只剩两张桌子了，你要是想回去可以先走。"

# game/scripts/Locations/bar.rpy:1789
translate chinese_simp emma_taming_4_a6ce699d:

    # player "Thanks, but I'll help you finish up."
    player "谢谢，不过我还是帮你一起弄完吧。"

# game/scripts/Locations/bar.rpy:1790
translate chinese_simp emma_taming_4_4136677b:

    # emma "Okay, in that case, we can each clean one."
    emma "好吧，那这样的话，我们一人擦一张桌子。"

# game/scripts/Locations/bar.rpy:1794
translate chinese_simp emma_taming_4_dc01e065:

    # player "It's been a long and busy day, huh?"
    player "真是漫长又忙碌的一天啊。"

# game/scripts/Locations/bar.rpy:1795
translate chinese_simp emma_taming_4_b26cc593:

    # player "I can't wait to go to bed..."
    player "我恨不得马上躺床上……"

# game/scripts/Locations/bar.rpy:1796
translate chinese_simp emma_taming_4_f07326ea:

    # emma "You can sleep here if you want."
    emma "如果你想的话，可以在这里睡。"

# game/scripts/Locations/bar.rpy:1800
translate chinese_simp emma_taming_4_2d4adbbe:

    # emma "In the guest bedroom!"
    emma "在客房！"

# game/scripts/Locations/bar.rpy:1801
translate chinese_simp emma_taming_4_937e3890:

    # player "Thought that part was obvious~"
    player "我本来也知道是客房~"

# game/scripts/Locations/bar.rpy:1802
translate chinese_simp emma_taming_4_baa5f687:

    # ava "You two just standing around?"
    ava "你们俩就在这站着聊天？"

# game/scripts/Locations/bar.rpy:1806
translate chinese_simp emma_taming_4_17d2f7d1:

    # emma "No, we just finished."
    emma "没有，我们刚忙完。"

# game/scripts/Locations/bar.rpy:1807
translate chinese_simp emma_taming_4_d7da5021:

    # ava "Ah. What were you two talking about?"
    ava "啊。你们俩刚才聊什么呢？"

# game/scripts/Locations/bar.rpy:1808
translate chinese_simp emma_taming_4_d81c9d5f:

    # player "[emma] offered me to sleep over."
    player "[emma] 说我可以在这里过夜。"

# game/scripts/Locations/bar.rpy:1812
translate chinese_simp emma_taming_4_885e1fca:

    # ava "That's very straightforward of you, [emma]~"
    ava "[emma]，你这话说得可真直白啊~"

# game/scripts/Locations/bar.rpy:1813
translate chinese_simp emma_taming_4_0b96c877:

    # emma "I meant in the guest bedroom!"
    emma "我说的是客房！"

# game/scripts/Locations/bar.rpy:1814
translate chinese_simp emma_taming_4_263e93c7:

    # ava "I know, I'm just teasing you~"
    ava "我知道，我逗你玩呢~"

# game/scripts/Locations/bar.rpy:1818
translate chinese_simp emma_taming_4_dc72e99c:

    # ava "Feel free to stay here, that's what the room's for."
    ava "想住就住下吧，那间房本来就是备着用的。"

# game/scripts/Locations/bar.rpy:1829
translate chinese_simp bar_after_island_58224e38:

    # emma "..."
    emma "……"

# game/scripts/Locations/bar.rpy:1833
translate chinese_simp bar_after_island_43a2c79f:

    # ava "Look who showed up to work."
    ava "看看这是谁来上班了啊。"

# game/scripts/Locations/bar.rpy:1834
translate chinese_simp bar_after_island_ce617334:

    # player "I got a good reason for not being here..."
    player "我没来是有充分理由的……"

# game/scripts/Locations/bar.rpy:1836
translate chinese_simp bar_after_island_b42f40d4:

    # ava "You better."
    ava "最好如此。"

# game/scripts/Locations/bar.rpy:1838
translate chinese_simp bar_after_island_1f98871e:

    # ava "I'm sure you do..."
    ava "我当然相信你……"

# game/scripts/Locations/bar.rpy:1842
translate chinese_simp bar_after_island_626d396b:

    # ava "So. Where were you?"
    ava "那么，你到底去哪儿了？"

# game/scripts/Locations/bar.rpy:1843
translate chinese_simp bar_after_island_fa141ad0:

    # ava "[emily] told us you just 'left town' and are coming back soon, but we didn't believe it for a second."
    ava "[emily]跟我们说你只是‘离开镇上’，很快就回来，但我们根本不信。"

# game/scripts/Locations/bar.rpy:1844
translate chinese_simp bar_after_island_4cb81d63:

    # player "Long story short, I was trapped... I got out, but it took a whole month."
    player "长话短说，我被困住了……我逃出来了，但花了整整一个月。"

# game/scripts/Locations/bar.rpy:1847
translate chinese_simp bar_after_island_bde13e0d:

    # ava "Trapped where?"
    ava "被困在哪里？"

# game/scripts/Locations/bar.rpy:1848
translate chinese_simp bar_after_island_9e710319:

    # emma "Why would [emily] lie about it?"
    emma "[emily]为什么要替你撒谎？"

# game/scripts/Locations/bar.rpy:1851
translate chinese_simp bar_after_island_20753bf9:

    # narrator "You explain the whole situation to them."
    narrator "你把整个情况都跟她们解释了。"

# game/scripts/Locations/bar.rpy:1854
translate chinese_simp bar_after_island_75f41fb1:

    # player "As for [emily]... I think she was probably trying to not worry you..."
    player "至于[emily]……她大概是不想让你们担心……"

# game/scripts/Locations/bar.rpy:1855
translate chinese_simp bar_after_island_e5c89b61:

    # ava "That's fair..."
    ava "那倒也是……"

# game/scripts/Locations/bar.rpy:1858
translate chinese_simp bar_after_island_cc9d66a7:

    # ava "Just when we gave you part of the business-"
    ava "我们才刚分了你一部分股份-"

# game/scripts/Locations/bar.rpy:1859
translate chinese_simp bar_after_island_682187d8:

    # ava "You decide to 'leave town'"
    ava "你就决定‘离开镇上’了"

# game/scripts/Locations/bar.rpy:1862
translate chinese_simp bar_after_island_b4ae4319:

    # ava "We were SO pissed at first."
    ava "一开始我们气疯了。"

# game/scripts/Locations/bar.rpy:1863
translate chinese_simp bar_after_island_25686167:

    # ava "We knew [emily] was covering for you."
    ava "我们知道[emily]在替你打掩护。"

# game/scripts/Locations/bar.rpy:1864
translate chinese_simp bar_after_island_ab636a7d:

    # emma "But we couldn't figure out why, so we dropped it..."
    emma "但想不通是为什么，所以就没再追究了……"

# game/scripts/Locations/bar.rpy:1867
translate chinese_simp bar_after_island_40b24b45:

    # ava "She must've felt pretty bad though..."
    ava "不过她肯定很不好受……"

# game/scripts/Locations/bar.rpy:1868
translate chinese_simp bar_after_island_a526c078:

    # ava "Came here almost daily, trying to help with anything we needed."
    ava "几乎每天都来，看看有什么能帮忙的。"

# game/scripts/Locations/bar.rpy:1869
translate chinese_simp bar_after_island_f011dc73:

    # player "Did you let her help?"
    player "你们让她帮忙了吗？"

# game/scripts/Locations/bar.rpy:1872
translate chinese_simp bar_after_island_b0ce407c:

    # ava "Sometimes... With some basic stuff like cleaning..."
    ava "有时候吧……一些基本的活，比如打扫什么的……"

# game/scripts/Locations/bar.rpy:1875
translate chinese_simp bar_after_island_2e37f228:

    # ava "We didn't want to work her more especially since she refused to take any payment."
    ava "我们不想让她太累，况且她也不肯收钱。"

# game/scripts/Locations/bar.rpy:1876
translate chinese_simp bar_after_island_a8fe758c:

    # emma "But it convinced us to trust her and wait out your disappearance..."
    emma "但这让我们愿意相信她，也愿意等着你回来……"

# game/scripts/Locations/bar.rpy:1877
translate chinese_simp bar_after_island_e21feeb9:

    # player "Thank you... I'm sure she appreciates that."
    player "谢谢……她肯定也很感激。"

# game/scripts/Locations/bar.rpy:1880
translate chinese_simp bar_after_island_167c1654:

    # ava "She does. She sent us a text when you returned."
    ava "她确实感激。你回来的时候她还发消息给我们了。"

# game/scripts/Locations/bar.rpy:1881
translate chinese_simp bar_after_island_1706180b:

    # ava "Said to expect your visit and explanation."
    ava "说你会来解释清楚。"

# game/scripts/Locations/bar.rpy:1882
translate chinese_simp bar_after_island_b45920c0:

    # player "That makes sense..."
    player "那就说得通了……"

# game/scripts/Locations/bar.rpy:1885
translate chinese_simp bar_after_island_76b9839a:

    # ava "I'm guessing you're not here for work today, but do come back soon."
    ava "我猜你今天不是来上班的吧，不过记得尽快回来。"

# game/scripts/Locations/bar.rpy:1888
translate chinese_simp bar_after_island_0fcec067:

    # ava "Working's much more fun when you're around!"
    ava "你在的时候干活有意思多了！"

# game/scripts/Locations/bar.rpy:1890
translate chinese_simp bar_after_island_262493f1:

    # ava "Things go much smoother when you're around!"
    ava "你在的时候事情都会顺利得多！"

# game/scripts/Locations/bar.rpy:1901
translate chinese_simp bar_family_one_5cfa234a:

    # think "What's going on here..."
    think "这是什么情况……"

# game/scripts/Locations/bar.rpy:1904
translate chinese_simp bar_family_one_89b35c92:

    # ava "Hey [player]."
    ava "嘿，[player]。"

# game/scripts/Locations/bar.rpy:1905
translate chinese_simp bar_family_one_25ab89bd:

    # player "You all seem a bit worried, is something wrong..?"
    player "你们看起来都有点担心，出什么事了吗……？"

# game/scripts/Locations/bar.rpy:1906
translate chinese_simp bar_family_one_136ad5a2:

    # katherine "Yes... It's about my family."
    katherine "嗯……是关于我娘家的事。"

# game/scripts/Locations/bar.rpy:1909
translate chinese_simp bar_family_one_2803ba49:

    # katherine "There's been some talks between them and the family we said is backing you."
    katherine "他们跟我们谎称在背后支持你的那个家族有过接触了。"

# game/scripts/Locations/bar.rpy:1910
translate chinese_simp bar_family_one_fd9d0b9c:

    # katherine "When the subject of this bar came up it became pretty obvious that we lied."
    katherine "一聊到这间酒吧，我们的谎言就被戳穿了。"

# game/scripts/Locations/bar.rpy:1911
translate chinese_simp bar_family_one_540b0385:

    # player "Did you get in trouble for it..?"
    player "你因此惹上麻烦了吗……？"

# game/scripts/Locations/bar.rpy:1914
translate chinese_simp bar_family_one_1c075052:

    # katherine "No... They think I was fooled too."
    katherine "没有……他们觉得我也是被骗了。"

# game/scripts/Locations/bar.rpy:1915
translate chinese_simp bar_family_one_d70c0c41:

    # emma "That's good..."
    emma "那就好……"

# game/scripts/Locations/bar.rpy:1918
translate chinese_simp bar_family_one_6949fcb2:

    # katherine "Yes~ I'm safe for now. But they're back to pressuring me to take the bar from you."
    katherine "嗯~我暂时是安全的。但他们又开始逼我把这间酒吧从你们手里弄过来了。"

# game/scripts/Locations/bar.rpy:1919
translate chinese_simp bar_family_one_cc087a15:

    # ava "So what did you tell them?"
    ava "那你是怎么跟他们说的？"

# game/scripts/Locations/bar.rpy:1920
translate chinese_simp bar_family_one_d5292ba0:

    # katherine "That I'll try my best and keep in touch."
    katherine "我说我会尽力，保持联系。"

# game/scripts/Locations/bar.rpy:1923
translate chinese_simp bar_family_one_534ee41a:

    # emma "We need to come up with a solution... Preferably one that's permanent."
    emma "我们得想个办法……最好能一劳永逸。"

# game/scripts/Locations/bar.rpy:1924
translate chinese_simp bar_family_one_506d486e:

    # katherine "I agree. Don't want them coming after any of you..."
    katherine "我同意。我不想让他们来找你们任何人的麻烦……"

# game/scripts/Locations/bar.rpy:1925
translate chinese_simp bar_family_one_5733a6e1:

    # player "What's so special about this bar anyway..?"
    player "话说回来，这间酒吧到底有什么特别的……？"

# game/scripts/Locations/bar.rpy:1928
translate chinese_simp bar_family_one_85ee9139:

    # katherine "Well the biggest reason is the money it's making."
    katherine "最大的原因就是它的盈利能力。"

# game/scripts/Locations/bar.rpy:1929
translate chinese_simp bar_family_one_cd2ec2ae:

    # katherine "A successful business is a very good foundation when trying to move into new territory."
    katherine "一家成功的生意，对于想要拓展新地盘的人来说，是非常好的基础。"

# game/scripts/Locations/bar.rpy:1930
translate chinese_simp bar_family_one_f7a8bf61:

    # player "That makes sense... So what's the plan? Did they give you any other orders?"
    player "这倒也是……那他们有什么计划吗？有没有给你别的指示？"

# game/scripts/Locations/bar.rpy:1933
translate chinese_simp bar_family_one_48297286:

    # katherine "There's some sort of plan in the works-"
    katherine "他们似乎在计划什么——"

# game/scripts/Locations/bar.rpy:1934
translate chinese_simp bar_family_one_5ab29ba1:

    # katherine "They said I need to be ready to swoop in after it happens..."
    katherine "他们说我要做好准备，等事情发生之后立刻介入……"

# game/scripts/Locations/bar.rpy:1935
translate chinese_simp bar_family_one_55608b0d:

    # ava "Know anything else about it?"
    ava "还知道别的细节吗？"

# game/scripts/Locations/bar.rpy:1938
translate chinese_simp bar_family_one_87003f4f:

    # katherine "No..."
    katherine "不知道了……"

# game/scripts/Locations/bar.rpy:1939
translate chinese_simp bar_family_one_30f613ab:

    # ava "Then let's wait and see."
    ava "那就等着瞧吧。"

# game/scripts/Locations/bar.rpy:1940
translate chinese_simp bar_family_one_eaffae47:

    # emma "What if it's bad..?"
    emma "万一是很糟的事呢……？"

# game/scripts/Locations/bar.rpy:1943
translate chinese_simp bar_family_one_0d0d4433:

    # ava "I doubt it. It's probably some kind of disturbance that's going to leave us needing help."
    ava "应该不会。大概就是制造点混乱，让我们不得不求助。"

# game/scripts/Locations/bar.rpy:1944
translate chinese_simp bar_family_one_d67f40e2:

    # katherine "And I'll be there to help out or save the day."
    katherine "然后我再出现帮忙或解决问题。"

# game/scripts/Locations/bar.rpy:1945
translate chinese_simp bar_family_one_3ff7e000:

    # ava "Exactly."
    ava "就是这样。"

# game/scripts/Locations/bar.rpy:1946
translate chinese_simp bar_family_one_69ad22ce:

    # player "Okay, then let's wait."
    player "好吧，那就等着吧。"

# game/scripts/Locations/bar.rpy:1949
translate chinese_simp bar_family_one_32f803e6:

    # ava "You'll be the first person we call, so be ready."
    ava "我们会第一个打电话给你，做好准备。"

# game/scripts/Locations/bar.rpy:1950
translate chinese_simp bar_family_one_bcd4659c:

    # player "Sure thing."
    player "没问题。"

# game/scripts/Locations/bar.rpy:1961
translate chinese_simp bar_family_two_d115571b:

    # think "Hmm..?"
    think "嗯……？"

# game/scripts/Locations/bar.rpy:1964
translate chinese_simp bar_family_two_3a72c6b6:

    # ava "Please get here as fast as you can!"
    ava "请尽快过来！"

# game/scripts/Locations/bar.rpy:1965
translate chinese_simp bar_family_two_767dd10b:

    # player "I'm on my way."
    player "我马上到。"

# game/scripts/Locations/bar.rpy:1969
translate chinese_simp bar_family_two_413b9adb:

    # think "Looks like it's starting..."
    think "看来是开始了……"

# game/scripts/Locations/bar.rpy:1973
translate chinese_simp bar_family_two_fb18a116:

    # player "What's going on?"
    player "怎么回事？"

# game/scripts/Locations/bar.rpy:1974
translate chinese_simp bar_family_two_64a52ae1:

    # ava "[katherine] just called and said to be ready."
    ava "[katherine]刚才打电话来，说准备好。"

# game/scripts/Locations/bar.rpy:1975
translate chinese_simp bar_family_two_8b48008e:

    # player "For what?"
    player "准备什么？"

# game/scripts/Locations/bar.rpy:1979
translate chinese_simp bar_family_two_eae67db6:

    # ava "Don't know. She just got a message saying to be ready."
    ava "不知道。她只是收到消息说要准备好。"

# game/scripts/Locations/bar.rpy:1980
translate chinese_simp bar_family_two_ec728023:

    # player "Right... Where are [leah] and [nora]?"
    player "好的……[leah]和[nora]呢？"

# game/scripts/Locations/bar.rpy:1981
translate chinese_simp bar_family_two_e65b2e10:

    # ava "They're hiding in the kitchen."
    ava "她们躲在厨房里。"

# game/scripts/Locations/bar.rpy:1984
translate chinese_simp bar_family_two_0e34bf4a:

    # ava "She's almost here."
    ava "她快到了。"

# game/scripts/Locations/bar.rpy:1989
translate chinese_simp bar_family_two_237e5998:

    # cynthiaTitle "What do we have here~?"
    cynthiaTitle "看看这里有什么～？"

# game/scripts/Locations/bar.rpy:1992
translate chinese_simp bar_family_two_274389fe:

    # cynthiaTitle "Two bunnies and a human..."
    cynthiaTitle "两只兔子和一个人类……"

# game/scripts/Locations/bar.rpy:1993
translate chinese_simp bar_family_two_3bea4e41:

    # ava "What do you want?"
    ava "你想干什么？"

# game/scripts/Locations/bar.rpy:1996
translate chinese_simp bar_family_two_64a9b26e:

    # cynthiaTitle "That's not a nice attitude to have towards your customers..."
    cynthiaTitle "对客人这种态度可不太好啊……"

# game/scripts/Locations/bar.rpy:1997
translate chinese_simp bar_family_two_942f2707:

    # ava "You're not our customers."
    ava "你不是我们的客人。"

# game/scripts/Locations/bar.rpy:2000
translate chinese_simp bar_family_two_4ebd16bb:

    # cynthiaTitle "Heh~ You got us there~"
    cynthiaTitle "呵～这倒被你说对了～"

# game/scripts/Locations/bar.rpy:2001
translate chinese_simp bar_family_two_cf0e2117:

    # ava "Get lost."
    ava "滚出去。"

# game/scripts/Locations/bar.rpy:2002
translate chinese_simp bar_family_two_0c610f38:

    # cynthiaTitle "That's no way to talk to your new boss~"
    cynthiaTitle "这可不像是对新老板说话的态度啊～"

# game/scripts/Locations/bar.rpy:2003
translate chinese_simp bar_family_two_1b5debc2:

    # ava "What?"
    ava "什么？"

# game/scripts/Locations/bar.rpy:2006
translate chinese_simp bar_family_two_4c67a3c1:

    # cynthiaTitle "From now on, this bar belongs to the Redveil clan."
    cynthiaTitle "从今天起，这间酒吧归红纱家族所有了。"

# game/scripts/Locations/bar.rpy:2007
translate chinese_simp bar_family_two_b09b6c37:

    # ava "You're dreaming."
    ava "你做梦。"

# game/scripts/Locations/bar.rpy:2010
translate chinese_simp bar_family_two_bdc46935:

    # cynthiaTitle "Seems like you're really struggling to grasp the situation you're in..."
    cynthiaTitle "看来你还没搞清楚自己现在的处境啊……"

# game/scripts/Locations/bar.rpy:2011
translate chinese_simp bar_family_two_9d5abd07:

    # cynthiaTitle "Maybe we could show these three what happens if they talk back."
    cynthiaTitle "也许我们应该让这三个看看顶嘴的下场是什么。"

# game/scripts/Locations/bar.rpy:2012
translate chinese_simp bar_family_two_b5e05023:

    # katherine "Hey!"
    katherine "住手！"

# game/scripts/Locations/bar.rpy:2015
translate chinese_simp bar_family_two_473cb5b6:

    # cynthiaTitle "Hmm?"
    cynthiaTitle "嗯？"

# game/scripts/Locations/bar.rpy:2018
translate chinese_simp bar_family_two_6aa943c5:

    # katherine "You know who I am?"
    katherine "你知道我是谁吗？"

# game/scripts/Locations/bar.rpy:2019
translate chinese_simp bar_family_two_71181206:

    # cynthiaTitle "Uhh... Yes. What do you want?"
    cynthiaTitle "呃……知道。你想怎样？"

# game/scripts/Locations/bar.rpy:2020
translate chinese_simp bar_family_two_0ce5f296:

    # katherine "This bar is under my family's protection. You know what that means, right?"
    katherine "这间酒吧受我家族保护。你明白那意味着什么吧？"

# game/scripts/Locations/bar.rpy:2023
translate chinese_simp bar_family_two_ab386d15:

    # cynthiaTitle "Tsk- Whatever..."
    cynthiaTitle "啧——算了……"

# game/scripts/Locations/bar.rpy:2024
translate chinese_simp bar_family_two_a565595b:

    # cynthiaTitle "Let's go guys... We got better places to be anyway."
    cynthiaTitle "走吧，伙计们……反正我们有更好的地方可去。"

# game/scripts/Locations/bar.rpy:2028
translate chinese_simp bar_family_two_905e300a:

    # katherine "You guys okay?"
    katherine "你们没事吧？"

# game/scripts/Locations/bar.rpy:2029
translate chinese_simp bar_family_two_867b486e:

    # ava "Yes..."
    ava "没事……"

# game/scripts/Locations/bar.rpy:2030
translate chinese_simp bar_family_two_dcd0304a:

    # player "So this was the plan?"
    player "这就是他们的计划？"

# game/scripts/Locations/bar.rpy:2033
translate chinese_simp bar_family_two_4e2d4060:

    # katherine "Seems so... They're the guys we lied about backing you by the way."
    katherine "看样子是的……顺便说一句，他们就是我们谎称会支持你的那个家族。"

# game/scripts/Locations/bar.rpy:2034
translate chinese_simp bar_family_two_a76da130:

    # player "Really? Do they work for your family now or something?"
    player "真的？他们现在是为你家族卖命了还是怎么回事？"

# game/scripts/Locations/bar.rpy:2037
translate chinese_simp bar_family_two_ce632898:

    # katherine "Not at all, they were happy to do this when they learned you lied about being one of them."
    katherine "完全不是。他们发现你谎称是自己人之后，就很乐意来这一出了。"

# game/scripts/Locations/bar.rpy:2040
translate chinese_simp bar_family_two_7a759a33:

    # katherine "I'm sure they would've gone through with the threat of fighting you."
    katherine "我相信他们本来也准备动手的。"

# game/scripts/Locations/bar.rpy:2043
translate chinese_simp bar_family_two_c2c5f5e2:

    # player "So how do we go from here?"
    player "那我们接下来怎么办？"

# game/scripts/Locations/bar.rpy:2044
translate chinese_simp bar_family_two_cdb63c6f:

    # katherine "Well... This bar being protected by my family is out now, no matter how true it is."
    katherine "嗯……不管真假，这间酒吧由我家族保护这件事已经公开了。"

# game/scripts/Locations/bar.rpy:2045
translate chinese_simp bar_family_two_3abf38bb:

    # ava "And I'm guessing they'll want something in exchange for this 'protection'?"
    ava "我猜他们会要求用什么东西来交换这种‘保护’吧？"

# game/scripts/Locations/bar.rpy:2048
translate chinese_simp bar_family_two_d1c286fc:

    # katherine "Yes. It's usually monthly payments, but I have seen ownership transfers before..."
    katherine "是的。通常是按月交钱，但我也见过直接转让所有权的……"

# game/scripts/Locations/bar.rpy:2049
translate chinese_simp bar_family_two_013d49b3:

    # ava "They're not getting a dollar from us."
    ava "他们别想从我们这拿到一分钱。"

# game/scripts/Locations/bar.rpy:2052
translate chinese_simp bar_family_two_c513580e:

    # katherine "I agree. But we need to figure out what to do before they ask for it."
    katherine "我同意。但我们得在他们开口之前想好对策。"

# game/scripts/Locations/bar.rpy:2053
translate chinese_simp bar_family_two_1b5d4457:

    # player "Any ideas?"
    player "有什么想法吗？"

# game/scripts/Locations/bar.rpy:2054
translate chinese_simp bar_family_two_253b6461:

    # emma "There's not much we {i}can{/i} do..."
    emma "我们能做的其实不多……"

# game/scripts/Locations/bar.rpy:2055
translate chinese_simp bar_family_two_9f16ac7e:

    # ava "What about legally?"
    ava "走法律途径呢？"

# game/scripts/Locations/bar.rpy:2058
translate chinese_simp bar_family_two_16faab0e:

    # katherine "I can help gather evidence..."
    katherine "我可以帮忙收集证据……"

# game/scripts/Locations/bar.rpy:2059
translate chinese_simp bar_family_two_699f4ba9:

    # player "Would that be enough to do anything?"
    player "这样能有什么用吗？"

# game/scripts/Locations/bar.rpy:2060
translate chinese_simp bar_family_two_87cb0a85:

    # katherine "Not really, but it would keep them out of this town for good."
    katherine "其实没什么用，但能让他们永远滚出这个镇子。"

# game/scripts/Locations/bar.rpy:2061
translate chinese_simp bar_family_two_6d5784d3:

    # emma "How?"
    emma "怎么做？"

# game/scripts/Locations/bar.rpy:2064
translate chinese_simp bar_family_two_62edb9d6:

    # katherine "I can get the name of every member and employee whoever worked for us and hand them over to the cops."
    katherine "我可以把所有曾经为我们工作过的成员和员工的名字都交给警方。"

# game/scripts/Locations/bar.rpy:2067
translate chinese_simp bar_family_two_6d162874:

    # katherine "Would make it hard to do anything in a town you can't legally open or run a business..."
    katherine "在一个连合法开店都做不到的镇上，他们也就没法兴风作浪了……"

# game/scripts/Locations/bar.rpy:2068
translate chinese_simp bar_family_two_9daf2ed5:

    # ava "But wouldn't that mean-"
    ava "但那不是意味着——"

# game/scripts/Locations/bar.rpy:2071
translate chinese_simp bar_family_two_62edb9d6:

    # katherine "I can get the name of every member and employee whoever worked for us and hand them over to the cops."
    katherine "我可以把所有曾经为我们工作过的成员和员工的名字都交给警方。"

# game/scripts/Locations/bar.rpy:2072
translate chinese_simp bar_family_two_7d12b075:

    # emma "No! We're not doing that! We're not losing you again!"
    emma "不行！我们不能那样做！我们不能再失去你了！"

# game/scripts/Locations/bar.rpy:2073
translate chinese_simp bar_family_two_7f221caf:

    # player "There's gotta be a better way..."
    player "肯定有更好的办法……"

# game/scripts/Locations/bar.rpy:2076
translate chinese_simp bar_family_two_677a9352:

    # katherine "It's something I need to do... I started all of this..."
    katherine "这是我必须要做的……这一切都是我引起的……"

# game/scripts/Locations/bar.rpy:2077
translate chinese_simp bar_family_two_0835bfb9:

    # player "I won't stop you, but think of your daughters, and what it means to abandon them again."
    player "我不会拦你，但想想你的女儿们，想想再抛弃她们一次意味着什么。"

# game/scripts/Locations/bar.rpy:2078
translate chinese_simp bar_family_two_63d17c45:

    # emma "Maybe there's some deal you can make with the police..."
    emma "也许你能和警方达成某种协议……"

# game/scripts/Locations/bar.rpy:2081
translate chinese_simp bar_family_two_0bb75423:

    # katherine "I can try, but I'm not expecting anything..."
    katherine "我可以试试，但我不抱什么希望……"

# game/scripts/Locations/bar.rpy:2082
translate chinese_simp bar_family_two_ab9fcb46:

    # player "You're giving them a lot... I'm sure you can ask for some sort of deal..."
    player "你提供了那么多情报……我相信你可以提一些条件……"

# game/scripts/Locations/bar.rpy:2083
translate chinese_simp bar_family_two_35077138:

    # katherine "I hope so..."
    katherine "希望如此……"

# game/scripts/Locations/bar.rpy:2086
translate chinese_simp bar_family_two_c4bb8be5:

    # katherine "Before I do this, can I ask to spend the day with just us three?"
    katherine "在我去做这件事之前，能让我和你们姐妹俩单独待一天吗？"

# game/scripts/Locations/bar.rpy:2087
translate chinese_simp bar_family_two_568542f0:

    # emma "Yes!"
    emma "当然！"

# game/scripts/Locations/bar.rpy:2088
translate chinese_simp bar_family_two_f972cb43:

    # ava "I guess that's fine..."
    ava "好吧……"

# game/scripts/Locations/bar.rpy:2089
translate chinese_simp bar_family_two_e5269a4f:

    # player "I'll leave you to it~"
    player "那我就不打扰你们了~"

# game/scripts/Locations/bar.rpy:2100
translate chinese_simp bar_family_three_invite_d115571b:

    # think "Hmm..?"
    think "嗯……？"

# game/scripts/Locations/bar.rpy:2103
translate chinese_simp bar_family_three_invite_0d47a687:

    # katherine "Can you come to the bar please?"
    katherine "你能来一下酒吧吗？"

# game/scripts/Locations/bar.rpy:2104
translate chinese_simp bar_family_three_invite_164eba55:

    # player "Sure."
    player "好的。"

# game/scripts/Locations/bar.rpy:2108
translate chinese_simp bar_family_three_invite_bae57f36:

    # think "Does she still have her freedom..? Good."
    think "她还有自由吗……？那就好。"

# game/scripts/Locations/bar.rpy:2116
translate chinese_simp bar_family_three_6e199929:

    # katherine "I wanted all of you together so I can explain the whole situation."
    katherine "我想让你们都到齐，好解释清楚整个情况。"

# game/scripts/Locations/bar.rpy:2117
translate chinese_simp bar_family_three_c1e6de82:

    # emma "So you're free..?"
    emma "所以你自由了……？"

# game/scripts/Locations/bar.rpy:2118
translate chinese_simp bar_family_three_d9964619:

    # katherine "Not exactly..."
    katherine "不完全是……"

# game/scripts/Locations/bar.rpy:2121
translate chinese_simp bar_family_three_3356d6e8:

    # katherine "I made a pretty good deal I think. I'm going to become an informant."
    katherine "我想我谈成了一笔不错的交易。我打算做个线人。"

# game/scripts/Locations/bar.rpy:2122
translate chinese_simp bar_family_three_a0fabaf9:

    # ava "For how long?"
    ava "要做多久？"

# game/scripts/Locations/bar.rpy:2125
translate chinese_simp bar_family_three_4ca34144:

    # katherine "For as long as they need me. As part of that deal, I can't leave town."
    katherine "做到他们不需要我为止。作为交易的一部分，我不能离开这个镇子。"

# game/scripts/Locations/bar.rpy:2126
translate chinese_simp bar_family_three_6697384e:

    # player "Won't your family get suspicious when they ask you to leave?"
    player "你家人让你离开的时候，他们不会起疑心吗？"

# game/scripts/Locations/bar.rpy:2129
translate chinese_simp bar_family_three_6c86c670:

    # katherine "They can feel the police putting some pressure on them, so they told me to stay low and continue playing the mother part."
    katherine "他们能感觉到警方在施压，所以让我低调点，继续扮演好母亲的角色。"

# game/scripts/Locations/bar.rpy:2132
translate chinese_simp bar_family_three_852114a5:

    # ava "Heh... 'playing the Mother part'..."
    ava "呵……‘扮演好母亲的角色’……"

# game/scripts/Locations/bar.rpy:2133
translate chinese_simp bar_family_three_c1f8d703:

    # katherine "Basically trying to get as close to you two as possible..."
    katherine "其实就是尽量跟你们俩搞好关系……"

# game/scripts/Locations/bar.rpy:2136
translate chinese_simp bar_family_three_90565e5b:

    # ava "I know what it means! It's just so ridiculous."
    ava "我知道是什么意思！只是觉得太离谱了。"

# game/scripts/Locations/bar.rpy:2137
translate chinese_simp bar_family_three_2af3f8f3:

    # katherine "Oh- Sorry..."
    katherine "哦——抱歉……"

# game/scripts/Locations/bar.rpy:2138
translate chinese_simp bar_family_three_e8491713:

    # emma "So does this mean they still won't give up?"
    emma "那他们还是不会善罢甘休吗？"

# game/scripts/Locations/bar.rpy:2141
translate chinese_simp bar_family_three_db64a9d6:

    # katherine "Technically no, but having the whole operation exposed like this should stop them from trying anything in this town for quite some time."
    katherine "严格来说是的，但整件事曝光到这个程度，应该能让他们在很长一段时间内不敢在镇子里乱来。"

# game/scripts/Locations/bar.rpy:2142
translate chinese_simp bar_family_three_ef723d5d:

    # katherine "Even if they won't say it, expanding in this area is pretty much over."
    katherine "即使他们嘴上不承认，在这个区域扩张的计划也基本泡汤了。"

# game/scripts/Locations/bar.rpy:2145
translate chinese_simp bar_family_three_5b2d26d0:

    # emma "That's good news then!"
    emma "那这算是个好消息！"

# game/scripts/Locations/bar.rpy:2146
translate chinese_simp bar_family_three_d4c67e31:

    # katherine "It is~! I get to spend time with you two and the bar is safe from my family!"
    katherine "是啊～！我可以跟你们俩待在一起，酒吧也不会被我娘家盯上了！"

# game/scripts/Locations/bar.rpy:2149
translate chinese_simp bar_family_three_6ae9c701:

    # katherine "There is something else that's bothering me though..."
    katherine "不过还有件事让我很在意……"

# game/scripts/Locations/bar.rpy:2150
translate chinese_simp bar_family_three_db6db326:

    # ava "The Redveils, right?"
    ava "红纱家族，对吧？"

# game/scripts/Locations/bar.rpy:2151
translate chinese_simp bar_family_three_1a2e53de:

    # katherine "Yes. When they find out that my family's out, they'll be back to take the bar for themselves."
    katherine "对。等他们发现我娘家出局了，就会回来把酒吧占为己有。"

# game/scripts/Locations/bar.rpy:2152
translate chinese_simp bar_family_three_c532efd1:

    # player "We'll just have to be ready for when that happens..."
    player "到时候我们做好准备就行了……"

# game/scripts/Locations/bar.rpy:2153
translate chinese_simp bar_family_three_87ab934a:

    # ava "There's not much else we can do..."
    ava "我们现在也做不了别的……"

# game/scripts/Locations/bar.rpy:2154
translate chinese_simp bar_family_three_1d796922:

    # katherine "Should be a while though, the detective handling my case was very set on doing this as quietly as possible."
    katherine "不过应该还能消停一阵子。负责我案子的侦探坚持要尽量低调处理。"

# game/scripts/Locations/bar.rpy:2155
translate chinese_simp bar_family_three_bfabfe95:

    # player "That's reassuring at least..."
    player "至少这点还算让人安心……"

# game/scripts/Locations/bar.rpy:2158
translate chinese_simp bar_family_three_eac980e8:

    # katherine "Well! I'm off to look for a job~!"
    katherine "好了！我要去找工作了～！"

# game/scripts/Locations/bar.rpy:2159
translate chinese_simp bar_family_three_41d9c80a:

    # ava "A job..?"
    ava "工作……？"

# game/scripts/Locations/bar.rpy:2160
translate chinese_simp bar_family_three_de65d93d:

    # katherine "My family's money was cut off... Not like I was getting a lot, but still."
    katherine "娘家断了我的经济来源……虽然本来也没多少，但总归是断了。"

# game/scripts/Locations/bar.rpy:2161
translate chinese_simp bar_family_three_744ba0af:

    # katherine "I need to get my own income now."
    katherine "我现在得靠自己赚钱了。"

# game/scripts/Locations/bar.rpy:2162
translate chinese_simp bar_family_three_364f8d98:

    # emma "You could-"
    emma "你可以——"

# game/scripts/Locations/bar.rpy:2165
translate chinese_simp bar_family_three_b8780d85:

    # katherine "Thank you [emma], but that's too much to ask for, I need to try on my own."
    katherine "谢谢你[emma]，但那样太麻烦你们了，我得自己先试试。"

# game/scripts/Locations/bar.rpy:2166
translate chinese_simp bar_family_three_83788c47:

    # emma "Okay..."
    emma "好吧……"

# game/scripts/Locations/bar.rpy:2169
translate chinese_simp bar_family_three_607aa1c3:

    # katherine "I'll still hang around here when I can! So you won't get rid of me that easy~"
    katherine "我只要有空还是会来这边转悠的！所以你们可别想轻易甩掉我～"

# game/scripts/Locations/bar.rpy:2172
translate chinese_simp bar_family_three_92d17296:

    # ava "That was surprisingly mature of her..."
    ava "她居然这么成熟，真让人意外……"

# game/scripts/Locations/bar.rpy:2173
translate chinese_simp bar_family_three_b69f39a9:

    # ava "I was sure she'd try begging us for a job."
    ava "我还以为她肯定会来求我们给她份工作。"

# game/scripts/Locations/bar.rpy:2176
translate chinese_simp bar_family_three_0fbab201:

    # emma "So what if she did? Would it be so bad to have our mom working with us?"
    emma "就算她来求了又怎样？让妈妈和我们一起工作就那么糟糕吗？"

# game/scripts/Locations/bar.rpy:2177
translate chinese_simp bar_family_three_17b693b1:

    # emma "She's clearly trying to change- Wasn't that obvious when she turned herself in?"
    emma "她明显在努力改变——她去自首的时候不就说明一切了吗？"

# game/scripts/Locations/bar.rpy:2178
translate chinese_simp bar_family_three_94c2459b:

    # ava "You're right... Sorry about that."
    ava "你说得对……是我不好。"

# game/scripts/Locations/bar.rpy:2181
translate chinese_simp bar_family_three_2de86220:

    # emma "She would be an asset to have working around here."
    emma "她如果能在这里工作，肯定会是一大助力。"

# game/scripts/Locations/bar.rpy:2184
translate chinese_simp bar_family_three_a2daf54c:

    # ava "I know I'm just-"
    ava "我知道我只是——"

# game/scripts/Locations/bar.rpy:2187
translate chinese_simp bar_family_three_a14610b7:

    # ava "What's gotten into her..."
    ava "她到底怎么了……"

# game/scripts/Locations/bar.rpy:2188
translate chinese_simp bar_family_three_01679233:

    # player "She's clearly upset by almost losing her mom again..."
    player "她显然是因为差点再次失去妈妈而难过……"

# game/scripts/Locations/bar.rpy:2191
translate chinese_simp bar_family_three_3b3db093:

    # ava "I told her she'd only get hurt trusting her so easily..."
    ava "我跟她说过了，这么轻易相信她只会受伤……"

# game/scripts/Locations/bar.rpy:2192
translate chinese_simp bar_family_three_71f1c104:

    # ava "Things won't always turn out good."
    ava "事情不会总是往好的方向发展。"

# game/scripts/Locations/bar.rpy:2193
translate chinese_simp bar_family_three_8f6d3659:

    # player "Then be happy with her when they do."
    player "那在事情变好的时候，就好好为她开心吧。"

# game/scripts/Locations/bar.rpy:2196
translate chinese_simp bar_family_three_c9ae2781:

    # ava "I am... I'm just pissed at [katherine] for risking everything like that."
    ava "我是开心……我只是气[katherine]拿一切去冒那种险。"

# game/scripts/Locations/bar.rpy:2199
translate chinese_simp bar_family_three_13982362:

    # ava "I should go talk to her, huh?"
    ava "我应该去跟她谈谈，对吧？"

# game/scripts/Locations/bar.rpy:2200
translate chinese_simp bar_family_three_0c081e71:

    # player "Yes."
    player "对。"

# game/scripts/Locations/bar.rpy:2203
translate chinese_simp bar_family_three_4070af5c:

    # ava "Thanks for being here through all of this."
    ava "谢谢你一直在这里陪着我们。"

# game/scripts/Locations/bar.rpy:2204
translate chinese_simp bar_family_three_ddd65e4f:

    # player "Of course..."
    player "当然了……"

# game/scripts/Locations/bar.rpy:2210
translate chinese_simp bar_family_three_29edd7bb:

    # ava "Mmmnn~"
    ava "嗯嗯～"

# game/scripts/Locations/bar.rpy:2214
translate chinese_simp bar_family_three_69e59727:

    # ava "See you later~"
    ava "待会见～"

# game/scripts/Locations/bar.rpy:2225
translate chinese_simp bar_chatty_locals_0734773c:

    # ava "You're getting pretty good at that."
    ava "你现在越来越厉害了。"

# game/scripts/Locations/bar.rpy:2226
translate chinese_simp bar_chatty_locals_502b488d:

    # player "You think so?"
    player "你觉得吗？"

# game/scripts/Locations/bar.rpy:2229
translate chinese_simp bar_chatty_locals_787b8afc:

    # ava "Yeah, there's been more and more customers asking for you specifically."
    ava "对，越来越多客人指名要找你。"

# game/scripts/Locations/bar.rpy:2232
translate chinese_simp bar_chatty_locals_3019e66c:

    # ava "If only you were here more~"
    ava "你要是能多来几次就好了～"

# game/scripts/Locations/bar.rpy:2233
translate chinese_simp bar_chatty_locals_36304242:

    # player "I'm trying my best~"
    player "我已经尽力了～"

# game/scripts/Locations/bar.rpy:2236
translate chinese_simp bar_chatty_locals_8b0ea2a3:

    # ava "But in all seriousness, you could use that skill of yours."
    ava "不过说正经的，你可以好好利用这项技能。"

# game/scripts/Locations/bar.rpy:2237
translate chinese_simp bar_chatty_locals_00eed014:

    # player "In what way?"
    player "怎么利用？"

# game/scripts/Locations/bar.rpy:2240
translate chinese_simp bar_chatty_locals_9cb30d5e:

    # ava "You know how chatty people get, especially the locals."
    ava "你知道人喝多了话就多，尤其是本地人。"

# game/scripts/Locations/bar.rpy:2241
translate chinese_simp bar_chatty_locals_88ecfc54:

    # ava "I bet you could find out a lot about this town through them."
    ava "我敢说你肯定能从他们嘴里打听出不少关于镇子的事。"

# game/scripts/Locations/bar.rpy:2242
translate chinese_simp bar_chatty_locals_b70a1156:

    # player "I see... I'll give that a try."
    player "我明白了……我试试看。"

# game/scripts/Locations/bar.rpy:2245
translate chinese_simp bar_chatty_locals_b19546cb:

    # ava "Most usually just vent about their lives."
    ava "大部分人就是吐槽一下自己的生活。"

# game/scripts/Locations/bar.rpy:2248
translate chinese_simp bar_chatty_locals_4b387d9a:

    # ava "But who knows, maybe one or two know something you don't."
    ava "不过谁知道呢，说不定有一两个知道些你不知道的事。"

# game/scripts/Locations/bar.rpy:2249
translate chinese_simp bar_chatty_locals_5a24069e:

    # player "You're just trying to get me to work more, aren't you~?"
    player "你就是想让我多来干活吧～？"

# game/scripts/Locations/bar.rpy:2252
translate chinese_simp bar_chatty_locals_a32c2686:

    # ava "Oh, I'll absolutely benefit from it~"
    ava "哦，我肯定会从中获益的～"

# game/scripts/Locations/bar.rpy:2253
translate chinese_simp bar_chatty_locals_a02089e0:

    # ava "I'm not even gonna pretend otherwise."
    ava "我也懒得假装不是。"

# game/scripts/Locations/bar.rpy:2256
translate chinese_simp bar_chatty_locals_1e8e53c7:

    # ava "But I am serious. We learned about [aurora]'s gang hideout pretty quick, right?"
    ava "不过我是认真的。我们不是很快打听到了[aurora]帮派的老巢吗？"

# game/scripts/Locations/bar.rpy:2257
translate chinese_simp bar_chatty_locals_439bb270:

    # player "That's true..."
    player "那倒是……"

# game/scripts/Locations/bar.rpy:2258
translate chinese_simp bar_chatty_locals_1bfaafc2:

    # player "I'll start asking a few more questions and actually listen to what comes back."
    player "我会开始多问问问题，然后认真听他们怎么说。"

# game/scripts/Locations/bar.rpy:2259
translate chinese_simp bar_chatty_locals_887f19b3:

    # player "Thanks."
    player "谢了。"

# game/scripts/Locations/bar.rpy:2262
translate chinese_simp bar_chatty_locals_159ab49f:

    # ava "You're welcome~"
    ava "不客气～"

