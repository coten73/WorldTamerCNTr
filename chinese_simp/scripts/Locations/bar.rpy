    # think "Damn it! I was kinda rooting for her..."
    think "妈的！我刚才还差点站她那边了……"

# game/scripts/Locations/bar.rpy:774
translate chinese_simp bar_katherine_meeting_08006580:

    # luna "What will you do now..?"
    luna "你现在打算怎么办..？"

# game/scripts/Locations/bar.rpy:775
translate chinese_simp bar_katherine_meeting_a981ffd6:

    # think "Don't know yet. I'll probably look her family up on the computer."
    think "还不知道。我回去用电脑查查她家的情况。"

# game/scripts/Locations/bar.rpy:789
translate chinese_simp bar_katherine_truth_d102b24c:

    # think "Looks like [katherine]'s already here..."
    think "[katherine]好像已经到了……"

# game/scripts/Locations/bar.rpy:793
translate chinese_simp bar_katherine_truth_89b35c92:

    # ava "Hey [player]."
    ava "嘿[player]。"

# game/scripts/Locations/bar.rpy:794
translate chinese_simp bar_katherine_truth_a049d20d:

    # katherine "Can we go sit down somewhere? I need to say something..."
    katherine "我们能找个地方坐下说吗？我有话要说……"

# game/scripts/Locations/bar.rpy:799
translate chinese_simp bar_katherine_truth_9b36ad80:

    # ava "What's this about?"
    ava "什么事？"

# game/scripts/Locations/bar.rpy:800
translate chinese_simp bar_katherine_truth_e2ac2f8d:

    # katherine "I have something important I need to tell you..."
    katherine "有件重要的事我必须告诉你们……"

# game/scripts/Locations/bar.rpy:801
translate chinese_simp bar_katherine_truth_677ed6f1:

    # katherine "It's about your father and me, and everything that happened."
    katherine "关于你们的父亲和我，还有过去的一切。"

# game/scripts/Locations/bar.rpy:804
translate chinese_simp bar_katherine_truth_693d66e6:

    # narrator "[katherine] spends the next half an hour explaining the whole story to [ava] and [emma]."
    narrator "[katherine]花了接下来的半小时，向[ava]和[emma]坦白了一切。"

# game/scripts/Locations/bar.rpy:808
translate chinese_simp bar_katherine_truth_5b14ef3a:

    # katherine "After meeting me, I guess [player] felt something was off about my story..."
    katherine "见过我之后，估计[player]觉得我的说法有什么不对劲……"

# game/scripts/Locations/bar.rpy:812
translate chinese_simp bar_katherine_truth_11946056:

    # katherine "He confronted me and made me realize how much I screwed up with everything."
    katherine "他来找我对质，让我意识到我犯的错有多大。"

# game/scripts/Locations/bar.rpy:813
translate chinese_simp bar_katherine_truth_f7e8e0a8:

    # katherine "He made me understand that I can't keep making decisions for you without you even knowing it."
    katherine "他让我明白，我不能在你们不知情的情况下，替你们做决定。"

# game/scripts/Locations/bar.rpy:816
translate chinese_simp bar_katherine_truth_916b541f:

    # katherine "So this time, it's up to you to decide what you want to do..."
    katherine "所以这次，由你们来决定该怎么做……"

# game/scripts/Locations/bar.rpy:817
translate chinese_simp bar_katherine_truth_88bd201c:

    # katherine "And how do you want me to deal with our family."
    katherine "还有你们希望我如何面对我那边的家人。"

# game/scripts/Locations/bar.rpy:821
translate chinese_simp bar_katherine_truth_057715f5:

    # ava "[player]. Is she telling the truth?"
    ava "[player]。她说的是实话吗？"

# game/scripts/Locations/bar.rpy:822
translate chinese_simp bar_katherine_truth_ab583a6f:

    # player "She seems to be, and her story does match up with what I know so far."
    player "看起来是，而且她说的跟我目前了解到的情况也吻合。"

# game/scripts/Locations/bar.rpy:826
translate chinese_simp bar_katherine_truth_093f7bf9:

    # ava "I see... In that case, we're in a really bad spot..."
    ava "这样啊……那我们的处境确实很糟糕……"

# game/scripts/Locations/bar.rpy:830
translate chinese_simp bar_katherine_truth_874a27df:

    # ava "We won't be signing the bar over to you [katherine]..."
    ava "我们不会把酒吧转给你的，[katherine]……"

# game/scripts/Locations/bar.rpy:831
translate chinese_simp bar_katherine_truth_8bc2613f:

    # ava "We can't give away Dad's work just like that."
    ava "我们不能就这样把爸爸的心血交出去。"

# game/scripts/Locations/bar.rpy:832
translate chinese_simp bar_katherine_truth_ea77cd28:

    # katherine "I understand... but that will put both of you in danger..."
    katherine "我明白……但这会让你们俩都陷入危险……"

# game/scripts/Locations/bar.rpy:836
translate chinese_simp bar_katherine_truth_b0aace5e:

    # emma "W-what if we have it co-owned?"
    emma "那，那如果我们找人共同持有呢？"

# game/scripts/Locations/bar.rpy:837
translate chinese_simp bar_katherine_truth_74819fa2:

    # ava "How would that help? Doing that would still pretty much be giving it away."
    ava "那有什么用？那样做不还是等于交出去了吗？"

# game/scripts/Locations/bar.rpy:838
translate chinese_simp bar_katherine_truth_44a49a3a:

    # emma "No, I meant [player]. Someone who's outside of the family..."
    emma "不，我说的是[player]。一个跟我们家族没关系的人……"

# game/scripts/Locations/bar.rpy:842
translate chinese_simp bar_katherine_truth_533c70a4:

    # emma "That way the bar doesn't go to Mom if something happens to us..."
    emma "这样如果我们出了什么事，酒吧也不会落到妈妈手里……"

# game/scripts/Locations/bar.rpy:843
translate chinese_simp bar_katherine_truth_afefb374:

    # ava "Hmm... That's not a bad idea..."
    ava "嗯……这主意不错……"

# game/scripts/Locations/bar.rpy:844
translate chinese_simp bar_katherine_truth_72e0062c:

    # ava "That way [katherine] can tell her family that the new co-owner can't be easily dealt with or something along those lines..."
    ava "这样[katherine]就可以跟她家里说，新合伙人不好对付之类的……"

# game/scripts/Locations/bar.rpy:845
translate chinese_simp bar_katherine_truth_e65fdcbd:

    # katherine "That could work, them knowing that hurting you won't help should keep you safe!"
    katherine "这应该行得通！让他们知道伤害你们也没用，反而能保证你们的安全！"

# game/scripts/Locations/bar.rpy:846
translate chinese_simp bar_katherine_truth_a592e21f:

    # player "Woah, woah! What about me? That sounds like a challenge to try to take me out!"
    player "等等，等等！那我呢？这听起来像是在挑衅他们来对付我啊！"

# game/scripts/Locations/bar.rpy:847
translate chinese_simp bar_katherine_truth_0f9a2c32:

    # katherine "I'll take care of that, I'll tell Dad that you're being backed by another family."
    katherine "这个我来解决，我会跟我爸说，你背后有另一个家族撑腰。"

# game/scripts/Locations/bar.rpy:848
translate chinese_simp bar_katherine_truth_88e6c5f5:

    # katherine "They can't afford a \"war\" right now, so they'll back off."
    katherine "他们现在打不起‘战争’，所以会退让的。"

# game/scripts/Locations/bar.rpy:849
translate chinese_simp bar_katherine_truth_832420b5:

    # player "Still feels like I'm being thrown under the bus here..."
    player "我怎么还是觉得自己被当枪使了……"

# game/scripts/Locations/bar.rpy:850
translate chinese_simp bar_katherine_truth_a56eedbf:

    # ava "We know you can take care of yourself."
    ava "我们知道你能保护好自己的。"

# game/scripts/Locations/bar.rpy:851
translate chinese_simp bar_katherine_truth_21a0aba9:

    # ava "And we'll have to repay you in a big way for risking your safety like this."
    ava "你为我们冒这么大风险，我们一定会好好报答你的。"

# game/scripts/Locations/bar.rpy:852
translate chinese_simp bar_katherine_truth_2c074376:

    # luna "Be careful... With the gang and now [katherine]'s family, you might be in real danger..."
    luna "小心点……帮派的事还没完，现在又来了[katherine]的家族，你真的可能很危险……"

# game/scripts/Locations/bar.rpy:853
translate chinese_simp bar_katherine_truth_97d9857c:

    # think "I know... I'm trying, but at this point, it's not even up to me anymore..."
    think "我知道……我在想办法，但事已至此，我也没得选了……"

# game/scripts/Locations/bar.rpy:857
translate chinese_simp bar_katherine_truth_a9c2d804:

    # katherine "That settles it then. Thank you for everything [player]!"
    katherine "那就这么定了。谢谢你做的一切，[player]！"

# game/scripts/Locations/bar.rpy:858
translate chinese_simp bar_katherine_truth_bf1acf2f:

    # katherine "I'm lucky you decided to come and confront me about all of this."
    katherine "你能来当面质问我，真是我的幸运。"

# game/scripts/Locations/bar.rpy:859
translate chinese_simp bar_katherine_truth_502b8a59:

    # katherine "And thank you for taking this risk for us... It means a lot to me..."
    katherine "也谢谢你为我们冒这个险……这对我意义重大……"

# game/scripts/Locations/bar.rpy:863
translate chinese_simp bar_katherine_truth_523702c3:

    # ava "Did you two..."
    ava "你们俩……"

# game/scripts/Locations/bar.rpy:864
translate chinese_simp bar_katherine_truth_2a44df43:

    # ava "Doesn't matter. Got no reason to doubt you, [player]..."
    ava "算了。我没有理由怀疑你，[player]……"

# game/scripts/Locations/bar.rpy:877
translate chinese_simp emma_taming_1_1e008891:

    # ava "Hey, [player]."
    ava "嘿，[player]。"

# game/scripts/Locations/bar.rpy:878
translate chinese_simp emma_taming_1_e81a3987:

    # player "Hey."
    player "嘿。"

# game/scripts/Locations/bar.rpy:882
translate chinese_simp emma_taming_1_db6aa360:

    # player "[emma] not at the bar today?"
    player "[emma]今天不在吧台？"

# game/scripts/Locations/bar.rpy:883
translate chinese_simp emma_taming_1_1d75aece:

    # ava "She is... She just went to get something in the back."
    ava "她在……刚去后面拿东西了。"

# game/scripts/Locations/bar.rpy:887
translate chinese_simp emma_taming_1_c3ffa17c:

    # ava "She has been gone for a while now..."
    ava "她去了一会儿了……"

# game/scripts/Locations/bar.rpy:888
translate chinese_simp emma_taming_1_844a78a0:

    # ava "Mind checking on her?"
    ava "帮我去看看她？"

# game/scripts/Locations/bar.rpy:889
translate chinese_simp emma_taming_1_aa75ffb7:

    # player "Sure..."
    player "好……"

# game/scripts/Locations/bar.rpy:893
translate chinese_simp emma_taming_1_ab729de4:

    # think "Not here..."
    think "不在这儿……"

# game/scripts/Locations/bar.rpy:896
translate chinese_simp emma_taming_1_5020a06d:

    # think "There she is..."
    think "在那儿……"

# game/scripts/Locations/bar.rpy:900
translate chinese_simp emma_taming_1_f6eb2ccf:

    # player "Can I help-"
    player "要我帮忙-"

# game/scripts/Locations/bar.rpy:904
translate chinese_simp emma_taming_1_e383e203:

    # emma "Ah!"
    emma "啊！"

# game/scripts/Locations/bar.rpy:913
translate chinese_simp emma_taming_1_ab47c79b:

    # player "Woah!"
    player "哇！"

# game/scripts/Locations/bar.rpy:914
translate chinese_simp emma_taming_1_fa35197e:

    # player "You okay?"
    player "你没事吧？"

# game/scripts/Locations/bar.rpy:918
translate chinese_simp emma_taming_1_6e3b2c6f:

    # emma "Y-yes..."
    emma "没，没事……"

# game/scripts/Locations/bar.rpy:921
translate chinese_simp emma_taming_1_d9a3a657:

    # emma "T-thank you... For catching me..."
    emma "谢……谢谢你……接住我……"

# game/scripts/Locations/bar.rpy:925
translate chinese_simp emma_taming_1_5838b889:

    # player "Sorry. Was kinda my fault for scaring you..."
    player "抱歉。都怪我吓到你了……"

# game/scripts/Locations/bar.rpy:928
translate chinese_simp emma_taming_1_06ce12b2:

    # emma "It's fine-"
    emma "没事的-"

# game/scripts/Locations/bar.rpy:929
translate chinese_simp emma_taming_1_bfc839da:

    # player "Did you find what you were looking for..?"
    player "找到你要找的东西了吗..？"

# game/scripts/Locations/bar.rpy:932
translate chinese_simp emma_taming_1_b6be3d5f:

    # emma "No... We probably ran out..."
    emma "没有……大概是用完了……"

# game/scripts/Locations/bar.rpy:935
translate chinese_simp emma_taming_1_e6a75c92:

    # emma "I just wanted to make sure before ordering more."
    emma "我只是想确认一下，免得重复下单。"

# game/scripts/Locations/bar.rpy:938
translate chinese_simp emma_taming_1_4416437b:

    # emma "I-I'll go back to work..."
    emma "我、我先回去工作了……"

# game/scripts/Locations/bar.rpy:941
translate chinese_simp emma_taming_1_aa75ffb7_1:

    # player "Sure..."
    player "好的……"

# game/scripts/Locations/bar.rpy:944
translate chinese_simp emma_taming_1_655b95e4:

    # ava "What happened in here?"
    ava "这里发生什么了？"

# game/scripts/Locations/bar.rpy:945
translate chinese_simp emma_taming_1_b879adee:

    # ava "She was completely red in the face, and I heard a scream?"
    ava "她脸完全红了，我还听到了一声尖叫？"

# game/scripts/Locations/bar.rpy:946
translate chinese_simp emma_taming_1_3bee3404:

    # player "She was on a box and I accidentally scared her..."
    player "她站在箱子上，我不小心吓到她了……"

# game/scripts/Locations/bar.rpy:949
translate chinese_simp emma_taming_1_8d68ef59:

    # ava "Okay... That explains the scream, what about the other thing?"
    ava "好吧……这解释了尖叫，那另一件事呢？"

# game/scripts/Locations/bar.rpy:950
translate chinese_simp emma_taming_1_d207b10d:

    # player "Well. I caught her in my arms..."
    player "呃，我把她接住了，抱在怀里……"

# game/scripts/Locations/bar.rpy:953
translate chinese_simp emma_taming_1_6df936c3:

    # ava "Oh, right. That adds up then."
    ava "哦，对。那就说得通了。"

# game/scripts/Locations/bar.rpy:954
translate chinese_simp emma_taming_1_218563d9:

    # ava "You here to finish the shift with us, right?"
    ava "你来跟我们一起上完这个班，对吧？"

# game/scripts/Locations/bar.rpy:955
translate chinese_simp emma_taming_1_f8495abb:

    # player "Right."
    player "对。"

# game/scripts/Locations/bar.rpy:958
translate chinese_simp emma_taming_1_7cbed109:

    # narrator "You spend the rest of the shift working at the bar."
    narrator "接下来你就在酒吧里忙完了剩下的班次。"

# game/scripts/Locations/bar.rpy:972
translate chinese_simp ava_taming_1_dd648c7e:

    # ava "You showed up! I guess [katherine] finally let you leave huh?"
    ava "你来了！我猜[katherine]终于肯放你走了，是吧？"

# game/scripts/Locations/bar.rpy:973
translate chinese_simp ava_taming_1_b76ab514:

    # player "Of course, I couldn't leave you hanging after you asked."
    player "当然了，你都开口了，我总不能放你鸽子。"

# game/scripts/Locations/bar.rpy:974
translate chinese_simp ava_taming_1_036e4b4d:

    # player "So, what's this job you needed help with?"
    player "所以，你找我帮忙的是什么活儿？"

# game/scripts/Locations/bar.rpy:978
translate chinese_simp ava_taming_1_cf54eb46:

    # ava "Well... Ever since we got the bar rebuilt, we've been getting a lot of eyes on us."
    ava "嗯……自从我们把酒吧重建好之后，就有很多人关注我们了。"

# game/scripts/Locations/bar.rpy:979
translate chinese_simp ava_taming_1_ddfb1589:

    # ava "And with us actually hiring you as security, the atmosphere around here changed quite a bit."
    ava "而且我们真的雇了你做安保，这里的气氛也变了不少。"

# game/scripts/Locations/bar.rpy:980
translate chinese_simp ava_taming_1_3aaf6560:

    # ava "Meaning we're getting visits from normal families, honest people who want to support a small business."
    ava "也就是说，我们现在会有普通家庭光顾了，都是些真心想支持小本生意的正派人。"

# game/scripts/Locations/bar.rpy:984
translate chinese_simp ava_taming_1_bf7672d5:

    # ava "Not just local drunks and weirdos like before..."
    ava "不像是以前那样，净是些本地醉鬼和怪人……"

# game/scripts/Locations/bar.rpy:985
translate chinese_simp ava_taming_1_1c9d5a96:

    # player "That makes sense, I did notice more and more \"normal\" people around..."
    player "有道理，我也确实注意到身边‘正常’的客人越来越多了……"

# game/scripts/Locations/bar.rpy:989
translate chinese_simp ava_taming_1_b8a12fc4:

    # ava "There have been quite a few requests for food. Especially family meal types, like pizza..."
    ava "有很多人开始询问食物了。特别是家庭餐那种类型的，像是披萨……"

# game/scripts/Locations/bar.rpy:990
translate chinese_simp ava_taming_1_1f46c127:

    # ava "And we've consistently had our tables full with new customers and nowhere to sit."
    ava "而且我们的桌子总是被新客人坐满，常常有人没位子坐。"

# game/scripts/Locations/bar.rpy:991
translate chinese_simp ava_taming_1_07850568:

    # ava "There are a few things we need to change or \"upgrade\" for us to be able to get those things sorted."
    ava "有些东西我们需要改一改或者‘升级’一下，才能把这些问题处理好。"

# game/scripts/Locations/bar.rpy:992
translate chinese_simp ava_taming_1_0226e684:

    # ava "We're already talking with the construction company to get the kitchen built."
    ava "我们已经在跟建筑公司谈建厨房的事情了。"

# game/scripts/Locations/bar.rpy:996
translate chinese_simp ava_taming_1_29c7aa04:

    # ava "We also ordered a bunch of stuff for the outside area, [emma] chose most of it, so I'm confident it's gonna look great!"
    ava "我们还给露天区域订了一堆东西，大部分是[emma]选的，所以我有信心，一定会很好看！"

# game/scripts/Locations/bar.rpy:997
translate chinese_simp ava_taming_1_fd93f306:

    # ava "But we bought it all online, and forgot to check the option to have them set everything up."
    ava "但是我们都是在网上买的，忘了勾选让他们帮忙组装好的选项。"

# game/scripts/Locations/bar.rpy:1001
translate chinese_simp ava_taming_1_a5a8acea:

    # ava "Right now everything is just sitting in the back waiting to be assembled..."
    ava "现在所有东西都堆在后面等着组装……"

# game/scripts/Locations/bar.rpy:1002
translate chinese_simp ava_taming_1_2eadb638:

    # player "I see why you needed me now... I'd be happy to take a look."
    player "我明白你为什么需要我了……我很乐意去看看。"

# game/scripts/Locations/bar.rpy:1006
translate chinese_simp ava_taming_1_29ee4991:

    # ava "You're the best! It shouldn't be hard, it's just tables, chairs and umbrellas. If you need help with anything let me know."
    ava "你最好了！应该不会很麻烦，就只是摆几张桌子、椅子和遮阳伞。要是有什么需要帮忙的，尽管告诉我。"
translate chinese_simp strings:
    old "You're the best! It shouldn't be hard, it's just tables, chairs and umbrellas. If you need help with anything let me know."
    new "你最好了！应该不会很麻烦，就只是摆几张桌子、椅子和遮阳伞。要是有什么需要帮忙的，尽管告诉我。"
# game/scripts/Locations/bar.rpy:1009
translate chinese_simp ava_taming_1_be9ee825:

    # narrator "You spend the rest of the day building the tables outside the bar."
    narrator "你花了一整天剩下的时间在酒吧外面组装桌椅。"

# game/scripts/Locations/bar.rpy:1016
translate chinese_simp ava_taming_1_a9aef82a:

    # think "Finally done... This took way longer than I thought it would..."
    think "终于搞定了……这比我想象的费时多了……"

# game/scripts/Locations/bar.rpy:1020
translate chinese_simp ava_taming_1_a2a7e353:

    # ava "Oh wow! You did all of this today? Thought it was gonna take you at least 2 days."
    ava "哇！你今天就全搞定了？我还以为你至少得花两天时间呢。"

# game/scripts/Locations/bar.rpy:1021
translate chinese_simp ava_taming_1_3d8d4a96:

    # player "Wanted to get it done as soon as possible."
    player "想尽快弄完。"

# game/scripts/Locations/bar.rpy:1032
translate chinese_simp ava_taming_2_3dd0197c:

    # ava "I got to admit, the outside looks really good, I knew it was fine to leave it in your hands!"
    ava "我得承认，外面看起来真的很棒，我就知道交给你准没错！"

# game/scripts/Locations/bar.rpy:1033
translate chinese_simp ava_taming_2_8648a647:

    # player "Thanks, but it was [emma] who picked them, I just put them up."
    player "谢了，但东西是[emma]挑的，我只是负责组装起来。"

# game/scripts/Locations/bar.rpy:1034
translate chinese_simp ava_taming_2_3014078e:

    # ava "Well, either way, we got people complimenting it already!"
    ava "不管怎么说，都已经有人在夸了！"

# game/scripts/Locations/bar.rpy:1035
translate chinese_simp ava_taming_2_3b81e2d1:

    # player "I've noticed that a lot recently... Everyone seems to be talking about us..."
    player "我最近也注意到了……感觉所有人都在讨论我们……"

# game/scripts/Locations/bar.rpy:1036
translate chinese_simp ava_taming_2_5d6e6c5e:

    # player "Everyone's really supportive... Must be the hate for the gang, rebuilding feels like laughing in their face."
    player "所有人都很支持……大概是因为大家都恨透了那个帮派吧。重新建设起来，就像是在他们脸上狠狠笑话他们一样。"

# game/scripts/Locations/bar.rpy:1040
translate chinese_simp ava_taming_2_c4924871:

    # ava "Does feel like that, doesn't it... I hope they don't retaliate again... Or worse..."
    ava "确实有这种感觉，是吧……希望他们不会再报复了……或者做出更过分的事……"

# game/scripts/Locations/bar.rpy:1041
translate chinese_simp ava_taming_2_c7f75686:

    # player "I told you I got that covered, the bar, [emma] and you are safe from them, I promise."
    player "我说过我已经处理好了，酒吧、[emma]还有你，他们都动不了的，我保证。"

# game/scripts/Locations/bar.rpy:1045
translate chinese_simp ava_taming_2_23c3fa41:

    # ava "If you say so... Now that I'm thinking back... You said you \"talked\" to this [aurora]?"
    ava "既然你这么说……不过话说回来……你说你‘谈’过那个[aurora]？"

# game/scripts/Locations/bar.rpy:1046
translate chinese_simp ava_taming_2_ba974fe7:

    # ava "And she just agreed to leave the bar alone, and not even bother with \"protection\" fees?"
    ava "她就那么干脆地同意不碰酒吧，连‘保护费’都不收了？"

# game/scripts/Locations/bar.rpy:1047
translate chinese_simp ava_taming_2_3004e3e0:

    # ava "That doesn't really make any sense, you'd have to offer something really big to her for that..."
    ava "这也太不合常理了，你肯定是给了她什么天大的好处才能谈成吧……"

# game/scripts/Locations/bar.rpy:1050
translate chinese_simp ava_taming_2_6a15efc6:

    # player "That's not exactly how it happened..."
    player "事情不是那样发展的……"

# game/scripts/Locations/bar.rpy:1051
translate chinese_simp ava_taming_2_cc3d634c:

    # player "She's a wolf girl, so when she saw me she tried to tame me but failed."
    player "她是狼族的，看到我的时候就想驯服我，但是没成功。"

# game/scripts/Locations/bar.rpy:1052
translate chinese_simp ava_taming_2_a5fd5be7:

    # player "After that you can imagine it was pretty easy to come to a deal with her..."
    player "之后，你应该也能想象到，和她谈条件就容易多了……"

# game/scripts/Locations/bar.rpy:1055
translate chinese_simp ava_taming_2_19253b6f:

    # ava "That makes much more sense..."
    ava "这听起来合理多了……"

# game/scripts/Locations/bar.rpy:1056
translate chinese_simp ava_taming_2_9687b0b4:

    # player "But I still got a bounty on my head from knocking him out..."
    player "不过我打晕了那个打手，所以还是背了赏金……"

# game/scripts/Locations/bar.rpy:1058
translate chinese_simp ava_taming_2_86add8cb:

    # think "I really want to tell her, but the smallest slip could get [aurora] in serious danger."
    think "我真的很想告诉她，但只要有一点差错，就可能让[aurora]陷入极大的危险。"

# game/scripts/Locations/bar.rpy:1059
translate chinese_simp ava_taming_2_3f0eabc2:

    # luna "I think it's safer to lie to her for now... Safer for everyone involved..."
    luna "我觉得现在还是骗她一下比较安全……对所有人都好……"

# game/scripts/Locations/bar.rpy:1060
translate chinese_simp ava_taming_2_3713ca19:

    # luna "Or at least not tell her the whole truth."
    luna "至少别把所有实情都告诉她。"

# game/scripts/Locations/bar.rpy:1061
translate chinese_simp ava_taming_2_58751bc4:

    # player "She said they're satisfied with what they did to the bar that day, and she agreed to leave it alone."
    player "她说他们对那天砸了酒吧已经满意了，并且同意不会再碰酒吧。"

# game/scripts/Locations/bar.rpy:1062
translate chinese_simp ava_taming_2_b69c078f:

    # player "The reason they did what they did was because of the grudge against me for knocking that guy out..."
    player "他们之所以会那么做，是因为我打晕了那个家伙，对我怀恨在心……"

# game/scripts/Locations/bar.rpy:1063
translate chinese_simp ava_taming_2_8b631597:

    # player "So while the bar is safe, I still have a bounty on my head."
    player "所以虽然酒吧是安全的，但我自己还是背着赏金。"

# game/scripts/Locations/bar.rpy:1066
translate chinese_simp ava_taming_2_fab92767:

    # ava "What? The gang as well as [katherine]'s family? You got two crime organizations after you, and it's all because of this place..."
    ava "什么？那个帮派还有[katherine]的家族？两个犯罪组织都在盯着你，而且全都是因为这个地方……"

# game/scripts/Locations/bar.rpy:1067
translate chinese_simp ava_taming_2_9416da59:

    # ava "Going through so much because of it... If you didn't already have it, I'd offer you co-ownership right now!"
    ava "因为你付出了这么多……如果你还不是共同所有人的话，我现在就想把这份所有权分给你！"

# game/scripts/Locations/bar.rpy:1068
translate chinese_simp ava_taming_2_6c799ee0:

    # ava "You deserve it just for that... Well, not like you didn't deserve it before..."
    ava "光是这一点你就完全配得上……不过，也不是说你以前就不配啦……"

# game/scripts/Locations/bar.rpy:1069
translate chinese_simp ava_taming_2_d6c95af7:

    # player "I appreciate that... But... We got a bit off track... What's the next thing you need me to do?"
    player "我很感激……不过……我们有点跑题了……你接下来需要我做什么？"

# game/scripts/Locations/bar.rpy:1073
translate chinese_simp ava_taming_2_b5c2d9b0:

    # ava "Oh. Sorry about that, yeah we need more staff, has to be a waitress."
    ava "哦。抱歉扯远了，我们需要更多人手，必须是女服务员。"

# game/scripts/Locations/bar.rpy:1074
translate chinese_simp ava_taming_2_d4f9747e:

    # player "Why a waitress?"
    player "为什么必须是女服务员？"

# game/scripts/Locations/bar.rpy:1075
translate chinese_simp ava_taming_2_39943444:

    # ava "It can be a waiter if it's the same species as [emma] and me..."
    ava "如果和我、[emma]是同一个种族的，那男服务员也行……"

# game/scripts/Locations/bar.rpy:1076
translate chinese_simp ava_taming_2_7becb033:

    # ava "I can't trust some new random dude around [emma] with the dangers of her getting tamed."
    ava "不能让随便一个陌生男的接近[emma]，那会让她有被驯服的危险。"

# game/scripts/Locations/bar.rpy:1077
translate chinese_simp ava_taming_2_76a8a22d:

    # ava "Same goes for me, but you know how [emma] is, she doesn't have the strongest of wills..."
    ava "我也一样，但你知道[emma]的性格，她的意志不算强……"

# game/scripts/Locations/bar.rpy:1078
translate chinese_simp ava_taming_2_b74af4cd:

    # ava "The only reason you got hired was because [emma] asked me to."
    ava "当时你会被雇用的唯一原因，就是[emma]让我这么做的。"

# game/scripts/Locations/bar.rpy:1079
translate chinese_simp ava_taming_2_2676835a:

    # ava "You're fine now, but back then I wouldn't have hired you myself..."
    ava "现在当然没问题了，但那时候我是不会主动雇佣你的……"

# game/scripts/Locations/bar.rpy:1080
translate chinese_simp ava_taming_2_192f9374:

    # player "I understand... It makes sense."
    player "我明白……这很合理。"

# game/scripts/Locations/bar.rpy:1081
translate chinese_simp ava_taming_2_e9ce2de6:

    # ava "I just put the ad up, when you're ready you can hold the interviews in the morning."
    ava "我刚刚把招聘广告贴出去了。你准备好了的话，可以早上来面试。"

# game/scripts/Locations/bar.rpy:1093
translate chinese_simp emma_taming_2_503d3fe1:

    # ava "Hey, [player]!"
    ava "嘿，[player]！"

# game/scripts/Locations/bar.rpy:1094
translate chinese_simp emma_taming_2_13ca50d8:

    # ava "You got some timing."
    ava "你来得正是时候。"

# game/scripts/Locations/bar.rpy:1095
translate chinese_simp emma_taming_2_1a2f1979:

    # player "Why? What's going on?"
    player "为什么？出什么事了？"

# game/scripts/Locations/bar.rpy:1098
translate chinese_simp emma_taming_2_cf3e7a4b:

    # ava "We're going shopping!"
    ava "我们要去逛街！"

# game/scripts/Locations/bar.rpy:1099
translate chinese_simp emma_taming_2_0e3a7de3:

    # ava "Now that the business is booming, we're gonna treat ourselves a little~"
    ava "现在生意这么好，我们打算犒劳一下自己~"

# game/scripts/Locations/bar.rpy:1100
translate chinese_simp emma_taming_2_390be837:

    # player "That's great to hear, you two deserve it."
    player "那太好了，你们两个也该好好享受一下。"

# game/scripts/Locations/bar.rpy:1103
translate chinese_simp emma_taming_2_fe287565:

    # ava "You wanna come with? You're part of the business too."
    ava "你要一起来吗？你也是生意的一份子啊。"

# game/scripts/Locations/bar.rpy:1104
translate chinese_simp emma_taming_2_dbc11eb5:

    # player "Sure, I'd love to."
    player "好啊，我很乐意。"

# game/scripts/Locations/bar.rpy:1108
translate chinese_simp emma_taming_2_90c5111a:

    # ava "Where do you wanna start, [emma]?"
    ava "[emma]，你想先去哪儿？"

# game/scripts/Locations/bar.rpy:1109
translate chinese_simp emma_taming_2_ab32d165:

    # emma "Uhh... With clothes..?"
    emma "呃……先去服装店……？"

# game/scripts/Locations/bar.rpy:1110
translate chinese_simp emma_taming_2_bee0bfb8:

    # ava "That sounds fun! Let's go!"
    ava "听起来不错！我们走！"

# game/scripts/Locations/bar.rpy:1113
translate chinese_simp emma_taming_2_2114749c:

    # ava "You good to wait out here while we try on a few outfits?"
    ava "我们试几件衣服的时候，你在这儿等会儿没问题吧？"

# game/scripts/Locations/bar.rpy:1114
translate chinese_simp emma_taming_2_644397ae:

    # player "Of course, I don't plan on buying any new clothes anyways."
    player "当然，反正我也不打算买新衣服。"

# game/scripts/Locations/bar.rpy:1115
translate chinese_simp emma_taming_2_e7f167a1:

    # ava "Alright."
    ava "好吧。"

# game/scripts/Locations/bar.rpy:1118
translate chinese_simp emma_taming_2_d43fb55a:

    # think "I guess I just wait for them to come out..."
    think "看来我就在这儿等她们出来吧……"

# game/scripts/Locations/bar.rpy:1122
translate chinese_simp emma_taming_2_8bf6679f:

    # luna "You could always just look around... Maybe there's something you'd like~"
    luna "你也可以四处看看啊……说不定有你想要的东西呢~"

# game/scripts/Locations/bar.rpy:1123
translate chinese_simp emma_taming_2_e4f7a5e9:

    # think "There's not much for me in the women's section..."
    think "我在女装区也没什么东西好逛的……"

# game/scripts/Locations/bar.rpy:1126
translate chinese_simp emma_taming_2_4cb953fa:

    # luna "That's fair I guess..."
    luna "好吧，这倒也是……"

# game/scripts/Locations/bar.rpy:1129
translate chinese_simp emma_taming_2_a542d9c8:

    # ava "What do you think?"
    ava "你觉得怎么样？"

# game/scripts/Locations/bar.rpy:1132
translate chinese_simp emma_taming_2_42ced3d8:

    # ava "C'mon [emma]... Get out here."
    ava "别害羞了，[emma]……出来吧。"

# game/scripts/Locations/bar.rpy:1135
translate chinese_simp emma_taming_2_64f23c9d:

    # ava "You look absolutely breathtaking in that dress!"
    ava "你穿这条裙子简直美得让人窒息！"

# game/scripts/Locations/bar.rpy:1136
translate chinese_simp emma_taming_2_6f8ab6ee:

    # emma "Stop..."
    emma "别说了……"

# game/scripts/Locations/bar.rpy:1139
translate chinese_simp emma_taming_2_e2cc5167:

    # ava "Thoughts?"
    ava "你觉得呢？"

# game/scripts/Locations/bar.rpy:1140
translate chinese_simp emma_taming_2_0d735dbd:

    # player "You both look amazing."
    player "你们两个都很美。"

# game/scripts/Locations/bar.rpy:1141
translate chinese_simp emma_taming_2_e9cbc586:

    # ava "Glad you think so, we're probably not gonna buy these, but it was fun trying them on~"
    ava "很高兴你这么想。我们大概不会买，但试穿一下也挺好玩的~"

# game/scripts/Locations/bar.rpy:1144
translate chinese_simp emma_taming_2_10ba7330:

    # ava "Let's go change into something more casual."
    ava "我们去换身更休闲的衣服吧。"

# game/scripts/Locations/bar.rpy:1147
translate chinese_simp emma_taming_2_c9aafc1d:

    # luna "[emma] looked really beautiful in that..."
    luna "[emma]穿那件真的很漂亮……"

# game/scripts/Locations/bar.rpy:1148
translate chinese_simp emma_taming_2_ecb4b325:

    # think "Yeah she did..."
    think "是啊……真的美……"

# game/scripts/Locations/bar.rpy:1149
translate chinese_simp emma_taming_2_2b81b4fc:

    # luna "She seemed really uncomfortable, you should say something next time."
    luna "她看起来不太自在，下次你该主动说点什么。"

# game/scripts/Locations/bar.rpy:1150
translate chinese_simp emma_taming_2_202e9823:

    # think "Yeah, yeah..."
    think "好好好……"

# game/scripts/Locations/bar.rpy:1153
translate chinese_simp emma_taming_2_f5fe702d:

    # ava "These are more our styles~"
    ava "这些更适合我们~"

# game/scripts/Locations/bar.rpy:1154
translate chinese_simp emma_taming_2_b8fcbd05:

    # ava "Even though [emma] doesn't really agree, had to drag her out here..."
    ava "虽然[emma]不太情愿，我还是硬把她拉出来了……"

# game/scripts/Locations/bar.rpy:1155
translate chinese_simp emma_taming_2_5d348c55:

    # ava "Doesn't seem like the biggest fan of that shirt."
    ava "看起来她不太喜欢那件上衣。"

# game/scripts/Locations/bar.rpy:1156
translate chinese_simp emma_taming_2_c36c9857:

    # player "I think she looks amazing in it..."
    player "我觉得她穿那件很好看……"

# game/scripts/Locations/bar.rpy:1159
translate chinese_simp emma_taming_2_e9603c8f:

    # ava "Right?"
    ava "是吧？"

# game/scripts/Locations/bar.rpy:1160
translate chinese_simp emma_taming_2_2d698981:

    # emma "Th-thank you..."
    emma "谢、谢谢……"

# game/scripts/Locations/bar.rpy:1163
translate chinese_simp emma_taming_2_ab9054cc:

    # ava "She fills it out perfectly~"
    ava "她穿起来身材曲线完美~"

# game/scripts/Locations/bar.rpy:1164
translate chinese_simp emma_taming_2_444af8de:

    # ava "Let's go change back, we're buying these, right?"
    ava "我们去换回来吧，我们就买这些了，对吧？"

# game/scripts/Locations/bar.rpy:1167
translate chinese_simp emma_taming_2_fa6bbd80:

    # emma "Yes."
    emma "嗯。"

# game/scripts/Locations/bar.rpy:1170
translate chinese_simp emma_taming_2_8445fe56:

    # luna "That was a quick 'Yes', told you complimenting her would do you good~"
    luna "这个‘嗯’答应得可真快。我说了吧，夸她肯定没坏处~"

# game/scripts/Locations/bar.rpy:1173
translate chinese_simp emma_taming_2_8bf6679f_1:

    # luna "You could always just look around... Maybe there's something you'd like~"
    luna "你也可以四处看看啊……说不定有你想要的东西呢~"

