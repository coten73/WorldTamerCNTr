# game/scripts/Locations/bar.rpy:705
translate chinese_simp bar_katherine_meeting_2c5ed5c0:

    # katherine "Oh! You must be so confused. I'm [katherine], I'm [ava] and [emma]'s mother."
    katherine "哦！你一定觉得很困惑吧。我是[katherine]，我是[ava]和[emma]的母亲。"

# game/scripts/Locations/bar.rpy:999
translate chinese_simp ava_taming_1_1f46c127:

    # ava "And we've consistently had our tables full with new customers and nowhere to sit."
    ava "而且我们的桌子总是被新客人坐满，常常有人没位子坐。"