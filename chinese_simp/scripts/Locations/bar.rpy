# game/scripts/Locations/bar.rpy:753
translate chinese_simp bar_katherine_meeting_7eadea28:

    # think "This should be far enough, just need to make sure I don't lose her, she's going quite fast."
    think "这个距离应该够了，但得跟紧点，她走得挺快的。"

# game/scripts/Locations/bar.rpy:757
translate chinese_simp bar_katherine_meeting_2dca41b9:

    # luna "Looks like she's getting a phone call..."
    luna "她好像接了个电话……"

# game/scripts/Locations/bar.rpy:761
