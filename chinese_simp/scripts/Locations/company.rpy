    # player "Any advice on what I should do..?"
    player "有什么建议吗...？"

# game/scripts/Locations/company.rpy:2302
translate chinese_simp company_letter_demands_d8160acf:

    # kora "Give me a few days and I'll take care of it."
    kora "给我几天时间，我来处理。"

# game/scripts/Locations/company.rpy:2303
translate chinese_simp company_letter_demands_4859e1c5:

    # player "A few days? I don't think they'll wait that long. And if they start going after people on that list-"
    player "几天？我觉得他们不会等那么久。如果他们开始对名单上的人下手-"

# game/scripts/Locations/company.rpy:2306
translate chinese_simp company_letter_demands_4e6048bd:

    # kora "Just live your life as if you never got this."
    kora "就当没收到过这封信，正常生活。"

# game/scripts/Locations/company.rpy:2307
translate chinese_simp company_letter_demands_6e671ef5:

    # kora "I'll make sure they do the same."
    kora "我会确保他们也这么想。"

# game/scripts/Locations/company.rpy:2308
translate chinese_simp company_letter_demands_9723d159:

