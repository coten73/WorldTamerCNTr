translate chinese_simp company_rescue_followup_ae695d2b:

    # kora "A Trap."
    kora "一个陷阱。"

# game/scripts/Locations/company.rpy:2063
translate chinese_simp company_rescue_followup_b1c6718b:

    # player "Come on... You have to give me more than that..."
    player "拜托...你得说得具体点..."

# game/scripts/Locations/company.rpy:2066
translate chinese_simp company_rescue_followup_5dcdc0a2:

    # kora "Fine. They hired her to build a place where time moved differently."
    kora "好吧。他们雇她建造一个时间流速不同的地方。"

# game/scripts/Locations/company.rpy:2067
translate chinese_simp company_rescue_followup_65750553:

    # kora "It was meant to accelerate research-experiments, projects, whatever they wanted finished faster."
    kora "目的是加速研究——实验、项目，任何他们想更快完成的东西。"

# game/scripts/Locations/company.rpy:2070
translate chinese_simp company_rescue_followup_a31f6461:

    # kora "After she found out what they're trying to do, she wanted no part in it."
    kora "当她发现他们想干什么之后，她不想再参与了。"

# game/scripts/Locations/company.rpy:2071
translate chinese_simp company_rescue_followup_c84fbcce:

    # kora "They obviously didn't like that, so they kidnapped her."
    kora "他们显然不乐意，所以就绑架了她。"

# game/scripts/Locations/company.rpy:2074
translate chinese_simp company_rescue_followup_ae8b344a:

    # kora "In retaliation she separated herself from that dimension, making it one-way."
    kora "作为报复，她将自己与那个维度剥离，让它变成单向的。"

# game/scripts/Locations/company.rpy:2075
translate chinese_simp company_rescue_followup_b34630ef:

    # kora "Since it was now useless, they decided to use it as a prison."
    kora "既然已经没用了，他们就决定把它当作监狱。"

# game/scripts/Locations/company.rpy:2076
translate chinese_simp company_rescue_followup_7a289425:

    # player "But they only ever put two people in there?"
    player "但他们只放了两个人进去？"

# game/scripts/Locations/company.rpy:2079
translate chinese_simp company_rescue_followup_a689982c:

    # kora "Much more effective to just kill who's giving you trouble."
    kora "直接杀掉麻烦的人更有效率。"

# game/scripts/Locations/company.rpy:2080
translate chinese_simp company_rescue_followup_028b34b0:

    # kora "The island was meant for people they couldn't kill."
    kora "那个岛是为他们杀不了的人准备的。"

