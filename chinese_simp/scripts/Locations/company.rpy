    # player "I think you've told me enough for now..."
    player "暂时应该够了..."

# game/scripts/Locations/company.rpy:2145
translate chinese_simp company_rescue_followup_41fe04a9:

    # kora "Then leave us be, she needs the quiet."
    kora "那别打扰我们了，她需要安静。"

