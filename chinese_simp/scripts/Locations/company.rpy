    player "我明白。有什么事就给我打电话。"

# game/scripts/Locations/company.rpy:2974
translate chinese_simp company_valerie_distraction_598b0978:

    # valerie "I will, thank you."
    valerie "好，谢谢。"

# game/scripts/Locations/company.rpy:3070
translate chinese_simp company_second_aftermath_a5159006:

