translate chinese_simp company_rescue_followup_8ce15288:

    # player "Right. Thanks for answering my questions..."
    player "好。谢谢你回答我的问题..."

# game/scripts/Locations/company.rpy:2147
translate chinese_simp company_rescue_followup_fbd9acdd:

    # kora "...mhm..."
    kora "...嗯..."

# game/scripts/Locations/company.rpy:2152
translate chinese_simp company_rescue_followup_201fb054:

    # astra "That was quick. You done already?"
    astra "挺快的。聊完了？"

