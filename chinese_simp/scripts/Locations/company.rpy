    # kora "But don't hold your breath this time."
    kora "但这次别抱太大希望。"

# game/scripts/Locations/company.rpy:3156
translate chinese_simp company_second_aftermath_03775ec8:

    # player "..."
    player "..."

# game/scripts/Locations/company.rpy:3159
translate chinese_simp company_second_aftermath_35beed9f:

    # nova "We're in a good spot now, we have leverage."
    nova "我们现在处境不错，手上有筹码了。"

# game/scripts/Locations/company.rpy:3160
translate chinese_simp company_second_aftermath_87c91ff2:

    # player "Even if you don't find anything useful in those files?"
    player "就算那些文件里没什么有用的东西？"

# game/scripts/Locations/company.rpy:3163
translate chinese_simp company_second_aftermath_3baaecec:

    # nova "[sophia] was mad that we stole them."
    nova "[sophia]因为我们偷了文件而大发雷霆。"

# game/scripts/Locations/company.rpy:3164
translate chinese_simp company_second_aftermath_d640ba0a:

    # nova "As long as she thinks we found what she's trying to hide we're good."
    nova "只要她以为我们发现了她想藏的东西，我们就占了上风。"

# game/scripts/Locations/company.rpy:3165
translate chinese_simp company_second_aftermath_d2d76725:

    # player "I see."
    player "我明白了。"

# game/scripts/Locations/company.rpy:3166
translate chinese_simp company_second_aftermath_799c96ab:

    # player "Well either way, there's no way to get back in there now."
    player "不管怎么说，现在已经没法再进去了。"

# game/scripts/Locations/company.rpy:3167
translate chinese_simp company_second_aftermath_3887af83:

    # player "I don't have access to that floor anymore."
    player "我已经没有那层楼的权限了。"

# game/scripts/Locations/company.rpy:3170
translate chinese_simp company_second_aftermath_d10b8470:

    # kora "You don't have to worry about that. We made sure there's a way in there if we need it."
    kora "你不用担心这个。我们已经确保如果需要的话，有办法进去。"

# game/scripts/Locations/company.rpy:3171
translate chinese_simp company_second_aftermath_f739a7fb:

    # player "Right... [nova]'s a powerful celestial..."
    player "对...[nova]是强大的天族..."

# game/scripts/Locations/company.rpy:3174
translate chinese_simp company_second_aftermath_bb0af65c:

    # nova "We'll call you when there's another development."
    nova "有新的进展我们会联系你。"

# game/scripts/Locations/company.rpy:3175
translate chinese_simp company_second_aftermath_41e60ee7:

    # player "I guess that's fine for now..."
    player "暂时也只能这样了..."

# game/scripts/Locations/company.rpy:3176
translate chinese_simp company_second_aftermath_603b9f88:

    # think "Sounds like they got something important after all."
    think "听起来她们确实找到了重要的东西。"

