translate chinese_simp company_rescue_followup_55684261:

    # astra "I got a nurse friend to come over and check on her."
    astra "我请了一位护士朋友过来帮她看了看。"

# game/scripts/Locations/company.rpy:2172
translate chinese_simp company_rescue_followup_bb2d7c21:

    # astra "All she needs at this point is sleep."
    astra "她现在需要的就是睡眠。"

# game/scripts/Locations/company.rpy:2173
