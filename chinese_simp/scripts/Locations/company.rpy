    # kora "We'll figure it out when the time comes. I'll follow her lead."
    kora "到时候再说。我会听她的。"

# game/scripts/Locations/company.rpy:2116
translate chinese_simp company_rescue_followup_c5b00b4c:

    # nova "...mmmnnn..."
    nova "...嗯嗯嗯..."

