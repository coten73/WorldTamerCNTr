    # player "Thanks... Bye."
    player "谢了...再见。"

# game/scripts/Locations/company.rpy:1286
translate chinese_simp field_job_seven_payment_5c49e0f5:

    # sophia "And by the way-"
    sophia "对了-"

# game/scripts/Locations/company.rpy:1287
translate chinese_simp field_job_seven_payment_0d3d31ef:

    # player "Hmm?"
    player "嗯？"

# game/scripts/Locations/company.rpy:1290
translate chinese_simp field_job_seven_payment_d289b9a4:

    # sophia "You intend to stick around from now on, right?"
    sophia "你以后打算好好待着不走了，对吧？"

# game/scripts/Locations/company.rpy:1291
translate chinese_simp field_job_seven_payment_dbd81e72:

    # luna "I think she knows exactly what happened to you."
    luna "我觉得她知道你身上发生过什么事。"

# game/scripts/Locations/company.rpy:1292
translate chinese_simp field_job_seven_payment_3ddb6a49:

    # think "I wonder if she's telling me to stop snooping around the company..."
    think "她这是在警告我别再在公司里打探了吧..."

# game/scripts/Locations/company.rpy:1293
translate chinese_simp field_job_seven_payment_83a64de9:

    # player "Yes. Something unexpected came up."
    player "当然。出了点意外状况。"

# game/scripts/Locations/company.rpy:1294
translate chinese_simp field_job_seven_payment_52602b26:

    # player "I'm more prepared now... It won't surprise me again."
    player "现在我有准备了...不会再被吓到。"

# game/scripts/Locations/company.rpy:1297
translate chinese_simp field_job_seven_payment_ed2aaf90:

    # sophia "That's great to hear, hope it works out for you!"
    sophia "那就好，祝你好运！"

# game/scripts/Locations/company.rpy:1298
translate chinese_simp field_job_seven_payment_943e0992:

    # player "It will."
    player "会的。"

# game/scripts/Locations/company.rpy:1301
translate chinese_simp field_job_seven_payment_51c37605:

    # sophia "Just know that we're all happy to have you back!"
    sophia "要知道，我们都很欢迎你回来！"

# game/scripts/Locations/company.rpy:1302
translate chinese_simp field_job_seven_payment_62c6acbf:

    # player "Happy to be back..."
    player "回来真好..."

# game/scripts/Locations/company.rpy:1306
translate chinese_simp field_job_seven_payment_3d561f89:

    # luna "She's definitely part of whatever's going on around here..."
    luna "她绝对是这里一切阴谋的一部分..."

# game/scripts/Locations/company.rpy:1321
translate chinese_simp field_job_eight_1_9dab6dc1:

    # player "Is there any more work for me to do..?"
    player "还有什么工作需要我做吗...？"

# game/scripts/Locations/company.rpy:1322
translate chinese_simp field_job_eight_1_fda91850:

    # valerie "Yes, [sophia]'s waiting for you."
    valerie "有，[sophia]在等你。"

# game/scripts/Locations/company.rpy:1325
translate chinese_simp field_job_eight_1_088a0bf8:

    # sophia "Let's get right to it."
    sophia "我们开门见山吧。"

# game/scripts/Locations/company.rpy:1326
translate chinese_simp field_job_eight_1_7d12db63:

    # sophia "I've been asked by my boss to present you with an offer."
    sophia "我老板让我给你一个提议。"

# game/scripts/Locations/company.rpy:1327
translate chinese_simp field_job_eight_1_82450268:

    # player "Offer?"
    player "提议？"

# game/scripts/Locations/company.rpy:1330
translate chinese_simp field_job_eight_1_f9fbe7ff:

    # sophia "Yes. It's concerning your position here at the company."
    sophia "对。跟你在这里的职位有关。"

# game/scripts/Locations/company.rpy:1331
translate chinese_simp field_job_eight_1_90f959e2:

    # sophia "Also. Let's not play this game any longer. We both know what's going on here."
    sophia "还有，我们别再玩那些把戏了。我们都清楚这里是怎么回事。"

# game/scripts/Locations/company.rpy:1332
translate chinese_simp field_job_eight_1_03775ec8:

    # player "..."
    player "..."

# game/scripts/Locations/company.rpy:1335
translate chinese_simp field_job_eight_1_97196733:

    # sophia "We know that you have an elf living in your house."
    sophia "我们知道你家里住着一个精灵。"

# game/scripts/Locations/company.rpy:1336
translate chinese_simp field_job_eight_1_347e2351:

    # think "I shouldn't be too surprised. They probably have people watching... but I wonder how sure she is about it."
    think "这倒也不意外。他们八成有人在监视...但不知道她有多确定。"

# game/scripts/Locations/company.rpy:1339
translate chinese_simp field_job_eight_1_47e93436:

    # player "What elf?"
    player "什么精灵？"

# game/scripts/Locations/company.rpy:1340
translate chinese_simp field_job_eight_1_2ba9a33d:

    # sophia "Stop playing games. Who do you think sent her your way?"
    sophia "别装了。你以为是谁把她送到你身边的？"

# game/scripts/Locations/company.rpy:1341
translate chinese_simp field_job_eight_1_39335316:

    # think "Considering everything that's happened, I really doubt [ellie]'s working with them..."
    think "考虑到所有发生的事，我实在很难相信[ellie]跟他们是一伙的..."

# game/scripts/Locations/company.rpy:1342
translate chinese_simp field_job_eight_1_46dc412f:

    # player "You sent her?"
    player "是你派她来的？"

# game/scripts/Locations/company.rpy:1345
translate chinese_simp field_job_eight_1_6a538446:

    # sophia "In a manner of speaking."
    sophia "可以这么说。"

# game/scripts/Locations/company.rpy:1346
translate chinese_simp field_job_eight_1_88efe640:

    # sophia "We've been keeping tabs on her for a few years now."
    sophia "我们观察她已经好几年了。"

# game/scripts/Locations/company.rpy:1347
translate chinese_simp field_job_eight_1_01305f52:

    # player "Why not take her yourself then?"
    player "那你们为什么不亲自动手？"

# game/scripts/Locations/company.rpy:1350
translate chinese_simp field_job_eight_1_14f007e3:

    # sophia "She could run away if spooked. And we wouldn't want that, would we~?"
    sophia "她要是受惊了可能会跑掉。我们可不希望那样，对吧~？"

# game/scripts/Locations/company.rpy:1351
translate chinese_simp field_job_eight_1_8f24672a:

    # think "[aurora] didn't have a problem catching her..."
    think "[aurora]抓她的时候可没费什么劲..."

# game/scripts/Locations/company.rpy:1352
translate chinese_simp field_job_eight_1_80776a38:

    # player "So you send her my way?"
    player "所以你们就把她送到我这里来了？"

# game/scripts/Locations/company.rpy:1355
translate chinese_simp field_job_eight_1_09206298:

    # sophia "Yes. If she trusts you, and you bring her to us willingly... There's a much higher chance of success."
    sophia "对。如果她信任你，而你又愿意主动把她带给我们...成功的概率就大得多。"

# game/scripts/Locations/company.rpy:1358
translate chinese_simp field_job_eight_1_1f2cab60:

    # sophia "Which brings me to my offer."
    sophia "所以，我提出这个条件。"

# game/scripts/Locations/company.rpy:1359
translate chinese_simp field_job_eight_1_6f439e7d:

    # sophia "I've been allowed to bring you into the fold and give you quite a big raise, which we both know you want—and is the only reason you're working here in the first place."
    sophia "我已经获得许可，可以把你吸纳进来，并且给你一大笔加薪。我们都知道你想要的——这也是你一开始在这里工作的唯一理由。"

# game/scripts/Locations/company.rpy:1362
translate chinese_simp field_job_eight_1_7e2aa9eb:

    # sophia "All you have to do is bring us the elf."
    sophia "你只要做的就是把那个精灵带给我们。"

# game/scripts/Locations/company.rpy:1363
translate chinese_simp field_job_eight_1_2920d744:

    # player "Why?"
    player "为什么？"

# game/scripts/Locations/company.rpy:1366
translate chinese_simp field_job_eight_1_177b7380:

    # sophia "You let us worry about that for now. But once you bring her, you'll find out everything."
    sophia "这个你现在不必操心。等你把她带来，自然会知道一切。"

# game/scripts/Locations/company.rpy:1367
translate chinese_simp field_job_eight_1_cab0fd92:

    # think "They must know I'd never do this... Or are they betting on me being ready to throw anything away for information about my parents..?"
    think "他们肯定知道我不会这么做...还是说他们在赌我愿意为了父母的消息放弃一切...？"

# game/scripts/Locations/company.rpy:1368
translate chinese_simp field_job_eight_1_2f6a75e8:

    # player "I'll have to think about it."
    player "我得考虑一下。"

# game/scripts/Locations/company.rpy:1371
translate chinese_simp field_job_eight_1_c1ad231e:

    # sophia "Fine. You know where to bring her."
    sophia "行。你知道该带她去哪里。"

# game/scripts/Locations/company.rpy:1372
translate chinese_simp field_job_eight_1_51ed66c1:

    # player "And what if I choose to not do it?"
    player "如果我不打算这么做呢？"

# game/scripts/Locations/company.rpy:1375
translate chinese_simp field_job_eight_1_3d37cc3c:

    # sophia "Then I might have to start thinking about your current position, and asking myself how committed you really are to the cause~"
    sophia "那我可能就得重新考虑你的职位了，顺便想想你对这份‘事业’到底有多上心~"

# game/scripts/Locations/company.rpy:1376
translate chinese_simp field_job_eight_1_722b8585:

    # player "So you'll fire me if I don't do it?"
    player "所以我不干的话你就要解雇我？"

# game/scripts/Locations/company.rpy:1379
translate chinese_simp field_job_eight_1_107ceba5:

    # sophia "I didn't say that. But I'll for sure have to start thinking about it~"
    sophia "我没那么说。但肯定会开始考虑这个选项~"

# game/scripts/Locations/company.rpy:1380
translate chinese_simp field_job_eight_1_9cc4157e:

    # think "If this offer really came from her boss as she said, then they probably want me here, so I doubt she'll be able to just fire me..."
    think "如果这个提议真像她说的来自老板，那他们应该是想留我在这里的，她恐怕没那么容易解雇我..."

# game/scripts/Locations/company.rpy:1381
translate chinese_simp field_job_eight_1_3fe4c975:

    # think "I'll have to call her bluff, but I should still talk to [ellie] about all of this. She might know something."
    think "我得戳穿她的虚张声势，不过还是应该跟[ellie]谈谈这件事。她或许知道些什么。"

# game/scripts/Locations/company.rpy:1392
translate chinese_simp field_job_eight_2_4e649f3d:

    # player "[ellie], I wanted to talk to you about something..."
    player "[ellie]，我想跟你聊点事..."

# game/scripts/Locations/company.rpy:1393
translate chinese_simp field_job_eight_2_00806a9c:

    # ellie "Sounds serious... What is it..?"
    ellie "听起来很严重...什么事啊...？"

# game/scripts/Locations/company.rpy:1394
translate chinese_simp field_job_eight_2_baf978c4:

    # player "You know anything about [company]?"
    player "你知道[company]的情况吗？"

# game/scripts/Locations/company.rpy:1397
translate chinese_simp field_job_eight_2_741d3c9d:

    # ellie "A little..."
    ellie "知道一点点..."

# game/scripts/Locations/company.rpy:1398
translate chinese_simp field_job_eight_2_00e189c6:

    # player "Well I've been working there for a bit, and they made me a really strange offer."
    player "我在那儿工作了一阵子，他们给了我一个很奇怪的提议。"

# game/scripts/Locations/company.rpy:1399
translate chinese_simp field_job_eight_2_cb44cad3:

    # player "I don't know how to say it, but they really want to have you."
    player "我不知道该怎么说，但他们真的很想要你。"

# game/scripts/Locations/company.rpy:1402
translate chinese_simp field_job_eight_2_fe673b1c:

    # ellie "Me?"
    ellie "我？"

# game/scripts/Locations/company.rpy:1403
translate chinese_simp field_job_eight_2_b21b3e53:

    # player "Whatever it is, it's not good, but I still wanted to ask if you know anything about it."
    player "不管为什么，肯定不是什么好事。但我还是想问问你知不知道些什么。"

# game/scripts/Locations/company.rpy:1404
translate chinese_simp field_job_eight_2_972eba20:

    # player "How exactly did you find out about me being able to untame people?"
    player "你到底是怎么知道我能‘解除驯化’的？"

# game/scripts/Locations/company.rpy:1407
translate chinese_simp field_job_eight_2_cd059ae8:

    # ellie "I don't know... I overheard people talking about it... No one told me directly..."
    ellie "我不知道...我是无意中听到别人说的...没人直接告诉我..."

# game/scripts/Locations/company.rpy:1408
translate chinese_simp field_job_eight_2_80f43fc9:

    # player "That makes sense. It was probably planted so you'd look for me... and end up here..."
    player "这就说得通了。很可能是故意放出的消息，让你来找我...然后来到我这里..."

# game/scripts/Locations/company.rpy:1411
translate chinese_simp field_job_eight_2_2eb9ac10:

    # ellie "Why would they want me here?"
    ellie "他们为什么要让我来找你？"

# game/scripts/Locations/company.rpy:1412
translate chinese_simp field_job_eight_2_8975f7d0:

    # player "So I could take you to them willingly."
    player "这样我就能主动把你送到他们那里去。"

# game/scripts/Locations/company.rpy:1415
translate chinese_simp field_job_eight_2_52e58028:

    # ellie "Are you-"
    ellie "你该不会-"

# game/scripts/Locations/company.rpy:1416
translate chinese_simp field_job_eight_2_da071ef7:

    # player "I have zero intention of taking their offer."
    player "我根本没打算接受他们的条件。"

# game/scripts/Locations/company.rpy:1417
translate chinese_simp field_job_eight_2_fad22877:

    # think "I want to learn more about the company, sure, but not with this kind of deal..."
    think "我确实想查清这家公司，但不能用这种方式..."

# game/scripts/Locations/company.rpy:1420
translate chinese_simp field_job_eight_2_55fd22cc:

    # ellie "Thank you. I don't really know what's going on, but that still means a lot."
    ellie "谢谢你。虽然我不太清楚怎么回事，但你能这么说，我很感激。"

# game/scripts/Locations/company.rpy:1421
translate chinese_simp field_job_eight_2_c90ce4af:

    # player "Do you know why they'd want you so badly? Any guesses?"
    player "你知道他们为什么这么想要你吗？能猜猜看吗？"

# game/scripts/Locations/company.rpy:1424
translate chinese_simp field_job_eight_2_e4158178:

    # ellie "Well, my best guess... I'm an elf. We're rare, but not that rare. The thing is..."
    ellie "嗯，我猜...我是精灵。精灵虽然稀少，但也不是特别罕见。问题是..."

# game/scripts/Locations/company.rpy:1425
translate chinese_simp field_job_eight_2_125095b5:

    # ellie "I'm the daughter of a village chief, so I'm very proficient with magic. Combine that with my age—"
    ellie "我是村长的女儿，所以魔法非常精通。再加上我的年龄-"

# game/scripts/Locations/company.rpy:1426
translate chinese_simp field_job_eight_2_14bf5b5f:

    # player "And you've got something pretty special."
    player "那你就有很特别的价值了。"

# game/scripts/Locations/company.rpy:1429
translate chinese_simp field_job_eight_2_d44945ef:

    # ellie "Yeah... Sorry I can't be more helpful."
    ellie "嗯...抱歉没能帮上更多忙。"

# game/scripts/Locations/company.rpy:1430
translate chinese_simp field_job_eight_2_281dfe10:

    # player "Don't apologize, it's fine. I'll be turning them down in a few days, though, so be ready. I don't know what they'll try after."
    player "别道歉，没关系。不过，我过几天就会拒绝他们，你做好心理准备。不知道之后他们会耍什么花招。"

# game/scripts/Locations/company.rpy:1433
translate chinese_simp field_job_eight_2_43c857e0:

    # ellie "I trust you. And I'm not going anywhere."
    ellie "我相信你。我哪儿也不会去。"

# game/scripts/Locations/company.rpy:1434
translate chinese_simp field_job_eight_2_539c79cb:

    # player "Good. Just... stay safe."
    player "那就好。只是...注意安全。"

# game/scripts/Locations/company.rpy:1437
translate chinese_simp field_job_eight_2_d794351c:

    # ellie "I've been reading some of the books [rose] bought me. I'm learning a lot about defensive magic."
    ellie "我一直在读[rose]给我买的那些书。学到了不少防御魔法。"

# game/scripts/Locations/company.rpy:1438
translate chinese_simp field_job_eight_2_483e0d7b:

    # player "That's great to hear. Hopefully, it won't come to that, though."
    player "那太好了。不过希望用不上。"

# game/scripts/Locations/company.rpy:1441
translate chinese_simp field_job_eight_2_81a7f4a2:

    # ellie "I hope so too."
    ellie "我也希望如此。"

# game/scripts/Locations/company.rpy:1452
translate chinese_simp field_job_eight_3_61beb7c3:

    # sophia "I'm guessing you made your decision..."
    sophia "看来你已经做决定了..."

# game/scripts/Locations/company.rpy:1453
translate chinese_simp field_job_eight_3_f8e387d5:

    # player "I did..."
    player "对..."

# game/scripts/Locations/company.rpy:1456
translate chinese_simp field_job_eight_3_ce96d574:

    # sophia "So?"
    sophia "所以呢？"

# game/scripts/Locations/company.rpy:1457
translate chinese_simp field_job_eight_3_e83e981d:

    # player "I'm obviously not giving you [ellie]."
    player "我显然不会把[ellie]交给你们。"

# game/scripts/Locations/company.rpy:1460
translate chinese_simp field_job_eight_3_f0ba9482:

    # sophia "Oh... Is that so?"
    sophia "哦...是这样吗？"

# game/scripts/Locations/company.rpy:1463
translate chinese_simp field_job_eight_3_bd439564:

    # sophia "I can't say I'm not surprised, but it's still a little disappointing to hear."
    sophia "不能说我不惊讶，但听到这个还是有点失望。"

# game/scripts/Locations/company.rpy:1464
translate chinese_simp field_job_eight_3_94ebc3b7:

    # player "Disappointing?"
    player "失望？"

# game/scripts/Locations/company.rpy:1467
translate chinese_simp field_job_eight_3_ad1f98cf:

    # sophia "Yes, disappointing. I thought you'd value the truth about your parents a bit more highly."
    sophia "对，失望。我还以为你会更看重关于你父母的真相呢。"

# game/scripts/Locations/company.rpy:1470
translate chinese_simp field_job_eight_3_005ce3d2:

    # sophia "But I guess I was wrong. Maybe their death just wasn't as important to you as I thought."
    sophia "看来是我错了。也许他们的死对你来说并没有我想象的那么重要。"

# game/scripts/Locations/company.rpy:1471
translate chinese_simp field_job_eight_3_e25bafe8:

    # player "It is important. I'll find out the truth—whether you're the one to tell me or not."
    player "这很重要。无论你告不告诉我，我都会查明真相。"

# game/scripts/Locations/company.rpy:1474
translate chinese_simp field_job_eight_3_60726c95:

    # sophia "I see."
    sophia "我明白了。"

# game/scripts/Locations/company.rpy:1475
translate chinese_simp field_job_eight_3_c00114ef:

    # player "What now? Last time I was here, you threatened to fire me."
    player "现在呢？上次我来的时候，你威胁要解雇我。"

# game/scripts/Locations/company.rpy:1478
translate chinese_simp field_job_eight_3_fdda6506:

    # sophia "Did I? I don't recall saying I'd fire you outright."
    sophia "我有吗？我不记得我说过要直接解雇你啊。"

# game/scripts/Locations/company.rpy:1479
translate chinese_simp field_job_eight_3_1e8f184a:

    # sophia "But I did say I'll have to think really hard about what to do next."
    sophia "但我说过我要好好想想下一步该怎么做。"

# game/scripts/Locations/company.rpy:1482
translate chinese_simp field_job_eight_3_b9ead2c1:

    # sophia "You can go now. You're not fired—yet. We'll get that information to you at a later date... If it happens."
    sophia "你可以走了。你还没被解雇——暂时没有。关于那件事的信息，我们之后会找机会告诉你...如果真有那么一天的话。"

# game/scripts/Locations/company.rpy:1483
translate chinese_simp field_job_eight_3_99062da7:

    # player "I expected some kind of retaliation from you. Or at least another threat."
    player "我本以为你会报复我。或者至少再威胁我一次。"

# game/scripts/Locations/company.rpy:1486
translate chinese_simp field_job_eight_3_5be0481a:

    # sophia "Retaliation? A threat? That would be very unprofessional of me."
    sophia "报复？威胁？那也太不专业了。"

# game/scripts/Locations/company.rpy:1487
translate chinese_simp field_job_eight_3_c12cead4:

    # sophia "I only wish good things for you... and everyone in your life."
    sophia "我只希望你好好的...还有你身边的每一个人。"

# game/scripts/Locations/company.rpy:1488
translate chinese_simp field_job_eight_3_096917ff:

    # player "Right..."
    player "行吧..."

# game/scripts/Locations/company.rpy:1501
translate chinese_simp company_hidden_room_7a1ce5c1:

    # think "I think it's safe to say that there's no one here today..."
    think "今天这里应该没人..."

