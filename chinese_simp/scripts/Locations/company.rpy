    player "[astra]说你们是姐妹...？"

# game/scripts/Locations/company.rpy:2100
translate chinese_simp company_rescue_followup_b9464931:

    # kora "Mm-hm."
    kora "嗯。"

# game/scripts/Locations/company.rpy:2101
translate chinese_simp company_rescue_followup_7fd8261f:

    # player "Biological?"
    player "亲姐妹？"

# game/scripts/Locations/company.rpy:2104
translate chinese_simp company_rescue_followup_c6c281ae:

    # kora "I said I'm not telling my life story."
    kora "我说过不会讲我的一生。"

# game/scripts/Locations/company.rpy:2105
translate chinese_simp company_rescue_followup_da256004:

    # player "Alright, alright. Just curious, that's all."
    player "好好好。就是好奇而已。"

# game/scripts/Locations/company.rpy:2108
translate chinese_simp company_rescue_followup_ccf2e9c6:

    # kora "Mother's a celestial, father's a demon."
    kora "母亲是天族，父亲是魔族。"

# game/scripts/Locations/company.rpy:2109
translate chinese_simp company_rescue_followup_d2d76725:

    # player "I see."
    player "原来如此。"

# game/scripts/Locations/company.rpy:2110
translate chinese_simp company_rescue_followup_e12a547c:

    # player "So then-what happens next? What's the plan?"
    player "那接下来呢？有什么计划？"

