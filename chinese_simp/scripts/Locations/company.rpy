translate chinese_simp company_second_aftermath_c81a0e15:

    # player "Did you threaten her?"
    player "你们威胁她了？"

# game/scripts/Locations/company.rpy:3098
translate chinese_simp company_second_aftermath_b8036ab0:

    # kora "Yes."
    kora "对。"

# game/scripts/Locations/company.rpy:3099
translate chinese_simp company_second_aftermath_d274f728:

    # nova "[kora] made sure she understood that calling security was a bad idea for everyone involved."
    nova "[kora]让她明白，叫保安对谁都没好处。"

# game/scripts/Locations/company.rpy:3100
translate chinese_simp company_second_aftermath_af6f9f19:

    # player "I guess that makes sense considering the last visit..."
    player "考虑到上一次的事，倒也说得通..."

# game/scripts/Locations/company.rpy:3101
translate chinese_simp company_second_aftermath_37614da2:

    # player "And that was enough for her to just give you what you wanted?"
    player "这样她就乖乖把你们想要的东西交出来了？"

# game/scripts/Locations/company.rpy:3104
translate chinese_simp company_second_aftermath_27719ca4:

    # kora "No, she resisted quite a bit."
    kora "不，她反抗了好一阵。"

# game/scripts/Locations/company.rpy:3105
translate chinese_simp company_second_aftermath_33da79f5:

    # nova "She didn't tell us everything, not even close."
    nova "她没跟我们全盘托出，差得远。"

# game/scripts/Locations/company.rpy:3108
translate chinese_simp company_second_aftermath_44cc87d6:

    # kora "She gave me just enough to make me leave."
    kora "她给的料只够让我离开。"

# game/scripts/Locations/company.rpy:3109
translate chinese_simp company_second_aftermath_9341da01:

    # player "Enough meaning what?"
    player "什么叫‘够让你离开’？"

# game/scripts/Locations/company.rpy:3112
translate chinese_simp company_second_aftermath_8223fbee:

    # nova "A lab that she's in charge of."
    nova "一个她负责的实验室。"

# game/scripts/Locations/company.rpy:3113
translate chinese_simp company_second_aftermath_2dfcdead:

    # player "What was inside it?"
    player "里面有什么？"

# game/scripts/Locations/company.rpy:3116
translate chinese_simp company_second_aftermath_b0b92709:

    # kora "Not much, was hoping for some clues about their future plans-"
    kora "没什么有价值的东西，本来想找找他们未来计划的线索-"

# game/scripts/Locations/company.rpy:3117
translate chinese_simp company_second_aftermath_3d4bb115:

    # kora "But it seems they either don't trust her, or she's on her way out."
    kora "但看起来他们要么不信任她，要么她自己也要出局了。"

# game/scripts/Locations/company.rpy:3118
translate chinese_simp company_second_aftermath_eff31342:

    # player "Getting fired?"
    player "也要被炒？"

# game/scripts/Locations/company.rpy:3121
translate chinese_simp company_second_aftermath_a365000d:

    # kora "That would be her best case scenario, yeah."
    kora "对，那已经是最好的结果了。"

# game/scripts/Locations/company.rpy:3122
translate chinese_simp company_second_aftermath_4a284c5d:

    # player "So you got nothing?"
    player "所以你们什么都没拿到？"

# game/scripts/Locations/company.rpy:3125
translate chinese_simp company_second_aftermath_928cc985:

    # nova "We got a few files that we're still going through."
    nova "拿到了几份文件，我们还在看。"

# game/scripts/Locations/company.rpy:3126
translate chinese_simp company_second_aftermath_c21d5140:

    # nova "We're hoping for something we can use."
    nova "希望能从中找到有用的东西。"

# game/scripts/Locations/company.rpy:3127
translate chinese_simp company_second_aftermath_caea383c:

    # player "I guess that would explain why she was so quick to fire [valerie]."
    player "这倒解释了为什么她那么快就把[valerie]开了。"

# game/scripts/Locations/company.rpy:3130
