    # player "We got nothing but time, so start with you getting stuck in that dimension for ten or however many years."
    player "我们有的是时间，就从你被困在那个维度十年还是多少年开始说吧。"

# game/scripts/Locations/company.rpy:2049
translate chinese_simp company_rescue_followup_02c0270b:

    # astra "I'll leave you guys to talk."
    astra "你们聊，我先走了。"

# game/scripts/Locations/company.rpy:2052
translate chinese_simp company_rescue_followup_8069bfbe:

    # kora "I'm not going to sit here and tell my whole life story."
    kora "我不会坐在这里讲我的一生。"

# game/scripts/Locations/company.rpy:2053
translate chinese_simp company_rescue_followup_5eff82ae:

    # kora "If you want answers, ask specific questions. I'll answer what I can."
    kora "如果你想要答案，就问具体的问题。能说的我会说。"

# game/scripts/Locations/company.rpy:2054
translate chinese_simp company_rescue_followup_28753b73:

    # player "Alright... fair enough."
    player "好吧...这样也行。"
# game/scripts/Locations/company.rpy:2055
translate chinese_simp company_rescue_followup_187afd40:

    # player "That island dimension-was [nova] the one who created it?"
    player "那个岛屿维度——是[nova]创造的吗？"

# game/scripts/Locations/company.rpy:2058
translate chinese_simp company_rescue_followup_b8036ab0:

    # kora "Yes."
    kora "是的。"

# game/scripts/Locations/company.rpy:2059
translate chinese_simp company_rescue_followup_5d937589:

    # player "How did you end up stuck inside of it?"
    player "你是怎么被困在里面的？"

