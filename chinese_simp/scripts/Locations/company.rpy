translate chinese_simp company_unknown_letter_e70d2b0e:

    # lisa "No... Doesn't have any sender name or location, just says 'For [player].'"
    lisa "不知道...没有署名也没有地址，只写着‘致[player]’。"

# game/scripts/Locations/company.rpy:2203
translate chinese_simp company_unknown_letter_b6de9a14:

    # player "Weird."
    player "奇怪。"

# game/scripts/Locations/company.rpy:2206
translate chinese_simp company_unknown_letter_c62506ec:

    # lisa "Want me to read it for you?"
    lisa "要我读给你听吗？"

# game/scripts/Locations/company.rpy:2207
translate chinese_simp company_unknown_letter_164eba55:

    # player "Sure."
    player "好。"

# game/scripts/Locations/company.rpy:2211
translate chinese_simp company_unknown_letter_5d27cdbc:

    # lisa "Okay..."
    lisa "好..."

# game/scripts/Locations/company.rpy:2214
translate chinese_simp company_unknown_letter_5b92506e:

    # lisa "'It has come to our attention that you participated in a break-in at our offices.'"
    lisa "‘我们注意到你参与了一起闯入我们办公室的事件。’"

# game/scripts/Locations/company.rpy:2215
translate chinese_simp company_unknown_letter_df33a540:

    # lisa "'We possess security footage showing you meeting with [lisa] behind the building-'"
    lisa "‘我们持有监控录像，显示你与[lisa]在大楼后面会面-’"

# game/scripts/Locations/company.rpy:2216
translate chinese_simp company_unknown_letter_9bfa8046:

    # lisa "'The same site that later exploded, leaving a hole in the wall.'"
    lisa "‘同一地点随后发生爆炸，在墙上留下了一个洞。’"

# game/scripts/Locations/company.rpy:2219
translate chinese_simp company_unknown_letter_68966e53:

    # lisa "After that, it lists a bunch of names... Along with their home addresses, phone numbers, even daily routines."
    lisa "之后，它列出了一堆名字...还有他们的家庭住址、电话号码，甚至日常作息。"

# game/scripts/Locations/company.rpy:2220
translate chinese_simp company_unknown_letter_7ed2c61c:

    # player "Which names..?"
    player "哪些名字...？"

# game/scripts/Locations/company.rpy:2251
translate chinese_simp company_unknown_letter_01a7296d:

    # lisa "There's [datingList]."
    lisa "有[datingList]。"

# game/scripts/Locations/company.rpy:2252
translate chinese_simp company_unknown_letter_becfa0a9:

    # player "So basically everyone I know around town..."
    player "基本上我在镇上认识的每个人都..."

# game/scripts/Locations/company.rpy:2255
translate chinese_simp company_unknown_letter_1750d775:

    # lisa "Yeah..."
    lisa "嗯..."

# game/scripts/Locations/company.rpy:2258
translate chinese_simp company_unknown_letter_12d1148b:

    # lisa "'You might be wondering what we want and why we sent you this letter.'"
    lisa "‘你可能想知道我们想要什么，以及为什么要给你这封信。’"

# game/scripts/Locations/company.rpy:2259
translate chinese_simp company_unknown_letter_b3b401e8:

    # lisa "'It's simple, during that break-in, you stole something from us. We want it returned. In exchange-as a gesture of good faith-'"
    lisa "‘很简单，在那次闯入中，你偷了我们的东西。我们要求归还。作为交换——作为一种善意的表示-’"

# game/scripts/Locations/company.rpy:2260
translate chinese_simp company_unknown_letter_1eb7be10:

    # lisa "'We'll delete the footage, and destroy the personal information listed above.'"
    lisa "‘我们会删除录像，并销毁上面列出的所有个人信息。’"

