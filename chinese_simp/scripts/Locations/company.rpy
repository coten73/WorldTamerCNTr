    # think "'We're closed for the time being. Please check our website for updates on reopening.'"
    think "‘我们暂时停止营业。请查看我们的网站了解重新开放的最新消息。’"

# game/scripts/Locations/company.rpy:2324
translate chinese_simp company_kora_aftermath_c86a473c:

    # think "No useful information on here..."
    think "这里没什么有用信息..."

# game/scripts/Locations/company.rpy:2325
translate chinese_simp company_kora_aftermath_2559ecfc:

    # think "I wonder how [kora] 'dealt with it.' Or forced them to close the building for a while..."
    think "不知道[kora]是怎么‘处理’的...或者是怎么逼他们暂时关门的..."

# game/scripts/Locations/company.rpy:2326
translate chinese_simp company_kora_aftermath_478c3376:

    # think "I should ask, and make sure everyone on that list's safe."
    think "我应该去问问，顺便确认名单上每个人都没事。"

# game/scripts/Locations/company.rpy:2329
translate chinese_simp company_kora_aftermath_fc68d483:

    # think "I should also check on [valerie], she probably lost her job..."
    think "我还应该去看看[valerie]，她可能失业了..."

# game/scripts/Locations/company.rpy:2344
translate chinese_simp company_kora_explanation_2ffb4cd9:

    # kora "What is it this time?"
    kora "这次又是什么事？"

# game/scripts/Locations/company.rpy:2345
translate chinese_simp company_kora_explanation_8b38d971:

    # player "I just came from the company's offices. Doors are locked, and the whole building's shut down."
    player "我刚从公司那边过来。门锁了，整栋楼都关门了。"

# game/scripts/Locations/company.rpy:2346
translate chinese_simp company_kora_explanation_f7740bd0:

    # player "What did you do?"
    player "你做了什么？"

# game/scripts/Locations/company.rpy:2349
translate chinese_simp company_kora_explanation_43b40737:

    # kora "Paid them a visit, and reminded them who's actually in charge."
    kora "去拜访了他们一下，提醒他们谁才是真正说了算的人。"

# game/scripts/Locations/company.rpy:2350
translate chinese_simp company_kora_explanation_f317ebb9:

    # player "What do you mean by that? Do you have something on them?"
    player "什么意思？你手里有他们的把柄？"

# game/scripts/Locations/company.rpy:2353
translate chinese_simp company_kora_explanation_a070abd8:

    # kora "Don't play dumb. You should know exactly what I am and what I'm capable of by now."
    kora "别装傻。你现在应该很清楚我是什么身份、有什么能力。"

# game/scripts/Locations/company.rpy:2356
translate chinese_simp company_kora_explanation_73a38ea1:

    # kora "I told you before, they trapped me because they couldn't kill me."
    kora "我之前说过，他们困住我是因为他们杀不了我。"

# game/scripts/Locations/company.rpy:2357
translate chinese_simp company_kora_explanation_f58cabdf:

    # player "Yeah... I remember."
    player "嗯...我记得。"

# game/scripts/Locations/company.rpy:2360
translate chinese_simp company_kora_explanation_ff62a3d0:

    # kora "You freed me, and they seemed to forget that."
    kora "你把我放了出来，他们好像忘了这件事。"

# game/scripts/Locations/company.rpy:2361
translate chinese_simp company_kora_explanation_761c7a7d:

    # kora "So I paid them a visit, trashed the offices, and told that blonde woman to leave you alone."
    kora "所以我去拜访了他们，把办公室砸了一通，然后告诉那个金发女人别来烦你。"

# game/scripts/Locations/company.rpy:2362
translate chinese_simp company_kora_explanation_84e7740a:

    # player "[sophia]?"
    player "[sophia]？"

# game/scripts/Locations/company.rpy:2365
translate chinese_simp company_kora_explanation_575a4c6e:

    # kora "I don't know what her name is, but she said she's the one in charge."
    kora "我不知道她叫什么，但她说她是负责人。"

# game/scripts/Locations/company.rpy:2366
translate chinese_simp company_kora_explanation_0c475ca1:

    # player "You didn't hurt anyone, right? Most of them are just people trying to make a living."
    player "你没伤人吧？大多数人只是为了混口饭吃。"

# game/scripts/Locations/company.rpy:2369
translate chinese_simp company_kora_explanation_ba5a358b:

    # kora "Relax. No one got hurt. It was just a taste of what's to come."
    kora "放心。没人受伤。这只是一点警告。"

# game/scripts/Locations/company.rpy:2370
translate chinese_simp company_kora_explanation_9460edf1:

    # kora "They should be back open in a few days."
    kora "他们过几天应该就会重新开门。"

# game/scripts/Locations/company.rpy:2373
translate chinese_simp company_kora_explanation_774796fb:

    # kora "But you and everyone on that list are off-limits now. I made [sophia] agree to it."
    kora "但你还有名单上的所有人，现在都是禁区了。我已经让[sophia]同意了。"

# game/scripts/Locations/company.rpy:2374
translate chinese_simp company_kora_explanation_f2c2673e:

    # kora "If they push again, I take the whole building down."
    kora "如果他们再轻举妄动，我就把整栋楼都拆了。"

# game/scripts/Locations/company.rpy:2375
translate chinese_simp company_kora_explanation_710bad2c:

    # player "Alright. Thanks for doing that..."
    player "好。谢谢你了..."

# game/scripts/Locations/company.rpy:2378
translate chinese_simp company_kora_explanation_bfe8ab91:

    # kora "Mhm."
    kora "嗯。"

# game/scripts/Locations/company.rpy:2381
translate chinese_simp company_kora_explanation_d4564f2e:

    # kora "[nova]!"
    kora "[nova]！"

# game/scripts/Locations/company.rpy:2382
translate chinese_simp company_kora_explanation_f07565fb:

    # nova "[kora]..."
    nova "[kora]..."

# game/scripts/Locations/company.rpy:2385
translate chinese_simp company_kora_explanation_d6744dc1:

    # nova "You're here too..."
    nova "你也在..."

# game/scripts/Locations/company.rpy:2386
translate chinese_simp company_kora_explanation_d75f2b01:

    # player "I am..?"
    player "我在...？"

# game/scripts/Locations/company.rpy:2387
translate chinese_simp company_kora_explanation_134462f9:

    # kora "You've seen him before?"
    kora "你见过他？"

# game/scripts/Locations/company.rpy:2390
translate chinese_simp company_kora_explanation_f73e546c:

    # nova "He's the reason you found me..."
    nova "是他让你找到我的..."

# game/scripts/Locations/company.rpy:2391
translate chinese_simp company_kora_explanation_2dabfdfb:

    # kora "Explain."
    kora "说清楚。"

# game/scripts/Locations/company.rpy:2394
translate chinese_simp company_kora_explanation_428be03c:

    # nova "When he reached out to that other celestial and they stole the island from me..."
    nova "当他联系到那个天族，他们从我这里夺走了那个岛的时候..."

# game/scripts/Locations/company.rpy:2395
translate chinese_simp company_kora_explanation_f50f864b:

    # nova "I felt hope again, someone strong out there knew I existed."
    nova "我重新感受到了希望，外面有个强大的人知道我的存在。"

# game/scripts/Locations/company.rpy:2398
translate chinese_simp company_kora_explanation_c2d2239d:

    # nova "It also meant you were free again, so I knew you'd come for me."
    nova "那也意味着你又自由了，所以我知道你一定会来救我。"

# game/scripts/Locations/company.rpy:2399
translate chinese_simp company_kora_explanation_fb892878:

    # kora "I would've come sooner if I knew they had you here..."
    kora "如果我知道你在这里，我会更早来的..."

# game/scripts/Locations/company.rpy:2402
translate chinese_simp company_kora_explanation_65b8a1ff:

    # nova "It's okay. I held out."
    nova "没关系。我挺住了。"

# game/scripts/Locations/company.rpy:2403
translate chinese_simp company_kora_explanation_8d0379ec:

    # kora "Barely. I saw the marks they made..."
    kora "勉强。我看到了他们留下的伤痕..."

# game/scripts/Locations/company.rpy:2406
translate chinese_simp company_kora_explanation_e3740f77:

    # nova "That started when I began fighting back."
    nova "那是我开始反抗之后才有的。"

# game/scripts/Locations/company.rpy:2407
translate chinese_simp company_kora_explanation_b7982079:

    # nova "They wanted the entrance held open all the time."
    nova "他们想让我把入口一直保持开放。"

# game/scripts/Locations/company.rpy:2410
translate chinese_simp company_kora_explanation_958b924a:

    # nova "I'm not capable of something like that, so they tried to force me."
    nova "我做不到那种事，所以他们就强迫我。"

# game/scripts/Locations/company.rpy:2411
translate chinese_simp company_kora_explanation_9c67eb5d:

    # player "How hard is it to have a door between worlds?"
    player "在两个世界之间维持一扇门有多难？"

# game/scripts/Locations/company.rpy:2414
translate chinese_simp company_kora_explanation_2b8fadd8:

    # nova "Making the entrance-or door exist is easy."
    nova "创造出入口——也就是门——很容易。"

# game/scripts/Locations/company.rpy:2415
translate chinese_simp company_kora_explanation_ccdefcc1:

    # nova "Keeping it open, where the real world, and a dimension meet directly... That's really difficult."
    nova "但要让它保持敞开，让现实世界和维度直接连通...那真的很难。"

# game/scripts/Locations/company.rpy:2416
translate chinese_simp company_kora_explanation_705b9b4d:

    # nova "Most celestials can only do it for a few minutes."
    nova "大多数天族只能维持几分钟。"

# game/scripts/Locations/company.rpy:2417
translate chinese_simp company_kora_explanation_d2d76725:

    # player "I see."
    player "原来如此。"

# game/scripts/Locations/company.rpy:2420
translate chinese_simp company_kora_explanation_0627fbe7:

    # nova "That's why you and the fox girl kept moving in and out."
    nova "所以你和那个狐族女孩才会一直在传送中进进出出。"

# game/scripts/Locations/company.rpy:2421
translate chinese_simp company_kora_explanation_578245e2:

    # nova "They wanted me to keep it opened, but when I couldn't, they-"
    nova "他们想让我维持开门状态，但我做不到，他们就-"

# game/scripts/Locations/company.rpy:2422
translate chinese_simp company_kora_explanation_5f4a74cd:

    # player "We heard the screaming..."
    player "我们听到了尖叫声..."

# game/scripts/Locations/company.rpy:2425
translate chinese_simp company_kora_explanation_7cb9b742:

    # nova "I'm glad you came when you did."
    nova "我很高兴你们当时来了。"

# game/scripts/Locations/company.rpy:2426
translate chinese_simp company_kora_explanation_1fe06c8c:

    # player "So that whole hallway was the door..?"
    player "所以整条走廊就是那扇门...？"

# game/scripts/Locations/company.rpy:2429
translate chinese_simp company_kora_explanation_b948a088:

    # nova "And the only path to the room I was in."
    nova "也是通往我所在房间的唯一路径。"

# game/scripts/Locations/company.rpy:2430
translate chinese_simp company_kora_explanation_c91deb14:

    # kora "If you were able to keep your dimension open-"
    kora "如果你能一直维持你的维度开放-"

# game/scripts/Locations/company.rpy:2433
translate chinese_simp company_kora_explanation_d7e28218:

    # nova "No help would've been able to ever reach me~"
    nova "那就没有任何人能救到我了~"

# game/scripts/Locations/company.rpy:2434
translate chinese_simp company_kora_explanation_07184ec1:

    # player "I'm just glad it didn't come to that."
    player "还好事情没有发展到那一步。"

# game/scripts/Locations/company.rpy:2435
translate chinese_simp company_kora_explanation_7892ea97:

    # nova "All thanks to you two~"
    nova "多亏了你们两个~"

# game/scripts/Locations/company.rpy:2436
translate chinese_simp company_kora_explanation_6421a46f:

    # player "So what's next..? Now that you're safe."
    player "那接下来呢...？既然你安全了。"

# game/scripts/Locations/company.rpy:2439
translate chinese_simp company_kora_explanation_67b617c3:

    # kora "Next is rest. She doesn't lift a finger until she's completely healed."
    kora "接下来是休息。她完全康复之前，什么都不准做。"

# game/scripts/Locations/company.rpy:2440
translate chinese_simp company_kora_explanation_35e64f0f:

    # nova "I already feel so much better... I want to help [player] out..."
    nova "我已经感觉好多了...我想帮[player]..."

# game/scripts/Locations/company.rpy:2443
translate chinese_simp company_kora_explanation_40f9344f:

    # kora "It can wait, the company isn't a threat at the moment, I made sure of that."
    kora "不急，公司目前已经构不成威胁了，我确认过了。"

# game/scripts/Locations/company.rpy:2444
translate chinese_simp company_kora_explanation_c3c6179c:

    # kora "So you don't need to worry about any of it. Just focus on getting better-"
    kora "所以你不用操心这些。专心养好身体-"

# game/scripts/Locations/company.rpy:2447
translate chinese_simp company_kora_explanation_6aa4001a:

    # kora "And [player] will give you space."
    kora "而且[player]会给你空间的。"

# game/scripts/Locations/company.rpy:2448
translate chinese_simp company_kora_explanation_f3ac97b6:

    # player "Yeah. Take the time you need. When you're up for it, I've got more questions."
    player "对。你好好休息。等你准备好了，我还有些问题想问你。"

# game/scripts/Locations/company.rpy:2451
translate chinese_simp company_kora_explanation_e222c372:

    # nova "Thank you. I'll find you..."
    nova "谢谢你。我会去找你的..."

# game/scripts/Locations/company.rpy:2452
translate chinese_simp company_kora_explanation_fa966702:

    # player "Ask [astra]. She knows where I am."
    player "问[astra]吧。她知道我在哪。"

# game/scripts/Locations/company.rpy:2455
translate chinese_simp company_kora_explanation_8f27d173:

    # kora "Tell her to come in on your way out."
    kora "你出去的时候让她进来一下。"

# game/scripts/Locations/company.rpy:2456
translate chinese_simp company_kora_explanation_54c934ae:

    # player "Will do."
    player "好的。"

# game/scripts/Locations/company.rpy:2467
translate chinese_simp company_risky_visit_cb50fe8d:

    # valerie "[player]..!"
    valerie "[player]..！"

# game/scripts/Locations/company.rpy:2468
translate chinese_simp company_risky_visit_8ceadc03:

    # valerie "What are you doing here? You can't just show up like this!"
    valerie "你来这里做什么？你不能就这么出现！"

# game/scripts/Locations/company.rpy:2471
translate chinese_simp company_risky_visit_8a69ed63:

    # valerie "You really shouldn't be here right now."
    valerie "你现在真的不该在这里。"

# game/scripts/Locations/company.rpy:2472
translate chinese_simp company_risky_visit_d9f917aa:

    # player "I'm not here to start trouble. I just need to talk."
    player "我不是来找麻烦的。我只是想谈谈。"

# game/scripts/Locations/company.rpy:2476
translate chinese_simp company_risky_visit_183b0a24:

    # valerie "Please leave... I can't have anything happen to you..."
    valerie "请你走吧...我不能让你出事..."

# game/scripts/Locations/company.rpy:2477
translate chinese_simp company_risky_visit_82f2c6eb:

    # player "I'll be fine, I promise..."
    player "我没事的，我保证..."

# game/scripts/Locations/company.rpy:2480
translate chinese_simp company_risky_visit_b9dcc91f:

    # valerie "It's not safe for you right now."
    valerie "现在对你来说不安全。"

# game/scripts/Locations/company.rpy:2481
translate chinese_simp company_risky_visit_58d2d53c:

    # player "I'll be fine..."
    player "我会没事的..."

# game/scripts/Locations/company.rpy:2482
translate chinese_simp company_risky_visit_677ed8bb:

    # player "How did you see me coming so fast anyway?"
    player "话说你怎么这么快就看到我来了？"

# game/scripts/Locations/company.rpy:2485
translate chinese_simp company_risky_visit_7f575b1c:

    # valerie "I have access to the new security cameras. They cover the whole floor now."
    valerie "我能看到新装的监控画面。现在整个楼层都在覆盖范围内。"

# game/scripts/Locations/company.rpy:2486
translate chinese_simp company_risky_visit_a9eab243:

    # player "Oh, that makes sense."
    player "哦，难怪。"

# game/scripts/Locations/company.rpy:2489
translate chinese_simp company_risky_visit_56716617:

    # valerie "Are you really insisting on talking to her?"
    valerie "你真的坚持要去跟她谈？"

# game/scripts/Locations/company.rpy:2490
translate chinese_simp company_risky_visit_b5c02a9b:

    # player "Yeah."
    player "嗯。"

# game/scripts/Locations/company.rpy:2493
translate chinese_simp company_risky_visit_e577f498:

    # valerie "Fine... Then go right in."
    valerie "好吧...那直接进去吧。"

# game/scripts/Locations/company.rpy:2497
translate chinese_simp company_risky_visit_d887f420:

    # sophia "What is it Val~?"
    sophia "什么事，瓦尔~？"

# game/scripts/Locations/company.rpy:2500
translate chinese_simp company_risky_visit_bd576da2:

    # sophia "..."
    sophia "..."

# game/scripts/Locations/company.rpy:2503
translate chinese_simp company_risky_visit_74c9d0ce:

    # sophia "This should be good~"
    sophia "有意思了~"

# game/scripts/Locations/company.rpy:2506
translate chinese_simp company_risky_visit_d0244108:

    # sophia "You have ten seconds to convince me not to call security."
    sophia "你有十秒钟说服我不叫保安。"

# game/scripts/Locations/company.rpy:2507
translate chinese_simp company_risky_visit_5d13c393:

    # player "I'm here to talk. Nothing else."
    player "我是来谈事情的。没别的意思。"

# game/scripts/Locations/company.rpy:2510
translate chinese_simp company_risky_visit_62145448:

    # sophia "I don't see what's there to talk about."
    sophia "我不觉得我们有什么好谈的。"

# game/scripts/Locations/company.rpy:2513
translate chinese_simp company_risky_visit_fdeb860b:

    # sophia "But fine. I got a few minutes to entertain this."
    sophia "不过行吧。我有几分钟时间奉陪。"

# game/scripts/Locations/company.rpy:2516
translate chinese_simp company_risky_visit_1bc13ab6:

    # sophia "I'm going to guess this is about that letter?"
    sophia "我猜是关于那封信的？"

# game/scripts/Locations/company.rpy:2517
translate chinese_simp company_risky_visit_b5c02a9b_1:

    # player "Yeah."
    player "对。"

# game/scripts/Locations/company.rpy:2520
translate chinese_simp company_risky_visit_b7709ea8:

    # sophia "Your friend [kora] solved that issue for you."
    sophia "你那个朋友[kora]已经帮你把问题解决了。"

# game/scripts/Locations/company.rpy:2523
translate chinese_simp company_risky_visit_7079b339:

    # sophia "So you can pretend that letter never existed."
    sophia "所以你可以当那封信从来没存在过。"

# game/scripts/Locations/company.rpy:2524
translate chinese_simp company_risky_visit_69a8e574:

    # player "But you still have the information. I can't pretend that magically disappeared too."
    player "但信息还在你们手里。我总不能当那些也凭空消失了吧。"

# game/scripts/Locations/company.rpy:2527
translate chinese_simp company_risky_visit_5e9e4727:

    # sophia "Oh please. Anyone can get that information if they're determined enough."
    sophia "拜托。如果足够有决心，谁都能搞到那些信息。"

# game/scripts/Locations/company.rpy:2528
translate chinese_simp company_risky_visit_2d2b2ddb:

    # sophia "The main difference is acting on it, and we no longer have any intention to do that."
