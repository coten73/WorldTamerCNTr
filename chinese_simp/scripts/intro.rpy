    # emily "[player]? Oh my God, you're actually here!"
    emily "[player]？天哪，你居然来了！"

# game/scripts/intro.rpy:373
translate chinese_simp house_intro_f3da95d0:

    # player "Hey, [emily]. Good to finally see you again~"
    player "Hey, [emily].很高兴终于又见到你了~"

# game/scripts/intro.rpy:374
translate chinese_simp house_intro_e13ebb7a:

    # player "I came straight after graduation, just like I promised."
    player "正如我所承诺的那样，我一毕业就来了。"

# game/scripts/intro.rpy:377
translate chinese_simp house_intro_e5994cbf:

    # emily "Yeah, you did!"
    emily "是啊，你做到了！"

# game/scripts/intro.rpy:380
translate chinese_simp house_intro_66c31f88:

    # emily "How was college?"
    emily "大学过得怎么样？"

# game/scripts/intro.rpy:381
translate chinese_simp house_intro_805727cb:

    # player "Long and slow, but I'm finally free~"
    player "又臭又长，但我终于自由了~"

# game/scripts/intro.rpy:382
translate chinese_simp house_intro_7761fbc4:

    # player "Honestly though, I was kinda surprised when you told me you moved back here."
    player "老实说，当你告诉我你搬回这里时，我有点惊讶。"

# game/scripts/intro.rpy:383
translate chinese_simp house_intro_7755022e:

    # player "Did something change?"
    player "这几年发生了什么吗？"

# game/scripts/intro.rpy:386
translate chinese_simp house_intro_07517149:

    # emily "Well... With your graduation coming up, I really wanted us to finally reconnect."
    emily "嗯……随着你即将毕业，我真的希望我们最终能重新联系起来。"

# game/scripts/intro.rpy:389
translate chinese_simp house_intro_18cb8eb0:

    # emily "Then out of the blue, my agent found this place—way too good a deal to skip."
    emily "然后很快啊，我的经纪人发现了这个地方——太划算了，不容错过。"

# game/scripts/intro.rpy:390
translate chinese_simp house_intro_f5e474a7:

    # emily "So I took it, and moved in almost immediately."
    emily "所以我接受了它，几乎立即搬了进去。"

# game/scripts/intro.rpy:391
translate chinese_simp house_intro_48c3192b:

    # player "You mentioned there's someone else living with you?"
    player "你提到还有其他人和你住？"

# game/scripts/intro.rpy:394
translate chinese_simp house_intro_b597212b:

    # emily "Yes! We're sharing the house with [rose]. She's amazing, and I'm sure you two will hit it off right away!"
    emily "是的！我们与 [rose] 合住这房子。她很厉害，我相信你们两个会一拍即合的！"

# game/scripts/intro.rpy:397
translate chinese_simp house_intro_e635fd84:

    # player "I'm looking forward to meeting her then."
    player "我很期待那时见到她。"

# game/scripts/intro.rpy:398
translate chinese_simp house_intro_996133ac:

    # rose "What's this about me being amazing~?"
    rose "纳尼, 说我很棒~？"

# game/scripts/intro.rpy:401
translate chinese_simp house_intro_fd8ff0a5:

    # emily "[rose]!"
    emily "[rose]!"

# game/scripts/intro.rpy:402
translate chinese_simp house_intro_aba8d8ac:

    # emily "Come over! Let me introduce you two!"
    emily "过来吧！让我给你们介绍一下吧！"

# game/scripts/intro.rpy:405
translate chinese_simp house_intro_1ed73eec:

    # emily "This is [player]-"
    emily "这是[player]-"

# game/scripts/intro.rpy:406
translate chinese_simp house_intro_0a05a86a:

    # player "Nice to meet you."
    player "很高兴认识你。"

# game/scripts/intro.rpy:407
translate chinese_simp house_intro_12fcd512:

    # rose "I'm [rose]."
    rose "我是 [rose]。"

# game/scripts/intro.rpy:410
translate chinese_simp house_intro_0deeed6e:

    # rose "So you're the guy [emily] can't shut up about..."
    rose "所以你就是那个 [emily] 无法闭嘴的人......"

# game/scripts/intro.rpy:411
translate chinese_simp house_intro_d75f2b01:

    # player "I am..?"
    player "我是..？"

# game/scripts/intro.rpy:414
translate chinese_simp house_intro_7567a32e:

    # rose "She kept going on and on and on about you two finally reuniting {i}back where it all started{/i} after you graduate..."
    rose "她一直在说你们两个终于在毕业后重聚然后{i}回到一切开始的地方{/i}……"

# game/scripts/intro.rpy:415
translate chinese_simp house_intro_641c3e5f:

    # think "Back where it all started..?"
    think "回到一切开始的地方..？"

# game/scripts/intro.rpy:416
translate chinese_simp house_intro_0f0323c9:

    # player "Oh, I see."
    player "哦，我明白了。"

# game/scripts/intro.rpy:419
translate chinese_simp house_intro_e4fd6959:

    # emily "Oh, come on. It hasn't been that bad."
    emily "哦，得了吧。也没有那么糟。"

# game/scripts/intro.rpy:420
translate chinese_simp house_intro_ed645f36:

    # emily "We've been apart like, fifteen years. I just missed him!"
    emily "我们已经分开十五年了。我只是想他了！"

# game/scripts/intro.rpy:421
translate chinese_simp house_intro_bc9cc158:

    # player "Missed you too, [emily]."
    player "我也想你，[emily]。"

# game/scripts/intro.rpy:424
translate chinese_simp house_intro_2c13febc:

    # emily "Aww, that's sweet of you."
    emily "哇，你真好。"

# game/scripts/intro.rpy:425
translate chinese_simp house_intro_c41bdac7:

    # rose "Oh, god. Get a room—"
    rose "哦，天哪。找个房间吧——"

# game/scripts/intro.rpy:428
translate chinese_simp house_intro_e7070108:

    # emily "Oh, right! Your room! Let me show you."
    emily "哦，对了！ 你的房间!我来带路。"

# game/scripts/intro.rpy:429
translate chinese_simp house_intro_c673bb53:

    # rose "That's not what I meant~"
    rose "我不是这个意思~"

# game/scripts/intro.rpy:432
translate chinese_simp house_intro_4008e8b3:

    # think "[rose]'s kinda wild... She clearly loves messing with [emily]."
    think "[rose] 有点乱来……她显然很喜欢抓弄 [emily]。"

# game/scripts/intro.rpy:435
translate chinese_simp house_intro_97199a94:

    # emily "Here we are! I tried to decorate it based on what my parents told me."
    emily "我们到了！我尝试根据父母告诉我的来装饰它。"

# game/scripts/intro.rpy:436
translate chinese_simp house_intro_416e9a30:

    # player "Wow, it looks great. Thanks~"
    player "哇，看起来很棒。谢谢~"

# game/scripts/intro.rpy:439
translate chinese_simp house_intro_8d3479cc:

    # emily "By the way, there's something you should know about [rose]..."
    emily "顺便说一句，关于 [rose]，你应该了解一些事......"

# game/scripts/intro.rpy:440
translate chinese_simp house_intro_344255ad:

    # emily "I... told her the truth about us."
    emily "我...告诉了她我们之间的真相。"

# game/scripts/intro.rpy:441
translate chinese_simp house_intro_12d9c9df:

    # player "I figured with the way she spoke, but why would you do that?"
    player "我从她说话的语气中猜到了，但你为什么要这么做？"

# game/scripts/intro.rpy:444
translate chinese_simp house_intro_4f9a148a:

    # emily "We've been through a lot together, I moved in right after she lost her parents."
    emily "我们一起经历了很多事情，她失去父母后我就搬进来和她一起住了。"

# game/scripts/intro.rpy:447
translate chinese_simp house_intro_d682ae01:

    # emily "I trust her completely, and I think you'll feel the same way eventually."
    emily "我完全信任她，我想你最终也会有同样的感觉。"

# game/scripts/intro.rpy:448
translate chinese_simp house_intro_42590b37:

    # player "You two did seem pretty close..."
    player "你们两个看上去确实很亲密……"

# game/scripts/intro.rpy:449
translate chinese_simp house_intro_b8b45838:

    # player "Does anyone else know?"
    player "还有其他人知道吗？"

# game/scripts/intro.rpy:452
translate chinese_simp house_intro_f554ad3e:

    # emily "No. Just [rose]."
    emily "不，只有 [rose]。"

# game/scripts/intro.rpy:453
translate chinese_simp house_intro_b1632898:

    # emily "And she promised to keep it a secret."
    emily "而且她答应保守秘密。"

# game/scripts/intro.rpy:454
translate chinese_simp house_intro_9a5cf871:

    # player "Alright."
    player "彳亍。"

# game/scripts/intro.rpy:457
translate chinese_simp house_intro_18da8725:

    # emily "Oh, and one more thing."
    emily "哦，还有一件事。"

# game/scripts/intro.rpy:458
translate chinese_simp house_intro_5796efd1:

    # emily "You should probably use my parents' last name for now. Going around as Mr. [persistent.lastName] would definitely put you on [company]' radar."
    emily "你现在或许应该使用我父母的姓氏。如果以 [persistent.lastName] 先生的身份四处走动肯定会你引起 [company] 的注意。"

# game/scripts/intro.rpy:459
translate chinese_simp house_intro_092258e5:

    # player "Got it. So... Mr. [persistent.emilyLastName], huh? Almost sounds like we're married~"
    player "明白了。那么...[persistent.emilyLastName]先生，嗯？搞得像我们两个已经结婚了一样~"

# game/scripts/intro.rpy:462
translate chinese_simp house_intro_4e6a7280:

    # emily "Then wouldn't that make me Mrs. [persistent.lastName]?"
    emily "那我岂不是成了[persistent.lastName]夫人了？"

# game/scripts/intro.rpy:465
translate chinese_simp house_intro_40999e89:

    # emily "[player]! Don't joke around like that!"
    emily "[player]!别开这样的玩笑啊！"

# game/scripts/intro.rpy:466
translate chinese_simp house_intro_79b2419d:

    # player "Sorry~"
    player "抱歉~"

# game/scripts/intro.rpy:469
translate chinese_simp house_intro_2f882f29:

    # emily "Anyway! Get yourself settled, and if you need anything just find me. okay?"
    emily "无论如何！你先安顿好，有什么需要就找我。好的？"

# game/scripts/intro.rpy:474
translate chinese_simp house_intro_66b61978:

    # think "Guess step one is checking out [company] on my PC."
    think "我猜第一步是在我的电脑上查看 [company]。"

