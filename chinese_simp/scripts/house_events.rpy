    player "刚才不想破坏气氛，不过请帮我保密。"

# game/scripts/house_events.rpy:1276
translate chinese_simp rose_lisa_event_d90ea5e6:

    # player "I'll be in serious danger if people find out I can untame others..."
    player "要是别人知道我还能‘驯服’别人，我就有麻烦了……"

# game/scripts/house_events.rpy:1277
translate chinese_simp rose_lisa_event_bc76adf5:

    # rose "Don't worry, [lisa] made me promise to never tell anyone. And I intend to keep that promise."
    rose "放心，[lisa] 让我保证过不说出去。我会遵守承诺的。"

# game/scripts/house_events.rpy:1278
translate chinese_simp rose_lisa_event_5a6e5dbf:

    # player "Thank you."
    player "谢谢你。"

# game/scripts/house_events.rpy:1279
translate chinese_simp rose_lisa_event_1f35576b:

    # player "And [lisa]... You can't just tell people without talking to me first, okay?"
    player "还有 [lisa]……你不能不先跟我说就告诉别人，知道吗？"

# game/scripts/house_events.rpy:1283
translate chinese_simp rose_lisa_event_e6919def:

    # lisa "Sorry, [persistent.lisaplayerTitle]... I trust [rose], so I didn't think it would be a problem..."
    lisa "对不起，[persistent.lisaplayerTitle]……我信任 [rose]，所以觉得应该没问题……"

# game/scripts/house_events.rpy:1284
translate chinese_simp rose_lisa_event_3d1e159c:

    # player "[rose] knowing isn't the problem, not talking to me first is."
    player "[rose] 知道不是问题，问题是你没先跟我说。"

# game/scripts/house_events.rpy:1285
translate chinese_simp rose_lisa_event_4247b4c4:

    # lisa "I understand... I won't tell anyone else..."
    lisa "我明白了……我不会再告诉别人了……"

# game/scripts/house_events.rpy:1302
translate chinese_simp rose_event_57a46800:

    # rose "Hey, [player]..."
    rose "嘿，[player]……"

# game/scripts/house_events.rpy:1303
translate chinese_simp rose_event_4e9efbc8:

    # rose "Nothing to do?"
    rose "没事做？"

# game/scripts/house_events.rpy:1304
translate chinese_simp rose_event_114cfd67:

    # player "Something like that... What you up to?"
    player "差不多吧……你在干嘛？"

# game/scripts/house_events.rpy:1308
translate chinese_simp rose_event_804fa36a:

    # rose "Just looking at some videos..."
    rose "就看些视频……"

# game/scripts/house_events.rpy:1309
translate chinese_simp rose_event_a606e30f:

    # rose "And procrastinating..."
    rose "顺便摸摸鱼……"

# game/scripts/house_events.rpy:1310
translate chinese_simp rose_event_8e61cb99:

    # player "Sounds familiar..."
    player "我懂……"

# game/scripts/house_events.rpy:1314
translate chinese_simp rose_event_bacb2048:

    # rose "Got a few minutes?"
    rose "有几分钟时间吗？"

# game/scripts/house_events.rpy:1315
translate chinese_simp rose_event_69210e85:

    # rose "I could use a pair of fresh eyes on this."
    rose "我想找个人帮我看看这个。"

# game/scripts/house_events.rpy:1316
translate chinese_simp rose_event_e6345a0e:

    # player "Yeah sure, what is it?"
    player "行，什么事？"

# game/scripts/house_events.rpy:1320
translate chinese_simp rose_event_69593802:

    # rose "I'm writing an article about a local farm."
    rose "我在写一篇关于本地农场的文章。"

# game/scripts/house_events.rpy:1321
translate chinese_simp rose_event_7b3a63fb:

    # rose "When it comes to dairy, they're the main supplier in this town."
    rose "在乳制品方面，他们是这个镇的主要供应商。"

# game/scripts/house_events.rpy:1322
translate chinese_simp rose_event_6b3be0c5:

    # rose "So I'm doing a short piece on their importance and letting people know how it all works."
    rose "所以我正在写一篇短文介绍他们的重要性，顺便让大家了解运作方式。"

# game/scripts/house_events.rpy:1323
translate chinese_simp rose_event_e210611d:

    # player "So it's a positive kind of article?"
    player "所以是一篇正面的文章？"

# game/scripts/house_events.rpy:1327
translate chinese_simp rose_event_795e3100:

    # rose "It's not a hit piece or anything like that, people love local products, so this should get them more business."
    rose "不是什么黑料之类的，大家都喜欢本地产品，所以这篇文章应该能给他们带来更多生意。"

# game/scripts/house_events.rpy:1328
translate chinese_simp rose_event_83464f78:

    # player "That's nice, what can I do to help?"
    player "那挺好的，我能帮什么忙？"

# game/scripts/house_events.rpy:1332
translate chinese_simp rose_event_6dac5bcc:

    # rose "I'm having problems with wording and framing of a few parts..."
    rose "我在某些部分的措辞和结构上有点问题……"

# game/scripts/house_events.rpy:1333
translate chinese_simp rose_event_06b43144:

    # rose "It could help if someone else looked at it."
    rose "能让别人帮忙看看就好了。"

# game/scripts/house_events.rpy:1334
translate chinese_simp rose_event_be7dad2e:

    # player "Yeah sure, I'd be happy to help."
    player "没问题，我很乐意帮忙。"

# game/scripts/house_events.rpy:1342
translate chinese_simp rose_event_1ecb7f38:

    # rose "Hey there..."
    rose "嘿……"

# game/scripts/house_events.rpy:1343
translate chinese_simp rose_event_63aacf0a:

    # player "Procrastinating again?"
    player "又在摸鱼？"

# game/scripts/house_events.rpy:1344
translate chinese_simp rose_event_22d4158c:

    # rose "Not at the moment..."
    rose "现在没有……"

# game/scripts/house_events.rpy:1349
translate chinese_simp rose_event_b0d06217:

    # rose "Talking about [emily] needing to take time off got me thinking..."
    rose "聊到 [emily] 需要休息的事，让我也想了想……"

# game/scripts/house_events.rpy:1351
translate chinese_simp rose_event_0fb78e02:

    # rose "I was thinking..."
    rose "我在想……"

# game/scripts/house_events.rpy:1352
translate chinese_simp rose_event_2a6c7c05:

    # rose "I haven't been on a vacation in at least 6 years..."
    rose "我至少六年没休过假了……"

# game/scripts/house_events.rpy:1353
translate chinese_simp rose_event_50e8ee9a:

    # player "Really? Like no time off, or just no going away?"
    player "真的假的？是没时间休息，还是没出去旅游？"

# game/scripts/house_events.rpy:1357
translate chinese_simp rose_event_f8e95a38:

    # rose "Oh, I've had time off, had lazy days and all that, I'm not as bad as [emily]."
    rose "哦，休息时间还是有的，也有慵懒的日子，我没 [emily] 那么夸张。"

# game/scripts/house_events.rpy:1361
translate chinese_simp rose_event_b4f7b21a:

    # rose "I'm talking more as in leaving or visiting another place for just that purpose."
    rose "我指的是那种专门为了度假而出门的情况。"

# game/scripts/house_events.rpy:1365
translate chinese_simp rose_event_cee22e14:

    # rose "So I'm looking into a spot that my parents always took me when I was a kid..."
    rose "所以我在看我小时候父母常带我去的一个地方……"

# game/scripts/house_events.rpy:1366
translate chinese_simp rose_event_f1349e4c:

    # player "Is it like an apartment or hotel near a beach?"
    player "是那种海边的公寓或者酒店吗？"

# game/scripts/house_events.rpy:1367
translate chinese_simp rose_event_49d7d14a:

    # rose "Something like that... It's gotten pretty expensive recently, so I'd have to save up a bit."
    rose "差不多……不过最近涨价了不少，我得攒点钱。"

# game/scripts/house_events.rpy:1368
translate chinese_simp rose_event_adf60965:

    # player "Maybe we could all go?"
    player "也许我们可以一起去？"

# game/scripts/house_events.rpy:1370
translate chinese_simp rose_event_d26e0a76:

    # player "You, me, [emily] and [lisa], could be much easier to afford split four ways..."
    player "你、我、[emily] 和 [lisa]，四个人分摊的话会轻松很多……"

# game/scripts/house_events.rpy:1372
translate chinese_simp rose_event_bd1b4d3f:

    # player "You, me, and [emily], could be much easier to afford split three ways..."
    player "你、我和 [emily]，三个人分摊的话会轻松很多……"

# game/scripts/house_events.rpy:1376
translate chinese_simp rose_event_5daa7a32:

    # rose "You're right about that..."
    rose "你说得对……"

# game/scripts/house_events.rpy:1377
translate chinese_simp rose_event_18b0ef6f:

    # rose "It would be fun going with you guys..."
    rose "跟你们一起去应该会很有意思……"

# game/scripts/house_events.rpy:1381
translate chinese_simp rose_event_dca65e83:

    # rose "I'll have to do the math and see how that would work."
    rose "我得算算看具体怎么操作。"

# game/scripts/house_events.rpy:1382
translate chinese_simp rose_event_61f91d2e:

    # rose "And try to make it happen soon... Or find another spot that's just as good."
    rose "然后尽快落实……或者找另一个同样好的地方。"

# game/scripts/house_events.rpy:1383
translate chinese_simp rose_event_83f14ce7:

    # player "I'll leave the whole process to you, you seem like you're good at that."
    player "那这事就交给你了，你看起来挺擅长的。"

# game/scripts/house_events.rpy:1387
translate chinese_simp rose_event_22d91344:

    # rose "I don't know what exactly would give you that idea..."
    rose "我不知道你为什么会这么觉得……"

# game/scripts/house_events.rpy:1395
translate chinese_simp rose_event_9c906883:

    # rose "Look who it is..."
    rose "看看这是谁……"

# game/scripts/house_events.rpy:1396
translate chinese_simp rose_event_99382a08:

    # player "Hey, no [emily] today?"
    player "嘿，今天 [emily] 不在？"

# game/scripts/house_events.rpy:1397
translate chinese_simp rose_event_00aeffba:

    # rose "She's busy right now..."
    rose "她现在正忙着呢……"

# game/scripts/house_events.rpy:1398
translate chinese_simp rose_event_0372ab5e:

    # rose "I see you two really hit it off recently huh?"
    rose "我看你们俩最近进展不错嘛？"

# game/scripts/house_events.rpy:1399
translate chinese_simp rose_event_faa0f553:

    # rose "Taking her on dates and everything..."
    rose "都开始约会了……"

# game/scripts/house_events.rpy:1400
translate chinese_simp rose_event_ece04e6c:

    # player "Yeah..."
    player "嗯……"

# game/scripts/house_events.rpy:1404
translate chinese_simp rose_event_d12493d1:

    # rose "Cool, cool..."
    rose "挺好，挺好……"

# game/scripts/house_events.rpy:1405
translate chinese_simp rose_event_13d7bf64:

    # player "There a reason you brought that up?"
    player "你提这个是有原因的吧？"

# game/scripts/house_events.rpy:1409
translate chinese_simp rose_event_19c59807:

    # rose "I'm just curious..."
    rose "我就是好奇……"

# game/scripts/house_events.rpy:1410
translate chinese_simp rose_event_b99e6d8a:

    # player "I see..."
    player "这样啊……"

# game/scripts/house_events.rpy:1411
