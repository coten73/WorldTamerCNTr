    # player "You're right..."
    player "你说得对……"

# game/scripts/house_events.rpy:1467
translate chinese_simp rose_event_15cd6046:

    # rose "Hey, [player]~"
    rose "嘿，[player]~"

# game/scripts/house_events.rpy:1468
translate chinese_simp rose_event_a900cf97:

    # rose "Come here... I wanna talk to you about something..."
    rose "过来……我想跟你说点事……"

# game/scripts/house_events.rpy:1469
translate chinese_simp rose_event_aa75ffb7:

    # player "Sure..."
    player "好啊……"

# game/scripts/house_events.rpy:1473
translate chinese_simp rose_event_4a8b3543:

    # rose "I just have a question..."
    rose "我有个问题……"

# game/scripts/house_events.rpy:1474
translate chinese_simp rose_event_b4cc0c38:

    # player "What is it?"
    player "什么问题？"

# game/scripts/house_events.rpy:1475
translate chinese_simp rose_event_fd87954a:

    # rose "It's about us..."
    rose "关于我们俩……"

# game/scripts/house_events.rpy:1476
translate chinese_simp rose_event_2e2132bf:

    # player "In what way..?"
    player "哪方面的？"

# game/scripts/house_events.rpy:1480
translate chinese_simp rose_event_2c9718d6:

    # rose "I wanna go on a date."
    rose "我想约会。"

# game/scripts/house_events.rpy:1481
translate chinese_simp rose_event_c2d74f20:

    # player "What do you mean?"
    player "什么意思？"

# game/scripts/house_events.rpy:1485
translate chinese_simp rose_event_4f69faa6:

    # rose "I mean a proper date, you know... The romantic stuff... Just you and me..."
    rose "就是正式的约会，你知道的……那种浪漫的……就你和我……"

# game/scripts/house_events.rpy:1486
translate chinese_simp rose_event_cb656fe9:

    # rose "What we've been doing so far is fun..."
    rose "我们之前做的事是挺有意思……"

# game/scripts/house_events.rpy:1487
translate chinese_simp rose_event_9968dab4:

    # rose "But I want to actually {i}be{/i} with you for a change..."
    rose "但我也想跟你就只是单纯地 {i}在一起{/i} 一次……"

# game/scripts/house_events.rpy:1488
translate chinese_simp rose_event_c8bf9100:

    # player "Honestly, you always struck me as someone who's not really into all that..."
    player "说实话，我一直觉得你不是那种喜欢浪漫约会的人……"

# game/scripts/house_events.rpy:1492
translate chinese_simp rose_event_69743e90:

    # rose "I mean, you're right..."
    rose "嗯，你说得没错……"

# game/scripts/house_events.rpy:1496
translate chinese_simp rose_event_d473dc72:

    # rose "But I've started thinking about those things recently..."
    rose "不过最近我开始想这些事情了……"

# game/scripts/house_events.rpy:1497
translate chinese_simp rose_event_2f8dccd1:

    # luna "I think she's falling for you..."
    luna "我觉得她喜欢上你了……"

# game/scripts/house_events.rpy:1501
translate chinese_simp rose_event_27b3ed6b:

    # player "We really did start messing around before we had a single real date..."
    player "我们确实在正式约会之前就开始瞎搞了……"

# game/scripts/house_events.rpy:1502
translate chinese_simp rose_event_7e302ab5:

    # rose "Our nights in the backyard... and the fun we have almost daily..."
    rose "我们在后院的那些晚上……还有几乎每天都会有的乐趣……"

# game/scripts/house_events.rpy:1506
translate chinese_simp rose_event_c5091c98:

    # rose "I don't really mind doing it in the wrong order..."
    rose "我倒是不太在乎顺序对不对……"

# game/scripts/house_events.rpy:1507
translate chinese_simp rose_event_01d0b24d:

    # player "I feel the same way... Do you have a preference for where you wanna go..."
    player "我也是……你有特别想去的地方吗……"

# game/scripts/house_events.rpy:1508
translate chinese_simp rose_event_ca6a0b95:

    # player "Or do you want me to take care of the whole thing?"
    player "还是全权交给我来安排？"

# game/scripts/house_events.rpy:1509
