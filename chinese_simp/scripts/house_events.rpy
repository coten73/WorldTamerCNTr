    # rose "I would let you take care of everything, but at this point, I feel like it would be better if we decided together..."
    rose "我本来想让你全权负责，但现在我觉得我们一起决定会更好……"

# game/scripts/house_events.rpy:1510
translate chinese_simp rose_event_97938765:

    # player "That's true."
    player "说得也是。"

# game/scripts/house_events.rpy:1512
translate chinese_simp rose_event_a28707ed:

    # player "I know a few spaces we could go, there's the restaurant, the park, there's even a spa..."
    player "我知道几个地方可以去，有餐厅、公园，甚至还有个水疗中心……"

# game/scripts/house_events.rpy:1514
translate chinese_simp rose_event_2214a0f3:

    # player "I know a few spaces we could go, there's the restaurant, the park..."
