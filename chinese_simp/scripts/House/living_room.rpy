    # player "Hey... What's going on here..?"
    player "嘿...这是怎么回事..？"

# game/scripts/House/living_room.rpy:968
translate chinese_simp home_halloween_772655c1:

    # rose "You finally showed up."
    rose "你终于出现了。"

# game/scripts/House/living_room.rpy:969
translate chinese_simp home_halloween_3e43f55e:

    # player "I didn't know this was even happening..."
    player "我甚至不知道正在发生什么......"

# game/scripts/House/living_room.rpy:970
translate chinese_simp home_halloween_731ff27b:

    # rose "Well we just started like an hour ago..."
    rose "好吧，我们大约一个小时前才开始......"

# game/scripts/House/living_room.rpy:973
translate chinese_simp home_halloween_3b5ac2ce:

    # emily "We would've skipped halloween like we always do, but-"
    emily "我们会像往常一样过万圣节，但是-"

# game/scripts/House/living_room.rpy:974
translate chinese_simp home_halloween_8a292fb4:

    # rose "When we heard that neither [lisa] nor [ellie] ever did this before, we had to do it~!"
    rose "当我们听说[lisa]和[ellie]以前都没有这样做过时，我们不得不这样做~！"

# game/scripts/House/living_room.rpy:975
translate chinese_simp home_halloween_c001bb81:

    # player "I guess that makes sense for [ellie]... But I would've thought that your village knew about Halloween, [lisa]..."
    player "我想这对 [ellie] 来说是有意义的...我还以为万圣节你们村儿也该听说过啊, [lisa]..."

# game/scripts/House/living_room.rpy:978
translate chinese_simp home_halloween_435f8c3c:

    # lisa "We know about it, we just never celebrate it or anything like that..."
    lisa "我们知道一点，但我们只是从不庆祝它或者什么的......"

# game/scripts/House/living_room.rpy:979
translate chinese_simp home_halloween_f8f4fff1:

    # lisa "It's seen as humans' holiday where they dress up like other races~"
    lisa "这种人类的节日，其他人打扮得像其他种族一样~"

# game/scripts/House/living_room.rpy:980
translate chinese_simp home_halloween_facd3a0e:

    # rose "Yeah... That sounds about right~!"
    rose "是啊……听起来还不错~！"

# game/scripts/House/living_room.rpy:983
translate chinese_simp home_halloween_7cbee997:

    # lisa "Join us! We can work on my pumpkin together!"
    lisa "快来！我们可以一起雕刻我的南瓜！"

# game/scripts/House/living_room.rpy:985
translate chinese_simp home_halloween_164eba55:

    # player "Sure."
    player "当然。"

# game/scripts/House/living_room.rpy:989
translate chinese_simp home_halloween_5c44661a:

    # rose "I'm guessing you're not a pro at this either?"
    rose "我猜你也不是这方面的专家？"

# game/scripts/House/living_room.rpy:990
translate chinese_simp home_halloween_b8891b4a:

    # player "Heh... No."
    player "呵呵……不。"

# game/scripts/House/living_room.rpy:993
translate chinese_simp home_halloween_95642087:

    # rose "Good! That means everyone's in the dark~!"
    rose "行啊，那意思就是谁都不知道~！"

# game/scripts/House/living_room.rpy:994
translate chinese_simp home_halloween_ccea0fda:

    # player "Is it that bad?"
    player "有那么糟糕吗？"

# game/scripts/House/living_room.rpy:997
translate chinese_simp home_halloween_8332f2bb:

    # rose "Well you know the story with these two..."
    rose "反正这俩什么情况，你也清楚......"

# game/scripts/House/living_room.rpy:998
translate chinese_simp home_halloween_bc7e77f7:

    # rose "My family wasn't the type to do this and [emily]-"
    rose "不是我们家人都不会这样做，--"

# game/scripts/House/living_room.rpy:999
translate chinese_simp home_halloween_959198f2:

    # emily "Just never had a reason before."
    emily "只是以前一直没这个必要"

# game/scripts/House/living_room.rpy:1002
translate chinese_simp home_halloween_61970f88:

    # rose "But how hard could carving a pumpkin actually be~?"
    rose "不过雕刻一个南瓜到底有多难呢~？"

# game/scripts/House/living_room.rpy:1003
translate chinese_simp home_halloween_d0518640:

    # emily "I guess we'll find out~!"
    emily "我想我们会知道的~！"

# game/scripts/House/living_room.rpy:1006
translate chinese_simp home_halloween_d612d1b3:

    # rose "I see that you two are almost done?"
    rose "我看你们两个已经快完成了？"

