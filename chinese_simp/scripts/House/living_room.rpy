    # player "I guess we got a bit carried away..."
    player "我想我们有点得意忘形了......"

# game/scripts/House/living_room.rpy:1131
translate chinese_simp home_halloween_95d26a92:

    # rose "We'll be down in a second."
    rose "我们一会儿就下来。"

# game/scripts/House/living_room.rpy:1134
translate chinese_simp home_halloween_860e4d4f:

    # rose "You mind doing it?"
    rose "你介意这样做吗？"

# game/scripts/House/living_room.rpy:1135
translate chinese_simp home_halloween_6f14fc88_1:

    # player "Not at all..."
    player "一点也不..."

# game/scripts/House/living_room.rpy:1138
translate chinese_simp home_halloween_93c5c002:

    # rose "I think that looks okay so far..."
    rose "我认为到目前为止看起来还不错......"

# game/scripts/House/living_room.rpy:1139
translate chinese_simp home_halloween_70366a5c:

    # player "Right. What's next?"
    player "对。接下来怎么办？"

# game/scripts/House/living_room.rpy:1142
translate chinese_simp home_halloween_ffff009a:

    # rose "We can put up the rest of those bats and spiders..."
    rose "我们可以把剩下的蝙蝠和蜘蛛放上去......"

# game/scripts/House/living_room.rpy:1143
