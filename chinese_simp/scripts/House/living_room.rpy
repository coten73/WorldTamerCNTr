    # rose "And a pretty amazing one at that!"
    rose "这是一个非常惊人的消息！"

# game/scripts/House/living_room.rpy:1059
translate chinese_simp home_halloween_830b1bd8:

    # ellie "Thank you..."
    ellie "谢谢你..."

# game/scripts/House/living_room.rpy:1060
translate chinese_simp home_halloween_b2b47850:

    # rose "Well I guess I don't need to be as careful anymore!"
    rose "好吧，我想我不需要再那么小心了！"

