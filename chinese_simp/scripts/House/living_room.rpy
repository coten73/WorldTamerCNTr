    # rose "Really! Just like that?"
    rose "我靠！这么简单？"

# game/scripts/House/living_room.rpy:1050
translate chinese_simp home_halloween_22438a3f:

    # ellie "Yeah~"
    ellie "是啊~"

# game/scripts/House/living_room.rpy:1053
