translate chinese_simp home_halloween_077f4f61:

    # rose "I guess I'm out then..."
    rose "那我估计就out了..."

# game/scripts/House/living_room.rpy:1027
translate chinese_simp home_halloween_07ce71b3:

    # ellie "Can I..?"
    ellie "我能..吗？"

# game/scripts/House/living_room.rpy:1030
translate chinese_simp home_halloween_e10529d4:

    # rose "Sure, you can try, but I doubt there's a way to fix it..."
    rose "当然，你可以试试，不过我估计这事儿没救了......"

# game/scripts/House/living_room.rpy:1031
translate chinese_simp home_halloween_371fc44b:

    # ellie "Can I use magic?"
    ellie "我可以使用魔法吗？"

