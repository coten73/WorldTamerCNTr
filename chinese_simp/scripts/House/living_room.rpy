    # rose "You make it look really easy, you know~"
    rose "你知道的, 你让它变得特别简单~"

# game/scripts/House/living_room.rpy:1121
translate chinese_simp home_halloween_84091066:

    # player "It's not like you'd be hard to lift anyway~"
    player "反正也不是很难举起来~"

# game/scripts/House/living_room.rpy:1124
translate chinese_simp home_halloween_223b45d1:

    # rose "We do work out in the gym... and occasionally the backyard~"
    rose "我们确实在健身房锻炼...偶尔也会在后院锻炼~"

# game/scripts/House/living_room.rpy:1125
