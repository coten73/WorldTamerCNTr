    # rose "Oh right... Go ahead!"
    rose "哦，对……继续吧！"

# game/scripts/House/living_room.rpy:1037
translate chinese_simp home_halloween_4440429a:

    # ellie "Okay..."
    ellie "好吧..."

# game/scripts/House/living_room.rpy:1046
translate chinese_simp home_halloween_f87436c4:

    # ellie "There."
    ellie "搞定了。"

