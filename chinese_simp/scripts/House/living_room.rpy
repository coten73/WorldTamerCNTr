    # lisa "That's fine."
    lisa "没关系。"

# game/scripts/House/living_room.rpy:1075
translate chinese_simp home_halloween_4f2087fd:

    # rose "Awesome!"
    rose "太棒了！"

# game/scripts/House/living_room.rpy:1079
translate chinese_simp home_halloween_0c5a5133:

    # ellie "I finished mine..."
    ellie "我完成了我的..."

# game/scripts/House/living_room.rpy:1080
translate chinese_simp home_halloween_fe7ca246:

    # rose "I think I'm done as well..!"
    rose "我想我也完成了..！"

# game/scripts/House/living_room.rpy:1083
translate chinese_simp home_halloween_420f8d8a:

    # emily "Great! That means we're all done!"
    emily "太棒了！这意味着我们都完成了！"

# game/scripts/House/living_room.rpy:1084
translate chinese_simp home_halloween_27ad390c:

    # ellie "Yes!"
    ellie "对的！"

# game/scripts/House/living_room.rpy:1085
translate chinese_simp home_halloween_21535f01:

    # emily "Then let's take these outside, and get to the second part of today's plans!"
    emily "那么我们就把这些带到外面去，开始今天计划的第二部分！"

# game/scripts/House/living_room.rpy:1086
translate chinese_simp home_halloween_c87c7cab:

    # rose "Right..!"
    rose "正确的..！"

# game/scripts/House/living_room.rpy:1089
translate chinese_simp home_halloween_4e057082:

    # emily "We got fake spiders, bats, ghosts, and pretty much anything else I could find in the store!"
    emily "我们有假蜘蛛、假蝙蝠、假幽灵，以及我在商店里能找到的几乎所有其他东西！"

# game/scripts/House/living_room.rpy:1092
translate chinese_simp home_halloween_e872fadc:

    # emily "Three should decorate the living room, and two of us can decorate the kitchen! Who's going to join me..?"
    emily "三个人可以装饰客厅，两个人可以装饰厨房！谁能帮我..？"

# game/scripts/House/living_room.rpy:1093
translate chinese_simp home_halloween_b1b0ad44:

    # lisa "I'll go!"
    lisa "我来！"

# game/scripts/House/living_room.rpy:1096
translate chinese_simp home_halloween_dccb3706:

    # emily "That works!"
    emily "那够了！"

# game/scripts/House/living_room.rpy:1099
translate chinese_simp home_halloween_0ba57a39:

    # rose "So I'm thinking we put these cutouts right above the window."
    rose "我在想，咱把这些剪好的东西直接搁窗户上头"

# game/scripts/House/living_room.rpy:1100
translate chinese_simp home_halloween_de74e956:

    # player "I'll help you..."
    player "我来帮你..."

# game/scripts/House/living_room.rpy:1101
translate chinese_simp home_halloween_12498947:

    # ellie "I'll start taping bats and spiders on the wall."
    ellie "我要开始在墙上贴上蝙蝠和蜘蛛。"

# game/scripts/House/living_room.rpy:1104
translate chinese_simp home_halloween_a7736a46:

    # rose "Make sure you count exactly how many you put up! I don't want to be scared to death a few weeks from now when I find a spider that fell off."
    rose "你贴几个一定数好了啊！别过几周掉下来一只，然后把我吓得神志不清。"

# game/scripts/House/living_room.rpy:1105
translate chinese_simp home_halloween_a4b809a2:

    # ellie "I understand~"
    ellie "我明白了~"

# game/scripts/House/living_room.rpy:1108
translate chinese_simp home_halloween_2ab21cdb:

    # rose "I can't... Quite... Reach..."
    rose "我……够……不到……"

# game/scripts/House/living_room.rpy:1112
translate chinese_simp home_halloween_aadfb3ba:

    # rose "Would you mind lifting me up~?"
    rose "能扶我起来吗~"

# game/scripts/House/living_room.rpy:1113
translate chinese_simp home_halloween_6f14fc88:

    # player "Not at all..."
    player "彳亍..."

# game/scripts/House/living_room.rpy:1116
translate chinese_simp home_halloween_bc121621:

    # rose "There we go! Thanks~"
    rose "开始吧！谢谢~"

# game/scripts/House/living_room.rpy:1117
translate chinese_simp home_halloween_9c3e270d:

    # player "Don't mention it~"
    player "小事~"

# game/scripts/House/living_room.rpy:1120
