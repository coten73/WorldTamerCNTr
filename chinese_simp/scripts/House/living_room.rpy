translate chinese_simp home_halloween_32765798:

    # player "Almost..."
    player "差不多了..."

# game/scripts/House/living_room.rpy:1010
translate chinese_simp home_halloween_0821f7a7:

    # rose "I don't have the patience for this~!"
    rose "我没这个耐心啊~！"

