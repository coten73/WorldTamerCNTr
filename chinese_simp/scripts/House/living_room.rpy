    # ellie "Guys..!"
    ellie "伙计们..！"

# game/scripts/House/living_room.rpy:1129
translate chinese_simp home_halloween_200b8473:

    # rose "Oops... Sorry about that~"
    rose "哎呀……抱歉啊~"

