    # lisa "(I am... Being in the sun for so long always does this to me...)"
    lisa "（我是有点困……在阳光下晒了这么久总会让我这样……）"

# game/scripts/House/living_room.rpy:939
translate chinese_simp island_visit_repeatable_869f2636:

    # player "(That's normal you know... Might be good for you to get some sleep as well...)"
    player "（这很正常，你知道的......可能对你睡一觉也有好处......）"

# game/scripts/House/living_room.rpy:943
translate chinese_simp island_visit_repeatable_949913df:

