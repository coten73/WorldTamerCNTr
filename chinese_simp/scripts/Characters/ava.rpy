    # ava "And also asking very nicely as someone you love~"
    ava "而且还是以你所爱之人的身份好好地请求你~"

# game/scripts/Characters/ava.rpy:408
translate chinese_simp ava_house_work_aecc69ba:

    # player "I can't possibly say no to that~"
    player "这个我实在没法拒绝~"

# game/scripts/Characters/ava.rpy:412
translate chinese_simp ava_house_work_79a4311c:

    # ava "Mmnnh~"
    ava "嗯嗯~"

# game/scripts/Characters/ava.rpy:415
translate chinese_simp ava_house_work_5237e2af:

    # ava "You're the best~"
    ava "你最好了~"

# game/scripts/Characters/ava.rpy:416
translate chinese_simp ava_house_work_a646d9d4:

    # player "What should I start with?"
    player "我从哪里开始？"

# game/scripts/Characters/ava.rpy:419
translate chinese_simp ava_house_work_f0ec9f54:

    # ava "All the tables need to be wiped."
    ava "所有桌子都要擦。"

# game/scripts/Characters/ava.rpy:420
translate chinese_simp ava_house_work_a5082a56:

    # player "On it."
    player "交给我。"

# game/scripts/Characters/ava.rpy:423
translate chinese_simp ava_house_work_b1f0d7dc:

    # narrator "You start helping [ava] clean the bar."
    narrator "你开始帮[ava]打扫酒吧。"

# game/scripts/Characters/ava.rpy:426
translate chinese_simp ava_house_work_b0351539:

    # ava "You just cut my workload in half~"
    ava "你一下帮我省了一半的活~"

# game/scripts/Characters/ava.rpy:427
translate chinese_simp ava_house_work_2e5f0c96:

    # player "Now you get to do what you usually do when [emma]'s around~"
    player "那你可以做点平时[emma]在的时候做的事了~"

# game/scripts/Characters/ava.rpy:430
translate chinese_simp ava_house_work_99435ed8:

    # ava "Not exactly."
    ava "也不是。"

# game/scripts/Characters/ava.rpy:431
translate chinese_simp ava_house_work_7eb20218:

    # ava "I usually do most of the cleaning inside."
    ava "我平时就负责室内的大部分打扫。"

# game/scripts/Characters/ava.rpy:432
translate chinese_simp ava_house_work_a47d6a73:

    # ava "[emma] counts the receipts and everything to do with the register."
    ava "[emma]负责点账和收银台相关的事。"

# game/scripts/Characters/ava.rpy:433
translate chinese_simp ava_house_work_1916af81:

    # player "So who's doing that tonight?"
    player "那今晚谁来做？"

# game/scripts/Characters/ava.rpy:436
translate chinese_simp ava_house_work_d4447820:

    # ava "No one."
    ava "没人做。"

# game/scripts/Characters/ava.rpy:437
translate chinese_simp ava_house_work_79bf1662:

    # ava "It's going to have to wait until morning when she's feeling better."
    ava "只能等到早上她好点了再说。"

# game/scripts/Characters/ava.rpy:438
translate chinese_simp ava_house_work_748d9194:

    # player "Not going to try it yourself?"
    player "你不自己试试？"

# game/scripts/Characters/ava.rpy:441
translate chinese_simp ava_house_work_49c91793:

    # ava "She's got a whole system set up."
    ava "她有一套完整的系统。"

# game/scripts/Characters/ava.rpy:442
translate chinese_simp ava_house_work_b4e8db41:

    # ava "And I don't think she'd like me messing with it."
    ava "我觉得她不会喜欢我乱动她的东西。"

# game/scripts/Characters/ava.rpy:443
translate chinese_simp ava_house_work_f8cf0004:

    # player "Then all we have to do is clean the bar?"
    player "那我们要做的就只是打扫酒吧？"

# game/scripts/Characters/ava.rpy:446
translate chinese_simp ava_house_work_11500a69:

    # ava "Just the inside yeah."
    ava "就里面，没错。"

# game/scripts/Characters/ava.rpy:447
translate chinese_simp ava_house_work_e139be18:

    # ava "[nora] and [leah] usually take care of the kitchen and the outside."
    ava "[nora]和[leah]一般负责厨房和外面的部分。"

# game/scripts/Characters/ava.rpy:448
translate chinese_simp ava_house_work_f58062c1:

    # player "Even better~"
    player "那更好了~"

# game/scripts/Characters/ava.rpy:451
translate chinese_simp ava_house_work_547faefe:

    # ava "You got that right~"
    ava "说得对~"

# game/scripts/Characters/ava.rpy:454
translate chinese_simp ava_house_work_98506615:

    # ava "We can finish up early, and head straight to bed~"
    ava "我们可以早点干完，然后直接上床~"

# game/scripts/Characters/ava.rpy:455
translate chinese_simp ava_house_work_8a844bfe:

    # ava "If you're up for staying over~"
    ava "如果你愿意留下来过夜的话~"

# game/scripts/Characters/ava.rpy:456
translate chinese_simp ava_house_work_ec781e0e:

    # player "I am~"
    player "好啊~"

# game/scripts/Characters/ava.rpy:459
translate chinese_simp ava_house_work_a341fb3e:

    # narrator "You finish wiping the tables as [ava] sweeps and cleans the floor."
    narrator "[ava]扫地拖地的时候，你擦完了所有的桌子。"

# game/scripts/Characters/ava.rpy:462
translate chinese_simp ava_house_work_42d0ac4d:

    # ava "Perfect~"
    ava "完美~"

# game/scripts/Characters/ava.rpy:463
translate chinese_simp ava_house_work_577e8c1e:

    # player "Mhm~"
    player "嗯~"

# game/scripts/Characters/ava.rpy:466
translate chinese_simp ava_house_work_1f7b1466:

    # ava "Let's take a shower and head to bed."
    ava "我们冲个澡就睡吧。"

# game/scripts/Characters/ava.rpy:467
translate chinese_simp ava_house_work_af9de627:

    # player "Right behind you."
    player "我跟着你。"

# game/scripts/Characters/ava.rpy:470
translate chinese_simp ava_house_work_9a4e87e3:

    # ava "We can shower together, but we can't get any ideas~"
    ava "我们可以一起洗，但不要有什么坏心思哦~"

# game/scripts/Characters/ava.rpy:471
translate chinese_simp ava_house_work_bd5b0f70:

    # ava "I really wanna use this to go to bed early."
    ava "我真的想趁这个机会早点睡。"

# game/scripts/Characters/ava.rpy:472
translate chinese_simp ava_house_work_3b3b2ada:

    # player "I understand. I'm kinda tired too."
    player "我懂。我也挺累的。"

# game/scripts/Characters/ava.rpy:475
translate chinese_simp ava_house_work_11f8dc48:

    # ava "As long as we agree~"
    ava "那就这么说定了~"

# game/scripts/Characters/ava.rpy:480
translate chinese_simp ava_house_work_67e0b2b6:

    # ava "Mmnnn~~"
    ava "嗯嗯嗯~~"

# game/scripts/Characters/ava.rpy:484
translate chinese_simp ava_house_work_ff9ec2da:

    # ava "You ever get tired of untaming me after every kiss?"
    ava "你每次接吻后都要解除驯服，会不会觉得烦？"

# game/scripts/Characters/ava.rpy:485
translate chinese_simp ava_house_work_0161a672:

    # player "Not at all."
    player "一点也不。"

# game/scripts/Characters/ava.rpy:486
translate chinese_simp ava_house_work_f61e3683:

    # player "But it does feel weird having to think about not wanting you tamed every time."
    player "不过每次都要想着‘不想驯服你’，确实有点奇怪。"

# game/scripts/Characters/ava.rpy:489
translate chinese_simp ava_house_work_27cd4470:

    # ava "Is that how you do it?"
    ava "你就是这么操作的？"

# game/scripts/Characters/ava.rpy:490
translate chinese_simp ava_house_work_0d5bfc35:

    # player "I basically just lie to myself for a second."
    player "基本上就是短暂地骗自己一下。"

# game/scripts/Characters/ava.rpy:491
translate chinese_simp ava_house_work_fa682a31:

    # player "'I love you, but I don't want to tame you.'"
    player "‘我爱你，但我不想驯服你。’"

# game/scripts/Characters/ava.rpy:494
translate chinese_simp ava_house_work_76b1c41b:

    # ava "So you do want me tamed~"
    ava "所以你其实是想的~"

# game/scripts/Characters/ava.rpy:497
translate chinese_simp ava_house_work_51c690d0:

    # player "Obviously~"
    player "那当然~"

# game/scripts/Characters/ava.rpy:498
translate chinese_simp ava_house_work_b84b8b34:

    # player "Whatever gets me closer to you~"
    player "只要能让我更靠近你就行~"

# game/scripts/Characters/ava.rpy:499
translate chinese_simp ava_house_work_db90ec87:

    # ava "That's a nice way of putting it~"
    ava "说得真好听~"

# game/scripts/Characters/ava.rpy:502
translate chinese_simp ava_house_work_db083c60:

    # ava "But I hope you don't come to resent me or anything like that."
    ava "但我希望你不会因此怨恨我什么的。"

# game/scripts/Characters/ava.rpy:503
translate chinese_simp ava_house_work_cfc6ffcb:

    # ava "I'm not sure I'll ever be ready to stay tamed permanently."
    ava "我不确定我能不能永远保持被驯服状态。"

# game/scripts/Characters/ava.rpy:506
translate chinese_simp ava_house_work_8ba3e4ae:

    # ava "It just dials up all my emotions to eleven..."
    ava "那会把我的所有情绪都拉到顶……"

# game/scripts/Characters/ava.rpy:509
translate chinese_simp ava_house_work_f07dcac3:

    # ava "And I like them better as is."
    ava "我还是更喜欢它们本来的样子。"

# game/scripts/Characters/ava.rpy:510
translate chinese_simp ava_house_work_d71be52f:

    # player "Like I said. I'll do it as many times as you want."
    player "我说过了，你让我做多少次都行。"

# game/scripts/Characters/ava.rpy:511
translate chinese_simp ava_house_work_649e6b76:

    # player "Just don't start avoiding me because it makes me feel a little bad."
    player "别因为这个躲着我就行，那会让我有点难受的。"

# game/scripts/Characters/ava.rpy:514
translate chinese_simp ava_house_work_fe7ec9aa:

    # ava "That's not possible~"
    ava "那不可能~"

# game/scripts/Characters/ava.rpy:515
translate chinese_simp ava_house_work_21e564ce:

    # ava "Call me selfish, but it's a trade I'm willing to make any day~"
    ava "你可以说我自私，但这个交换条件，我随时都愿意做~"

# game/scripts/Characters/ava.rpy:518
translate chinese_simp ava_house_work_e338e10d:

    # ava "We both get something out of it too~"
    ava "而且我们双方都有收获~"

# game/scripts/Characters/ava.rpy:519
translate chinese_simp ava_house_work_aca1c6dd:

    # ava "A warm kiss... And often a lot more with it~"
    ava "一个温暖的吻……还往往附带更多~"

# game/scripts/Characters/ava.rpy:520
translate chinese_simp ava_house_work_6c66edb1:

    # player "Exactly~"
    player "没错~"

# game/scripts/Characters/ava.rpy:525
translate chinese_simp ava_house_work_b01cadf2:

    # ava "Mmmnnnn~~"
    ava "嗯嗯嗯嗯~~"

# game/scripts/Characters/ava.rpy:529
translate chinese_simp ava_house_work_1da63254:

    # ava "Ready to get in that shower and then bed~?"
    ava "准备好去洗澡然后睡觉了吗~？"

# game/scripts/Characters/ava.rpy:530
translate chinese_simp ava_house_work_ec781e0e_1:

    # player "I am~"
    player "好了~"

# game/scripts/Characters/ava.rpy:533
translate chinese_simp ava_house_work_9a8091f3:

    # narrator "You and [ava] take a shower and head directly to bed."
    narrator "你和[ava]一起冲了个澡，然后直接上床睡觉。"