    player "她确保没人再动你们的酒吧。"

# game/scripts/Characters/aurora.rpy:1847
translate chinese_simp aurora_checkup_2d226bb4:

    # ava "And you want us to what... Hire them?"
    ava "所以你想让我们……雇佣她们？"

# game/scripts/Characters/aurora.rpy:1848
