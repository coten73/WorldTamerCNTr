    ava "那 {i}或许{/i} 可行……"

# game/scripts/Characters/aurora.rpy:1869
translate chinese_simp aurora_checkup_35d533ff:

    # ava "They should know how to handle themselves, given their past."
    ava "以她们的背景，应该知道怎么应对状况。"

