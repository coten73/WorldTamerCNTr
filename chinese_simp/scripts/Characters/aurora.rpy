    ava "但名义上才重要啊。"

# game/scripts/Characters/aurora.rpy:1834
translate chinese_simp aurora_checkup_34a881e8:

    # player "I guess... But I'd never go over your heads."
    player "也许吧……但我不会越过你们做决定。"

# game/scripts/Characters/aurora.rpy:1835
translate chinese_simp aurora_checkup_bda3c703:

    # player "Especially in this case. Your word matters more."
    player "尤其这件事。你们的意见更重要。"

# game/scripts/Characters/aurora.rpy:1838
translate chinese_simp aurora_checkup_c4773b5e:

    # ava "What's so special about these two?"
    ava "这两个人有什么特别的？"

# game/scripts/Characters/aurora.rpy:1839
translate chinese_simp aurora_checkup_54cd19bb:

    # player "They're high-ranking members of the gang that fell apart recently."
