    ava "你怎么突然提这个？"

# game/scripts/Characters/aurora.rpy:1824
translate chinese_simp aurora_checkup_23b4e83f:

    # player "I know two girls who are in a bad spot right now."
    player "我认识两个女孩，她们现在处境很不好。"

