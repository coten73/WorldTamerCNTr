# game/scripts/Characters/aurora.rpy:1828
translate chinese_simp aurora_checkup_fc52c8ab:

    # ava "I see..."
    ava "这样啊……"

# game/scripts/Characters/aurora.rpy:1829
translate chinese_simp aurora_checkup_704d43d5:

