    # emma "..."
    emma "……"

# game/scripts/Characters/aurora.rpy:1856
translate chinese_simp aurora_checkup_a542d9c8:

    # ava "What do you think?"
    ava "你觉得呢？"

# game/scripts/Characters/aurora.rpy:1857
