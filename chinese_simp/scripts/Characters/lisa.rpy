    # player "And much less scary than you thought, right?"
    player "而且没你想的那么可怕，对吧？"

# game/scripts/Characters/lisa.rpy:663
translate chinese_simp lisa_date_one_e2e79eda:

    # lisa "I don't know... We haven't run into anyone yet..."
    lisa "不知道……我们还没遇到别人呢……"

# game/scripts/Characters/lisa.rpy:664
translate chinese_simp lisa_date_one_ea40a294:

    # player "Probably because it's early in the morning."
    player "可能是因为时间还早。"

# game/scripts/Characters/lisa.rpy:665
translate chinese_simp lisa_date_one_b7ed4443:

    # player "And when we do, no one's gonna pay attention to us anyways..."
    player "就算遇到了，也不会有人注意我们的……"

# game/scripts/Characters/lisa.rpy:668
translate chinese_simp lisa_date_one_c4b93975:

    # lisa "You think so?"
    lisa "你觉得吗？"

# game/scripts/Characters/lisa.rpy:669
translate chinese_simp lisa_date_one_68e0afa0:

    # think "What has she been taught? Who's been filling her head with fear..."
    think "她到底被灌输了什么？谁一直让她这么害怕……"

# game/scripts/Characters/lisa.rpy:670
translate chinese_simp lisa_date_one_14a5199e:

    # player "I'm sure of it. On that thought, how come you were essentially homeless?"
    player "我确定。说起来，你怎么会无家可归呢？"

# game/scripts/Characters/lisa.rpy:673
translate chinese_simp lisa_date_one_9821a1f2:

    # lisa "I... I had to leave home..."
    lisa "我……我不得不离开家……"

# game/scripts/Characters/lisa.rpy:674
translate chinese_simp lisa_date_one_8c74f9b4:

    # player "You don't have to tell me if you don't want to."
    player "你不想说可以不说。"

# game/scripts/Characters/lisa.rpy:677
translate chinese_simp lisa_date_one_838154eb:

    # lisa "It's not important anymore... I got a new home now!"
    lisa "这些都不重要了……我现在有新家了！"

# game/scripts/Characters/lisa.rpy:678
translate chinese_simp lisa_date_one_e721050e:

    # lisa "What's in the past is in the past..."
    lisa "过去的事就让它过去吧……"

# game/scripts/Characters/lisa.rpy:679
translate chinese_simp lisa_date_one_d69e032c:

    # player "When you're ready to share it, I'll be there to listen."
    player "等你愿意说的时候，我随时都在。"

# game/scripts/Characters/lisa.rpy:682
translate chinese_simp lisa_date_one_8d6397f3:

    # lisa "Thank you... It means a lot to me..."
    lisa "谢谢……这对我很重要……"

# game/scripts/Characters/lisa.rpy:685
translate chinese_simp lisa_date_one_55c5c022:

    # lisa "What about you, [persistent.lisaplayerTitle]?"
    lisa "你呢，[persistent.lisaplayerTitle]？"

# game/scripts/Characters/lisa.rpy:686
translate chinese_simp lisa_date_one_00f35df1:

    # lisa "Where are you from?"
    lisa "你来自哪里？"

# game/scripts/Characters/lisa.rpy:687
translate chinese_simp lisa_date_one_a2da05da:

    # player "I guess I'm from here... I was born in this town, but had to leave pretty young..."
    player "我算是在这儿出生的……我出生在这个镇子，但很小就离开了……"

# game/scripts/Characters/lisa.rpy:688
translate chinese_simp lisa_date_one_26ed5a5e:

    # lisa "Really? Why?"
    lisa "真的？为什么？"

# game/scripts/Characters/lisa.rpy:689
translate chinese_simp lisa_date_one_44c6f37a:

    # player "Something happened with my parents... So I ended up living far away with [emily]'s parents."
    player "我父母出了点事……所以我后来跟[emily]的父母住到了很远的地方。"

# game/scripts/Characters/lisa.rpy:690
translate chinese_simp lisa_date_one_5bcf1a7d:

    # lisa "Oh, okay..."
    lisa "哦，这样啊……"

# game/scripts/Characters/lisa.rpy:693
translate chinese_simp lisa_date_one_dd737721:

    # lisa "Never knew this would be so relaxing... I've never been out like this..."
    lisa "从没想过会这么放松……我从没这样出来过……"

# game/scripts/Characters/lisa.rpy:694
translate chinese_simp lisa_date_one_9a50365f:

    # player "Yeah, you said that..."
    player "嗯，你说过了……"

# game/scripts/Characters/lisa.rpy:697
translate chinese_simp lisa_date_one_7d987461:

    # lisa "I really mean it. I hope we can do something like this again..."
    lisa "我是认真的。我希望我们还能再这样出来……"

# game/scripts/Characters/lisa.rpy:698
translate chinese_simp lisa_date_one_be08464a:

    # player "I'm sure we will... You're stuck with me, right?"
    player "一定会的……反正你也跑不掉了，对吧？"

# game/scripts/Characters/lisa.rpy:701
translate chinese_simp lisa_date_one_48b0fba5:

    # lisa "Please don't say it like that... Makes it sound like I don't wanna be here..."
    lisa "别这么说嘛……好像我不想待在你身边似的……"

# game/scripts/Characters/lisa.rpy:702
translate chinese_simp lisa_date_one_3a896047:

    # player "I know... I'm just messing with you~"
    player "我知道……逗你玩的~"

# game/scripts/Characters/lisa.rpy:703
translate chinese_simp lisa_date_one_5c70ebcf:

    # player "But I do think it's time we get back home..."
    player "不过我们真该回去了……"

# game/scripts/Characters/lisa.rpy:706
translate chinese_simp lisa_date_one_4091dfdb:

    # lisa "Already?"
    lisa "这么快？"

# game/scripts/Characters/lisa.rpy:707
translate chinese_simp lisa_date_one_e60572b6:

    # player "I mean, we spent a good few hours here..."
    player "我们已经在这儿待了好几个小时了……"

# game/scripts/Characters/lisa.rpy:708
translate chinese_simp lisa_date_one_e67e9492:

    # player "As far as first dates go, I think it was great~"
    player "作为第一次约会，我觉得很棒了~"

# game/scripts/Characters/lisa.rpy:711
translate chinese_simp lisa_date_one_5db293fe:

    # lisa "It was the best!"
    lisa "这是最棒的！"

# game/scripts/Characters/lisa.rpy:712
translate chinese_simp lisa_date_one_25d140a0:

    # player "Glad you think so..."
    player "很高兴你也这么觉得……"

# game/scripts/Characters/lisa.rpy:720
translate chinese_simp lisa_date_two_ad2aa558:

    # player "You ready to go on another date?"
    player "准备好再去约一次会了吗？"

# game/scripts/Characters/lisa.rpy:721
translate chinese_simp lisa_date_two_0767ecac:

    # lisa "Of course I am? Where are we going this time?"
    lisa "当然！这次我们去哪儿？"

# game/scripts/Characters/lisa.rpy:722
translate chinese_simp lisa_date_two_bde2cb02:

    # player "It's a surprise~"
    player "保密~"

# game/scripts/Characters/lisa.rpy:726
translate chinese_simp lisa_date_two_21fc08e3:

    # player "You ever been on a bus before?"
    player "你以前坐过公交吗？"

# game/scripts/Characters/lisa.rpy:727
translate chinese_simp lisa_date_two_4a75c525:

    # player "Or a car for that matter?"
    player "或者坐过汽车吗？"

# game/scripts/Characters/lisa.rpy:728
translate chinese_simp lisa_date_two_283975ea:

    # player "I see you're really focused on looking out there..."
    player "我看你一直盯着窗外看……"

# game/scripts/Characters/lisa.rpy:731
translate chinese_simp lisa_date_two_eb2d2e05:

    # lisa "No... We didn't have cars in my village..."
    lisa "没有……我们村子里没有车……"

# game/scripts/Characters/lisa.rpy:732
translate chinese_simp lisa_date_two_011806ee:

    # lisa "Or any kind of transport."
    lisa "任何交通工具都没有。"

# game/scripts/Characters/lisa.rpy:733
translate chinese_simp lisa_date_two_e20c3cb7:

    # lisa "But we did learn about them and everything, I just never had a reason to be in one."
    lisa "但我们学过这些，只是我从来没用过。"

# game/scripts/Characters/lisa.rpy:736
translate chinese_simp lisa_date_two_bf779660:

    # lisa "How much longer is the ride? I don't wanna go too far away from home..."
    lisa "还要坐多久？我不想离家太远……"

# game/scripts/Characters/lisa.rpy:737
translate chinese_simp lisa_date_two_48873a29:

    # player "Don't worry, it's just a short ten-minute ride."
    player "别担心，就十分钟车程。"

# game/scripts/Characters/lisa.rpy:740
translate chinese_simp lisa_date_two_022154bd:

    # lisa "Can you tell me where we're going yet?"
    lisa "现在能告诉我我们去哪儿了吗？"

# game/scripts/Characters/lisa.rpy:741
translate chinese_simp lisa_date_two_a8f54ec8:

    # player "Not yet, but we have to make another stop before it, and I'm sure that's gonna give it away."
    player "还不行，不过我们要先去个地方，你肯定能猜到。"

# game/scripts/Characters/lisa.rpy:744
translate chinese_simp lisa_date_two_04ad0e1f:

    # lisa "Okay! I can't wait!"
    lisa "好吧！我等不及了！"

# game/scripts/Characters/lisa.rpy:747
translate chinese_simp lisa_date_two_4ba97845:

    # lisa "A clothing store? But I told you... I don't have any money..."
    lisa "服装店？可我跟你说了……我没钱……"

# game/scripts/Characters/lisa.rpy:748
translate chinese_simp lisa_date_two_4f49ba4e:

    # player "Don't worry about that."
    player "不用担心。"

# game/scripts/Characters/lisa.rpy:749
translate chinese_simp lisa_date_two_ce308e80:

    # player "Go and pick the swimsuit you like the most."
    player "去挑一件你最喜欢的泳衣吧。"

# game/scripts/Characters/lisa.rpy:750
translate chinese_simp lisa_date_two_bf9de478:

    # player "I'll go get the cashier, and she can help you try them on."
    player "我去叫店员，让她帮你试穿。"

# game/scripts/Characters/lisa.rpy:753
translate chinese_simp lisa_date_two_90af7b5a:

    # lisa "Okay... Thank you..."
    lisa "好……谢谢你……"

# game/scripts/Characters/lisa.rpy:757
translate chinese_simp lisa_date_two_2c009045:

    # lisa "Sorry it took so long..."
    lisa "抱歉花了这么久……"

# game/scripts/Characters/lisa.rpy:758
translate chinese_simp lisa_date_two_57f2766e:

    # player "No worries... Let's go."
    player "没事……我们走吧。"

# game/scripts/Characters/lisa.rpy:761
translate chinese_simp lisa_date_two_7946956c:

    # lisa "How do I look..?"
    lisa "我看起来怎么样？"

# game/scripts/Characters/lisa.rpy:762
translate chinese_simp lisa_date_two_d00f9883:

    # player "Amazing... You picked a great swimsuit."
    player "太棒了……你挑的泳衣真好。"

# game/scripts/Characters/lisa.rpy:763
translate chinese_simp lisa_date_two_0bfe2d3c:

    # lisa "Knew you'd like it~"
    lisa "就知道你会喜欢~"

# game/scripts/Characters/lisa.rpy:766
translate chinese_simp lisa_date_two_4353d30c:

    # lisa "Thank you again... For buying it..."
    lisa "再次谢谢你……给我买这个……"

# game/scripts/Characters/lisa.rpy:767
translate chinese_simp lisa_date_two_5eb0e897:

    # player "You're welcome..."
    player "不客气……"

# game/scripts/Characters/lisa.rpy:770
translate chinese_simp lisa_date_two_2f300901:

    # player "I gotta ask... Is it comfortable sitting like that? On your tail?"
    player "我得问一下……那样坐着舒服吗？坐在尾巴上？"

# game/scripts/Characters/lisa.rpy:773
translate chinese_simp lisa_date_two_3c38fad7:

    # lisa "Not really... It kinda hurts if I lean all the way back..."
    lisa "不太舒服……往后靠的话会有点疼……"

# game/scripts/Characters/lisa.rpy:774
translate chinese_simp lisa_date_two_4d37e4d3:

    # player "I see... Come join me on the towel then."
    player "这样啊……那过来和我一起坐在毛巾上吧。"

# game/scripts/Characters/lisa.rpy:778
translate chinese_simp lisa_date_two_8c1afe38:

    # player "Better?"
    player "好点了吗？"

# game/scripts/Characters/lisa.rpy:781
translate chinese_simp lisa_date_two_9d9b9515:

    # lisa "Much better~"
    lisa "好多了~"

# game/scripts/Characters/lisa.rpy:784
translate chinese_simp lisa_date_two_62d65a8a:

    # lisa "I wish we were alone..."
    lisa "真希望只有我们两个……"

# game/scripts/Characters/lisa.rpy:787
translate chinese_simp lisa_date_two_a50ef9d6:

    # player "I bet you do~"
    player "我看得出来~"

# game/scripts/Characters/lisa.rpy:790
translate chinese_simp lisa_date_two_4196be4b:

    # player "Doesn't mean we can't still do something like this~"
    player "但也不妨碍我们做点什么~"

# game/scripts/Characters/lisa.rpy:795
translate chinese_simp lisa_date_two_f3eab48a:

    # lisa "Mmmnnnn..."
    lisa "嗯嗯嗯……"

# game/scripts/Characters/lisa.rpy:798
translate chinese_simp lisa_date_two_2e8237da:

    # lisa "This was an amazing day, [persistent.lisaplayerTitle]..."
    lisa "今天真是美好的一天，[persistent.lisaplayerTitle]……"

# game/scripts/Characters/lisa.rpy:799
translate chinese_simp lisa_date_two_c3e40b83:

    # lisa "I had lots of fun with you..."
    lisa "和你在一起很开心……"

# game/scripts/Characters/lisa.rpy:800
translate chinese_simp lisa_date_two_4ad72028:

    # player "So did I..."
    player "我也是……"

# game/scripts/Characters/lisa.rpy:801
translate chinese_simp lisa_date_two_e8f3356b:

    # player "Let's relax for a bit longer before getting ready to leave."
    player "再休息一会儿，然后准备回去吧。"

# game/scripts/Characters/lisa.rpy:802
translate chinese_simp lisa_date_two_5d27cdbc:

    # lisa "Okay..."
    lisa "好……"

# game/scripts/Characters/lisa.rpy:812
translate chinese_simp lisa_shared_secrets_one_c6d875f2:

    # player "What's going on? You okay?"
    player "怎么了？你还好吗？"

# game/scripts/Characters/lisa.rpy:813
translate chinese_simp lisa_shared_secrets_one_3451aba6:

    # lisa "It's... it's fine. Don't worry."
    lisa "没事的……别担心。"

# game/scripts/Characters/lisa.rpy:814
translate chinese_simp lisa_shared_secrets_one_6e399aae:

    # player "You're clearly upset. Is there any way I can help?"
    player "你明明很难过。我能帮上什么忙吗？"

# game/scripts/Characters/lisa.rpy:815
translate chinese_simp lisa_shared_secrets_one_a3577fd9:

    # lisa "I'm not sure."
    lisa "我不知道。"

# game/scripts/Characters/lisa.rpy:816
translate chinese_simp lisa_shared_secrets_one_381debde:

    # player "Well, I can't just stand here and watch you cry."
    player "我不能就这么站着看你哭。"

# game/scripts/Characters/lisa.rpy:819
translate chinese_simp lisa_shared_secrets_one_f6576135:

    # lisa "You really want to know? Fine."
    lisa "你真想知道？好吧。"

# game/scripts/Characters/lisa.rpy:820
translate chinese_simp lisa_shared_secrets_one_a787e2b1:

    # lisa "The reason I was living in the attic is because I failed my tribe's trial."
    lisa "我住在阁楼里，是因为我没能通过族里的试炼。"

# game/scripts/Characters/lisa.rpy:821
translate chinese_simp lisa_shared_secrets_one_b27a10d2:

    # player "Trial?"
    player "试炼？"

# game/scripts/Characters/lisa.rpy:822
translate chinese_simp lisa_shared_secrets_one_857a1831:

    # lisa "Yeah, it's a tradition. When we turn 20, We have to fight and defeat a human warrior."
    lisa "嗯，这是传统。我们年满20岁时，必须打败一名人类战士。"

# game/scripts/Characters/lisa.rpy:823
translate chinese_simp lisa_shared_secrets_one_5a90f5e0:

    # player "So you didn't win the fight?"
    player "所以你输了？"

# game/scripts/Characters/lisa.rpy:824
translate chinese_simp lisa_shared_secrets_one_e88c81ed:

    # lisa "Exactly. I was too weak."
    lisa "对，我太弱了。"

# game/scripts/Characters/lisa.rpy:827
translate chinese_simp lisa_shared_secrets_one_48d22924:

    # lisa "I got banished for it. I haven't seen my mom in two years."
    lisa "因此我被放逐了。我已经两年没见过妈妈了。"

# game/scripts/Characters/lisa.rpy:828
translate chinese_simp lisa_shared_secrets_one_395e5cd9:

    # player "That must've been really tough."
    player "那一定很艰难。"

# game/scripts/Characters/lisa.rpy:829
translate chinese_simp lisa_shared_secrets_one_018d66ee:

    # think "Can't really say I feel similar about my parents..."
    think "我对父母倒是没有这种感觉……"

# game/scripts/Characters/lisa.rpy:832
translate chinese_simp lisa_shared_secrets_one_bcf21f19:

    # player "Listen, you don't have to go through this on your own. I'll help you get stronger."
    player "听着，你不用一个人扛。我会帮你变强的。"

# game/scripts/Characters/lisa.rpy:835
translate chinese_simp lisa_shared_secrets_one_5c9afdd6:

    # lisa "You will?"
    lisa "真的？"

# game/scripts/Characters/lisa.rpy:836
translate chinese_simp lisa_shared_secrets_one_68150de1:

    # player "Of course. You've gotten stronger after I tamed you right?"
    player "当然。我驯服你之后，你变强了，对吧？"

# game/scripts/Characters/lisa.rpy:837
translate chinese_simp lisa_shared_secrets_one_93289fa0:

    # player "When you're confident enough, I'll help you get accepted back into the village."
    player "等你觉得有信心了，我就帮你回到族里。"

# game/scripts/Characters/lisa.rpy:838
translate chinese_simp lisa_shared_secrets_one_8dab5cca:

    # lisa "You would do that for me?"
    lisa "你愿意为我这么做？"

# game/scripts/Characters/lisa.rpy:839
translate chinese_simp lisa_shared_secrets_one_dfcef7d8:

    # player "I don't see why not..."
    player "为什么不呢……"

# game/scripts/Characters/lisa.rpy:842
translate chinese_simp lisa_shared_secrets_one_201dd621:

    # lisa "Thank you. That means the world to me. I love you [persistent.lisaplayerTitle]!"
    lisa "谢谢。这对我来说就是一切。我爱你，[persistent.lisaplayerTitle]！"

# game/scripts/Characters/lisa.rpy:855
translate chinese_simp lisa_training_two_4dd1a3d2:

    # lisa "[persistent.lisaplayerTitle], guess what?"
    lisa "[persistent.lisaplayerTitle]，猜猜怎么着？"

# game/scripts/Characters/lisa.rpy:856
translate chinese_simp lisa_training_two_5db5ed78:

    # lisa "I've been feeling much stronger lately!"
    lisa "我最近感觉强多了！"

# game/scripts/Characters/lisa.rpy:857
translate chinese_simp lisa_training_two_bd3c303c:

    # player "That's great to hear! You'll be ready to retake the trial in no time!"
    player "太好了！你很快就能重新参加试炼了！"

# game/scripts/Characters/lisa.rpy:860
translate chinese_simp lisa_training_two_567975a8:

    # lisa "Thank you for all of this. I feel more and more connected to you every day..."
    lisa "谢谢你为我做的一切。我每天都觉得和你更亲近了……"

# game/scripts/Characters/lisa.rpy:861
translate chinese_simp lisa_training_two_e18f3209:

    # player "I feel the same, you've helped me get much stronger as well you know..."
    player "我也是，你也帮我变强了不少，你知道吗……"

# game/scripts/Characters/lisa.rpy:862
translate chinese_simp lisa_training_two_acb440e4:

    # lisa "I couldn't be happier to have found such a strong Tamer~!"
    lisa "能遇到你这么强大的驯兽师，我太开心了~！"

# game/scripts/Characters/lisa.rpy:865
translate chinese_simp lisa_training_two_ce01c153:

    # lisa "I was thinking..."
    lisa "我在想……"

# game/scripts/Characters/lisa.rpy:866
translate chinese_simp lisa_training_two_5676e6dc:

    # lisa "I love the ways you've been helping me grow stronger."
    lisa "我很喜欢你帮我变强的方式。"

# game/scripts/Characters/lisa.rpy:869
translate chinese_simp lisa_training_two_d13392e7:

    # lisa "But there's a different, more effective way, to receive your strength..."
    lisa "但还有一种不同的、更有效的方式来获得你的力量……"

# game/scripts/Characters/lisa.rpy:870
translate chinese_simp lisa_training_two_d7330fd0:

    # player "Are you sure?"
    player "你确定？"

# game/scripts/Characters/lisa.rpy:873
translate chinese_simp lisa_training_two_d4338c38:

    # lisa "Yes!"
    lisa "确定！"

# game/scripts/Characters/lisa.rpy:874
translate chinese_simp lisa_training_two_abba2aa7:

    # lisa "I've been thinking about it, and this would be the perfect thing to give you..."
    lisa "我想了很久，这会是给你的完美礼物……"

# game/scripts/Characters/lisa.rpy:875
translate chinese_simp lisa_training_two_5cd6335d:

    # lisa "To make you feel really really good."
    lisa "让你感到非常非常舒服。"

# game/scripts/Characters/lisa.rpy:878
translate chinese_simp lisa_training_two_8f7ce8e9:

    # lisa "And I've seen the way you've been looking at me lately..."
    lisa "而且我看得出来你最近看我的眼神……"

# game/scripts/Characters/lisa.rpy:879
translate chinese_simp lisa_training_two_a01bef35:

    # player "Can't deny that..."
    player "我无法否认……"

# game/scripts/Characters/lisa.rpy:894
translate chinese_simp lisa_clan_one_4dd1a3d2:

    # lisa "[persistent.lisaplayerTitle], guess what?"
    lisa "[persistent.lisaplayerTitle]，猜猜怎么着？"

# game/scripts/Characters/lisa.rpy:895
translate chinese_simp lisa_clan_one_e5a014f4:

    # lisa "I think I'm ready. I'm stronger than I've ever been."
    lisa "我觉得我准备好了。我从未如此强大过。"

# game/scripts/Characters/lisa.rpy:898
translate chinese_simp lisa_clan_one_a979961f:

    # player "We can keep training more if you think it's needed."
    player "如果你觉得有必要，我们可以继续训练。"

# game/scripts/Characters/lisa.rpy:900
translate chinese_simp lisa_clan_one_a2a6d795:

    # lisa "Oh, I'm going to need to be trained a lot more in the future~"
    lisa "噢，我以后还需要更多的“训练”呢~"

# game/scripts/Characters/lisa.rpy:903
translate chinese_simp lisa_clan_one_e78e154c:

    # lisa "I hope this doesn't mean we'll stop our special training..!"
    lisa "希望这不是我们“特殊训练”的终点……！"

# game/scripts/Characters/lisa.rpy:906
translate chinese_simp lisa_clan_one_1975290e:

    # lisa "But I genuinely feel I've become strong enough to redo the trial."
    lisa "但我真心觉得我已经够强了，可以重试试炼。"

# game/scripts/Characters/lisa.rpy:907
translate chinese_simp lisa_clan_one_141350ef:

    # player "That's great to hear! How long do you think the trip might take?"
    player "太好了！你觉得这趟行程要多久？"

# game/scripts/Characters/lisa.rpy:908
translate chinese_simp lisa_clan_one_e80b1e69:

    # lisa "Hard to say... The village is pretty deep into the forest... Around two days I think..."
    lisa "不好说……村子在森林深处……我想大概要两天……"

# game/scripts/Characters/lisa.rpy:909
translate chinese_simp lisa_clan_one_1181d941:

    # player "Okay, that's good to know. I'll get my affairs in order as soon as I can."
    player "好，我知道了。我会尽快安排好这边的事。"

# game/scripts/Characters/lisa.rpy:910
translate chinese_simp lisa_clan_one_8655d92e:

    # lisa "Perfect, I'll be waiting for you at the entrance to the forest."
    lisa "太好了，我在森林入口等你。"

# game/scripts/Characters/lisa.rpy:925
translate chinese_simp lisa_clan_two_6051e1b3:

    # lisa "Ah, there you are!"
    lisa "啊，你来了！"

# game/scripts/Characters/lisa.rpy:928
translate chinese_simp lisa_clan_two_35fa285c:

    # player "Are you ready?"
    player "准备好了吗？"

# game/scripts/Characters/lisa.rpy:932
translate chinese_simp lisa_clan_two_38e41947:

    # lisa "As ready as I'll ever be."
    lisa "前所未有的准备好了。"

# game/scripts/Characters/lisa.rpy:933
translate chinese_simp lisa_clan_two_f7f6b12e:

    # player "Don't worry, you've come a long way."
    player "别担心，你进步很大了。"

# game/scripts/Characters/lisa.rpy:937
translate chinese_simp lisa_clan_two_21be0c8e:

    # lisa "Thanks to you~"
    lisa "多亏了你~"

# game/scripts/Characters/lisa.rpy:938
translate chinese_simp lisa_clan_two_53a350d9:

    # player "How long will it take us to reach the village?"
    player "到村子要多久？"

# game/scripts/Characters/lisa.rpy:939
translate chinese_simp lisa_clan_two_76a754da:

    # lisa "Just a few hours' walk."
    lisa "步行几个小时就到了。"

# game/scripts/Characters/lisa.rpy:940
translate chinese_simp lisa_clan_two_245a411d:

    # player "Alright, let's go."
    player "行，出发吧。"

# game/scripts/Characters/lisa.rpy:943
translate chinese_simp lisa_clan_two_66b4e174:

    # narrator "You make your way through the dense forest, the path stretching on seemingly without end."
    narrator "你穿行在茂密的森林中，小路似乎没有尽头。"

# game/scripts/Characters/lisa.rpy:944
translate chinese_simp lisa_clan_two_a2f6ef4a:

    # narrator "Luckily it's mostly a straight path, so you're confident you can remember it."
    narrator "幸运的是，路基本都是直的，所以你相信自己能记住。"

# game/scripts/Characters/lisa.rpy:948
translate chinese_simp lisa_clan_two_432198e8:

    # player "Woah, what's this place?"
    player "哇，这是什么地方？"

# game/scripts/Characters/lisa.rpy:949
translate chinese_simp lisa_clan_two_aa45526f:

    # lisa "No idea what it was, but it looks like some kind of run-down spring."
    lisa "不知道以前是干什么的，看起来像是个破败的泉眼。"

# game/scripts/Characters/lisa.rpy:950
translate chinese_simp lisa_clan_two_ca1ccd37:

    # player "Wanna take a break? It looks really relaxing..."
    player "想休息一下吗？看起来挺舒服的……"

# game/scripts/Characters/lisa.rpy:951
translate chinese_simp lisa_clan_two_26781981:

    # lisa "I do."
    lisa "好呀。"

# game/scripts/Characters/lisa.rpy:955
translate chinese_simp lisa_clan_two_2d550e9e:

    # think "Of course she's interested in fish..."
    think "她果然对鱼感兴趣……"

# game/scripts/Characters/lisa.rpy:956
translate chinese_simp lisa_clan_two_a1a77576:

    # player "If you catch it are you going to eat it?"
    player "你抓到它要吃掉吗？"

# game/scripts/Characters/lisa.rpy:960
translate chinese_simp lisa_clan_two_a9463744:

    # lisa "Hmm? no, I mean yes, but I'm not going to catch it."
    lisa "嗯？不，我是说会吃，但我不会去抓。"

# game/scripts/Characters/lisa.rpy:961
translate chinese_simp lisa_clan_two_b07bc9b5:

    # lisa "It would involve me getting wet, and these are the only pair of clothes I brought with me..."
    lisa "抓它会弄湿我，而我带的衣服就这一身……"

# game/scripts/Characters/lisa.rpy:962
translate chinese_simp lisa_clan_two_2309345b:

    # think "Makes sense."
    think "有道理。"

# game/scripts/Characters/lisa.rpy:966
translate chinese_simp lisa_clan_two_72b01a33:

    # player "You ready to leave? I think we rested for long enough."
    player "准备走了吗？我们休息得够久了。"

# game/scripts/Characters/lisa.rpy:967
translate chinese_simp lisa_clan_two_9a476611:

    # think "Well, I did, she's been following fish around for the whole time..."
    think "嗯，我说的是我，她倒是一直跟着鱼跑来跑去……"

# game/scripts/Characters/lisa.rpy:968
translate chinese_simp lisa_clan_two_f6039b9c:

    # lisa "Yes! I'm on my way, just need to dry my feet first~"
    lisa "好！我来了，先擦干脚~"

# game/scripts/Characters/lisa.rpy:974
translate chinese_simp lisa_clan_two_9f8944c2:

    # narrator "You walk for a few more hours until you reach the outskirts of the village."
    narrator "又走了几个小时，你们来到了村子的外围。"

# game/scripts/Characters/lisa.rpy:980
translate chinese_simp lisa_clan_two_08066898:

    # lisa "The village is just up ahead."
    lisa "村子就在前面了。"

# game/scripts/Characters/lisa.rpy:981
translate chinese_simp lisa_clan_two_d93c94be:

    # lisa "Since it's nighttime, we should camp up here until morning!"
    lisa "天黑了，我们就在这儿扎营，等到早上吧！"

# game/scripts/Characters/lisa.rpy:985
translate chinese_simp lisa_clan_two_08d699de:

    # lisa "Most villagers would be asleep by now, anyway."
    lisa "反正大多数村民现在都睡了。"

# game/scripts/Characters/lisa.rpy:986
translate chinese_simp lisa_clan_two_54996c58:

    # player "Is it safe here?"
    player "这儿安全吗？"

# game/scripts/Characters/lisa.rpy:990
translate chinese_simp lisa_clan_two_5fc1d621:

    # lisa "Normally no, but there aren't many predators this close to the village."
    lisa "一般来说不安全，但离村子这么近，没什么猛兽。"

# game/scripts/Characters/lisa.rpy:991
translate chinese_simp lisa_clan_two_99ceee50:

    # lisa "Plus, I feel safe knowing you could handle any danger that comes our way."
    lisa "而且，有你在，什么危险你都能应付，我放心。"

# game/scripts/Characters/lisa.rpy:992
translate chinese_simp lisa_clan_two_30a877d1:

    # player "Alright, let's set it up here."
    player "好，就在这儿扎营吧。"

# game/scripts/Characters/lisa.rpy:997
translate chinese_simp lisa_clan_two_f549e364:

    # lisa "Thank you for coming with me [persistent.lisaplayerTitle]..."
    lisa "谢谢你陪我一起来，[persistent.lisaplayerTitle]……"

# game/scripts/Characters/lisa.rpy:998
translate chinese_simp lisa_clan_two_805e851c:

    # player "Of course, I wanna be there for you."
    player "应该的，我想陪着你。"

# game/scripts/Characters/lisa.rpy:1001
translate chinese_simp lisa_clan_two_493dd90f:

    # lisa "Hey... Wanna have a bit more fun before we fall asleep?"
    lisa "嘿……睡前想不想再“开心”一下？"

# game/scripts/Characters/lisa.rpy:1004
translate chinese_simp lisa_clan_two_e8a02a67:

    # lisa "Couldn't wait until morning either, hmm?"
    lisa "你也等不到早上了，嗯？"

# game/scripts/Characters/lisa.rpy:1011
translate chinese_simp lisa_clan_two_50cbb89a:

    # player "Hey [lisa]..."
    player "嘿，[lisa]……"

# game/scripts/Characters/lisa.rpy:1012
translate chinese_simp lisa_clan_two_40eb2037:

    # lisa "Hmmm..?"
    lisa "嗯？"

# game/scripts/Characters/lisa.rpy:1013
translate chinese_simp lisa_clan_two_d595d3b8:

    # player "It's morning, we should get up..."
    player "天亮了，我们该起来了……"

# game/scripts/Characters/lisa.rpy:1014
translate chinese_simp lisa_clan_two_3884f77a:

    # lisa "Oh... Right..."
    lisa "哦……对……"

# game/scripts/Characters/lisa.rpy:1015
translate chinese_simp lisa_clan_two_01b91c43:

    # lisa "I wish we could stay like this a bit longer..."
    lisa "真希望能再这样待一会儿……"

# game/scripts/Characters/lisa.rpy:1016
translate chinese_simp lisa_clan_two_49c5933d:

    # player "Me too, but you have a trial you have to be ready for."
    player "我也是，但你还有试炼要准备。"

# game/scripts/Characters/lisa.rpy:1020
translate chinese_simp lisa_clan_two_fb6d8bfd:

    # player "Sorry [lisa], I'm too tired after a whole day of walking..."
    player "抱歉，[lisa]，走了一天我太累了……"

# game/scripts/Characters/lisa.rpy:1023
translate chinese_simp lisa_clan_two_3948bb10:

    # lisa "I understand."
    lisa "我明白。"

# game/scripts/Characters/lisa.rpy:1028
translate chinese_simp lisa_clan_two_50cbb89a_1:

    # player "Hey [lisa]..."
    player "嘿，[lisa]……"

# game/scripts/Characters/lisa.rpy:1029
translate chinese_simp lisa_clan_two_40eb2037_1:

    # lisa "Hmmm..?"
    lisa "嗯？"

# game/scripts/Characters/lisa.rpy:1030
translate chinese_simp lisa_clan_two_d595d3b8_1:

    # player "It's morning, we should get up..."
    player "天亮了，我们该起来了……"

# game/scripts/Characters/lisa.rpy:1031
translate chinese_simp lisa_clan_two_3884f77a_1:

    # lisa "Oh... Right..."
    lisa "哦……对……"

# game/scripts/Characters/lisa.rpy:1032
translate chinese_simp lisa_clan_two_01b91c43_1:

    # lisa "I wish we could stay like this a bit longer..."
    lisa "真希望能再这样待一会儿……"

# game/scripts/Characters/lisa.rpy:1033
translate chinese_simp lisa_clan_two_49c5933d_1:

    # player "Me too, but you have a trial you have to be ready for."
    player "我也是，但你还有试炼要准备。"

# game/scripts/Characters/lisa.rpy:1036
translate chinese_simp lisa_clan_two_d8efe5ab:

    # lisa "You're right, I need to be at 100 percent for it."
    lisa "你说得对，我得拿出百分百的状态来。"

# game/scripts/Characters/lisa.rpy:1037
translate chinese_simp lisa_clan_two_5db35f35:

    # player "Let's go."
    player "走吧。"

# game/scripts/Characters/lisa.rpy:1042
translate chinese_simp lisa_clan_two_113efa42:

    # lisa "Here we are."
    lisa "我们到了。"

# game/scripts/Characters/lisa.rpy:1043
translate chinese_simp lisa_clan_two_5373fd01:

    # player "Woah, a whole village in the middle of the forest?"
    player "哇，森林里居然有个村子？"

# game/scripts/Characters/lisa.rpy:1047
translate chinese_simp lisa_clan_two_75ded927:

    # lisa "Yeah, it's very hidden, no outsider knows about the actual location..."
    lisa "嗯，位置很隐蔽，没有外人知道具体在哪儿……"

# game/scripts/Characters/lisa.rpy:1048
translate chinese_simp lisa_clan_two_ba63f478:

    # player "In that case I hope it's not a big problem I'm here..."
    player "那我希望我的出现不会惹麻烦……"

# game/scripts/Characters/lisa.rpy:1049
translate chinese_simp lisa_clan_two_ce71f0b3:

    # lisa "You're fine, I trust you, and once I prove myself so will others."
    lisa "没事的，我相信你。等我证明了自己，大家也会相信你的。"

# game/scripts/Characters/lisa.rpy:1050
translate chinese_simp lisa_clan_two_22e40977:

    # lisa "The Elders' house is right up ahead."
    lisa "长老的房子就在前面。"

# game/scripts/Characters/lisa.rpy:1051
translate chinese_simp lisa_clan_two_e2cb8e6f:

    # player "How are there no guards stopping us?"
    player "怎么没有守卫拦我们？"

# game/scripts/Characters/lisa.rpy:1055
translate chinese_simp lisa_clan_two_dd65ebc5:

    # lisa "They still recognize me and know I have no ill intentions towards my old home..."
    lisa "他们还认得我，也知道我对故乡没有恶意……"

# game/scripts/Characters/lisa.rpy:1056
translate chinese_simp lisa_clan_two_7f7fc1ed:

    # lisa "They also know my mom lives here, so I wouldn't put her in danger..."
    lisa "他们也清楚我妈妈住在这里，我不会让她陷入危险……"

# game/scripts/Characters/lisa.rpy:1057
translate chinese_simp lisa_clan_two_b99e6d8a:

    # player "I see..."
    player "原来如此……"

# game/scripts/Characters/lisa.rpy:1060
translate chinese_simp lisa_clan_two_134fbbb5:

    # narrator "As you and [lisa] step into the room, the door slams shut and everything goes dark."
    narrator "当你和[lisa]走进房间时，门砰地一声关上了，四周一片漆黑。"

# game/scripts/Characters/lisa.rpy:1062
translate chinese_simp lisa_clan_two_eca55bca:

    # narrator "After your eyes adjust, you can see three shadowy figures sitting at a table in front of you."
    narrator "等眼睛适应后，你看到三个模糊的身影坐在前方的桌旁。"

# game/scripts/Characters/lisa.rpy:1063
translate chinese_simp lisa_clan_two_5e812105:

    # think "Woah, it's pitch black in here..."
    think "哇，这里面一片漆黑……"

# game/scripts/Characters/lisa.rpy:1067
translate chinese_simp lisa_clan_two_cd4ab566:

    # elder1 "Why have you returned?"
    elder1 "你为何回来？"

# game/scripts/Characters/lisa.rpy:1068
translate chinese_simp lisa_clan_two_8985e25d:

    # lisa "I wish to retake the trial. I am stronger now."
    lisa "我想重新接受试炼。我现在更强了。"

# game/scripts/Characters/lisa.rpy:1071
translate chinese_simp lisa_clan_two_31a2f0a7:

    # elder3 "Who is this human you bring with you?"
    elder3 "你带来的这个人类是谁？"

# game/scripts/Characters/lisa.rpy:1072
translate chinese_simp lisa_clan_two_727aeb10:

    # lisa "This is [player]... he's my-"
    lisa "他是[player]……他是我的——"

# game/scripts/Characters/lisa.rpy:1075
translate chinese_simp lisa_clan_two_5d78e61a:

    # elder2 "Strength must be proven, not stated."
    elder2 "实力要用行动证明，不是用嘴说。"

# game/scripts/Characters/lisa.rpy:1078
translate chinese_simp lisa_clan_two_5ee61e1f:

    # elder3 "Did you think taming one human in 2 years would make us think you're stronger?"
    elder3 "你觉得花两年时间驯服一个人类，就能证明你更强了吗？"

# game/scripts/Characters/lisa.rpy:1079
translate chinese_simp lisa_clan_two_aa078bf6:

    # lisa "No... he-"
    lisa "不……是他——"

# game/scripts/Characters/lisa.rpy:1082
translate chinese_simp lisa_clan_two_d2164187:

    # elder2 "Silence."
    elder2 "住口。"

# game/scripts/Characters/lisa.rpy:1083
translate chinese_simp lisa_clan_two_4e12632a:

    # think "They asked her a question..."
    think "他们明明问了问题……"

# game/scripts/Characters/lisa.rpy:1086
translate chinese_simp lisa_clan_two_73e58ba3:

    # elder1 "You bring shame by returning without permission."
    elder1 "你擅自归来，简直丢人现眼。"

# game/scripts/Characters/lisa.rpy:1087
translate chinese_simp lisa_clan_two_52e3e7c9:

    # lisa "I bring strength, and I wish for a chance to prove it."
    lisa "我带来了力量，只求一个证明的机会。"

# game/scripts/Characters/lisa.rpy:1090
translate chinese_simp lisa_clan_two_bdeb48a2:

    # elder3 "So be it."
    elder3 "那就如你所愿。"

# game/scripts/Characters/lisa.rpy:1093
translate chinese_simp lisa_clan_two_8bb6c2d3:

    # narrator "You hear the elders stand up and leave."
    narrator "你听到长老们起身离开了。"

# game/scripts/Characters/lisa.rpy:1094
translate chinese_simp lisa_clan_two_22281307:

    # narrator "After a few minutes, they return and sit back at the table."
    narrator "几分钟后，他们回来，重新在桌边坐下。"

# game/scripts/Characters/lisa.rpy:1097
translate chinese_simp lisa_clan_two_0b4846b4:

    # elder3 "Very well. The trial may be retaken, but the test will be different."
    elder3 "很好。你可以重试试炼，但内容会有所不同。"

# game/scripts/Characters/lisa.rpy:1100
translate chinese_simp lisa_clan_two_9c8bd655:

    # elder2 "You are much older now, besting a human should no longer pose a challenge."
    elder2 "你已年长不少，打败一个人类应该不成问题。"

# game/scripts/Characters/lisa.rpy:1103
translate chinese_simp lisa_clan_two_bd022bc7:

    # elder1 "Therefore the human you tamed will be fighting your generation's strongest warrior. [layla]."
    elder1 "因此，你驯服的这个人类，将与你同辈中最强的战士[layla]对战。"

# game/scripts/Characters/lisa.rpy:1106
translate chinese_simp lisa_clan_two_689b0f5b:

    # elder2 "If he wins, you may rejoin us."
    elder2 "若他获胜，你便可重返部族。"

# game/scripts/Characters/lisa.rpy:1109
translate chinese_simp lisa_clan_two_cf2bdeeb:

    # elder1 "If he loses, you will be banished forever and your human companion gets tamed by [layla]."
    elder1 "若他落败，你将永远被放逐，而你的人类同伴将归[layla]所有。"

# game/scripts/Characters/lisa.rpy:1112
translate chinese_simp lisa_clan_two_d4912a5e:

    # elder3 "Leave and return if you agree to the terms."
    elder3 "若同意条件，便出去考虑，想好了再进来。"

# game/scripts/Characters/lisa.rpy:1116
translate chinese_simp lisa_clan_two_78a08c39:

    # player "That was kinda funny."
    player "有点好笑。"

# game/scripts/Characters/lisa.rpy:1117
translate chinese_simp lisa_clan_two_0ba73c9e:

    # player "So they think you tamed me..."
    player "所以他们以为是你驯服了我……"

# game/scripts/Characters/lisa.rpy:1118
translate chinese_simp lisa_clan_two_2eecac46:

    # player "They can't comprehend a human being stronger..."
    player "他们无法想象人类能更强……"

# game/scripts/Characters/lisa.rpy:1119
translate chinese_simp lisa_clan_two_d4c206de:

    # lisa "I tried to tell them..."
    lisa "我试着告诉他们了……"

# game/scripts/Characters/lisa.rpy:1120
translate chinese_simp lisa_clan_two_f2220359:

    # player "It's okay, this might be better for us."
    player "没事，这样对我们可能更有利。"

# game/scripts/Characters/lisa.rpy:1121
