    # naomi "[persistent.naomiplayerTitle]..."
    naomi "[persistent.naomiplayerTitle]……"

# game/scripts/Characters/naomi.rpy:588
translate chinese_simp naomi_farm_work_four_4a891669:

    # player "I get it. You feel like you owe them for everything they've done..."
    player "我懂。你觉得欠她们太多……"

# game/scripts/Characters/naomi.rpy:589
translate chinese_simp naomi_farm_work_four_83f34a5c:

    # player "But there's gotta be a better way."
    player "但肯定有更好的办法。"

