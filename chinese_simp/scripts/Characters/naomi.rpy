    # sally "It's a bit complicated~"
    sally "有点复杂~"

# game/scripts/Characters/naomi.rpy:478
translate chinese_simp naomi_farm_work_three_c9514bcb:

    # sally "You know [naomi]'s story, right?"
    sally "你知道 [naomi] 的过去吧？"

# game/scripts/Characters/naomi.rpy:479
translate chinese_simp naomi_farm_work_three_cc60810c:

    # player "Yeah, I do."
    player "嗯，我知道。"

# game/scripts/Characters/naomi.rpy:482
translate chinese_simp naomi_farm_work_three_4c3fc3b8:

    # sally "Well, she's been overcompensatin' by throwin' herself into farm work."
    sally "她一直在用干农活来过度补偿自己。"

# game/scripts/Characters/naomi.rpy:483
translate chinese_simp naomi_farm_work_three_15ea4a14:

    # player "I noticed that the other day... She was eager to help more than an hour too early..."
    player "我前几天就注意到了……她提早一个多小时就想帮忙……"

# game/scripts/Characters/naomi.rpy:486
translate chinese_simp naomi_farm_work_three_ada7e706:

    # sally "Yeah, she does that every day. And that mornin' is exactly what I wanted to ask you about."
    sally "对，她每天都这样。那天早上我就是想问你这事。"

# game/scripts/Characters/naomi.rpy:489
translate chinese_simp naomi_farm_work_three_26618d86:

    # sally "What did you do to stop her from goin'?"
    sally "你是怎么让她不去的？"

# game/scripts/Characters/naomi.rpy:492
translate chinese_simp naomi_farm_work_three_772d6ce9:

    # sally "I've been tellin' her I don't need the help ever since you tamed her... but nothin' works. She insists on helpin' out."
    sally "从你驯服她开始，我就一直跟她说我不需要帮忙……但没用。她非要帮忙。"

# game/scripts/Characters/naomi.rpy:495
translate chinese_simp naomi_farm_work_three_e4453dfe:

    # sally "I wouldn't have a problem with it if it didn't go against everythin' we stand for."
    sally "如果不是违背我们的原则，我倒也不反对。"

# game/scripts/Characters/naomi.rpy:498
translate chinese_simp naomi_farm_work_three_5f5ec05f:

    # sally "Cow girls aren't supposed to be workin' the farm. They're supposed to be takin' it easy, gettin' spoiled, and produce healthy milk."
    sally "牛娘不该干农活。她们应该享福、被宠着、产出健康的奶。"

# game/scripts/Characters/naomi.rpy:501
translate chinese_simp naomi_farm_work_three_ffdf6d61:

    # sally "I don't want someone seein' her workin'... or worse, gettin' hurt."
    sally "我不想让别人看到她干活……更怕她受伤。"

# game/scripts/Characters/naomi.rpy:502
translate chinese_simp naomi_farm_work_three_3275e7de:

    # player "I didn't know it was that bad... I just asked her to stay and cuddle with me..."
    player "我不知道这么严重……我就只是让她留下陪我抱着……"

# game/scripts/Characters/naomi.rpy:505
translate chinese_simp naomi_farm_work_three_b964684c:

    # sally "That's it? I mean, it makes sense that she'd listen to you..."
    sally "就这样？嗯，她听你的话也正常……"

# game/scripts/Characters/naomi.rpy:508
translate chinese_simp naomi_farm_work_three_4ba5d4f7:

    # sally "If there's anythin' she'd rather do, it's probably spendin' time with her tamer."
    sally "如果有什么她更想做的事，那大概就是跟她的驯兽师待在一起。"

# game/scripts/Characters/naomi.rpy:511
translate chinese_simp naomi_farm_work_three_851ffb70:

    # sally "Can you talk to her? Ask her to stop?"
    sally "你能跟她谈谈吗？让她别干了？"

# game/scripts/Characters/naomi.rpy:512
translate chinese_simp naomi_farm_work_three_e6a61509:

    # player "Do you think that would convince her..?"
    player "你觉得那能说服她吗……？"

# game/scripts/Characters/naomi.rpy:515
translate chinese_simp naomi_farm_work_three_1d6e5fb0:

    # sally "Well... They're in the barn right now. Come back tonight and give it a try?"
    sally "嗯……她们现在在谷仓。你今晚过来试试？"

# game/scripts/Characters/naomi.rpy:516
translate chinese_simp naomi_farm_work_three_feca95b7:

    # player "Sure... I'll give it a shot. If that doesn't work I'll think of something else."
    player "好……我试试。不行的话再想别的办法。"

# game/scripts/Characters/naomi.rpy:519
translate chinese_simp naomi_farm_work_three_d68caa99:

    # sally "Good. I appreciate it."
    sally "好。谢谢。"

# game/scripts/Characters/naomi.rpy:528
translate chinese_simp naomi_farm_work_four_56cfb564:

    # think "I guess [sally] told her I'd be coming over tonight..."
    think "[sally] 应该告诉她我今晚会来吧……"

# game/scripts/Characters/naomi.rpy:531
translate chinese_simp naomi_farm_work_four_9bfd6d63:

    # think "Hope she didn't stay up for too long..."
    think "希望她没等太久……"

# game/scripts/Characters/naomi.rpy:532
