    # naomi "I told you... This is the only way..."
    naomi "我说了……只有这一个办法……"

# game/scripts/Characters/naomi.rpy:606
translate chinese_simp naomi_farm_work_four_555d72ec:

    # player "Give me a bit of time..."
    player "给我点时间……"

# game/scripts/Characters/naomi.rpy:609
translate chinese_simp naomi_farm_work_four_88480ad9:

    # naomi "How much..?"
    naomi "多久……？"

# game/scripts/Characters/naomi.rpy:610
translate chinese_simp naomi_farm_work_four_7f02baa3:

    # player "I don't know, enough for me to find something you can do instead."
    player "不知道，够我找到你能做的事就行。"

# game/scripts/Characters/naomi.rpy:611
translate chinese_simp naomi_farm_work_four_0678339a:

    # player "And in the meantime... Try sleeping in like today. Leave the farm work to [sally] and other workers..."
    player "这期间……你试着像今天这样睡懒觉。农活让 [sally] 她们去做……"

# game/scripts/Characters/naomi.rpy:614
translate chinese_simp naomi_farm_work_four_9181081f:

    # naomi "Fine..."
    naomi "好吧……"

# game/scripts/Characters/naomi.rpy:617
translate chinese_simp naomi_farm_work_four_ab04f8ac:

    # naomi "But don't take forever..."
    naomi "但别太久……"

# game/scripts/Characters/naomi.rpy:618
translate chinese_simp naomi_farm_work_four_dca95e0f:

    # player "I'll do my best~"
    player "我尽量~"

# game/scripts/Characters/naomi.rpy:621
translate chinese_simp naomi_farm_work_four_3052862d:

    # naomi "I really wish we had the time..."
    naomi "真希望我们有时间……"

# game/scripts/Characters/naomi.rpy:622
translate chinese_simp naomi_farm_work_four_6f425283:

    # player "Maybe the next time I visit... And hopefully with good news~"
    player "也许下次我再来的时候……希望能带来好消息~"

# game/scripts/Characters/naomi.rpy:627
translate chinese_simp naomi_farm_work_four_330af88d:

    # naomi "Mmmnnnn..."
    naomi "嗯嗯嗯……"

# game/scripts/Characters/naomi.rpy:630
translate chinese_simp naomi_farm_work_four_562227ea:

    # naomi "I'll be waiting~"
    naomi "我等着~"

# game/scripts/Characters/naomi.rpy:639
translate chinese_simp naomi_farm_work_five_e3cef633:

    # sally "How did it go..?"
    sally "谈得怎么样……？"

# game/scripts/Characters/naomi.rpy:640
translate chinese_simp naomi_farm_work_five_97b6195f:

    # player "Better than expected... I think..?"
    player "比预想的好……大概……？"

# game/scripts/Characters/naomi.rpy:643
translate chinese_simp naomi_farm_work_five_6b58abb5:

    # sally "Oh~?"
    sally "哦~？"

# game/scripts/Characters/naomi.rpy:644
translate chinese_simp naomi_farm_work_five_7cd78777:

    # player "She agreed to stop for now, but I kinda promised her I'd find another way for her to pay you back."
    player "她答应暂时不干了，不过我答应她要找别的办法回报你。"

# game/scripts/Characters/naomi.rpy:647
translate chinese_simp naomi_farm_work_five_d3f9940a:

    # sally "I already told her there's nothin' she could do around the farm..."
    sally "我已经跟她说过她在农场没有能做的事……"

# game/scripts/Characters/naomi.rpy:648
translate chinese_simp naomi_farm_work_five_cca7c661:

    # player "She said that, yes... But there's gotta be something..."
    player "她确实这么说了……但总该有点什么……"

# game/scripts/Characters/naomi.rpy:651
translate chinese_simp naomi_farm_work_five_10d5cd59:

    # sally "I really tried- I went through every single task, and there's nothin' that she could do."
    sally "我真的尽力了——我一项项都看过了，没有她能干的活。"

# game/scripts/Characters/naomi.rpy:652
translate chinese_simp naomi_farm_work_five_ee06ac3e:

    # sally "Everythin' is either dangerous, mentally stressful, or she just can't be seen doin' by an outsider."
    sally "要么危险，要么精神压力大，要么不能被人看到她做。"

# game/scripts/Characters/naomi.rpy:653
translate chinese_simp naomi_farm_work_five_b99e6d8a:

    # player "I see..."
    player "这样啊……"

# game/scripts/Characters/naomi.rpy:656
translate chinese_simp naomi_farm_work_five_ee5da9c6:

    # sally "There is somethin' we could do, but it's a bit..."
    sally "倒是有件事能做，不过有点……"

# game/scripts/Characters/naomi.rpy:659
translate chinese_simp naomi_farm_work_five_ec53c710:

    # sally "I don't know..."
    sally "说不上来……"

# game/scripts/Characters/naomi.rpy:660
translate chinese_simp naomi_farm_work_five_1cca4a96:

    # player "What were you thinking..?"
    player "你想到什么了……？"

# game/scripts/Characters/naomi.rpy:663
translate chinese_simp naomi_farm_work_five_0a8d5461:

    # sally "This would depend on how the girls accept her, but she could become sort of a leader- In name."
    sally "这要看其他姑娘们接不接受她，不过她可以当个名义上的领导。"

# game/scripts/Characters/naomi.rpy:666
translate chinese_simp naomi_farm_work_five_562aa736:

    # sally "It's not much in practice, but they would hopefully see her as someone they can talk to."
    sally "实际上没什么具体工作，但她们应该会把她当成可以倾诉的对象。"

# game/scripts/Characters/naomi.rpy:667
translate chinese_simp naomi_farm_work_five_1e0f4fb8:

    # player "Oh I see..."
    player "哦我明白了……"

# game/scripts/Characters/naomi.rpy:670
translate chinese_simp naomi_farm_work_five_568351bf:

    # sally "That role is currently mine, but it might be better if given to an actual cow girl."
    sally "这个角色目前是我的，但交给真正的牛娘可能更好。"

# game/scripts/Characters/naomi.rpy:673
