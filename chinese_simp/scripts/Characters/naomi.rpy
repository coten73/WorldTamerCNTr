    # think "No way I'm waking her up now..."
    think "我可不能现在叫醒她……"

# game/scripts/Characters/naomi.rpy:535
translate chinese_simp naomi_farm_work_four_466889e2:

    # think "I'll talk to her in the morning."
    think "明早再跟她说吧。"

# game/scripts/Characters/naomi.rpy:540
translate chinese_simp naomi_farm_work_four_38d3e8fd:

    # think "Okay..."
    think "好了……"

# game/scripts/Characters/naomi.rpy:541
translate chinese_simp naomi_farm_work_four_0b70733e:

    # think "She's definitely awake... But with the way she just woke me up, I can't tell if she's excited or pissed..."
    think "她肯定醒了……但她叫醒我的方式，分不清是兴奋还是生气……"

# game/scripts/Characters/naomi.rpy:544
translate chinese_simp naomi_farm_work_four_ecafa235:

    # think "Yeah... Pissed."
    think "嗯……是生气。"

# game/scripts/Characters/naomi.rpy:545
translate chinese_simp naomi_farm_work_four_2379cba4:

    # naomi "You finally woke up..."
    naomi "你终于醒了……"

# game/scripts/Characters/naomi.rpy:546
translate chinese_simp naomi_farm_work_four_3433a4ef:

    # player "Don't act like you didn't just wake me up~"
    player "别说得好像不是你先把我弄醒的一样~"

# game/scripts/Characters/naomi.rpy:547
translate chinese_simp naomi_farm_work_four_e6e8a12f:

    # player "May I ask why the angry face~?"
    player "能问问为什么臭着脸吗~？"

