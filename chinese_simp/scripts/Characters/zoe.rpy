    cynthia "当一个小偷的气味正好消失在你家后院外面时，你家就变得有趣了~"

# game/scripts/Characters/zoe.rpy:1186
translate chinese_simp zoe_backyard_search_81f9fe59:

    # player "You already said you couldn't smell her around here."
    player "你已经说过在这附近闻不到她了。"

# game/scripts/Characters/zoe.rpy:1189
