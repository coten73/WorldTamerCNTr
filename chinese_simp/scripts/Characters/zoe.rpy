    # zoe "Yeah. I found out not long after you dropped me off."
    zoe "知道。你送我回来后没多久我就知道了。"

# game/scripts/Characters/zoe.rpy:1041
translate chinese_simp zoe_checkin_deb49809:

    # player "What did you do to them?"
    player "你对他们做了什么？"

# game/scripts/Characters/zoe.rpy:1042
translate chinese_simp zoe_checkin_bd1af741:

    # player "I can't see them putting a bounty on a cop for no reason."
    player "他们总不会无缘无故悬赏一个警察吧。"

# game/scripts/Characters/zoe.rpy:1045
translate chinese_simp zoe_checkin_b18710c9:

    # zoe "I'll tell you, but it stays between us."
    zoe "我告诉你，但这只限于我们之间。"

# game/scripts/Characters/zoe.rpy:1046
translate chinese_simp zoe_checkin_8eb9fc93:

    # player "That's fine, I won't tell anyone."
    player "没问题，我不会告诉别人。"

# game/scripts/Characters/zoe.rpy:1049
translate chinese_simp zoe_checkin_2aae811d:

    # zoe "I stole something from them."
    zoe "我从他们那儿偷了东西。"

# game/scripts/Characters/zoe.rpy:1050
