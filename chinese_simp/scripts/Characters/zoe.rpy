    zoe "我心里事情太多，没法真正享受你……"

# game/scripts/Characters/zoe.rpy:837
translate chinese_simp zoe_hiding_fe7f9a05:

    # zoe "But it did help me forget about it, even if just for a bit~"
    zoe "但这确实让我暂时忘了那些事，哪怕只有一小会儿~"

# game/scripts/Characters/zoe.rpy:838
translate chinese_simp zoe_hiding_4231f11e:

    # player "You should sleep."
    player "你该睡了。"

# game/scripts/Characters/zoe.rpy:839
