    # player "You can do your thinking and planning in the morning."
    player "明天早上再想和计划吧。"

# game/scripts/Characters/zoe.rpy:842
translate chinese_simp zoe_hiding_92467da6:

    # zoe "Maybe you're right..."
    zoe "也许你说得对……"

# game/scripts/Characters/zoe.rpy:843
translate chinese_simp zoe_hiding_15699098:

    # zoe "That means waking up together, though."
    zoe "不过那就意味着要一起醒来了。"

# game/scripts/Characters/zoe.rpy:844
translate chinese_simp zoe_hiding_e5c3382a:

    # player "I'm aware."
    player "我知道。"

# game/scripts/Characters/zoe.rpy:847
translate chinese_simp zoe_hiding_c9030914:

    # zoe "Fine then. I'll worry about it in the morning."
    zoe "那好吧。我明天再操心。"

# game/scripts/Characters/zoe.rpy:855
translate chinese_simp zoe_hiding_b240ce5c:

    # zoe "Morning..."
    zoe "早……"

# game/scripts/Characters/zoe.rpy:856
translate chinese_simp zoe_hiding_a39117ee:

    # player "Hey... Glad you're still here."
    player "嘿……很高兴你还在这儿。"

# game/scripts/Characters/zoe.rpy:859
translate chinese_simp zoe_hiding_d2660d0f:

    # zoe "Don't have much of a choice."
    zoe "也没什么选择。"

# game/scripts/Characters/zoe.rpy:862
translate chinese_simp zoe_hiding_e9b5199b:

    # zoe "Seems they're still patrolling the area. If I leave now, they'll see me."
    zoe "看来他们还在附近巡逻。我现在出去会被看见的。"

# game/scripts/Characters/zoe.rpy:863
translate chinese_simp zoe_hiding_65baa61d:

    # player "Can't the police come get you?"
    player "不能让警察来接你吗？"

# game/scripts/Characters/zoe.rpy:866
translate chinese_simp zoe_hiding_536f1d6e:

    # zoe "Would be too obvious. They'd find out where I was."
    zoe "太明显了。他们会发现我在哪。"

# game/scripts/Characters/zoe.rpy:867
translate chinese_simp zoe_hiding_39be44f6:

    # zoe "I'll wait a few more hours, and see from there."
    zoe "我再等几个小时，到时候再看看情况。"

# game/scripts/Characters/zoe.rpy:868
translate chinese_simp zoe_hiding_eaca425e:

    # player "They've been doing it the whole night... I'm not sure that'll do anything..."
    player "他们整晚都在巡逻……我不确定等下去会有用……"

# game/scripts/Characters/zoe.rpy:872
translate chinese_simp zoe_hiding_14b870da:

    # zoe "What other choice do I have?"
    zoe "我还有什么别的选择？"

# game/scripts/Characters/zoe.rpy:873
translate chinese_simp zoe_hiding_6cbe4b70:

    # zoe "I leave, they catch me."
    zoe "我出去，他们抓到我。"

# game/scripts/Characters/zoe.rpy:874
translate chinese_simp zoe_hiding_eb29b9dd:

    # zoe "If I get outside help, they'll know where I was."
    zoe "如果我找外面的人帮忙，他们就知道我在哪。"

# game/scripts/Characters/zoe.rpy:877
translate chinese_simp zoe_hiding_8659e0b6:

    # zoe "Only thing I can do is wait a few hours for an officer to pick me up in a civilian car."
    zoe "我只能等几个小时，让一个警察开民用车来接我。"

# game/scripts/Characters/zoe.rpy:878
translate chinese_simp zoe_hiding_64e8fbba:

    # zoe "But even that's risky if we're not careful."
    zoe "但就算那样，不小心的话也有风险。"

# game/scripts/Characters/zoe.rpy:879
translate chinese_simp zoe_hiding_7a859a8d:

    # player "What if I drive you?"
    player "我开车送你怎么样？"

# game/scripts/Characters/zoe.rpy:880
translate chinese_simp zoe_hiding_fbc638c7:

    # player "Hide you in the trunk if needed."
    player "需要的话你可以躲后备箱。"

# game/scripts/Characters/zoe.rpy:881
translate chinese_simp zoe_hiding_02431c73:

    # player "They shouldn't see me driving as suspicious."
    player "他们应该不会觉得我开车可疑。"

# game/scripts/Characters/zoe.rpy:884
translate chinese_simp zoe_hiding_c155736d:

    # zoe "That could work."
    zoe "这或许可行。"

# game/scripts/Characters/zoe.rpy:885
translate chinese_simp zoe_hiding_975e1949:

    # zoe "But you can't drive me to the station."
    zoe "但你不能直接开到警局。"

# game/scripts/Characters/zoe.rpy:886
translate chinese_simp zoe_hiding_a25287b4:

    # zoe "We'll stop two blocks north, and walk from there."
    zoe "我们在往北两条街的地方停，然后走过去。"

# game/scripts/Characters/zoe.rpy:887
translate chinese_simp zoe_hiding_10cdc0da:

    # player "Will you be safe to walk outside?"
    player "你走出去安全吗？"

# game/scripts/Characters/zoe.rpy:890
translate chinese_simp zoe_hiding_064896f4:

    # zoe "Yeah, they're not looking for me that far north."
    zoe "嗯，他们不会往北那么远找我。"

# game/scripts/Characters/zoe.rpy:891
translate chinese_simp zoe_hiding_fef5a150:

    # player "Alright then."
    player "那行。"

# game/scripts/Characters/zoe.rpy:892
translate chinese_simp zoe_hiding_406a0409:

    # player "I'll go get your clothes from the bathroom, since you're still naked."
    player "我去浴室给你拿衣服，反正你还光着。"

# game/scripts/Characters/zoe.rpy:895
translate chinese_simp zoe_hiding_62f087bf:

    # zoe "Thank you..."
    zoe "谢谢……"

# game/scripts/Characters/zoe.rpy:899
translate chinese_simp zoe_hiding_2df12ed7:

    # narrator "You drive with [zoe] hidden, then walk the rest of the way to the station."
    narrator "你开着车，[zoe] 藏起来，然后你们走完剩下的路到警局。"

# game/scripts/Characters/zoe.rpy:904
translate chinese_simp zoe_hiding_b01b00b9:

    # player "What's the plan now?"
    player "现在打算怎么办？"

# game/scripts/Characters/zoe.rpy:905
translate chinese_simp zoe_hiding_c06faf99:

    # zoe "I lay low, probably going to stay here for a few days."
    zoe "我低调行事，可能要在警局待几天。"

# game/scripts/Characters/zoe.rpy:906
translate chinese_simp zoe_hiding_333da94d:

    # player "Gotcha. Let me know if you need anything."
    player "明白了。需要什么就跟我说。"

# game/scripts/Characters/zoe.rpy:909
translate chinese_simp zoe_hiding_50f21ff8:

    # zoe "I appreciate it, but you've done more than enough at this point."
    zoe "谢谢你，但你已经做得够多了。"

# game/scripts/Characters/zoe.rpy:911
translate chinese_simp zoe_hiding_acbd0fa0:

    # player "Glad you think so."
    player "很高兴你这么认为。"

# game/scripts/Characters/zoe.rpy:916
translate chinese_simp zoe_hiding_3d8e4fb8:

    # zoe "Mmm~"
    zoe "嗯~"

# game/scripts/Characters/zoe.rpy:919
translate chinese_simp zoe_hiding_64381a72:

    # zoe "Stay safe, okay~?"
    zoe "注意安全，好吗~？"

# game/scripts/Characters/zoe.rpy:920
translate chinese_simp zoe_hiding_ed30e89a:

    # player "You too..."
    player "你也是……"

# game/scripts/Characters/zoe.rpy:930
translate chinese_simp zoe_consequences_0dfe689b:

    # think "Who could that be?"
    think "会是谁呢？"

# game/scripts/Characters/zoe.rpy:935
translate chinese_simp zoe_consequences_13cf8f58:

    # cynthiaTitle "...You."
    cynthiaTitle "……是你。"

# game/scripts/Characters/zoe.rpy:936
translate chinese_simp zoe_consequences_a5e586d3:

    # player "Do we... know each other?"
    player "我们……认识？"

# game/scripts/Characters/zoe.rpy:939
translate chinese_simp zoe_consequences_22b897bc:

    # cynthiaTitle "You were at that bar."
    cynthiaTitle "你在那家酒吧里。"

# game/scripts/Characters/zoe.rpy:940
translate chinese_simp zoe_consequences_86fc0e0a:

    # cynthiaTitle "And somehow you keep showing up around messes."
    cynthiaTitle "而且你总是出现在各种麻烦事附近。"

# game/scripts/Characters/zoe.rpy:941
translate chinese_simp zoe_consequences_6af2bd73:

    # player "I was there, yeah."
    player "我当时是在那儿。"

# game/scripts/Characters/zoe.rpy:942
translate chinese_simp zoe_consequences_15b4f70c:

    # player "But I honestly don't know what you're talking about this time."
    player "但这次我真的不知道你在说什么。"

# game/scripts/Characters/zoe.rpy:943
translate chinese_simp zoe_consequences_bed3aae1:

    # player "And I definitely don't know who you are."
    player "而且我完全不知道你是谁。"

# game/scripts/Characters/zoe.rpy:946
translate chinese_simp zoe_consequences_8fa2bf8f:

    # cynthia "I'm [cynthia]."
    cynthia "我是 [cynthia]。"

# game/scripts/Characters/zoe.rpy:947
