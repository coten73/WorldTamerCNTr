    # cynthia "I smell a few different races around here."
    cynthia "我在这儿闻到了几种不同种族的气味。"

# game/scripts/Characters/zoe.rpy:963
translate chinese_simp zoe_consequences_6c9c8934:

    # player "...Mhm."
    player "……嗯。"

# game/scripts/Characters/zoe.rpy:964
translate chinese_simp zoe_consequences_0d262142:

    # player "Then I'm guessing you can also smell I'm not hiding the blonde you're looking for."
    player "那我猜你也能闻出来我没藏你要找的那个金发女郎。"

# game/scripts/Characters/zoe.rpy:967
