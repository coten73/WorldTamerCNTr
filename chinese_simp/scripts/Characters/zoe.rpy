    player "就一直待在警局里？"

# game/scripts/Characters/zoe.rpy:1096
translate chinese_simp zoe_checkin_3f55dd6d:

    # zoe "That's the safest way. I don't know how many people know about my bounty."
    zoe "这是最安全的办法。我不知道有多少人知道我的悬赏。"

# game/scripts/Characters/zoe.rpy:1097
