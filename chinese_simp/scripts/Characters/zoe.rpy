    # player "One of the people looking for you showed up at my house."
    player "有个在找你的人出现在我家。"

# game/scripts/Characters/zoe.rpy:1009
translate chinese_simp zoe_checkin_6e729dea:

    # zoe "What? What happened?"
    zoe "什么？发生什么事了？"

# game/scripts/Characters/zoe.rpy:1010
translate chinese_simp zoe_checkin_fde958c9:

    # player "She knocked on my door asking about someone matching your description."
    player "她敲我门，问有没有见过符合你特征的人。"

# game/scripts/Characters/zoe.rpy:1013
translate chinese_simp zoe_checkin_372dec4c:

    # zoe "What did you say?"
    zoe "你怎么说的？"

# game/scripts/Characters/zoe.rpy:1014
translate chinese_simp zoe_checkin_a385a5bd:

    # player "I told her I don't know you."
    player "我说我不认识你。"

# game/scripts/Characters/zoe.rpy:1015
translate chinese_simp zoe_checkin_121451cb:

    # player "And that even if I did, I wouldn't help her."
    player "而且就算认识，我也不会帮她。"

# game/scripts/Characters/zoe.rpy:1018
translate chinese_simp zoe_checkin_d02de447:

    # zoe "How'd she take that?"
    zoe "她什么反应？"

# game/scripts/Characters/zoe.rpy:1019
translate chinese_simp zoe_checkin_1c117a81:

    # player "She wasn't able to smell you, so she gave up pretty quick."
    player "她没闻到你，所以很快就放弃了。"

# game/scripts/Characters/zoe.rpy:1022
translate chinese_simp zoe_checkin_89576077:

    # zoe "Yeah... I came through your back window, and left after a good shower."
    zoe "嗯……我从你后窗进来的，好好洗了个澡才走。"

# game/scripts/Characters/zoe.rpy:1025
translate chinese_simp zoe_checkin_9c9de394:

    # zoe "Your house might be clear now."
    zoe "你家现在应该安全了。"

# game/scripts/Characters/zoe.rpy:1026
translate chinese_simp zoe_checkin_307a6f5f:

    # player "I don't know about that..."
    player "我不太确定……"

# game/scripts/Characters/zoe.rpy:1027
translate chinese_simp zoe_checkin_12a6c44f:

    # player "I've had a run-in with her before."
    player "我以前跟她打过照面。"

# game/scripts/Characters/zoe.rpy:1030
translate chinese_simp zoe_checkin_b581f284:

    # zoe "When?"
    zoe "什么时候？"

# game/scripts/Characters/zoe.rpy:1031
