    # player "Just how valuable was it?"
    player "有多值钱？"

# game/scripts/Characters/zoe.rpy:1053
translate chinese_simp zoe_checkin_8b0afc34:

    # zoe "Very. But is wasn't money."
    zoe "非常值钱。但不是钱。"

# game/scripts/Characters/zoe.rpy:1054
