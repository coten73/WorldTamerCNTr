    # player "A while ago, they wanted 'protection' money from the bar I work at."
    player "前阵子，他们想收我工作的酒吧的‘保护费’。"

# game/scripts/Characters/zoe.rpy:1032
translate chinese_simp zoe_checkin_c47d2d62:

    # player "We managed to stop it, but it seems like she remembered me."
    player "我们搞定了，但她好像还记得我。"

# game/scripts/Characters/zoe.rpy:1035
translate chinese_simp zoe_checkin_89929be5:

    # zoe "I hope they don't try anything at your home..."
    zoe "希望他们别在你家搞事……"

# game/scripts/Characters/zoe.rpy:1036
translate chinese_simp zoe_checkin_dc5ee6f1:

    # player "I'd be more worried about yourself."
    player "我更担心你。"

# game/scripts/Characters/zoe.rpy:1037
translate chinese_simp zoe_checkin_fdf28bb5:

    # player "Do you know they have a bounty on you?"
    player "你知道他们悬赏你吗？"

# game/scripts/Characters/zoe.rpy:1040
