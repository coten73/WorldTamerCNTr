    # player "Are you telling me you hid them at my house?"
    player "你是说你把它们藏我家了？"

# game/scripts/Characters/zoe.rpy:1241
translate chinese_simp zoe_item_plan_601e6d46:

    # zoe "I am."
    zoe "对。"

# game/scripts/Characters/zoe.rpy:1242
