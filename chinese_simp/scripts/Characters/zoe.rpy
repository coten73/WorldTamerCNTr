    # player "..."
    player "……"

# game/scripts/Characters/zoe.rpy:1250
translate chinese_simp zoe_item_plan_35024f11:

    # zoe "I'm really sorry, I thought it would be the safest to hide them in your backyard."
    zoe "真的很抱歉，我当时觉得藏在你后院里最安全。"

# game/scripts/Characters/zoe.rpy:1251
translate chinese_simp zoe_item_plan_8b3bd88b:

    # player "Safe for who?"
    player "对谁安全？"

# game/scripts/Characters/zoe.rpy:1252
