    # zoe "The second someone crosses onto your property, they move in, grab them, and it's over."
    zoe "一旦有人踏入你的地盘，他们就行动，抓住人，完事。"

# game/scripts/Characters/zoe.rpy:1272
translate chinese_simp zoe_item_plan_02843d1c:

    # player "And then what?"
    player "然后呢？"

# game/scripts/Characters/zoe.rpy:1273
translate chinese_simp zoe_item_plan_664ea81a:

    # player "They figure out I worked with the police and start targeting me too..?"
    player "他们发现我跟警察合作了，然后也开始对付我……？"

# game/scripts/Characters/zoe.rpy:1276
translate chinese_simp zoe_item_plan_9946f87f:

    # zoe "We'll keep someone on standby after the operation."
    zoe "行动之后我们会派人待命保护。"

# game/scripts/Characters/zoe.rpy:1277
translate chinese_simp zoe_item_plan_3bc78f4b:

    # zoe "And you won't look suspicious."
    zoe "而且你不会显得可疑。"

# game/scripts/Characters/zoe.rpy:1278
translate chinese_simp zoe_item_plan_633433d4:

    # zoe "A gang member broke into your backyard. Any normal person would call the police after that."
    zoe "是帮派成员闯进了你的后院。正常人之后都会报警。"

# game/scripts/Characters/zoe.rpy:1279
translate chinese_simp zoe_item_plan_7490288e:

    # zoe "I also won't be anywhere near your house, so there won't be anything tying me to it directly."
    zoe "我也不会出现在你家附近，所以不会有任何直接指向我的线索。"

# game/scripts/Characters/zoe.rpy:1280
translate chinese_simp zoe_item_plan_14c81394:

    # player "I get the idea..."
    player "我明白你的意思……"

# game/scripts/Characters/zoe.rpy:1283
translate chinese_simp zoe_item_plan_6ba1ec74:

    # zoe "That's why [ivy] handles the pickup separately."
    zoe "所以 [ivy] 会单独处理取文件的事。"

# game/scripts/Characters/zoe.rpy:1284
translate chinese_simp zoe_item_plan_0145919a:

    # zoe "She comes by, you hand over the documents at the door, and from there we do the rest."
    zoe "她过来，你在门口把文件交给她，剩下的事我们来处理。"

# game/scripts/Characters/zoe.rpy:1285
translate chinese_simp zoe_item_plan_067e2019:

    # player "If it's done separately, then why can't I bring them there?"
    player "既然是分开处理，那我为什么不能直接送过去？"

# game/scripts/Characters/zoe.rpy:1286
translate chinese_simp zoe_item_plan_186baa17:

    # zoe "I have a hunch, and if I'm right, then this is the safest way to do it."
    zoe "我有种直觉，如果我没猜错，这是最安全的做法。"

# game/scripts/Characters/zoe.rpy:1287
translate chinese_simp zoe_item_plan_79fe5ad0:

    # player "Alright, I'll believe you."
    player "好吧，我相信你。"

# game/scripts/Characters/zoe.rpy:1290
translate chinese_simp zoe_item_plan_db0801be:

    # zoe "Hopefully once this is done, it gets the bounty off my head~"
    zoe "希望事情办完后，我头上的悬赏能取消~"

# game/scripts/Characters/zoe.rpy:1291
translate chinese_simp zoe_item_plan_a061616b:

    # player "Wouldn't they just be even more pissed?"
    player "他们不会更恼火吗？"

# game/scripts/Characters/zoe.rpy:1294
translate chinese_simp zoe_item_plan_a89abab1:

    # zoe "Not if they know the documents are in police hands for real."
    zoe "如果知道文件真的到了警方手里，就不会了。"

# game/scripts/Characters/zoe.rpy:1295
translate chinese_simp zoe_item_plan_0b582ba7:

    # zoe "At that point it's no longer about me personally."
    zoe "到那时候就不再是针对我个人了。"

# game/scripts/Characters/zoe.rpy:1296
translate chinese_simp zoe_item_plan_b7d16d45:

    # zoe "If the files are out of reach, there's no point going after just me."
    zoe "如果文件拿不回来了，光对付我一个人也没用。"

# game/scripts/Characters/zoe.rpy:1297
translate chinese_simp zoe_item_plan_300ec773:

    # player "Hope so..."
    player "希望如此……"

# game/scripts/Characters/zoe.rpy:1298
translate chinese_simp zoe_item_plan_074cce36:

    # player "You're still living in the office then?"
    player "那你还住在办公室里？"

# game/scripts/Characters/zoe.rpy:1301
translate chinese_simp zoe_item_plan_66734ae9:

    # zoe "Yeah. It's really boring, but at least I've been productive~"
    zoe "嗯。是很无聊，但至少我工作效率上来了~"

# game/scripts/Characters/zoe.rpy:1302
translate chinese_simp zoe_item_plan_ee6af8f4:

    # player "I can imagine~"
    player "可以想象~"

# game/scripts/Characters/zoe.rpy:1303
translate chinese_simp zoe_item_plan_c53bf5a8:

    # player "So when can you set everything up?"
    player "那你什么时候能安排好？"

# game/scripts/Characters/zoe.rpy:1306
translate chinese_simp zoe_item_plan_d2ea793d:

    # zoe "As soon as possible."
    zoe "尽快。"

# game/scripts/Characters/zoe.rpy:1307
translate chinese_simp zoe_item_plan_d5e0a0d6:

    # zoe "Call me at night when you're ready, and I'll give the order."
    zoe "你准备好了晚上给我电话，我就下令。"

# game/scripts/Characters/zoe.rpy:1308
translate chinese_simp zoe_item_plan_9a5cf871:

    # player "Alright."
    player "好。"

# game/scripts/Characters/zoe.rpy:1311
translate chinese_simp zoe_item_plan_f6f2d758:

    # zoe "And come back here after it's done, okay?"
    zoe "事情完了之后来我这里，好吗？"

# game/scripts/Characters/zoe.rpy:1312
translate chinese_simp zoe_item_plan_2920d744:

    # player "Why?"
    player "为什么？"

# game/scripts/Characters/zoe.rpy:1315
translate chinese_simp zoe_item_plan_6bab83b9:

    # zoe "I got a lot of making up to do."
    zoe "我有很多要补偿你的。"

# game/scripts/Characters/zoe.rpy:1316
translate chinese_simp zoe_item_plan_91afb6d1:

    # zoe "I dragged you into this, so I owe you."
    zoe "我把你卷进来了，所以欠你的。"

# game/scripts/Characters/zoe.rpy:1317
translate chinese_simp zoe_item_plan_21bb6018:

    # player "You got that right~"
    player "这倒是~"

# game/scripts/Characters/zoe.rpy:1330
translate chinese_simp zoe_item_retrieval_c18f783a:

    # zoe "Hey."
    zoe "嘿。"

# game/scripts/Characters/zoe.rpy:1331
translate chinese_simp zoe_item_retrieval_28598475:

    # player "Hi, are you able to do that thing we talked about tonight?"
    player "嗨，今晚你说的事能安排吗？"

# game/scripts/Characters/zoe.rpy:1332
translate chinese_simp zoe_item_retrieval_e6135820:

    # zoe "Yeah, absolutely."
    zoe "嗯，当然可以。"

# game/scripts/Characters/zoe.rpy:1333
translate chinese_simp zoe_item_retrieval_f567cbbc:

    # zoe "[ivy] will be there in a few minutes."
    zoe "[ivy] 几分钟后到。"

# game/scripts/Characters/zoe.rpy:1334
translate chinese_simp zoe_item_retrieval_126b449b:

    # zoe "Just give her the documents and let us handle the rest."
    zoe "把文件给她，剩下的我们来。"

# game/scripts/Characters/zoe.rpy:1335
translate chinese_simp zoe_item_retrieval_076d2ca9:

    # player "Alright, I'll go dig them up in the meantime."
    player "好，我这会儿去把它们挖出来。"

# game/scripts/Characters/zoe.rpy:1339
translate chinese_simp zoe_item_retrieval_8c83bd66:

    # think "I really hope nothing goes wrong..."
    think "真希望别出什么岔子……"

# game/scripts/Characters/zoe.rpy:1343
translate chinese_simp zoe_item_retrieval_ec94656b:

    # narrator "[ivy] shows up a few minutes later, and I hand over the documents."
    narrator "几分钟后 [ivy] 来了，我把文件交给她。"

# game/scripts/Characters/zoe.rpy:1344
translate chinese_simp zoe_item_retrieval_56d7564f:

    # narrator "After that you head to bed while it's still quiet outside."
    narrator "之后，趁外面还安静，你就去睡了。"

# game/scripts/Characters/zoe.rpy:1355
translate chinese_simp zoe_item_followup_1c2393be:

    # zoe "Hey. Sit down, please."
    zoe "嘿。请坐。"

# game/scripts/Characters/zoe.rpy:1356
translate chinese_simp zoe_item_followup_aa75ffb7:

    # player "Sure..."
    player "好……"

# game/scripts/Characters/zoe.rpy:1357
translate chinese_simp zoe_item_followup_6a9ce9e5:

    # player "Is something wrong?"
    player "出什么事了？"

# game/scripts/Characters/zoe.rpy:1358
translate chinese_simp zoe_item_followup_e825f555:

    # zoe "Yeah."
    zoe "嗯。"

# game/scripts/Characters/zoe.rpy:1361
translate chinese_simp zoe_item_followup_60a8466b:

    # zoe "Let's wait until [ivy] gets here."
    zoe "等 [ivy] 到了再说。"

# game/scripts/Characters/zoe.rpy:1362
translate chinese_simp zoe_item_followup_9398a7e0:

    # think "I hope I'm not in trouble..."
    think "希望不是我惹上麻烦……"

# game/scripts/Characters/zoe.rpy:1363
translate chinese_simp zoe_item_followup_93633c91:

    # think "Would probably be arrested already if that was the case."
    think "要是真有事，我大概已经被抓了。"

# game/scripts/Characters/zoe.rpy:1366
translate chinese_simp zoe_item_followup_d1a49e7b:

    # ivy "Hey."
    ivy "嘿。"

# game/scripts/Characters/zoe.rpy:1367
translate chinese_simp zoe_item_followup_3d08d858:

    # zoe "Lock the door, please."
    zoe "请锁门。"

# game/scripts/Characters/zoe.rpy:1370
translate chinese_simp zoe_item_followup_f9d6a8b5:

    # ivy "I'm guessing you found something big?"
    ivy "我猜你发现了重要的事？"

# game/scripts/Characters/zoe.rpy:1371
translate chinese_simp zoe_item_followup_e825f555_1:

    # zoe "Yeah."
    zoe "嗯。"

# game/scripts/Characters/zoe.rpy:1372
translate chinese_simp zoe_item_followup_90bdc516:

    # player "If that's the case, why am I here?"
    player "既然这样，我为什么在这儿？"

# game/scripts/Characters/zoe.rpy:1375
translate chinese_simp zoe_item_followup_6b22a196:

    # zoe "You're basically forced to work with us."
    zoe "你基本上是被迫跟我们合作了。"

# game/scripts/Characters/zoe.rpy:1378
translate chinese_simp zoe_item_followup_094d1ca2:

    # zoe "With the things I found..."
    zoe "根据我发现的线索……"

# game/scripts/Characters/zoe.rpy:1379
translate chinese_simp zoe_item_followup_439ce7bd:

    # zoe "From their point of view, you're already on our side."
    zoe "从他们的角度看，你已经是我们这边的人了。"

# game/scripts/Characters/zoe.rpy:1382
translate chinese_simp zoe_item_followup_7a52ebeb:

    # ivy "Why all the secrecy, [zoe]?"
    ivy "干嘛这么神秘，[zoe]？"

# game/scripts/Characters/zoe.rpy:1383
translate chinese_simp zoe_item_followup_f130989a:

    # zoe "Let me start from the beginning."
    zoe "让我从头说起。"

# game/scripts/Characters/zoe.rpy:1386
translate chinese_simp zoe_item_followup_0abf1af9:

    # zoe "I wanted to understand what made them so aggressive in getting the files back."
    zoe "我想搞清楚他们为什么那么拼了命想要拿回文件。"

# game/scripts/Characters/zoe.rpy:1387
translate chinese_simp zoe_item_followup_fc0c542e:

    # zoe "The more I read, the stranger it got."
    zoe "我读得越多，越觉得不对劲。"

# game/scripts/Characters/zoe.rpy:1388
translate chinese_simp zoe_item_followup_66f3fd38:

    # zoe "Turns out the gang's been around for quite a while."
    zoe "结果发现这个帮派已经存在很久了。"

# game/scripts/Characters/zoe.rpy:1389
translate chinese_simp zoe_item_followup_d141b505:

    # zoe "They stayed small, quiet, and patient while the bigger gangs were busy fighting each other."
    zoe "在大帮派忙着互相争斗的时候，他们一直保持小而低调，耐心等待。"

# game/scripts/Characters/zoe.rpy:1390
translate chinese_simp zoe_item_followup_16bbfb2a:

    # zoe "During all that time, they built connections, favors, and a circle of people loyal to them."
    zoe "在那期间，他们建立了关系网、人情，和一群忠于他们的人。"

# game/scripts/Characters/zoe.rpy:1393
translate chinese_simp zoe_item_followup_161bc540:

    # zoe "Now that we made a vacuum, they're getting ready to jump in."
    zoe "现在我们已经制造了权力真空，他们准备趁虚而入。"

# game/scripts/Characters/zoe.rpy:1394
translate chinese_simp zoe_item_followup_d6d02b4e:

    # ivy "Meaning what exactly?"
    ivy "具体是什么意思？"

# game/scripts/Characters/zoe.rpy:1397
translate chinese_simp zoe_item_followup_eef8baa0:

    # zoe "Meaning I was wrong about the bounty."
    zoe "意思是我之前对悬赏的理解是错的。"

# game/scripts/Characters/zoe.rpy:1398
translate chinese_simp zoe_item_followup_55aa9aa6:

    # zoe "I thought it was just them acting cocky."
    zoe "我原以为只是他们在狂妄自大。"

# game/scripts/Characters/zoe.rpy:1399
translate chinese_simp zoe_item_followup_39a763ff:

    # zoe "It turns out they've got friends inside the police too."
    zoe "结果他们在警局内部也有内应。"

# game/scripts/Characters/zoe.rpy:1400
translate chinese_simp zoe_item_followup_8ec8ffaa:

    # ivy "Do we know who?"
    ivy "知道是谁吗？"

# game/scripts/Characters/zoe.rpy:1403
translate chinese_simp zoe_item_followup_0dc89c40:

    # zoe "No names yet. But from what I can piece together from the documents, it's at least three different people."
    zoe "还没查到名字。但从文件里拼凑出的信息来看，至少有三个人。"

# game/scripts/Characters/zoe.rpy:1404
translate chinese_simp zoe_item_followup_fa972aa9:

    # zoe "I don't know how high up they are, though."
    zoe "不过我不知道他们的级别有多高。"

# game/scripts/Characters/zoe.rpy:1405
translate chinese_simp zoe_item_followup_59b7fa1a:

    # player "I thought they were a raccoon-only gang."
    player "我以为他们是个只有浣熊的帮派。"

# game/scripts/Characters/zoe.rpy:1408
translate chinese_simp zoe_item_followup_800accaf:

    # zoe "Not exactly. The leadership is one family."
    zoe "不完全是。核心领导层是一个家族。"

# game/scripts/Characters/zoe.rpy:1409
translate chinese_simp zoe_item_followup_e7d22d81:

    # zoe "The rest is just normal members."
    zoe "其余的都是普通成员。"

# game/scripts/Characters/zoe.rpy:1410
translate chinese_simp zoe_item_followup_1922eb17:

    # ivy "And the family keeps the real information close."
    ivy "而这个家族把真正重要的信息都攥在手里。"

# game/scripts/Characters/zoe.rpy:1414
translate chinese_simp zoe_item_followup_8b5dcc59:

    # zoe "It was a guy, and he was a human."
    zoe "那是个男的，而且是人类。"

# game/scripts/Characters/zoe.rpy:1415
translate chinese_simp zoe_item_followup_80805ce3:

    # player "Really?"
    player "真的？"

# game/scripts/Characters/zoe.rpy:1416
translate chinese_simp zoe_item_followup_14f79e44:

    # player "Why'd they send someone else this time?"
    player "这次为什么派了别人？"

# game/scripts/Characters/zoe.rpy:1419
translate chinese_simp zoe_item_followup_d10eb115:

    # zoe "Not hard to connect the dots now that we know they got people inside the police."
    zoe "既然知道他们在警局有内应，联系起来就不难了。"

# game/scripts/Characters/zoe.rpy:1420
translate chinese_simp zoe_item_followup_8b5af7e7:

    # player "Then why send anyone at all?"
    player "那为什么还要派人来？"

# game/scripts/Characters/zoe.rpy:1423
translate chinese_simp zoe_item_followup_d76a59fe:

    # ivy "Makes it less obvious they knew about it."
    ivy "显得他们没那么清楚内情。"

# game/scripts/Characters/zoe.rpy:1424
translate chinese_simp zoe_item_followup_18a8865f:

    # player "But if they know you have the documents..."
    player "但如果他们知道文件在你手上……"

# game/scripts/Characters/zoe.rpy:1427
translate chinese_simp zoe_item_followup_6cf8c273:

    # zoe "I guess they were hoping we don't yet."
    zoe "我猜他们希望我们还没发现。"

# game/scripts/Characters/zoe.rpy:1428
translate chinese_simp zoe_item_followup_17444198:

    # zoe "And for now, we're keeping it that way."
    zoe "而目前，我们让他们继续这么以为。"

# game/scripts/Characters/zoe.rpy:1429
translate chinese_simp zoe_item_followup_21b4cb69:

    # zoe "No one outside this room knows we actually have the documents."
    zoe "这个房间外没人知道文件已经在我们手上了。"

# game/scripts/Characters/zoe.rpy:1430
translate chinese_simp zoe_item_followup_37ea9bdb:

    # ivy "Was a good call by having me pick them up separately."
    ivy "你让我单独去取果然是明智的。"

# game/scripts/Characters/zoe.rpy:1433
translate chinese_simp zoe_item_followup_5d2841f2:

    # zoe "I knew something was off when they managed to stay a step ahead no matter what."
    zoe "他们总能抢先一步的时候，我就知道不对劲了。"

# game/scripts/Characters/zoe.rpy:1434
translate chinese_simp zoe_item_followup_6bb6edad:

    # player "So where does that leave me exactly?"
    player "那我到底算什么位置？"

# game/scripts/Characters/zoe.rpy:1435
translate chinese_simp zoe_item_followup_04d592fb:

    # player "And what happens if they show up at my house again?"
    player "而且如果他们再来我家怎么办？"

# game/scripts/Characters/zoe.rpy:1438
translate chinese_simp zoe_item_followup_2a736490:

    # zoe "We stick to the plan."
    zoe "我们按计划行事。"

# game/scripts/Characters/zoe.rpy:1439
translate chinese_simp zoe_item_followup_cde4bd2c:

    # zoe "For the next few weeks, there'll be an officer I trust parked near your house every night in a civilian car."
    zoe "接下来几周，每晚都会有一个我信任的警员开着民用车停在你家附近。"

# game/scripts/Characters/zoe.rpy:1442
translate chinese_simp zoe_item_followup_fa479495:

    # zoe "If anything happens, you call her."
    zoe "有事你就打给她。"

# game/scripts/Characters/zoe.rpy:1443
translate chinese_simp zoe_item_followup_4c72607d:

    # zoe "Luckily your house isn't far from the station, so if something big does goes down, we'll be there fast."
    zoe "幸好你家离警局不远，要真出大事，我们也能很快赶到。"

# game/scripts/Characters/zoe.rpy:1444
translate chinese_simp zoe_item_followup_096917ff:

    # player "Right..."
    player "好吧……"

# game/scripts/Characters/zoe.rpy:1445
translate chinese_simp zoe_item_followup_5fc020e8:

    # player "So I'm guessing you didn't get anything useful out of the human they sent?"
    player "所以你们从他们派来的人身上没问出什么有用的？"

# game/scripts/Characters/zoe.rpy:1448
translate chinese_simp zoe_item_followup_b4da7ac6:

    # ivy "We picked up a few of his friends too, but nothing major."
    ivy "我们也抓了几个他的同伙，但没什么大收获。"

# game/scripts/Characters/zoe.rpy:1449
translate chinese_simp zoe_item_followup_ff583497:

    # ivy "They're all low-level, all joined the gang last month."
    ivy "都是小喽啰，上个月才入伙的。"

# game/scripts/Characters/zoe.rpy:1450
translate chinese_simp zoe_item_followup_ab9b9471:

    # player "Alright... There's at least a few more criminals in jail..."
    player "好吧……至少牢里多了几个罪犯……"

# game/scripts/Characters/zoe.rpy:1453
translate chinese_simp zoe_item_followup_f449c2ee:

    # zoe "I honestly don't think they'll try anything huge at your house."
    zoe "说实话，我觉得他们不会在你家搞大动作。"

# game/scripts/Characters/zoe.rpy:1454
translate chinese_simp zoe_item_followup_7ca5e8fa:

    # zoe "They're aggressive and arrogant, but they're not stupid."
    zoe "他们虽然好斗又自大，但也不傻。"

# game/scripts/Characters/zoe.rpy:1455
translate chinese_simp zoe_item_followup_01b7cecf:

    # zoe "Judging by these documents, they know a lot about you, so they might sooner try to recruit you."
    zoe "从这些文件来看，他们很了解你，所以更可能想拉拢你。"

# game/scripts/Characters/zoe.rpy:1456
translate chinese_simp zoe_item_followup_d345714c:

    # player "They've already tried that a couple of times."
    player "他们已经试过几次了。"

# game/scripts/Characters/zoe.rpy:1459
translate chinese_simp zoe_item_followup_091ca78e:

    # zoe "They'll probably escalate."
    zoe "他们可能会升级手段。"

