    # cynthia "That's true... I can't smell her. Not from here."
    cynthia "这倒是……我闻不到她。至少在这儿闻不到。"

# game/scripts/Characters/zoe.rpy:968
translate chinese_simp zoe_consequences_5a46ceb4:

    # think "I guess [zoe] really {i}was{/i} careful getting here..."
    think "看来 [zoe] 来这儿确实 {i}很{/i} 小心……"

# game/scripts/Characters/zoe.rpy:969
translate chinese_simp zoe_consequences_f8495abb:

    # player "Right."
    player "那就对了。"

# game/scripts/Characters/zoe.rpy:972
translate chinese_simp zoe_consequences_ebefe1a0:

    # cynthia "Well, if you do see someone matching her description, you tell one of our people."
    cynthia "好吧，如果你真看到符合她特征的人，就告诉我们的人。"

# game/scripts/Characters/zoe.rpy:973
translate chinese_simp zoe_consequences_3115ba5e:

    # player "Why would I do that?"
    player "我为什么要这么做？"

# game/scripts/Characters/zoe.rpy:976
translate chinese_simp zoe_consequences_dc579798:

    # cynthia "Because there's a bounty on her."
    cynthia "因为她头上悬着赏金。"

# game/scripts/Characters/zoe.rpy:977
translate chinese_simp zoe_consequences_5cb3a6ac:

    # cynthia "A big one~"
    cynthia "数目不小哦~"

# game/scripts/Characters/zoe.rpy:981
translate chinese_simp zoe_consequences_4ff6db05:

    # cynthia "Though... judging by this place, money probably isn't your problem."
    cynthia "不过……看你这地方，你应该不缺钱。"

# game/scripts/Characters/zoe.rpy:984
translate chinese_simp zoe_consequences_19c30b05:

    # cynthia "I know a few girls who'd do a lot to get stronger."
    cynthia "我认识几个愿意为变强付出很多的女孩。"

# game/scripts/Characters/zoe.rpy:985
translate chinese_simp zoe_consequences_9b640df5:

    # cynthia "Let's call that a tamer's special~"
    cynthia "就当作是给驯兽师的特别待遇吧~"

# game/scripts/Characters/zoe.rpy:986
translate chinese_simp zoe_consequences_050d7d5e:

    # player "...mhm."
    player "……嗯。"

# game/scripts/Characters/zoe.rpy:990
translate chinese_simp zoe_consequences_021059e8:

    # think "They put a bounty on her?"
    think "他们悬赏抓她？"

# game/scripts/Characters/zoe.rpy:991
translate chinese_simp zoe_consequences_7a7874d1:

    # think "Do they not know she's a cop... or do they not care?"
    think "他们不知道她是警察……还是根本不在乎？"

# game/scripts/Characters/zoe.rpy:992
translate chinese_simp zoe_consequences_27a3882a:

    # think "I wonder what she did to piss them off this badly..."
    think "不知道她做了什么让他们气成这样……"

# game/scripts/Characters/zoe.rpy:993
translate chinese_simp zoe_consequences_f9d1571e:

    # think "I should ask [zoe] about it."
    think "我应该去问问 [zoe]。"

# game/scripts/Characters/zoe.rpy:1004
