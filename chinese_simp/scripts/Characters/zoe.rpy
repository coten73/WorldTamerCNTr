    # player "[player]."
    player "[player]。"

# game/scripts/Characters/zoe.rpy:950
translate chinese_simp zoe_consequences_b8e87cc9:

    # cynthia "Alright, [player]. Simple question."
    cynthia "好的，[player]。简单的问题。"

