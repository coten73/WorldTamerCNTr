translate chinese_simp zoe_consequences_04114cbe:

    # cynthia "You seen a blonde girl snooping around here lately?"
    cynthia "你最近有没有看到一个金发女孩在附近鬼鬼祟祟？"

# game/scripts/Characters/zoe.rpy:952
translate chinese_simp zoe_consequences_c97edc5a:

    # cynthia "Big ears, big tail, says her life's in danger."
    cynthia "大耳朵，大尾巴，说她有生命危险。"

# game/scripts/Characters/zoe.rpy:953
translate chinese_simp zoe_consequences_3d375d78:

    # player "Uhh... No?"
    player "呃……没有？"

# game/scripts/Characters/zoe.rpy:956
translate chinese_simp zoe_consequences_df00cca2:

    # cynthia "Then you won't mind if I take a quick look inside, right~?"
    cynthia "那我进去看一眼你也不介意吧~？"

# game/scripts/Characters/zoe.rpy:957
translate chinese_simp zoe_consequences_1a743992:

    # player "Yeah, I mind."
    player "不，我介意。"

# game/scripts/Characters/zoe.rpy:958
translate chinese_simp zoe_consequences_0c1dc148:

    # player "I don't know what you expected, but I'm obviously not letting you into my house."
    player "我不知道你期望什么，但我显然不会让你进我家。"

# game/scripts/Characters/zoe.rpy:961
translate chinese_simp zoe_consequences_f98c77dd:

    # cynthia "I'm guessing you're a tamer?"
    cynthia "我猜你是个驯兽师？"

