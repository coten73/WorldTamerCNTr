    # zoe "It was some kind of documents."
    zoe "是一些文件。"

# game/scripts/Characters/zoe.rpy:1055
translate chinese_simp zoe_checkin_20e871f9:

    # player "How'd you manage that?"
    player "你怎么得手的？"

# game/scripts/Characters/zoe.rpy:1058
