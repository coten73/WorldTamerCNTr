# game/scripts/Characters/ellie.rpy:189
translate chinese_simp ellie_taming_1377ef43:

    # aurora "I- I didn't- I'm sorry, [persistent.auroraplayerTitle]!"
    aurora "我-我没有-对不起，[persistent.auroraplayerTitle]！"

# game/scripts/Characters/ellie.rpy:190
translate chinese_simp ellie_taming_34dabe71:

    # player "I know you were just trying to protect me."
    player "我知道你只是想保护我。"

# game/scripts/Characters/ellie.rpy:194
translate chinese_simp ellie_taming_1e3b5d14:

    # player "But you need to stop going straight to violence every time there's a problem."
    player "但每次出现问题时，你都需要停止直接诉诸暴力。"

