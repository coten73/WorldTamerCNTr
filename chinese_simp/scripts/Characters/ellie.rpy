    # player "Let's start at the beginning... Before you came to visit me..."
    player "让我们从头开始吧...在你来看我之前..."

# game/scripts/Characters/ellie.rpy:256
translate chinese_simp ellie_taming_70c798c1:

    # player "Where did you hear about me being able to untame people?"
    player "你从哪里听说我能驯服人？"

# game/scripts/Characters/ellie.rpy:259
translate chinese_simp ellie_taming_a191e07c:

    # ellie "I don't know..."
    ellie "我不知道..."

# game/scripts/Characters/ellie.rpy:260
translate chinese_simp ellie_taming_2a3d1be8:

    # ellie "A lot of people were talking about it..."
    ellie "很多人都在谈论它..."

# game/scripts/Characters/ellie.rpy:261
translate chinese_simp ellie_taming_bdcb0890:

    # player "So you just heard it on the street?"
    player "所以你只是在街上听到的？"

# game/scripts/Characters/ellie.rpy:264
translate chinese_simp ellie_taming_bd86208b:

    # ellie "Yes..."
    ellie "是的..."

# game/scripts/Characters/ellie.rpy:265
translate chinese_simp ellie_taming_c0df7a3d:

    # player "Okay... Why do you want to be untamed, and where is your tamer?"
    player "好吧……你为什么要野性，你的驯服者在哪里？"

# game/scripts/Characters/ellie.rpy:266
translate chinese_simp ellie_taming_d6f68d10:

    # player "Is he the one you're running from?"
    player "他就是你要逃避的那个人吗？"

# game/scripts/Characters/ellie.rpy:269
translate chinese_simp ellie_taming_ffa8e8f5:

    # ellie "..."
    ellie "..."

# game/scripts/Characters/ellie.rpy:270
translate chinese_simp ellie_taming_73e0de75:

    # player "Okay, here's the deal."
    player "好吧，事情就是这样。"

# game/scripts/Characters/ellie.rpy:271
translate chinese_simp ellie_taming_93bbcfa7:

    # player "It's true that I can untame people, but I'm not going to do that without knowing what I'm up against."
    player "确实，我可以驯服别人，但在不知道自己要面对什么的情况下，我不会这么做。"

# game/scripts/Characters/ellie.rpy:272
translate chinese_simp ellie_taming_b0b5e043:

    # player "So you need to tell me everything you can about your tamer."
    player "所以你需要告诉我关于你的驯兽师的一切。"

# game/scripts/Characters/ellie.rpy:275
translate chinese_simp ellie_taming_b8d37e68:

    # ellie "Really? You'll help me if I tell you?"
    ellie "真的吗？如果我告诉你你会帮我吗？"

# game/scripts/Characters/ellie.rpy:276
translate chinese_simp ellie_taming_701b1898:

    # player "If I can."
    player "如果我可以的话。"

# game/scripts/Characters/ellie.rpy:279
translate chinese_simp ellie_taming_12742794:

    # ellie "Okay. I don't know much about him... He's a druid..."
    ellie "好的。我对他了解不多……他是个德鲁伊……"

# game/scripts/Characters/ellie.rpy:282
translate chinese_simp ellie_taming_5a6e7c5e:

    # ellie "A few hundred years ago, I got tamed when they passed by our village..."
    ellie "几百年前，当他们路过我们村子时，我就被驯服了……"

# game/scripts/Characters/ellie.rpy:283
translate chinese_simp ellie_taming_3aabb785:

    # ellie "He and his wife were travelers, and because druids are so rare, we believed they would bring us good fortune, so we threw them a feast..."
    ellie "他和他的妻子都是旅行者，由于德鲁伊非常罕见，我们相信他们会给我们带来好运，所以我们为他们举办了一场盛宴......"

# game/scripts/Characters/ellie.rpy:286
translate chinese_simp ellie_taming_7b02fe5e:

    # ellie "In a blink of an eye roots came from the ground and injected everyone with their DNA."
    ellie "转眼间根茎就从地里长出来，给每个人注入了自己的DNA。"

# game/scripts/Characters/ellie.rpy:287
translate chinese_simp ellie_taming_51b52700:

    # ellie "Hundreds of elves, tamed in seconds..."
    ellie "数百只精灵，秒被驯服……"

# game/scripts/Characters/ellie.rpy:290
translate chinese_simp ellie_taming_ddcb1a30:

    # ellie "After that, they both just left."
    ellie "说完，两人就离开了。"

# game/scripts/Characters/ellie.rpy:291
translate chinese_simp ellie_taming_2932cbd5:

    # player "Any idea what their plan was?"
    player "知道他们的计划是什么吗？"

# game/scripts/Characters/ellie.rpy:294
translate chinese_simp ellie_taming_f55e35a2:

    # ellie "My species has an extremely high magic affinity, but we're physically weak to balance it out..."
    ellie "我的种族拥有极高的魔法亲和力，但我们的体力却很弱，无法平衡它……"

# game/scripts/Characters/ellie.rpy:295
translate chinese_simp ellie_taming_e161c035:

    # ellie "We figured they wanted to grow stronger... Be able to use stronger magic..."
    ellie "我们认为他们想要变得更强......能够使用更强的魔法......"

# game/scripts/Characters/ellie.rpy:296
translate chinese_simp ellie_taming_a1c24fc2:

    # player "If they just left, why are you on the run?"
    player "如果他们就走了，你为什么还要逃？"

# game/scripts/Characters/ellie.rpy:299
translate chinese_simp ellie_taming_ae710c46:

    # ellie "They're not the ones I'm running from..."
    ellie "他们不是我要逃避的人..."

# game/scripts/Characters/ellie.rpy:300
translate chinese_simp ellie_taming_d2915133:

    # ellie "It's my village..."
    ellie "这是我的村庄..."

# game/scripts/Characters/ellie.rpy:303
translate chinese_simp ellie_taming_c475ebde:

    # ellie "Most of them started worshiping the druids as gods..."
    ellie "他们中的大多数人开始将德鲁伊视为神来崇拜......"

# game/scripts/Characters/ellie.rpy:304
translate chinese_simp ellie_taming_f2b96626:

    # ellie "Their one goal in life was to tame as many beings as they could."
    ellie "他们的人生目标之一就是驯服尽可能多的众生。"

# game/scripts/Characters/ellie.rpy:305
translate chinese_simp ellie_taming_12f04417:

    # ellie "In hopes of getting the druids to visit again and reward them..."
    ellie "希望德鲁伊能够再次拜访并奖励他们......"

# game/scripts/Characters/ellie.rpy:306
translate chinese_simp ellie_taming_87b17ff9:

    # player "And you were against that?"
    player "你反对吗？"

# game/scripts/Characters/ellie.rpy:309
translate chinese_simp ellie_taming_29731e6f:

    # ellie "When it all started there were quite a few of us fighting against it."
    ellie "当这一切开始时，我们中有不少人与之抗争。"

# game/scripts/Characters/ellie.rpy:310
translate chinese_simp ellie_taming_f23be990:

    # ellie "But as time went on, most gave in or chose to leave the village..."
    ellie "但随着时间的推移，大多数人屈服了，或者选择离开村庄……"

# game/scripts/Characters/ellie.rpy:311
translate chinese_simp ellie_taming_90aa8754:

    # player "If they had that option, why couldn't you?"
    player "如果他们有这样的选择，为什么你不能呢？"

# game/scripts/Characters/ellie.rpy:314
translate chinese_simp ellie_taming_8a147703:

    # ellie "I'm the Chief's daughter... I didn't get that choice..."
    ellie "我是酋长的女儿……我没有这个选择……"

# game/scripts/Characters/ellie.rpy:315
translate chinese_simp ellie_taming_a72a2017:

    # ellie "So I ran. I've been running for the past two hundred years..."
    ellie "所以我跑了。我已经奔跑了两百年了"

# game/scripts/Characters/ellie.rpy:318
translate chinese_simp ellie_taming_5f921b9e:

    # ellie "They sent people after me, and every few years they catch up, so I have to move to a different town..."
    ellie "他们派人追捕我，每隔几年他们就会追上来，所以我不得不搬到另一个城镇......"

# game/scripts/Characters/ellie.rpy:319
translate chinese_simp ellie_taming_83c086a3:

    # player "I can see why you were so desperate to get untamed..."
    player "我明白你为什么如此渴望摆脱束缚......"

# game/scripts/Characters/ellie.rpy:320
translate chinese_simp ellie_taming_e36044c2:

    # player "But I don't know if I'm stronger than this Druid..."
    player "但不知道自己是否比这个德鲁伊强……"

# game/scripts/Characters/ellie.rpy:321
