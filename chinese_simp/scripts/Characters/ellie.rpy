translate chinese_simp ellie_taming_377a6708:

    # aurora "After I confronted her about going to your house, she didn't say anything, she just ran."
    aurora "当我质问她要不要去你家时，她什么也没说，只是跑了。"

# game/scripts/Characters/ellie.rpy:201
translate chinese_simp ellie_taming_ddd169a6:

    # aurora "I'm much faster than an elf, so I chased her down and brought her back to my hideout."
    aurora "我比精灵快多了，所以我追上了她，把她带回了我的藏身之处。"

# game/scripts/Characters/ellie.rpy:202
translate chinese_simp ellie_taming_db338d2d:

    # player "The gang's hideout?"
    player "该团伙的藏身之处？"

# game/scripts/Characters/ellie.rpy:205
translate chinese_simp ellie_taming_ca03a967:

    # aurora "No. No one knows about this place, it's where I go to get away from everything..."
    aurora "不，没有人知道这个地方，这是我逃离一切的地方......"

# game/scripts/Characters/ellie.rpy:206
translate chinese_simp ellie_taming_0d50e5a4:

    # player "Okay... Then what?"
    player "好吧……然后呢？"

# game/scripts/Characters/ellie.rpy:209
translate chinese_simp ellie_taming_0914f88a:

    # aurora "I chained her up, so she couldn't run away and questioned her about you..."
    aurora "我把她锁起来，不让她逃跑，还问她关于你的事……"

# game/scripts/Characters/ellie.rpy:210
translate chinese_simp ellie_taming_0cc2c5ab:

    # aurora "She said that she heard about a guy who can untame people..."
    aurora "她说她听说过一个能驯服人的家伙……"

# game/scripts/Characters/ellie.rpy:213
translate chinese_simp ellie_taming_fcd35b10:

    # aurora "She didn't believe it, but she was desperate."
    aurora "她不相信，但她又绝望了。"

# game/scripts/Characters/ellie.rpy:214
translate chinese_simp ellie_taming_f5333843:

    # aurora "I don't know who she's running from, but she was scared of them way more than me."
    aurora "我不知道她在躲避谁，但她比我更害怕他们。"

# game/scripts/Characters/ellie.rpy:217
translate chinese_simp ellie_taming_7778d08d:

    # aurora "After I got what I could out of her, I figured I'd release her in a few weeks..."
    aurora "在我从她身上得到了我能得到的一切后，我想我会在几周内释放她......"

# game/scripts/Characters/ellie.rpy:218
translate chinese_simp ellie_taming_9b1280eb:

    # player "Weeks??"
    player "几周？"

# game/scripts/Characters/ellie.rpy:221
translate chinese_simp ellie_taming_95466d89:

    # aurora "I'm sorry... I just wanted to protect you... Please don't be mad at me..."
    aurora "对不起...我只是想保护你...请不要生我的气..."

# game/scripts/Characters/ellie.rpy:222
translate chinese_simp ellie_taming_b4181888:

    # player "I'm not- Well I am mad, but I get why you did it..."
    player "我不是——好吧，我很生气，但我明白你为什么这么做……"

# game/scripts/Characters/ellie.rpy:223
