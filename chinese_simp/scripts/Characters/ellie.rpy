    # player "It's better if the elf girl doesn't see you when she gets back..."
    player "精灵女孩回来时最好不要看到你……"

# game/scripts/Characters/ellie.rpy:224
translate chinese_simp ellie_taming_a9ea95ed:

    # player "I think you put her through enough."
    player "我想你已经让她受够了。"

# game/scripts/Characters/ellie.rpy:227
translate chinese_simp ellie_taming_8e092404:

    # aurora "I understand..."
    aurora "我明白了..."

# game/scripts/Characters/ellie.rpy:228
translate chinese_simp ellie_taming_26ed0858:

    # player "I'll call when I need you again, but for now, go back to work as usual."
    player "当我再次需要你的时候我会打电话给你，但是现在，像往常一样回去工作吧。"

# game/scripts/Characters/ellie.rpy:229
translate chinese_simp ellie_taming_f0b7932d_1:

    # aurora "Okay..."
    aurora "好吧..."

# game/scripts/Characters/ellie.rpy:233
