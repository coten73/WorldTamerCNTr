    emily "她没有任何瘀伤或任何东西......"

# game/scripts/Characters/ellie.rpy:237
translate chinese_simp ellie_taming_01f7f5bc:

    # player "Well I sent [aurora] away, if you're worried about that..."
    player "好吧，我已经把 [aurora] 送走了，如果你担心的话......"

# game/scripts/Characters/ellie.rpy:240
translate chinese_simp ellie_taming_91c73c7d:

    # player "I just wanna talk... What's your name?"
    player "我只是想谈谈...你叫什么名字？"

# game/scripts/Characters/ellie.rpy:243
translate chinese_simp ellie_taming_b42b80e2:

    # ellie "...[ellie]..."
    ellie "...[ellie]..."

# game/scripts/Characters/ellie.rpy:244
translate chinese_simp ellie_taming_49838c21:

    # player "Okay..."
    player "好吧..."

# game/scripts/Characters/ellie.rpy:247
translate chinese_simp ellie_taming_1b2aa5fd:

    # emily "I don't know what's going on here, and I don't want to get involved so I'll leave."
    emily "我不知道这里发生了什么，我也不想参与其中，所以我会离开。"

# game/scripts/Characters/ellie.rpy:248
translate chinese_simp ellie_taming_6d9dab3e:

    # player "That's fair..."
    player "这很公平..."

# game/scripts/Characters/ellie.rpy:252
translate chinese_simp ellie_taming_8af1d82b:

    # player "Again. I want to say how sorry I am about what [aurora] did to you..."
    player "再次。我想说，对于 [aurora] 对你所做的事情，我感到非常抱歉……"

# game/scripts/Characters/ellie.rpy:253
translate chinese_simp ellie_taming_c7a2a7ec:

    # player "But I hope you can put that aside at least for now, and just talk."
    player "但我希望你至少现在能把这件事放在一边，只是谈谈。"

# game/scripts/Characters/ellie.rpy:254
translate chinese_simp ellie_taming_4440429a:

    # ellie "Okay..."
    ellie "好吧..."

# game/scripts/Characters/ellie.rpy:255
