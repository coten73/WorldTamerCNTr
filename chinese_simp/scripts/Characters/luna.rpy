translate chinese_simp luna_body_eight_2314ea95:

    # player "We already had our first kiss a while ago~"
    player "我们不久前已经有过初吻了~"

# game/scripts/Characters/luna.rpy:859
translate chinese_simp luna_body_eight_cc9d4a8e:

    # ellie "There you go again, bringing that up..."
    ellie "你又来了……又提这个……"

# game/scripts/Characters/luna.rpy:860
translate chinese_simp luna_body_eight_40e5353d:

    # player "Sorry—I'll let you make the move this time."
    player "抱歉——那这次换你来主动。"

# game/scripts/Characters/luna.rpy:863
translate chinese_simp luna_body_eight_9dadb4b0:

    # ellie "As in..."
    ellie "意思是……"

# game/scripts/Characters/luna.rpy:864
translate chinese_simp luna_body_eight_9a6e0873:

    # player "You're the one who has to initiate the kiss~"
    player "你来主动亲我~"

# game/scripts/Characters/luna.rpy:867
translate chinese_simp luna_body_eight_94dcd7ee_1:

    # ellie "Oh..."
    ellie "哦……"

# game/scripts/Characters/luna.rpy:870
translate chinese_simp luna_body_eight_f8c5d323:

    # ellie "And what if I don't want to tonight..?"
    ellie "如果我今晚不想呢……？"

# game/scripts/Characters/luna.rpy:871
translate chinese_simp luna_body_eight_a11ba296:

    # player "I wouldn't expect you to just give in right away."
    player "我没指望你这么快就妥协。"

# game/scripts/Characters/luna.rpy:874
translate chinese_simp luna_body_eight_47aa8ce2:

    # ellie "Right..."
    ellie "对……"

# game/scripts/Characters/luna.rpy:875
translate chinese_simp luna_body_eight_97f76264:

    # player "Something wrong?"
    player "怎么了？"

# game/scripts/Characters/luna.rpy:878
translate chinese_simp luna_body_eight_f084dce5:

    # ellie "No... It's just... You got me all dressed up, and now we're just sitting here on my bed."
    ellie "没有……就是……你把我打扮得漂漂亮亮的，结果我们就这么坐在我床上。"

# game/scripts/Characters/luna.rpy:879
translate chinese_simp luna_body_eight_09781d75:

    # player "Would you rather go out?"
    player "你想出去吗？"

# game/scripts/Characters/luna.rpy:882
translate chinese_simp luna_body_eight_b50d714d:

    # ellie "No—I already told you I don't like crowded spaces."
    ellie "不——我说过我不喜欢拥挤的地方。"

# game/scripts/Characters/luna.rpy:883
translate chinese_simp luna_body_eight_096917ff:

    # player "Right..."
    player "对……"

# game/scripts/Characters/luna.rpy:886
translate chinese_simp luna_body_eight_6497c4cb:

    # ellie "It's... nice."
    ellie "这样……挺好的。"

# game/scripts/Characters/luna.rpy:887
translate chinese_simp luna_body_eight_26513c26:

    # ellie "We've never been alone like this before."
    ellie "我们以前从未这样独处过。"

# game/scripts/Characters/luna.rpy:888
translate chinese_simp luna_body_eight_97232ba8:

    # player "Now that you mention it... The last time we sat together on a bed..."
    player "你这么一说……上次我们坐在一起，也是在床上……"

# game/scripts/Characters/luna.rpy:891
translate chinese_simp luna_body_eight_21418b3e:

    # ellie "[player]! You promised not to bring up the kiss again..!"
    ellie "[player]！你答应过不再提那个吻了……！"

# game/scripts/Characters/luna.rpy:892
translate chinese_simp luna_body_eight_fae65c52:

    # player "Hey, you kinda brought that one up..."
    player "嘿，这次是你先提起来的……"

# game/scripts/Characters/luna.rpy:895
translate chinese_simp luna_body_eight_da5db070:

    # ellie "Still..."
    ellie "那也不能……"

# game/scripts/Characters/luna.rpy:899
translate chinese_simp luna_body_eight_1ceccfa5:

    # player "Like I said... I'm fine with just falling asleep like this."
    player "就像我说的……就这么睡着我也没问题。"

# game/scripts/Characters/luna.rpy:900
translate chinese_simp luna_body_eight_5d8b034a:

    # ellie "But what about the magic you need—"
    ellie "但你需要用的魔法——"

# game/scripts/Characters/luna.rpy:901
translate chinese_simp luna_body_eight_2b3a9820:

    # ellie "Can you at least tell me what that's about?"
    ellie "你至少能告诉我那是什么吗？"

# game/scripts/Characters/luna.rpy:902
translate chinese_simp luna_body_eight_39e46839:

    # player "Well... It's complicated. There's this voice—or a being—inside my head."
    player "嗯……这有点复杂。我脑子里有个声音——或者说一个存在。"

# game/scripts/Characters/luna.rpy:903
translate chinese_simp luna_body_eight_20d47cd6:

    # player "I got [astra] to build a body for her, but I need magic to actually move her into it."
    player "我让 [astra] 给她造了个身体，但我需要用魔法才能把她移进去。"

# game/scripts/Characters/luna.rpy:904
translate chinese_simp luna_body_eight_5bfb4f1b:

    # ellie "And how do you know my kind of magic is the right one?"
    ellie "你怎么知道我的魔法就是对的？"

# game/scripts/Characters/luna.rpy:905
translate chinese_simp luna_body_eight_ef797259:

    # player "I don't, really... [astra] can't detect her at all, but she said your magic should be able to."
    player "我也不确定……[astra] 完全探测不到她，但她说你的魔法应该可以。"

# game/scripts/Characters/luna.rpy:908
translate chinese_simp luna_body_eight_7e0a475f:

    # player "Figured it's worth a try either way. Even if it doesn't work, at least I still get to tame someone as beautiful as you~"
    player "不管怎样都值得一试。就算不成功，至少我也能驯服像你这么美的对象~"

# game/scripts/Characters/luna.rpy:909
translate chinese_simp luna_body_eight_3eef5134:

    # ellie "..!"
    ellie "……！"

# game/scripts/Characters/luna.rpy:912
translate chinese_simp luna_body_eight_b8b209ae:

    # player "Sorry, couldn't resist~"
    player "抱歉，没忍住~"

# game/scripts/Characters/luna.rpy:913
translate chinese_simp luna_body_eight_da3a0a95:

    # ellie "...There's a way to test it."
    ellie "……有个办法可以试试。"

# game/scripts/Characters/luna.rpy:914
translate chinese_simp luna_body_eight_4b25d237:

    # player "How?"
    player "什么办法？"

# game/scripts/Characters/luna.rpy:915
translate chinese_simp luna_body_eight_546f5418:

    # ellie "I can try looking into your mind."
    ellie "我可以试着窥探你的意识。"

# game/scripts/Characters/luna.rpy:916
translate chinese_simp luna_body_eight_938fa140:

    # ellie "If my magic's compatible, I should be able to sense her."
    ellie "如果我的魔法兼容，我应该能感知到她。"

# game/scripts/Characters/luna.rpy:917
translate chinese_simp luna_body_eight_2fd7a58c:

    # player "Go ahead."
    player "来吧。"

# game/scripts/Characters/luna.rpy:921
translate chinese_simp luna_body_eight_ffa8e8f5:

    # ellie "..."
    ellie "……"

# game/scripts/Characters/luna.rpy:922
translate chinese_simp luna_body_eight_1aba3913:

    # player "See anything strange?"
    player "看到什么奇怪的东西了吗？"

# game/scripts/Characters/luna.rpy:923
translate chinese_simp luna_body_eight_df0d9ad0:

    # ellie "Yeah..."
    ellie "嗯……"

# game/scripts/Characters/luna.rpy:924
translate chinese_simp luna_body_eight_010afd32:

    # ellie "There's definitely something else in your head."
    ellie "你脑子里确实有别的存在。"

# game/scripts/Characters/luna.rpy:925
translate chinese_simp luna_body_eight_2c4fd607:

    # ellie "It's like I'm looking into two heads at the same time—"
    ellie "就好像我同时在看着两个意识——"

# game/scripts/Characters/luna.rpy:926
translate chinese_simp luna_body_eight_d9aeca37:

    # player "That's [luna]..."
    player "那是 [luna]……"

# game/scripts/Characters/luna.rpy:927
translate chinese_simp luna_body_eight_26b2656e:

    # ellie "That's her name?"
    ellie "她叫 [luna]？"

# game/scripts/Characters/luna.rpy:928
translate chinese_simp luna_body_eight_56df4f1e:

    # player "Yeah—"
    player "对——"

# game/scripts/Characters/luna.rpy:929
translate chinese_simp luna_body_eight_00a930c1:

    # luna "[ellie]..?"
    luna "[ellie]……？"

# game/scripts/Characters/luna.rpy:932
translate chinese_simp luna_body_eight_021dbcc3:

    # ellie "Oh... I think I can hear her..."
    ellie "哦……我想我能听到她说话……"

# game/scripts/Characters/luna.rpy:933
translate chinese_simp luna_body_eight_7cd2a713:

    # player "She just said your name."
    player "她刚说了你的名字。"

# game/scripts/Characters/luna.rpy:934
translate chinese_simp luna_body_eight_806465ad:

    # ellie "Then I heard right..."
    ellie "那我没听错……"

# game/scripts/Characters/luna.rpy:937
translate chinese_simp luna_body_eight_56c3e5e7:

    # ellie "But I should stop—I don't want to poke around in your head."
    ellie "但我该停了——我不想在你脑子里乱探。"

# game/scripts/Characters/luna.rpy:938
translate chinese_simp luna_body_eight_b0a98418:

    # player "Afraid of what you might find~?"
    player "怕发现什么不该发现的东西~？"

# game/scripts/Characters/luna.rpy:941
translate chinese_simp luna_body_eight_476e9994:

    # ellie "What's in your head is yours. You'll share it if you want to."
    ellie "你脑子里的东西属于你。你想分享的时候自然会分享。"

# game/scripts/Characters/luna.rpy:942
translate chinese_simp luna_body_eight_ba09431b:

    # player "Fair enough."
    player "有道理。"

# game/scripts/Characters/luna.rpy:943
translate chinese_simp luna_body_eight_fbd7bdc9:

    # player "So, I guess that confirms it—your magic works."
    player "所以，我想这证实了——你的魔法有用。"

# game/scripts/Characters/luna.rpy:944
translate chinese_simp luna_body_eight_be3531ac:

    # ellie "It does."
    ellie "确实。"

# game/scripts/Characters/luna.rpy:945
translate chinese_simp luna_body_eight_616818b2:

    # player "But do you think you could move her without me taming you?"
    player "但你觉得你能在不驯服你的情况下把她移走吗？"

# game/scripts/Characters/luna.rpy:946
translate chinese_simp luna_body_eight_a7c9d845:

    # ellie "Not permanently, no. But technically, yes..."
    ellie "永久性的不行，不行。但从技术上来说，可以……"

# game/scripts/Characters/luna.rpy:947
translate chinese_simp luna_body_eight_6f28840c:

    # ellie "I won't, though. I don't want you to have to rely on me every time."
    ellie "不过我不会这么做。我不想你每次都依赖我。"

# game/scripts/Characters/luna.rpy:948
translate chinese_simp luna_body_eight_1951e37a:

    # ellie "It's better if you learn to do it yourself."
    ellie "你自己学会会更好。"

# game/scripts/Characters/luna.rpy:949
translate chinese_simp luna_body_eight_974ca076:

    # player "That makes sense."
    player "说得对。"

# game/scripts/Characters/luna.rpy:950
translate chinese_simp luna_body_eight_cde86da6:

    # ellie "...If I said I'd be able to move her for you whenever you needed..."
    ellie "……如果我说，只要你需要，我就能帮你转移她……"

# game/scripts/Characters/luna.rpy:951
translate chinese_simp luna_body_eight_095f32c1:

    # ellie "Would you stop trying to tame me?"
    ellie "你会不再试图驯服我吗？"

# game/scripts/Characters/luna.rpy:952
translate chinese_simp luna_body_eight_29113672:

    # player "No."
    player "不会。"

# game/scripts/Characters/luna.rpy:953
translate chinese_simp luna_body_eight_4eaa6ef0:

    # player "I told you—there are plenty of other reasons I want you~"
    player "我说过了——我想要你还有好多别的理由~"

# game/scripts/Characters/luna.rpy:954
translate chinese_simp luna_body_eight_97a67729:

    # ellie "So... if you do end up taming me in a few days..."
    ellie "所以……如果你过几天真的驯服了我……"

# game/scripts/Characters/luna.rpy:955
translate chinese_simp luna_body_eight_fd1c9659:

    # ellie "Nothing will change?"
    ellie "什么都不会改变？"

# game/scripts/Characters/luna.rpy:959
translate chinese_simp luna_body_eight_34cd8b0e:

    # player "Exactly. Tamed or not, nothing changes between us."
    player "没错。不管驯不驯服，我们之间都不会改变。"

# game/scripts/Characters/luna.rpy:960
translate chinese_simp luna_body_eight_4440429a:

    # ellie "Okay..."
    ellie "好……"

# game/scripts/Characters/luna.rpy:965
translate chinese_simp luna_body_eight_03775ec8:

    # player "..."
    player "……"

# game/scripts/Characters/luna.rpy:968
translate chinese_simp luna_body_eight_06ff2778:

    # player "Thought you said not tonight~"
    player "你刚才不是说今晚不行吗~"

# game/scripts/Characters/luna.rpy:971
translate chinese_simp luna_body_eight_3f03239f:

    # ellie "You said the right things and... Changed my mind."
    ellie "你说对了话……我改变主意了。"

# game/scripts/Characters/luna.rpy:974
translate chinese_simp luna_body_eight_ac527c89:

    # ellie "Besides, I'm curious to see how you'll learn to use my magic."
    ellie "而且，我很好奇你会怎么学我的魔法。"

# game/scripts/Characters/luna.rpy:975
translate chinese_simp luna_body_eight_cd592ed8:

    # player "Is it that hard..?"
    player "有那么难吗……？"

# game/scripts/Characters/luna.rpy:978
translate chinese_simp luna_body_eight_86f72aa8:

    # ellie "Took me decades to get this good... But you won't need to be anywhere close to my level."
    ellie "我花了几十年才练到这个地步……但你不需要达到我的水平。"

# game/scripts/Characters/luna.rpy:979
translate chinese_simp luna_body_eight_47d2061e:

    # ellie "You just need to get good enough to move [luna] out."
    ellie "你只需要能成功把 [luna] 移出去就够了。"

# game/scripts/Characters/luna.rpy:980
translate chinese_simp luna_body_eight_d290ed97:

    # player "How long would it take?"
    player "要花多久？"

# game/scripts/Characters/luna.rpy:981
translate chinese_simp luna_body_eight_cdf2a0e2:

    # ellie "Shouldn't be too long. With a good teacher of course..."
    ellie "应该不会太久。当然，前提是有个好老师……"

# game/scripts/Characters/luna.rpy:982
translate chinese_simp luna_body_eight_18bbb49c:

    # player "Would that be you~?"
    player "那不就是你吗~？"

# game/scripts/Characters/luna.rpy:983
translate chinese_simp luna_body_eight_f1c23e9c:

    # ellie "We can start tomorrow. I'd be happy to."
    ellie "我们可以明天开始。我很乐意。"

# game/scripts/Characters/luna.rpy:984
translate chinese_simp luna_body_eight_3ea1e271:

    # player "I appreciate it..."
    player "谢谢你……"

# game/scripts/Characters/luna.rpy:985
translate chinese_simp luna_body_eight_17b4beb5:

    # ellie "Oh, and about the whole taming thing... That kiss was just payback."
    ellie "哦，关于驯服的事……那个吻只是报复。"

# game/scripts/Characters/luna.rpy:986
translate chinese_simp luna_body_eight_7e1b3f32:

    # ellie "Same way you kissed me to save me from that 'curse.'"
    ellie "就像你为了‘破除诅咒’吻我一样。"

# game/scripts/Characters/luna.rpy:987
translate chinese_simp luna_body_eight_d2340913:

    # ellie "I still want you to properly tame me. To actually want to date me."
    ellie "我还是想让你正式驯服我。要真心想跟我交往才行。"

# game/scripts/Characters/luna.rpy:988
translate chinese_simp luna_body_eight_33dc3867:

    # player "You don't have to worry about that."
    player "你不用担心这个。"

# game/scripts/Characters/luna.rpy:989
translate chinese_simp luna_body_eight_5d0cce52:

    # player "Nothing's changed. I'll be looking forward to getting a real kiss from you one day~"
    player "什么都没有变。我会期待有一天能获得你真心的吻~"

# game/scripts/Characters/luna.rpy:990
translate chinese_simp luna_body_eight_6f1ae69f:

    # ellie "...Good..."
    ellie "……好……"

# game/scripts/Characters/luna.rpy:1004
translate chinese_simp luna_body_nine_04c9fee2:

    # ellie "You here for the lesson we talked about..?"
    ellie "来上我们说好的课吗……？"

# game/scripts/Characters/luna.rpy:1005
translate chinese_simp luna_body_nine_ec2c7d86:

    # player "I'm ready to learn from the best~"
    player "我准备好向最厉害的老师学习了~"

# game/scripts/Characters/luna.rpy:1008
translate chinese_simp luna_body_nine_37426eb6:

    # ellie "Okay~! Let's get started then."
    ellie "好~！那我们开始吧。"

# game/scripts/Characters/luna.rpy:1009
translate chinese_simp luna_body_nine_98e77aef:

    # player "So, how will this work?"
    player "所以，这具体怎么进行？"

# game/scripts/Characters/luna.rpy:1012
translate chinese_simp luna_body_nine_41fdef6e:

    # ellie "Well, I'm not going to be teaching you in a conventional way. My magic can do a lot of things-"
    ellie "嗯，我不会用常规方式教你。我的魔法能办到很多事——"

# game/scripts/Characters/luna.rpy:1013
translate chinese_simp luna_body_nine_bdee097d:

    # ellie "But we'll only focus on exactly what you need to move [luna]. Otherwise, it would take decades..."
    ellie "但我们只专注在移走 [luna] 所需的部分。不然的话，得花几十年……"

# game/scripts/Characters/luna.rpy:1014
translate chinese_simp luna_body_nine_6d9dab3e:

    # player "That's fair..."
    player "这很合理……"

# game/scripts/Characters/luna.rpy:1017
translate chinese_simp luna_body_nine_69b050cb:

    # ellie "Okay, I'm going to try to show you what it feels like to have magic flowing through you..."
    ellie "好，我会试着让你感受一下体内有魔力流动是什么感觉……"

# game/scripts/Characters/luna.rpy:1018
translate chinese_simp luna_body_nine_55cf0dcb:

    # ellie "It won't be painful or anything. It should feel like you just became ten times stronger... Very similar to adrenaline."
    ellie "不会痛或什么的。应该会感觉像突然强大了十倍……跟肾上腺素激增很像。"

# game/scripts/Characters/luna.rpy:1021
translate chinese_simp luna_body_nine_2dbefecb:

    # ellie "You ready?"
    ellie "准备好了吗？"

# game/scripts/Characters/luna.rpy:1022
translate chinese_simp luna_body_nine_0c081e71:

    # player "Yes."
    player "嗯。"

# game/scripts/Characters/luna.rpy:1026
translate chinese_simp luna_body_nine_138bbe54:

    # ellie "Do you feel it?"
    ellie "感觉到了吗？"

# game/scripts/Characters/luna.rpy:1027
translate chinese_simp luna_body_nine_ece04e6c:

    # player "Yeah..."
    player "感觉到了……"

# game/scripts/Characters/luna.rpy:1030
translate chinese_simp luna_body_nine_0022be01:

    # ellie "Good... It should be pretty easy to teach you. You'll practice by moving energy around in your body."
    ellie "好……教你应该不难。你先练习在体内引导能量。"

# game/scripts/Characters/luna.rpy:1031
translate chinese_simp luna_body_nine_ea6d0776:

    # ellie "I'll be here to give you a little boost, but more you can do on your own, the better."
    ellie "我会在旁边帮你一把，但你能自己做的越多越好。"

# game/scripts/Characters/luna.rpy:1032
translate chinese_simp luna_body_nine_822ab9fb:

    # player "Sounds straight-forward enough..."
    player "听起来挺直接的……"

# game/scripts/Characters/luna.rpy:1035
translate chinese_simp luna_body_nine_d2769998:

    # narrator "You spend the morning meditating and training you magic with [ellie]."
    narrator "你花了一整个早上跟 [ellie] 一起冥想和训练魔法。"

# game/scripts/Characters/luna.rpy:1038
translate chinese_simp luna_body_nine_816ce66c:

    # player "I feel like I'm making progress fast..."
    player "我感觉进步很快……"

# game/scripts/Characters/luna.rpy:1041
translate chinese_simp luna_body_nine_26e2a098:

    # ellie "Let me explain it to you... There's two big ways this kind of magic works."
    ellie "我跟你解释一下……这种魔法主要有两种用法。"

# game/scripts/Characters/luna.rpy:1042
translate chinese_simp luna_body_nine_dce54151:

    # ellie "Transferring a soul from one person to another or transferring your own soul into someone else's body."
    ellie "一是把灵魂从一个人转移到另一个人身上，二是把自己的灵魂转移到别人体内。"

