translate chinese_simp kora_taming_3_8bd93f1c:

    # kora "You? Someone like you tamed a celestial?"
    kora "你？你这种人能驯服天神？"

# game/scripts/Characters/kora.rpy:357
translate chinese_simp kora_taming_3_ece04e6c:

    # player "Yeah..."
    player "嗯……"

# game/scripts/Characters/kora.rpy:361
translate chinese_simp kora_taming_3_f8df7181:

    # kora "Maybe I got it all wrong... There might be more to you after all..."
    kora "也许是我看走眼了……你这人说不定真有点本事……"

# game/scripts/Characters/kora.rpy:362
translate chinese_simp kora_taming_3_e7a42129:

    # player "Does that mean you know of a way to get home?"
    player "那你是知道回家的办法了？"

# game/scripts/Characters/kora.rpy:366
translate chinese_simp kora_taming_3_b3781403:

    # kora "I know of a potential way home... It would largely depend on you though..."
    kora "我知道一个可能的方法……不过那很大程度上取决于你……"

# game/scripts/Characters/kora.rpy:367
translate chinese_simp kora_taming_3_f7553ee2:

    # player "What do I have to do?"
    player "我需要做什么？"

# game/scripts/Characters/kora.rpy:368
translate chinese_simp kora_taming_3_0f527d74:

    # kora "You need to reach your celestial, but I doubt you'll be able to do that right now..."
    kora "你需要联系上你的天神，但我怀疑你现在还做不到……"

# game/scripts/Characters/kora.rpy:372
translate chinese_simp kora_taming_3_90d30643:

    # kora "You'll need to train your mind, and do it daily."
    kora "你需要锻炼精神力，而且每天都不能间断。"

# game/scripts/Characters/kora.rpy:373
translate chinese_simp kora_taming_3_6c0459ff:

    # kora "After a bit of time you should be able to focus and send her a message if you're lucky and she's in her dimension when you do."
    kora "一段时间后，如果你运气好，而她正好也在自己的维度里，你就能集中精神给她传话。"

# game/scripts/Characters/kora.rpy:374
translate chinese_simp kora_taming_3_c5053c7e:

    # player "Okay... How do I train?"
    player "好……那我该怎么锻炼？"

# game/scripts/Characters/kora.rpy:378
translate chinese_simp kora_taming_3_d9df6f32:

    # kora "Just meditate alone and without distractions."
    kora "独自冥想，不受任何干扰。"

# game/scripts/Characters/kora.rpy:379
translate chinese_simp kora_taming_3_d5e9e8ce:

    # player "Sure... Thank you..."
    player "好……谢谢你……"

# game/scripts/Characters/kora.rpy:380
translate chinese_simp kora_taming_3_dc5ec2e9:

    # kora "Yeah, yeah..."
    kora "行了行了……"

# game/scripts/Characters/kora.rpy:391
translate chinese_simp kora_taming_4_f5dd5c67:

    # player "Figured it was you..."
    player "我就猜到是你……"

# game/scripts/Characters/kora.rpy:392
translate chinese_simp kora_taming_4_77303858:

    # player "Why did you take it?"
    player "你为什么要拿走它？"

# game/scripts/Characters/kora.rpy:395
translate chinese_simp kora_taming_4_80b745d7:

    # kora "I noticed another fox girl suddenly showed up and I knew she had to be connected to you..."
    kora "我发现又来了一个狐女，就知道她肯定跟你有关系……"

# game/scripts/Characters/kora.rpy:396
translate chinese_simp kora_taming_4_dddf90f5:

    # kora "I checked her out and found this thing next to her when she was sleeping."
    kora "我去查探她的时候，在她睡着时旁边发现了这东西。"

# game/scripts/Characters/kora.rpy:399
translate chinese_simp kora_taming_4_c025391f:

    # kora "I knew it had to be important~"
    kora "我就知道这肯定很重要~"

# game/scripts/Characters/kora.rpy:400
translate chinese_simp kora_taming_4_9812835b:

    # player "It is... Can I please have it back?"
    player "确实……能把它还给我吗？"

# game/scripts/Characters/kora.rpy:403
translate chinese_simp kora_taming_4_18072cb0:

    # kora "What does it do?"
    kora "这东西有什么作用？"

# game/scripts/Characters/kora.rpy:404
translate chinese_simp kora_taming_4_78f03484:

    # player "It's our only way home... We just have to use it at the right time."
    player "这是我们回家的唯一办法……只要在正确的时机使用它就行了。"

# game/scripts/Characters/kora.rpy:407
translate chinese_simp kora_taming_4_922bfb04:

    # kora "If that's all, then I can be the one to use it."
    kora "就这么简单的话，那就由我来用吧。"

# game/scripts/Characters/kora.rpy:408
translate chinese_simp kora_taming_4_977c28d4:

    # player "What are you worried about? I have no reason to leave you or [quila] behind..."
    player "你在担心什么？我没理由扔下你或者[quila]不管……"

# game/scripts/Characters/kora.rpy:409
translate chinese_simp kora_taming_4_8178988d:

    # player "We've known each other for a few months now, you can trust-"
    player "我们认识也有几个月了，你可以相信——"

# game/scripts/Characters/kora.rpy:412
translate chinese_simp kora_taming_4_78a01085:

    # kora "I don't trust anyone. I'll be the one to use this thing, that's not a problem is it?"
    kora "我不相信任何人。这东西得由我来用，没问题吧？"

# game/scripts/Characters/kora.rpy:413
translate chinese_simp kora_taming_4_ac3b3355:

    # player "Fine."
    player "行吧。"

# game/scripts/Characters/kora.rpy:414
translate chinese_simp kora_taming_4_29e19398:

    # player "I'll come get you when it's time to go."
    player "走的时候我来找你。"

# game/scripts/Characters/kora.rpy:417
translate chinese_simp kora_taming_4_07eb4d0a:

    # kora "I'll be waiting~"
    kora "我等着~"

