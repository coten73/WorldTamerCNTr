    # player "I'm just visiting in case you're lonely again~"
    player "我就来看看，怕你又孤单了~"

# game/scripts/Characters/quila.rpy:416
translate chinese_simp quila_taming_2_2f5c9757:

    # quila "What? I was never lonely!"
    quila "什么？我从来不孤单！"

# game/scripts/Characters/quila.rpy:419
translate chinese_simp quila_taming_2_47ad2b63:

    # quila "If that's what you came for you can get lost!"
    quila "你要是为这个来的，可以滚了！"

# game/scripts/Characters/quila.rpy:420
translate chinese_simp quila_taming_2_7a282055:

    # player "Sorry, I'm just messing with you~"
    player "抱歉，逗你玩呢~"

# game/scripts/Characters/quila.rpy:424
translate chinese_simp quila_taming_2_a8256d2f:

    # quila "Hmm?"
    quila "嗯？"

# game/scripts/Characters/quila.rpy:425
translate chinese_simp quila_taming_2_73f86f9e:

    # player "How do you pass the time? Since there's nothing to do around here..."
    player "你怎么打发时间？毕竟这儿也没事干……"

# game/scripts/Characters/quila.rpy:426
translate chinese_simp quila_taming_2_b104044d:

    # quila "At the beginning, I used to go for walks and explored almost daily..."
    quila "一开始，我几乎每天都出去散步、到处探索……"

# game/scripts/Characters/quila.rpy:427
translate chinese_simp quila_taming_2_807d11bb:

    # quila "But that got boring after a year."
    quila "但一年之后就腻了。"

# game/scripts/Characters/quila.rpy:431
translate chinese_simp quila_taming_2_d558b23a:

    # quila "By then, I explored most of the island and all it has to offer."
    quila "到那时候，我已经探索了岛上大部分地方，知道它也就那样了。"

# game/scripts/Characters/quila.rpy:432
translate chinese_simp quila_taming_2_0792d6be:

    # quila "So I've been spending most of my time in this cave ever since."
    quila "所以之后我大部分时间都待在这个山洞里。"

# game/scripts/Characters/quila.rpy:433
translate chinese_simp quila_taming_2_cabc47aa:

    # player "Why not build something like a house or what [kora] has?"
    player "为什么不建个房子，或者像 [kora] 那样？"

# game/scripts/Characters/quila.rpy:437
translate chinese_simp quila_taming_2_90d5bdf8:

    # quila "It's quite hidden, feels safe, and it's kinda pretty, so I got no reason to do such a thing..."
    quila "这儿够隐蔽，感觉安全，也挺好看，我没必要折腾……"

# game/scripts/Characters/quila.rpy:441
translate chinese_simp quila_taming_2_fac599b6:

    # player "Pretty..."
    player "好看……"

# game/scripts/Characters/quila.rpy:442
translate chinese_simp quila_taming_2_5e1165ce:

    # player "I noticed them before, but what's with the crystals?"
    player "我之前就注意到了，但这些水晶是怎么回事？"

# game/scripts/Characters/quila.rpy:443
translate chinese_simp quila_taming_2_3e747f99:

    # quila "I don't really know, they've been here for as long as I have..."
    quila "我也说不太清，我来的时候它们就在了……"

# game/scripts/Characters/quila.rpy:444
translate chinese_simp quila_taming_2_d947d050:

    # quila "And there's a whole cave full of them a bit deeper in."
    quila "再往里走还有一整个洞穴都是。"

# game/scripts/Characters/quila.rpy:445
translate chinese_simp quila_taming_2_9fa3a47c:

    # player "They look valuable..."
    player "看起来挺值钱的……"

# game/scripts/Characters/quila.rpy:449
translate chinese_simp quila_taming_2_681731dd:

    # quila "I collected them daily when I first got here..."
    quila "我刚来的时候天天收集……"

# game/scripts/Characters/quila.rpy:450
translate chinese_simp quila_taming_2_17178492:

    # quila "But after a few years and seemingly no way back home, I stopped."
    quila "但过了几年，似乎也回不了家了，我就不收了。"

# game/scripts/Characters/quila.rpy:451
translate chinese_simp quila_taming_2_e2ff3363:

    # quila "No point in collecting something I'm probably never going to be able to use..."
    quila "收集一堆可能永远用不上的东西，有什么意义……"

# game/scripts/Characters/quila.rpy:452
translate chinese_simp quila_taming_2_f9128995:

    # player "Do you mind if I collect them?"
    player "你介意我收集吗？"

# game/scripts/Characters/quila.rpy:456
translate chinese_simp quila_taming_2_36dd5d87:

    # quila "Knock yourself out..."
    quila "随你便……"

# game/scripts/Characters/quila.rpy:457
translate chinese_simp quila_taming_2_bee46ee0:

    # quila "Just don't do it at night when I'm trying to sleep."
    quila "别晚上我睡觉的时候弄就行。"

# game/scripts/Characters/quila.rpy:458
translate chinese_simp quila_taming_2_6b0c3900:

    # player "That's fair."
    player "没问题。"

# game/scripts/Characters/quila.rpy:459
translate chinese_simp quila_taming_2_d5e21e57:

    # player "Maybe we can use them for something when we finally get back home."
    player "等我们真回去了，说不定能派上用场。"

# game/scripts/Characters/quila.rpy:463
translate chinese_simp quila_taming_2_00a4ff66:

    # quila "Yea right."
    quila "呵，说得好像真能回去似的。"

# game/scripts/Characters/quila.rpy:464
translate chinese_simp quila_taming_2_9cccb972:

    # quila "If you actually manage to find a way back, I'll give you some of mine as a thank you."
    quila "要是你真能找到回去的办法，我的那些分你一些当谢礼。"

# game/scripts/Characters/quila.rpy:470
translate chinese_simp quila_taming_2_300dbdea:

    # player "I would much rather have a different kind of gift from you~"
    player "我倒是更想要点别的礼物~"

# game/scripts/Characters/quila.rpy:471
translate chinese_simp quila_taming_2_1df9e3a0:

    # quila "Huh..!"
    quila "哈……！"

# game/scripts/Characters/quila.rpy:475
translate chinese_simp quila_taming_2_fb6d6700:

    # quila "What are you even talking about..."
    quila "你都在说些什么啊……"

# game/scripts/Characters/quila.rpy:476
translate chinese_simp quila_taming_2_698efa94:

    # player "You know~"
    player "你懂的~"

# game/scripts/Characters/quila.rpy:480
translate chinese_simp quila_taming_2_da0ffe6d:

    # quila "Whatever..!"
    quila "随便你……！"

# game/scripts/Characters/quila.rpy:484
translate chinese_simp quila_taming_2_1e54de15:

    # player "I didn't hear a no~"
    player "我没听到拒绝哦~"

# game/scripts/Characters/quila.rpy:488
translate chinese_simp quila_taming_2_e18a376f:

    # quila "No! Happy?!?"
    quila "不行！满意了吧！？"

# game/scripts/Characters/quila.rpy:489
translate chinese_simp quila_taming_2_02673f21:

    # player "Why would that make me happy? I wanted to hear a yes."
    player "那有什么好满意的？我想听的是‘行’。"

# game/scripts/Characters/quila.rpy:493
translate chinese_simp quila_taming_2_31d74c50:

    # quila "Yeah well..."
    quila "那又怎样……"

# game/scripts/Characters/quila.rpy:494
translate chinese_simp quila_taming_2_8cb43ade:

    # quila "That's just how it is for now..."
    quila "反正目前就这样……"

# game/scripts/Characters/quila.rpy:495
translate chinese_simp quila_taming_2_54103d81:

    # player "For now? Does that mean there's still a chance?"
    player "目前？意思是还有机会？"

# game/scripts/Characters/quila.rpy:496
translate chinese_simp quila_taming_2_96cc7616:

    # player "That's all I wanted to hear~"
    player "我想听的就是这个~"

# game/scripts/Characters/quila.rpy:497
translate chinese_simp quila_taming_2_922cfdc8:

    # quila "G-Go away!"
    quila "走、走开！"

# game/scripts/Characters/quila.rpy:498
translate chinese_simp quila_taming_2_a6e84363:

    # think "Probably teased her enough for now..."
    think "大概逗够了吧……"

# game/scripts/Characters/quila.rpy:499
translate chinese_simp quila_taming_2_d251197e:

    # player "Alright, I'll come visit again in a bit~"
    player "好吧，我过会儿再来~"

# game/scripts/Characters/quila.rpy:500
translate chinese_simp quila_taming_2_a1df5588:

    # quila "Okay..."
    quila "嗯……"

# game/scripts/Characters/quila.rpy:503
translate chinese_simp quila_taming_2_d4137500:

    # player "And I'll be looking to collect that reward."
    player "我可惦记着那份谢礼呢。"

# game/scripts/Characters/quila.rpy:507
translate chinese_simp quila_taming_2_04e8861b:

    # quila "I'm rooting for you, but I'm not getting my hopes up."
    quila "我精神上支持你，但我不抱希望。"

# game/scripts/Characters/quila.rpy:508
translate chinese_simp quila_taming_2_cc5741bf:

    # player "Thanks..."
    player "谢了……"

# game/scripts/Characters/quila.rpy:512
translate chinese_simp quila_taming_2_29b25b26:

    # quila "I'm going to take a nap."
    quila "我要睡个午觉。"

# game/scripts/Characters/quila.rpy:513
translate chinese_simp quila_taming_2_073548a1:

    # player "I'll leave you to it."
    player "那我不打扰了。"

# game/scripts/Characters/quila.rpy:517
translate chinese_simp quila_taming_2_7772cc62:

    # quila "See ya."
    quila "再见。"

# game/scripts/Characters/quila.rpy:531
translate chinese_simp quila_taming_3_eab16e1b:

    # quila "What do you mean?"
    quila "什么意思？"

# game/scripts/Characters/quila.rpy:532
translate chinese_simp quila_taming_3_527ed7fd:

    # player "Exactly what I said, I think we found a way home..."
    player "就是字面意思，我觉得我们找到回家的路了……"

# game/scripts/Characters/quila.rpy:536
translate chinese_simp quila_taming_3_df998a9a:

    # quila "Is this some kind of prank? Don't get my hopes up for nothing please..."
    quila "你是在开玩笑吧？别让我空欢喜一场……"

# game/scripts/Characters/quila.rpy:537
translate chinese_simp quila_taming_3_ad924622:

    # player "It's no prank, but it might take some time..."
    player "不是玩笑，但可能得花些时间……"

# game/scripts/Characters/quila.rpy:538
translate chinese_simp quila_taming_3_232d3d74:

    # quila "I see..."
    quila "这样啊……"

# game/scripts/Characters/quila.rpy:542
translate chinese_simp quila_taming_3_e189869a:

    # quila "Is there anything I can do to speed it up?"
    quila "我能做点什么加快进度吗？"

# game/scripts/Characters/quila.rpy:543
translate chinese_simp quila_taming_3_ab53909f:

    # player "I mean... Technically..?"
    player "嗯……从理论上说……？"

# game/scripts/Characters/quila.rpy:547
translate chinese_simp quila_taming_3_b0922369:

    # quila "What's that supposed to mean?"
    quila "你这话什么意思？"

# game/scripts/Characters/quila.rpy:548
translate chinese_simp quila_taming_3_de27227e:

    # player "Well, looks like getting home is dependant on me, and how fast I can reach someone on the outside..."
    player "呃，看起来回家这事取决于我，还有我能多快联系上外面的人……"

# game/scripts/Characters/quila.rpy:549
translate chinese_simp quila_taming_3_c86d0212:

    # quila "Yeah..?"
    quila "然后呢……？"

# game/scripts/Characters/quila.rpy:550
translate chinese_simp quila_taming_3_6fb7ca40:

    # player "So you could technically help by getting me stronger~"
    player "所以从技术上来说，你可以帮我变强~"

# game/scripts/Characters/quila.rpy:551
translate chinese_simp quila_taming_3_108f5ad8:

    # quila "How would-"
    quila "怎么帮——"

# game/scripts/Characters/quila.rpy:555
translate chinese_simp quila_taming_3_f0a485ff:

    # quila "Oh."
    quila "哦。"

# game/scripts/Characters/quila.rpy:556
translate chinese_simp quila_taming_3_a314dffe:

    # quila "Forget it!"
    quila "当我没问！"

# game/scripts/Characters/quila.rpy:557
translate chinese_simp quila_taming_3_643f876f:

    # player "Thought that would be your reaction~"
    player "我就猜到你会这个反应~"

# game/scripts/Characters/quila.rpy:558
translate chinese_simp quila_taming_3_f7504a6c:

    # quila "Yeah whatever! I barely know you! And I'm not that strong to begin with, so it wouldn't be worth it anyway!"
    quila "行行行随便！我跟你不熟！而且我本来也没多强，总之不值当！"

# game/scripts/Characters/quila.rpy:562
translate chinese_simp quila_taming_3_ea55ceaf:

    # quila "Wh-what about the big lady? [kora]."
    quila "那、那个大个子女士呢？[kora]。"

# game/scripts/Characters/quila.rpy:563
translate chinese_simp quila_taming_3_6dfb5ec4:

    # quila "She looks way more useful than I could ever be."
    quila "她看着比我有用多了。"

# game/scripts/Characters/quila.rpy:564
translate chinese_simp quila_taming_3_2403f2fa:

    # player "She's physically stronger than me and I don't wanna be thrown from her treehouse again, so I'm not even gonna ask her."
    player "她力气比我大，我可不想再被从她的树屋扔出去了，所以我不打算问她。"

# game/scripts/Characters/quila.rpy:565
translate chinese_simp quila_taming_3_016479e5:

    # quila "Oh..."
    quila "哦……"

# game/scripts/Characters/quila.rpy:566
translate chinese_simp quila_taming_3_f2f550f5:

    # player "Also..."
    player "而且……"

# game/scripts/Characters/quila.rpy:570
translate chinese_simp quila_taming_3_6b77994c:

    # quila "..!"
    quila "……！"

# game/scripts/Characters/quila.rpy:571
translate chinese_simp quila_taming_3_422dac0e:

    # player "Don't sell yourself short, I'm sure you're just as strong as her, just maybe not physically~"
    player "别妄自菲薄，我相信你和她一样强大，只是可能不是身体上的~"

# game/scripts/Characters/quila.rpy:575
translate chinese_simp quila_taming_3_ba2842bd:

    # quila "Whatever!"
    quila "随便！"

# game/scripts/Characters/quila.rpy:576
translate chinese_simp quila_taming_3_0b1bb6e2:

    # quila "I won't agree to being tamed that easily!"
    quila "我才不会随随便便就答应被你驯服！"

# game/scripts/Characters/quila.rpy:577
translate chinese_simp quila_taming_3_c9057064:

    # player "Just means I have to try harder~"
    player "那就说明我得加倍努力了~"

# game/scripts/Characters/quila.rpy:578
translate chinese_simp quila_taming_3_5fd5d303:

    # quila "Do whatever you want!"
    quila "随你便！"

# game/scripts/Characters/quila.rpy:579
translate chinese_simp quila_taming_3_0a0a22a6:

    # player "I think I've teased you enough~"
    player "我想我已经逗得够多了~"

# game/scripts/Characters/quila.rpy:583
translate chinese_simp quila_taming_3_a8256d2f:

    # quila "Hmm?"
    quila "嗯？"

# game/scripts/Characters/quila.rpy:584
translate chinese_simp quila_taming_3_5ee1437b:

    # player "Just wanted to come to tell you about the potential way home..."
    player "只是想来告诉你可能回去的办法……"

# game/scripts/Characters/quila.rpy:588
translate chinese_simp quila_taming_3_c58f967d:

    # quila "So you were just messing with me!?"
    quila "所以你刚才都是在耍我！？"

# game/scripts/Characters/quila.rpy:589
translate chinese_simp quila_taming_3_b8c81439:

    # player "No... Everything I said was true."
    player "不是……我说的都是真的。"

# game/scripts/Characters/quila.rpy:593
translate chinese_simp quila_taming_3_828d9cc7:

    # quila "Fine. Whatever!"
    quila "行吧。随便！"

# game/scripts/Characters/quila.rpy:594
translate chinese_simp quila_taming_3_090b4eba:

    # player "Hey, come visit us at the camp sometime..."
    player "嘿，有空来营地找我们……"

# game/scripts/Characters/quila.rpy:599
translate chinese_simp quila_taming_3_5a7d8fbd:

    # quila "I tried to... But you were busy..."
    quila "我试过……但你们在忙……"

# game/scripts/Characters/quila.rpy:600
translate chinese_simp quila_taming_3_9e79a99a:

    # player "What do you mean? How were we busy- Oh..."
    player "什么意思？我们忙什么了——哦……"

# game/scripts/Characters/quila.rpy:601
translate chinese_simp quila_taming_3_98bbd0a9:

    # player "Well don't let that stop you next time~"
    player "下次可别因为这个就不来了~"

# game/scripts/Characters/quila.rpy:606
translate chinese_simp quila_taming_3_91535452:

    # quila "If I find the time."
    quila "得看我有没有空。"

# game/scripts/Characters/quila.rpy:607
translate chinese_simp quila_taming_3_4a244d06:

    # player "What could you possibly be busy with around here..?"
    player "你在这儿能忙什么……？"

# game/scripts/Characters/quila.rpy:611
translate chinese_simp quila_taming_3_a6081e37:

    # quila "Go!"
    quila "走啦！"

# game/scripts/Characters/quila.rpy:612
translate chinese_simp quila_taming_3_5ab4fab9:

    # player "Yeah, yeah..."
    player "好，好……"

# game/scripts/Characters/quila.rpy:622
translate chinese_simp quila_taming_4_4606f2cb:

    # quila "You here to mine crystals again..?"
    quila "你又来挖水晶了……？"

# game/scripts/Characters/quila.rpy:623
translate chinese_simp quila_taming_4_5c54dfaa:

    # player "Not right now... I'm here to bring you some great news..."
    player "不是……我来告诉你个好消息……"

# game/scripts/Characters/quila.rpy:626
translate chinese_simp quila_taming_4_c7a79ae4:

    # quila "What is it about?"
    quila "什么消息？"

# game/scripts/Characters/quila.rpy:627
translate chinese_simp quila_taming_4_e01d2ccf:

    # player "It's about getting us back home."
    player "关于我们回家的事。"

# game/scripts/Characters/quila.rpy:630
translate chinese_simp quila_taming_4_1dcb91e4:

    # quila "You still trying that? I thought you gave up months ago..."
    quila "你还在折腾这个？我以为你几个月前就放弃了……"

# game/scripts/Characters/quila.rpy:631
translate chinese_simp quila_taming_4_833352e1:

    # player "No... I was trying to reach someone on the outside every day, and now I succeeded for the first time."
    player "没有……我每天都试着联系外面的人，今天第一次成功了。"

# game/scripts/Characters/quila.rpy:635
translate chinese_simp quila_taming_4_a1df5588:

    # quila "Okay..."
    quila "是么……"

# game/scripts/Characters/quila.rpy:636
translate chinese_simp quila_taming_4_1ad285e8:

    # player "It's the first proof we have that I wasn't yelling into the void for all that time."
    player "这至少证明了，我这段时间不是在对空气喊话。"

# game/scripts/Characters/quila.rpy:637
translate chinese_simp quila_taming_4_40526c55:

    # player "And it's a very good indication that someone's actually coming to save us."
    player "也说明真的有人会来救我们。"

# game/scripts/Characters/quila.rpy:641
translate chinese_simp quila_taming_4_e4f4b508:

    # quila "Is it going to take much longer now?"
    quila "现在还需要很久吗？"

# game/scripts/Characters/quila.rpy:645
translate chinese_simp quila_taming_4_e4d33762:

    # player "I don't know... Depends on how things go~"
    player "不好说……看情况吧~"

# game/scripts/Characters/quila.rpy:648
translate chinese_simp quila_taming_4_d6bf5d11:

    # quila "What are you doing... Are you trying that thing again?"
    quila "你干嘛……又想那事？"

# game/scripts/Characters/quila.rpy:651
translate chinese_simp quila_taming_4_3cc7654e:

    # player "Busted... Sorry."
    player "被抓包了……抱歉。"

# game/scripts/Characters/quila.rpy:652
translate chinese_simp quila_taming_4_51572cdb:

    # quila "Why do you do that? You always just tease me..."
    quila "你为什么老这样？总是逗我……"

# game/scripts/Characters/quila.rpy:653
translate chinese_simp quila_taming_4_82f610d9:

    # player "What else am I supposed to do..? You always tell me to leave right after~"
    player "那我还能怎么办？你老是说完就赶我走~"

# game/scripts/Characters/quila.rpy:656
translate chinese_simp quila_taming_4_52209b86:

    # quila "You don't have to take it seriously..."
    quila "你不用真当回事……"

# game/scripts/Characters/quila.rpy:657
translate chinese_simp quila_taming_4_02faca00:

    # player "Does that mean you want me to do more..?"
    player "这是说你想让我多做点什么……？"

